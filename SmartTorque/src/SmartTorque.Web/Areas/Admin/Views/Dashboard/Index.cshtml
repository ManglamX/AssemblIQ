@using SmartTorque.Core.Enums
@model SmartTorque.Services.DashboardStatsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Plant Quality Dashboard</h1>
        <p class="text-muted small mb-0">Real-time overview of shop-floor assembly, device telemetry, and quality yield</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="" asp-controller="Report" asp-action="Sessions" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-clock-history me-1"></i> Full Session Report
        </a>
        <a asp-area="" asp-controller="Job" asp-action="Workload" class="btn btn-primary btn-sm">
            <i class="bi bi-kanban me-1"></i> Workload Board
        </a>
    </div>
</div>

<!-- KPI Row -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card shadow-sm">
            <div class="kpi-label mb-2"><i class="bi bi-clipboard-check me-1"></i>Jobs Today</div>
            <div class="kpi-value num text-dark" id="kpi-jobs-today">@Model.TotalJobsToday</div>
            <div class="text-muted small mt-1">
                <span class="text-primary fw-semibold">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.InProgress, 0))</span> In Progress &bull;
                <span class="text-success fw-semibold">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.Completed, 0))</span> Done
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card shadow-sm border-start border-success border-4">
            <div class="kpi-label mb-2"><i class="bi bi-check-circle me-1"></i>Today's Pass Rate</div>
            <div class="kpi-value num text-success" id="kpi-pass-rate">@Model.TodayPassRate%</div>
            <div class="text-muted small mt-1">First-pass yield: <span class="fw-semibold text-dark">@Model.TodayFirstPassYield%</span> (@Model.TodaySessionsCount sessions)</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card shadow-sm border-start border-primary border-4">
            <div class="kpi-label mb-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-router me-1"></i>Online Devices</span>
                <span class="badge bg-success-subtle text-success small" id="live-indicator"><i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> Live</span>
            </div>
            <div class="kpi-value num text-primary" id="kpi-devices-online">@Model.OnlineDevicesCount</div>
            <div class="text-muted small mt-1">
                <span id="kpi-devices-torque">@Model.OnlineTorqueCount</span> Torque &bull;
                <span id="kpi-devices-vernier">@Model.OnlineVernierCount</span> Vernier (of @Model.TotalDevicesCount fleet)
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card shadow-sm border-start border-dark border-4" style="background-color: @(Model.CriticalBlackJobsWaiting > 0 ? "#FFF1F2" : "#FFFFFF");">
            <div class="kpi-label mb-2 text-danger fw-bold"><i class="bi bi-exclamation-octagon-fill me-1"></i>Black Jobs Waiting</div>
            <div class="kpi-value num @(Model.CriticalBlackJobsWaiting > 0 ? "text-danger" : "text-muted")" id="kpi-critical-jobs">@Model.CriticalBlackJobsWaiting</div>
            <div class="text-muted small mt-1">
                @if (Model.CriticalBlackJobsWaiting > 0)
                {
                    <a asp-area="" asp-controller="Job" asp-action="Workload" class="text-danger fw-semibold text-decoration-none">
                        Urgent dispatch required <i class="bi bi-arrow-right"></i>
                    </a>
                }
                else
                {
                    <span>All critical jobs addressed</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Jobs by Status Overview Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-pie-chart me-1"></i> Shop Floor Job Distribution</span>
        <a asp-area="" asp-controller="Job" asp-action="Workload" class="btn btn-sm btn-link text-decoration-none">Manage Workload &rarr;</a>
    </div>
    <div class="card-body">
        <div class="row g-2 text-center">
            <div class="col">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small">Pending</div>
                    <div class="fs-5 fw-bold text-secondary">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.Pending, 0))</div>
                </div>
            </div>
            <div class="col">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small">Assigned</div>
                    <div class="fs-5 fw-bold text-info">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.Assigned, 0))</div>
                </div>
            </div>
            <div class="col">
                <div class="p-2 rounded bg-light border border-primary">
                    <div class="text-muted small">In Progress</div>
                    <div class="fs-5 fw-bold text-primary">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.InProgress, 0))</div>
                </div>
            </div>
            <div class="col">
                <div class="p-2 rounded bg-light border border-success">
                    <div class="text-muted small">Completed</div>
                    <div class="fs-5 fw-bold text-success">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.Completed, 0))</div>
                </div>
            </div>
            <div class="col">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small">On Hold</div>
                    <div class="fs-5 fw-bold text-warning">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.OnHold, 0))</div>
                </div>
            </div>
            <div class="col">
                <div class="p-2 rounded bg-light border border-danger">
                    <div class="text-muted small">Rework</div>
                    <div class="fs-5 fw-bold text-danger">@(Model.JobsByStatus.GetValueOrDefault(JobStatus.Rework, 0))</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Sessions Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-clock-history me-1"></i> Recent Assembly Sessions</span>
        <a asp-area="" asp-controller="Report" asp-action="Sessions" class="btn btn-sm btn-link text-decoration-none">View All Sessions &rarr;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Session</th>
                    <th>Job & Serial</th>
                    <th>Product / Component</th>
                    <th>Worker</th>
                    <th>Started</th>
                    <th>Duration</th>
                    <th class="text-center">Result</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentSessions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-clipboard-x fs-2 d-block mb-2 text-secondary"></i>
                            No sessions recorded yet. Sessions will appear here once workers begin assembly jobs.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model.RecentSessions)
                    {
                        <tr>
                            <td><span class="fw-bold text-secondary">#@s.SessionId</span></td>
                            <td>
                                <div class="fw-semibold">@s.JobNo</div>
                                @if (!string.IsNullOrEmpty(s.ProductSerial))
                                {
                                    <div class="small text-muted font-monospace">@s.ProductSerial</div>
                                }
                            </td>
                            <td>
                                <div class="fw-medium">@s.ProductName</div>
                                <div class="small text-muted">@s.ComponentName</div>
                            </td>
                            <td>@s.WorkerName</td>
                            <td class="small">@s.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="small">@(s.Duration.HasValue ? $"{s.Duration.Value.TotalMinutes:0.0} min" : "In Progress")</td>
                            <td class="text-center">
                                @if (s.FinalResult == SessionResult.Pass)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>PASS</span>
                                }
                                else if (s.FinalResult == SessionResult.Fail)
                                {
                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-circle me-1"></i>FAIL</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning">@s.FinalResult</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-area="" asp-controller="Report" asp-action="SessionDetail" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-primary">
                                    Audit
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        // Connect to SignalR hub to receive real-time device status updates
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/live")
            .withAutomaticReconnect()
            .build();

        connection.on("deviceStatus", function(data) {
            console.log("Device status broadcast received:", data);
            // Request latest count or increment/decrement live
            const onlineCountElem = document.getElementById("kpi-devices-online");
            if (onlineCountElem && data) {
                // If device came online
                if (data.isOnline === true) {
                    // Visual pulse
                    onlineCountElem.classList.add("text-success");
                    setTimeout(() => onlineCountElem.classList.remove("text-success"), 1000);
                }
            }
        });

        connection.start()
            .then(function() {
                console.log("Connected to LiveReadingHub as admin");
                return connection.invoke("JoinAdmins");
            })
            .catch(function(err) {
                console.warn("SignalR connection error:", err);
            });
    </script>
}
