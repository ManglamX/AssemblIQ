@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h4 fw-bold mb-1">Dashboard</h1>
        <p class="text-muted small mb-0">Overview of today's production and system status</p>
    </div>
</div>

<!-- KPI Row -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label mb-2"><i class="bi bi-clipboard-check me-1"></i>Jobs Today</div>
            <div class="kpi-value num" id="kpi-jobs-today">—</div>
            <div class="text-muted small mt-1">Pending / In Progress / Done</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label mb-2"><i class="bi bi-check-circle me-1"></i>Pass Rate Today</div>
            <div class="kpi-value num" id="kpi-pass-rate">—</div>
            <div class="text-muted small mt-1">First-pass yield</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label mb-2"><i class="bi bi-router me-1"></i>Online Devices</div>
            <div class="kpi-value num" id="kpi-devices-online">—</div>
            <div class="text-muted small mt-1">Torque / Vernier</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card" style="border: 2px solid var(--pri-black);">
            <div class="kpi-label mb-2"><i class="bi bi-exclamation-circle me-1"></i>Critical Jobs Waiting</div>
            <div class="kpi-value num text-brand" id="kpi-critical-jobs">—</div>
            <div class="text-muted small mt-1">BLACK priority</div>
        </div>
    </div>
</div>

<!-- Recent sessions placeholder -->
<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-clock-history"></i> Recent Sessions
    </div>
    <div class="card-body text-center text-muted py-5" id="recent-sessions-empty">
        <i class="bi bi-clipboard-x" style="font-size:2rem;"></i>
        <p class="mt-2 mb-0">No sessions recorded yet.</p>
        <p class="small">Sessions will appear here once workers start jobs.</p>
    </div>
</div>
