@model SmartTorque.Services.ExecutionStateDto
@using SmartTorque.Core.Enums
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = $"Assembly Cockpit — {Model.JobNo}";

    var currentStep = Model.CurrentStep;
    var instrumentName = currentStep?.Instrument == InstrumentType.Torque ? "Torque Wrench" : "Vernier Caliper";
    var unitSymbol = currentStep?.Instrument == InstrumentType.Torque ? "N·m" : "mm";
    var activeDevice = currentStep?.Instrument == InstrumentType.Torque ? Model.TorqueDeviceTransmitterId ?? "SIM-TORQUE-01" : Model.VernierDeviceTransmitterId ?? "SIM-VERNIER-01";

    decimal minScale = 0;
    decimal maxScale = 100;
    decimal zoneLeft = 30;
    decimal zoneWidth = 40;

    if (currentStep != null)
    {
        var span = Math.Max(currentStep.UpperLimit - currentStep.LowerLimit, currentStep.Target * 0.2m);
        minScale = Math.Max(0, currentStep.LowerLimit - (span * 1.5m));
        maxScale = currentStep.UpperLimit + (span * 1.5m);
        if (maxScale <= minScale) maxScale = minScale + 10;

        zoneLeft = Math.Max(0, Math.Min(100, ((currentStep.LowerLimit - minScale) / (maxScale - minScale)) * 100));
        var right = Math.Max(0, Math.Min(100, ((currentStep.UpperLimit - minScale) / (maxScale - minScale)) * 100));
        zoneWidth = Math.Max(1, right - zoneLeft);
    }
}

<div class="container-fluid px-3 py-2">
    <!-- Top Bar: Breadcrumb, Unit, Hardware chips, Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom gap-2">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker" })" class="btn btn-outline-secondary btn-sm" title="Back to Job Board">
                <i class="bi bi-arrow-left me-1"></i>Jobs
            </a>
            <div>
                <span class="badge bg-dark me-1">@Model.JobNo</span>
                <span class="fw-bold">@Model.ProductCode</span>
                <span class="text-muted small ms-1">(@Model.ProductName)</span>
            </div>
            <div class="vr mx-1 d-none d-md-block"></div>
            <div class="badge bg-primary text-white fs-6 py-1 px-2">
                Unit @Model.UnitNo of @Model.Quantity
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Hardware connection badges -->
            <span class="badge bg-light text-dark border d-flex align-items-center gap-1" id="torque-status-badge">
                <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i>
                <i class="bi bi-wrench"></i> @(Model.TorqueDeviceTransmitterId ?? "SIM-TORQUE-01")
            </span>
            <span class="badge bg-light text-dark border d-flex align-items-center gap-1" id="vernier-status-badge">
                <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i>
                <i class="bi bi-rulers"></i> @(Model.VernierDeviceTransmitterId ?? "SIM-VERNIER-01")
            </span>

            <!-- SignalR Status -->
            <span class="badge bg-light text-secondary border d-flex align-items-center gap-1" id="signalr-status">
                <i class="bi bi-broadcast text-secondary" id="signalr-icon"></i>
                <span id="signalr-text">Connecting...</span>
            </span>

            <a href="/dev/simulator?device=@activeDevice" target="_blank" class="btn btn-outline-info btn-sm fw-semibold" title="Launch Simulator to send readings">
                <i class="bi bi-cpu me-1"></i>Hardware Simulator
            </a>

            <!-- Hold Action -->
            <form asp-action="Hold" asp-route-id="@Model.JobId" method="post" class="d-inline" onsubmit="return confirm('Place this job on hold?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-pause-circle me-1"></i>Hold
                </button>
            </form>
        </div>
    </div>

    <!-- Component Progress Strip -->
    <div class="card mb-3 border shadow-sm">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small text-muted fw-bold text-uppercase">Assembly Order — Components</span>
                <span class="small text-muted">@Model.CurrentComponent.ComponentName (@Model.CurrentComponent.AssemblyOrder of @Model.Components.Count)</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var c in Model.Components)
                {
                    var isCurrent = c.ProductComponentId == Model.CurrentComponent.ProductComponentId;
                    var isDone = c.IsCompletedForCurrentUnit;

                    <div class="d-flex align-items-center">
                        @if (isCurrent)
                        {
                            <span class="btn btn-sm btn-primary active py-1 px-2 d-flex align-items-center gap-1">
                                <span class="badge bg-white text-primary rounded-circle">@c.AssemblyOrder</span>
                                <strong>@c.ComponentName</strong>
                                <span class="badge bg-light text-dark ms-1">@c.StepCount steps</span>
                            </span>
                        }
                        else
                        {
                            <form asp-action="SwitchComponent" asp-route-id="@Model.JobId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productComponentId" value="@c.ProductComponentId" />
                                <button type="submit" class="btn btn-sm @(isDone ? "btn-outline-success" : "btn-outline-secondary") py-1 px-2 d-flex align-items-center gap-1">
                                    <span class="badge @(isDone ? "bg-success text-white" : "bg-secondary text-white") rounded-circle">
                                        @if (isDone) { <i class="bi bi-check"></i> } else { @c.AssemblyOrder }
                                    </span>
                                    <span>@c.ComponentName</span>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.Status == JobStatus.Completed || Model.QuantityCompleted >= Model.Quantity)
    {
        <!-- Celebration Job Completed Banner -->
        <div class="alert alert-success border-success text-center py-5 shadow-sm rounded-3">
            <i class="bi bi-trophy-fill text-warning" style="font-size: 4rem;"></i>
            <h2 class="h3 fw-bold mt-3">Job Complete!</h2>
            <p class="fs-5 text-muted mb-4">All @Model.Quantity units have been assembled and verified through calibrated measurements.</p>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker" })" class="btn btn-success btn-lg px-4">
                <i class="bi bi-arrow-left-circle me-2"></i>Return to Job Board
            </a>
        </div>
    }
    else if (currentStep == null || Model.SessionFinalResult == SmartTorque.Core.Enums.SessionResult.Pass)
    {
        <!-- Component Passed State -->
        <div class="alert alert-success border-success text-center py-5 shadow-sm rounded-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
            <h2 class="h3 fw-bold mt-3">Component "@Model.CurrentComponent.ComponentName" Complete!</h2>
            <p class="fs-5 text-muted mb-4">All steps have passed acceptance criteria.</p>
            @{
                var nextComp = Model.Components.FirstOrDefault(c => c.AssemblyOrder > Model.CurrentComponent.AssemblyOrder && !c.IsCompletedForCurrentUnit)
                    ?? Model.Components.FirstOrDefault(c => !c.IsCompletedForCurrentUnit);
            }
            @if (nextComp != null)
            {
                <form asp-action="SwitchComponent" asp-route-id="@Model.JobId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productComponentId" value="@nextComp.ProductComponentId" />
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        Proceed to Next Component: @nextComp.ComponentName <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Start" asp-route-id="@Model.JobId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        Proceed to Unit @(Model.UnitNo + 1) <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </form>
            }
        </div>
    }
    else
    {
        <!-- Main Cockpit Layout: 2 Columns (Execution Gauge & Steps/Blueprint) -->
        <div class="row g-3">
            <!-- Left Column: Gauge, Live Value, Tolerance limits, Simulator -->
            <div class="col-12 col-xl-7">
                <div class="card border shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <!-- Step Header -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary text-uppercase fs-6 py-1 px-2">
                                    Step @currentStep.SequenceNo of @Model.Steps.Count
                                </span>
                                <span class="badge @(currentStep.Instrument == InstrumentType.Torque ? "bg-info text-dark" : "bg-warning text-dark") fs-6 py-1 px-2">
                                    <i class="bi @(currentStep.Instrument == InstrumentType.Torque ? "bi-wrench" : "bi-rulers") me-1"></i>
                                    @instrumentName
                                </span>
                            </div>
                            <h2 class="h4 fw-bold mb-3" id="step-label">@currentStep.Label</h2>

                            <!-- Target and Limits Bar -->
                            <div class="row g-2 text-center mb-4">
                                <div class="col-4">
                                    <div class="p-2 border rounded bg-light">
                                        <div class="text-muted small">Target</div>
                                        <div class="fw-bold fs-5 text-dark" id="target-value">@currentStep.Target.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 border rounded bg-light">
                                        <div class="text-muted small">Lower Limit</div>
                                        <div class="fw-bold fs-5 text-success" id="lower-limit">@currentStep.LowerLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 border rounded bg-light">
                                        <div class="text-muted small">Upper Limit</div>
                                        <div class="fw-bold fs-5 text-success" id="upper-limit">@currentStep.UpperLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Value Big Digits Display -->
                            <div class="text-center py-4 bg-light border rounded-3 position-relative mb-4">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    Live Reading (@activeDevice)
                                </div>
                                <div class="live-value-display" id="live-value">
                                    <span id="reading-num">--.-</span>
                                    <span class="live-value-unit">@unitSymbol</span>
                                </div>
                                <div id="live-status-text" class="text-muted small mt-2">
                                    <i class="bi bi-clock-history me-1"></i>Waiting for device transmission...
                                </div>
                            </div>

                            <!-- Gauge Bar -->
                            <div class="mb-4 px-2">
                                <div class="gauge-track position-relative" style="height: 18px; background: #e9ecef; border-radius: 9px;">
                                    <!-- Accept Zone (Green) -->
                                    <div class="gauge-accept-zone" id="gauge-zone"
                                         style="position: absolute; top: 0; bottom: 0; left: @zoneLeft%; width: @zoneWidth%; background: #d1e7dd; border: 1px solid #198754; border-radius: 4px;"
                                         title="Acceptance Band [@currentStep.LowerLimit - @currentStep.UpperLimit]">
                                    </div>
                                    <!-- Needle Indicator -->
                                    <div class="gauge-needle" id="gauge-needle"
                                         style="position: absolute; top: -5px; width: 6px; height: 28px; background: #0d6efd; border-radius: 3px; transform: translateX(-50%); left: 0%; transition: left 0.15s ease;">
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mt-1">
                                    <span>@minScale.ToString("0.#")</span>
                                    <span class="text-success fw-bold">Acceptance Zone</span>
                                    <span>@maxScale.ToString("0.#")</span>
                                </div>
                            </div>

                            <!-- Result Banner -->
                            <div id="result-banner" class="d-none alert mb-3 py-3 px-4 rounded-3 text-center fs-5 fw-bold" role="alert">
                                <span id="banner-text">PASS</span>
                            </div>
                        </div>

                        <!-- Simulator Control Panel (For Interactive Testing & Station 1) -->
                        <div class="border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted fw-bold text-uppercase">
                                    <i class="bi bi-sliders me-1"></i>Device Simulator (@activeDevice)
                                </span>
                                <span class="badge bg-secondary">Station 1</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-outline-success btn-sm sim-btn" onclick="sendSimulated(@currentStep.Target)">
                                    <i class="bi bi-bullseye me-1"></i>Target (@currentStep.Target.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm sim-btn" onclick="sendSimulated(@currentStep.LowerLimit)">
                                    <i class="bi bi-chevron-bar-right me-1"></i>Min Limit (@currentStep.LowerLimit.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm sim-btn" onclick="sendSimulated(@currentStep.UpperLimit)">
                                    <i class="bi bi-chevron-bar-left me-1"></i>Max Limit (@currentStep.UpperLimit.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm sim-btn" onclick="sendSimulated(@(currentStep.LowerLimit - 2.0m))">
                                    <i class="bi bi-x-circle me-1"></i>Fail Low (@((currentStep.LowerLimit - 2.0m).ToString("0.0##")))
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm sim-btn" onclick="sendSimulated(@(currentStep.UpperLimit + 2.0m))">
                                    <i class="bi bi-x-circle me-1"></i>Fail High (@((currentStep.UpperLimit + 2.0m).ToString("0.0##")))
                                </button>
                            </div>

                            <div class="input-group input-group-sm">
                                <span class="input-group-text">Custom @unitSymbol:</span>
                                <input type="number" step="0.01" id="custom-sim-val" class="form-control" placeholder="@currentStep.Target" />
                                <button class="btn btn-primary" type="button" onclick="sendCustomSimulated()">
                                    <i class="bi bi-send me-1"></i>Send Reading
                                </button>
                                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#manualEntryModal">
                                    <i class="bi bi-pencil-square me-1"></i>Manual Entry
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual Component Blueprint with Markers & Steps Checklist -->
            <div class="col-12 col-xl-5">
                <div class="card border shadow-sm mb-3">
                    <div class="card-header bg-white py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-uppercase">
                                <i class="bi bi-diagram-3 me-1"></i>@Model.CurrentComponent.ComponentName Blueprint
                            </span>
                            <span class="badge bg-light text-dark border">@Model.CurrentComponent.TemplateCode</span>
                        </div>
                    </div>
                    <div class="card-body p-2 text-center bg-light position-relative" style="min-height: 260px; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(Model.CurrentComponent.ImagePath))
                        {
                            <div class="position-relative d-inline-block">
                                <img src="@Model.CurrentComponent.ImagePath" alt="@Model.CurrentComponent.ComponentName" class="img-fluid rounded border" style="max-height: 250px;" />
                                @foreach (var s in Model.Steps)
                                {
                                    if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                    {
                                        var isCurr = s.IsCurrent;
                                        var isPass = s.IsCompleted;
                                        var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");

                                        <div class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass"
                                             style="left: @s.MarkerX%; top: @s.MarkerY%; width: 28px; height: 28px; font-size: 13px; transform: translate(-50%, -50%); cursor: pointer;"
                                             title="@s.Label: @s.Target @unitSymbol">
                                            @if (isPass) { <i class="bi bi-check"></i> } else { @s.SequenceNo }
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Fallback Schematic Container with Visual Pins -->
                            <div class="position-relative w-100 rounded border bg-white" style="height: 240px; border-style: dashed !important;">
                                <div class="text-muted small position-absolute top-50 start-50 translate-middle">
                                    <i class="bi bi-box fs-1 d-block mb-1 text-secondary"></i>
                                    <span>@Model.CurrentComponent.ComponentName Schematic</span>
                                </div>
                                @foreach (var s in Model.Steps)
                                {
                                    if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                    {
                                        var isCurr = s.IsCurrent;
                                        var isPass = s.IsCompleted;
                                        var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");

                                        <div class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass"
                                             style="left: @s.MarkerX%; top: @s.MarkerY%; width: 28px; height: 28px; font-size: 13px; transform: translate(-50%, -50%);"
                                             title="@s.Label: @s.Target @unitSymbol">
                                            @if (isPass) { <i class="bi bi-check"></i> } else { @s.SequenceNo }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Steps Checklist -->
                <div class="card border shadow-sm">
                    <div class="card-header bg-white py-2">
                        <span class="fw-bold small text-uppercase">
                            <i class="bi bi-list-check me-1"></i>Steps Checklist
                        </span>
                    </div>
                    <div class="list-group list-group-flush" style="max-height: 320px; overflow-y: auto;">
                        @foreach (var s in Model.Steps)
                        {
                            var rowClass = s.IsCurrent ? "bg-primary-subtle border-start border-primary border-4" : "";
                            var statusBadge = s.IsCompleted
                                ? "<span class=\"badge bg-success\"><i class=\"bi bi-check-lg me-1\"></i>Pass</span>"
                                : (s.IsCurrent
                                    ? "<span class=\"badge bg-primary\"><i class=\"bi bi-arrow-right-circle me-1\"></i>Active</span>"
                                    : "<span class=\"badge bg-light text-muted border\">Pending</span>");

                            <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 @rowClass">
                                <div>
                                    <div class="fw-semibold small">
                                        <span class="me-1">#@s.SequenceNo</span> @s.Label
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        Target: <strong>@s.Target.ToString("0.0##")</strong> [@s.LowerLimit.ToString("0.0##") - @s.UpperLimit.ToString("0.0##")] @(s.Instrument == InstrumentType.Torque ? "N·m" : "mm")
                                        @if (s.AttemptCount > 0)
                                        {
                                            <span class="ms-1">(@s.AttemptCount attempt(s))</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    @Html.Raw(statusBadge)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Manual Entry Modal -->
<div class="modal fade" id="manualEntryModal" tabindex="-1" aria-labelledby="manualEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="manualEntryModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Record Manual Measurement
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    Manual entry requires recording a valid reason code per traceability rules (PRD §5.5).
                </p>
                <div class="mb-3">
                    <label class="form-label fw-bold">Measured Value (@unitSymbol)</label>
                    <input type="number" step="0.001" id="manual-value" class="form-control" placeholder="@(currentStep?.Target.ToString("0.0##") ?? "0")" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason Code</label>
                    <select id="manual-reason" class="form-select" required>
                        <option value="DEVICE_OFFLINE">Transmitter / Tool Battery Depleted</option>
                        <option value="TOOL_CALIBRATION_CHECK">Manual Calibrated Gauge Verification</option>
                        <option value="COMM_ERROR">Gateway Communication Timeout</option>
                        <option value="SUPERVISOR_OVERRIDE">Supervisor Inspection Override</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitManualReading()">
                    <i class="bi bi-check-circle me-1"></i>Submit Manual Reading
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const sessionId = @Model.SessionId;
        const jobId = @Model.JobId;
        const minScale = @minScale;
        const maxScale = @maxScale;
        const targetVal = @(currentStep?.Target ?? 0);
        const lowerLimit = @(currentStep?.LowerLimit ?? 0);
        const upperLimit = @(currentStep?.UpperLimit ?? 0);
        const instrumentType = @((int)(currentStep?.Instrument ?? InstrumentType.Torque));
        const unitSymbol = "@unitSymbol";

        // Setup SignalR connection
        let connection = null;
        if (typeof signalR !== 'undefined') {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            connection.on("ReadingProcessed", function (data) {
                console.log("Received live reading via SignalR:", data);
                handleReadingResult(data);
            });

            connection.on("SessionCompleted", function (data) {
                console.log("Session completed via SignalR:", data);
                setTimeout(function () {
                    window.location.href = '/Worker/JobBoard/Summary/' + (data.sessionId || sessionId);
                }, 1000);
            });

            connection.start()
                .then(function () {
                    console.log("Connected to SignalR LiveReadingHub");
                    document.getElementById("signalr-text").textContent = "Live Connected";
                    document.getElementById("signalr-icon").className = "bi bi-broadcast text-success";
                    connection.invoke("JoinSession", sessionId);
                    connection.invoke("JoinJob", jobId);
                })
                .catch(function (err) {
                    console.warn("SignalR connection error:", err.toString());
                    document.getElementById("signalr-text").textContent = "Polling Mode";
                });
        }

        function updateGaugeNeedle(val) {
            const clamped = Math.max(minScale, Math.min(maxScale, val));
            const range = maxScale - minScale;
            const pct = range > 0 ? ((clamped - minScale) / range) * 100 : 50;
            const needle = document.getElementById("gauge-needle");
            if (needle) {
                needle.style.left = pct + "%";
            }

            const readingNum = document.getElementById("reading-num");
            if (readingNum) {
                readingNum.textContent = Number(val).toFixed(2);
            }

            const liveVal = document.getElementById("live-value");
            if (liveVal) {
                if (val >= lowerLimit && val <= upperLimit) {
                    liveVal.className = "live-value-display in-range text-success";
                } else {
                    liveVal.className = "live-value-display out-range text-danger";
                }
            }
        }

        function handleReadingResult(res) {
            updateGaugeNeedle(res.actualValue);

            const banner = document.getElementById("result-banner");
            const bannerText = document.getElementById("banner-text");
            const statusText = document.getElementById("live-status-text");

            if (banner && bannerText) {
                banner.classList.remove("d-none", "alert-success", "alert-danger");
                if (res.isStepPassed) {
                    banner.classList.add("alert-success");
                    bannerText.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>PASS — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (statusText) statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Within acceptance limits</span>';
                } else {
                    banner.classList.add("alert-danger");
                    bannerText.innerHTML = '<i class="bi bi-x-circle-fill me-2"></i>FAIL (Attempt ' + res.attemptNo + '/' + res.maxRetries + ') — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (statusText) statusText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Outside tolerance limits</span>';
                }
            }

            // Auto-advance or redirect to summary if session completed
            if (res.isSessionCompleted) {
                setTimeout(function () {
                    window.location.href = '/Worker/JobBoard/Summary/' + res.sessionId;
                }, 900);
            } else if (res.isStepPassed) {
                setTimeout(function () {
                    window.location.reload();
                }, 850);
            }
        }

        async function sendSimulated(val) {
            updateGaugeNeedle(val);

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit reading.');
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        function sendCustomSimulated() {
            const input = document.getElementById("custom-sim-val");
            const val = parseFloat(input.value);
            if (isNaN(val)) {
                alert("Please enter a valid numeric reading value.");
                return;
            }
            sendSimulated(val);
        }

        async function submitManualReading() {
            const valInput = document.getElementById("manual-value");
            const reasonInput = document.getElementById("manual-reason");
            const val = parseFloat(valInput.value);

            if (isNaN(val)) {
                alert("Please enter a valid numeric reading value.");
                return;
            }

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                IsManualEntry: true,
                ReasonCode: reasonInput.value,
                CapturedAt: new Date().toISOString()
            };

            const modalEl = document.getElementById('manualEntryModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit manual reading.');
                }
            } catch (ex) {
                console.error("Manual reading error:", ex);
            }
        }
    </script>
}
