                    <i class="bi bi-arrows-move me-1"></i>Click and drag to pan • Scroll wheel to zoom in/out
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/tohnichi-ble-driver.js"></script>
    <script>
        var sessionId = @Model.SessionId;
        var jobId = @Model.JobId;
        var currentJobId = @Model.JobId;
        var currentUnitNo = @Model.UnitNo;
        var minScale = @minScale;
        var maxScale = @maxScale;
        var targetVal = @(currentStep?.Target ?? 0);
        var lowerLimit = @(currentStep?.LowerLimit ?? 0);
        var upperLimit = @(currentStep?.UpperLimit ?? 0);
        var currentStepSeq = @(currentStep?.SequenceNo ?? 1);
        var instrumentType = @((int)(currentStep?.Instrument ?? InstrumentType.Torque));
        var unitSymbol = "@unitSymbol";

        // Active timer and hold state
        var isJobOnHold = @(Model.IsOnHold ? "true" : "false");
        var activeSeconds = @(Model.AccumulatedActiveSeconds);
        var holdReason = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoldReason ?? "Operator paused work"));
        var activeTimerInterval = null;

        var allSteps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Steps.Select(s => new {
            SequenceNo = s.SequenceNo,
            Label = s.Label,
            Target = s.Target,
            LowerLimit = s.LowerLimit,
            UpperLimit = s.UpperLimit,
            Instrument = (int)s.Instrument,
            InstrumentName = s.Instrument == InstrumentType.Torque ? "Torque Wrench" : "Vernier Caliper",
            UnitSymbol = s.Instrument == InstrumentType.Torque ? "N·m" : "mm",
            IsCompleted = s.IsCompleted
        })));

        // Polling fallback state
        var pollingInterval = null;
        var isSignalRConnected = false;

        // Clean up any previous SignalR connection or polling interval from prior cockpit session
        if (window.cockpitSignalR) {
            try { window.cockpitSignalR.stop(); } catch(e) {}
            window.cockpitSignalR = null;
        }
        if (window.cockpitPollingInterval) {
            clearInterval(window.cockpitPollingInterval);
            window.cockpitPollingInterval = null;
        }

        // Initialize lastProcessedResultId with the highest SessionResultId currently in this session
        let lastProcessedResultId = @(Model.Steps.SelectMany(s => s.Attempts).Any() ? Model.Steps.SelectMany(s => s.Attempts).Max(a => a.ResultId) : 0);

        // Setup SignalR connection
        var connection = null;
        if (typeof signalR !== 'undefined') {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();
            window.cockpitSignalR = connection;

            // Real-time live torque/vernier values streamed from ESP32 (!isStable)
            connection.on("liveValue", function (data) {
                if (data && data.sessionId && data.sessionId !== sessionId) return;
                console.log("Live stream reading:", data);
                if (data && typeof data.value !== 'undefined') {
                    updateGaugeNeedle(data.value);
                    const statusText = document.getElementById("live-status-text");
                    if (statusText) {
                        if (data.inTolerance) {
                            statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-arrow-repeat spin me-1"></i>Torque in Target Range (' + Number(data.value).toFixed(2) + ' ' + (data.unit || unitSymbol) + ')</span>';
                        } else {
                            statusText.innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-wrench me-1"></i>Applying Torque... ' + Number(data.value).toFixed(2) + ' ' + (data.unit || unitSymbol) + '</span>';
                        }
                    }
                }
            });

            // Confirmed reading evaluated by backend (isStable == true)
            connection.on("stepResult", function (data) {
                if (data && data.sessionId && data.sessionId !== sessionId) {
                    if (data.jobId && data.jobId !== jobId) return;
                }
                const rId = data.resultId || data.ResultId;
                if (rId && rId <= lastProcessedResultId) {
                    console.log("Ignoring already processed step result:", rId);
                    return;
                }

                console.log("Step result via SignalR:", data);
                handleReadingResult({
                    resultId: rId,
                    actualValue: data.actual !== undefined ? data.actual : data.actualValue,
                    isStepPassed: data.result === "Pass" || data.isStepPassed === true,
                    attemptNo: data.attemptNo,
                    sessionId: data.sessionId || sessionId,
                    isSessionCompleted: data.isSessionCompleted || false,
                    nextStepSequence: data.nextStepSequence,
                    nextProductComponentId: data.nextProductComponentId || data.NextProductComponentId
                });
            });

            connection.on("ReadingProcessed", function (data) {
                if (data && data.sessionId && data.sessionId !== sessionId) {
                    if (data.jobId && data.jobId !== jobId) return;
                }
                const rId = data.resultId || data.ResultId;
                if (rId && rId <= lastProcessedResultId) {
                    console.log("Ignoring already processed reading:", rId);
                    return;
                }

                console.log("Received reading processed via SignalR:", data);
                handleReadingResult(data);
            });

            connection.on("SessionCompleted", function (data) {
                if (data && data.sessionId && data.sessionId !== sessionId) return;
                console.log("Session completed via SignalR:", data);
                setTimeout(function () {
                    const sumUrl = '/Worker/JobBoard/Summary/' + (data.sessionId || sessionId);
                    if (window.assemblWorkerShell) window.assemblWorkerShell.loadUrl(sumUrl);
                    else window.location.href = sumUrl;
                }, 1000);
            });

            connection.on("SessionHoldChanged", function (data) {
                if (data && (data.sessionId === sessionId || !data.sessionId)) {
                    if (data.accumulatedSeconds !== undefined) {
                        activeSeconds = data.accumulatedSeconds;
                    }
                    updateHoldUi(data.isOnHold, data.reason);
                }
            });

            connection.onreconnected(function (connectionId) {
                console.log("SignalR reconnected:", connectionId);
                isSignalRConnected = true;
                stopPolling();
                document.getElementById("signalr-text").textContent = "Live Connected";
                document.getElementById("signalr-icon").className = "bi bi-broadcast text-success";
                connection.invoke("JoinSession", sessionId);
                if (jobId) connection.invoke("JoinJob", jobId);
            });

            connection.onclose(function () {
                console.warn("SignalR connection closed, starting polling fallback");
                isSignalRConnected = false;
                startPolling();
                document.getElementById("signalr-text").textContent = "Polling Mode";
                document.getElementById("signalr-icon").className = "bi bi-broadcast text-warning";
            });

            connection.start()
                .then(function () {
                    console.log("Connected to SignalR LiveReadingHub");
                    isSignalRConnected = true;
                    stopPolling();
                    document.getElementById("signalr-text").textContent = "Live Connected";
                    document.getElementById("signalr-icon").className = "bi bi-broadcast text-success";
                    connection.invoke("JoinSession", sessionId);
                    if (jobId) connection.invoke("JoinJob", jobId);
                })
                .catch(function (err) {
                    console.warn("SignalR connection error:", err.toString());
                    isSignalRConnected = false;
                    startPolling();
                    document.getElementById("signalr-text").textContent = "Polling Mode";
                    document.getElementById("signalr-icon").className = "bi bi-broadcast text-warning";
                });
        } else {
            // SignalR not available, start polling immediately
            startPolling();
            document.getElementById("signalr-text").textContent = "Polling Mode";
            document.getElementById("signalr-icon").className = "bi bi-broadcast text-warning";
        }

        // Polling fallback functions
        function startPolling() {
            if (window.cockpitPollingInterval) return; // Already polling

            console.log("Starting polling fallback (every 2 seconds)");
            window.cockpitPollingInterval = setInterval(async function () {
                try {
                    const response = await fetch('/Worker/JobBoard/GetSessionState?sessionId=' + sessionId + '&lastResultId=' + lastProcessedResultId, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.ok) {
                        const data = await response.json();

                        // Check for new step results
                        if (data.hasNewResult && data.latestResult) {
                            handleReadingResult(data.latestResult);
                        } else if (data.latestResultId && data.latestResultId > lastProcessedResultId) {
                            lastProcessedResultId = data.latestResultId;
                        }

                        // Check if session completed
                        if (data.isCompleted) {
                            stopPolling();
                            const sumUrl = '/Worker/JobBoard/Summary/' + sessionId;
                            if (window.assemblWorkerShell) window.assemblWorkerShell.loadUrl(sumUrl);
                            else window.location.href = sumUrl;
                        }
                    }
                } catch (ex) {
                    console.error("Polling error:", ex);
                }
            }, 2000);
        }

        function stopPolling() {
            if (window.cockpitPollingInterval) {
                console.log("Stopping polling fallback");
                clearInterval(window.cockpitPollingInterval);
                window.cockpitPollingInterval = null;
            }
        }

        let latestLiveReadingValue = null;

        function updateGaugeNeedle(val) {
            latestLiveReadingValue = Number(val);
            const clamped = Math.max(minScale, Math.min(maxScale, val));
            const range = maxScale - minScale;
            const pct = range > 0 ? ((clamped - minScale) / range) * 100 : 50;
            const needle = document.getElementById("gauge-needle");
            if (needle) {
                needle.style.left = pct + "%";
            }

            const readingNum = document.getElementById("reading-num");
            if (readingNum) {
                readingNum.textContent = Number(val).toFixed(2);
            }

            const liveVal = document.getElementById("live-value");
            if (liveVal) {
                if (val >= lowerLimit && val <= upperLimit) {
                    liveVal.className = "live-value-display in-range text-success";
                } else {
                    liveVal.className = "live-value-display out-range text-danger";
                }
            }
        }

        // --- Factory Floor Sensory Feedback (High-Noise Immunity) ---
        let audioCtxInstance = null;
        function getAudioContext() {
            if (!audioCtxInstance && (window.AudioContext || window.webkitAudioContext)) {
                audioCtxInstance = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtxInstance && audioCtxInstance.state === 'suspended') {
                audioCtxInstance.resume();
            }
            return audioCtxInstance;
        }

        function triggerIndustrialFeedback(isPass, isSessionDone) {
            // 1. Visual Strobe Flash (Screen Perimeter Pulse for High-Noise Shop Floors)
            let overlay = document.getElementById('factory-strobe-overlay');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.id = 'factory-strobe-overlay';
                overlay.style.position = 'fixed';
                overlay.style.inset = '0';
                overlay.style.pointerEvents = 'none';
                overlay.style.zIndex = '99999';
                overlay.style.transition = 'opacity 0.35s ease-out';
                document.body.appendChild(overlay);
            }
            overlay.style.backgroundColor = isPass ? 'rgba(34, 197, 94, 0.40)' : 'rgba(239, 68, 68, 0.50)';
            overlay.style.boxShadow = isPass ? 'inset 0 0 120px #22c55e' : 'inset 0 0 120px #ef4444';
            overlay.style.opacity = '1';
            setTimeout(function() { overlay.style.opacity = '0'; }, 400);

            // 2. Heavy Haptic Vibration Patterns (Ergonomic Heads-Up Fastening)
            if (navigator.vibrate) {
                try {
                    if (isSessionDone) {
                        navigator.vibrate([180, 80, 260]);
                    } else if (isPass) {
                        navigator.vibrate([100, 50, 100]);
                    } else {
                        navigator.vibrate([200, 80, 200, 80, 250]);
                    }
                } catch (e) { }
            }

            // 3. Audio Chime / Warning Buzzer (Synthetic Web Audio API)
            const ctx = getAudioContext();
            if (ctx) {
                try {
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    if (isSessionDone) {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(587.33, now);
                        osc.frequency.setValueAtTime(739.99, now + 0.12);
                        osc.frequency.setValueAtTime(880.00, now + 0.24);
                        gain.gain.setValueAtTime(0.35, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.55);
                        osc.start(now);
                        osc.stop(now + 0.55);
                    } else if (isPass) {
                        // Crisp High-Frequency Chime (880 Hz, 120 ms)
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(880, now);
                        osc.frequency.exponentialRampToValueAtTime(1175, now + 0.12);
                        gain.gain.setValueAtTime(0.35, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
                        osc.start(now);
                        osc.stop(now + 0.12);
                    } else {
                        // Low-Frequency Warning Double-Buzz (220 Hz, 250 ms)
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(220, now);
                        osc.frequency.linearRampToValueAtTime(160, now + 0.25);
                        gain.gain.setValueAtTime(0.40, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                        osc.start(now);
                        osc.stop(now + 0.25);
                    }
                } catch (e) { }
            }
        }

        let isAdvancingStep = false;

        function handleReadingResult(res) {
            if (!res) return;
            const rId = res.resultId || res.ResultId || res.sessionResultId || res.SessionResultId;
            if (rId && rId <= lastProcessedResultId) {
                console.log("Ignoring already applied reading result:", rId);
                return;
            }
            if (rId) lastProcessedResultId = Math.max(lastProcessedResultId, rId);

            const actualNum = Number(res.actualValue !== undefined ? res.actualValue : (res.actual !== undefined ? res.actual : res.value));
            if (!isNaN(actualNum)) {
                updateGaugeNeedle(actualNum);
                const readNum = document.getElementById("reading-num");
                if (readNum) readNum.textContent = actualNum.toFixed(1);
            }
            triggerIndustrialFeedback(res.isStepPassed, res.isSessionCompleted);

            const banner = document.getElementById("result-banner");
            const bannerText = document.getElementById("banner-text");
            const statusText = document.getElementById("live-status-text");
            const failAdvanceContainer = document.getElementById("fail-advance-btn-container");

            if (banner && bannerText) {
                banner.classList.remove("d-none", "alert-success", "alert-danger");
                if (res.isStepPassed) {
                    banner.classList.add("alert-success");
                    bannerText.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>PASS — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (failAdvanceContainer) failAdvanceContainer.classList.add("d-none");
                    if (statusText) statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Within acceptance limits</span>';
                } else {
                    banner.classList.add("alert-danger");
                    bannerText.innerHTML = '<i class="bi bi-x-circle-fill me-2"></i>FAIL (Attempt ' + res.attemptNo + ' — unlimited retries) — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (failAdvanceContainer) failAdvanceContainer.classList.remove("d-none");
                    if (statusText) statusText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Outside tolerance limits. Apply torque again to retry, or record defect to advance.</span>';
                }
            }

            // Auto-advance or redirect to summary if session completed
            const nextCompId = res.nextProductComponentId || res.NextProductComponentId;
            if (res.isSessionCompleted) {
                setTimeout(function () {
                    const sumUrl = '/Worker/JobBoard/Summary/' + res.sessionId;
                    if (window.assemblWorkerShell) window.assemblWorkerShell.loadUrl(sumUrl);
                    else window.location.href = sumUrl;
                }, 1000);
            } else if (res.isStepPassed && nextCompId && nextCompId !== currentComponentId) {
                // Smooth transition across components within the same PRD unit session!
                console.log("[AssemblIQ] Panel finished. Advancing dynamically to next component panel:", nextCompId);
                setTimeout(function () {
                    switchComponentDynamically(jobId, nextCompId, currentUnitNo);
                }, 800);
            } else if (res.isStepPassed && res.nextStepSequence && res.nextStepSequence !== currentStepSeq && !isAdvancingStep) {
                // Smooth dynamic transition to next bolt without page reload (keeps Bluetooth GATT connected!)
                isAdvancingStep = true;
                setTimeout(function () {
                    advanceToNextStepDynamically(res.nextStepSequence, currentStepSeq);
                    isAdvancingStep = false;
                }, 750);
            } else if (res.nextStepSequence && res.nextStepSequence !== currentStepSeq && !isAdvancingStep) {
                isAdvancingStep = true;
                setTimeout(function () {
                    advanceToNextStepDynamically(res.nextStepSequence, currentStepSeq);
                    isAdvancingStep = false;
                }, 750);
            } else if (res.isStepPassed && !res.nextStepSequence) {
                // Current panel finished! Look for next incomplete component panel
                const nextCompBtn = document.querySelector("#assembly-order-tabs button[id^='comp-btn-']");
                if (nextCompBtn) {
                    const match = nextCompBtn.id.match(/comp-btn-(\d+)/);
                    if (match) {
                        const nextId = parseInt(match[1], 10);
                        if (nextId !== currentComponentId) {
                            console.log("[AssemblIQ] Current panel finished. Auto-advancing dynamically to next panel:", nextId);
                            setTimeout(function () {
                                switchComponentDynamically(jobId, nextId, currentUnitNo);
                            }, 800);
                        }
                    }
                }
            }
        }

        function advanceToNextStepDynamically(nextSeq, prevSeq) {
            // 1. Mark previous step as completed in checklist
            const prevRow = document.getElementById("step-row-" + prevSeq);
            if (prevRow) {
                prevRow.className = "list-group-item d-flex justify-content-between align-items-center gap-2 py-1 px-2";
                const badgeContainer = prevRow.querySelector("div:last-child");
                if (badgeContainer) {
                    badgeContainer.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-lg me-1"></i>Pass</span>';
                }
            }

            // 2. Mark previous pin on blueprint
            const prevPin = document.getElementById("marker-pin-" + prevSeq);
            if (prevPin) {
                prevPin.classList.remove("marker-current", "bg-secondary");
                prevPin.classList.add("bg-success");
                const pinLbl = prevPin.querySelector(".bp-marker-label");
                if (pinLbl) pinLbl.textContent = "✓";
            }

            // 3. Find next step definition
            const nextStep = Array.isArray(allSteps) ? allSteps.find(s => (s.SequenceNo || s.sequenceNo) === nextSeq) : null;
            if (!nextStep) {
                // If not found in local list, fallback to soft reload
                window.location.reload();
                return;
            }

            // 4. Update state variables
            currentStepSeq = nextSeq;
            targetVal = nextStep.Target !== undefined ? nextStep.Target : nextStep.target;
            lowerLimit = nextStep.LowerLimit !== undefined ? nextStep.LowerLimit : nextStep.lowerLimit;
            upperLimit = nextStep.UpperLimit !== undefined ? nextStep.UpperLimit : nextStep.upperLimit;
            instrumentType = nextStep.Instrument !== undefined ? nextStep.Instrument : nextStep.instrument;
            unitSymbol = nextStep.UnitSymbol || nextStep.unitSymbol || (instrumentType === 1 ? "N·m" : "mm");

            // 5. Update header operation badge & label
            const nextIdx = allSteps.findIndex(s => (s.SequenceNo || s.sequenceNo) === nextSeq);
            const opNum = nextIdx >= 0 ? nextIdx + 1 : nextSeq;
            const opBadge = document.getElementById("operation-step-badge") || document.querySelector(".badge.bg-secondary.text-uppercase");
            if (opBadge) opBadge.textContent = "Operation " + opNum + " of " + allSteps.length;

            const stepLabelEl = document.getElementById("step-label");
            if (stepLabelEl) stepLabelEl.textContent = nextStep.Label || nextStep.label;

            const targetValEl = document.getElementById("target-value");
            if (targetValEl) targetValEl.innerHTML = targetVal.toFixed(1) + ' <span class="small text-muted">' + unitSymbol + '</span>';

            const lowerLimitEl = document.getElementById("lower-limit");
            if (lowerLimitEl) lowerLimitEl.innerHTML = lowerLimit.toFixed(1) + ' <span class="small text-muted">' + unitSymbol + '</span>';

            const upperLimitEl = document.getElementById("upper-limit");
            if (upperLimitEl) upperLimitEl.innerHTML = upperLimit.toFixed(1) + ' <span class="small text-muted">' + unitSymbol + '</span>';

            // 6. Update gauge band
            const gaugeRange = maxScale - minScale;
            if (gaugeRange > 0) {
                const zLeft = Math.max(0, Math.min(100, ((lowerLimit - minScale) / gaugeRange) * 100));
                const zRight = Math.max(0, Math.min(100, ((upperLimit - minScale) / gaugeRange) * 100));
                const zWidth = Math.max(2, zRight - zLeft);
                const gaugeZone = document.getElementById("gauge-zone");
                if (gaugeZone) {
                    gaugeZone.style.left = zLeft + "%";
                    gaugeZone.style.width = zWidth + "%";
                    gaugeZone.title = "Acceptance Band [" + lowerLimit + " - " + upperLimit + "]";
                }
            }

            // 7. Reset live display & needle
            updateGaugeNeedle(0);
            const readNum = document.getElementById("reading-num");
            if (readNum) readNum.textContent = "--.-";
            const liveStatus = document.getElementById("live-status-text");
            if (liveStatus) liveStatus.innerHTML = '<i class="bi bi-clock-history me-1"></i>Waiting for device transmission...';
            const banner = document.getElementById("result-banner");
            if (banner) banner.classList.add("d-none");
            const sendBtnText = document.getElementById("btn-send-reading-text");
            if (sendBtnText) sendBtnText.textContent = `Confirm Reading (${targetVal.toFixed(1)} ${unitSymbol})`;
            const manualValInput = document.getElementById("manual-value");
            if (manualValInput) {
                manualValInput.placeholder = targetVal.toFixed(1);
                manualValInput.value = targetVal.toFixed(1);
            }

            // 8. Highlight next row in checklist
            const nextRow = document.getElementById("step-row-" + nextSeq);
            if (nextRow) {
                nextRow.className = "list-group-item d-flex justify-content-between align-items-center gap-2 py-1 px-2 bg-light border-start border-primary border-4";
                const badgeContainer = nextRow.querySelector("div:last-child");
                if (badgeContainer) {
                    badgeContainer.innerHTML = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold"><i class="bi bi-arrow-right-circle me-1"></i>Active</span>';
                }
                nextRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            // 9. Highlight next pin on blueprint
            const nextPin = document.getElementById("marker-pin-" + nextSeq);
            if (nextPin) {
                nextPin.classList.remove("bg-secondary", "bg-success");
                nextPin.classList.add("marker-current");
            }

            // 10. Automatically sync new step limits to the wrench over Bluetooth!
            if (window.tohnichiBle && window.tohnichiBle.isConnected) {
                window.tohnichiBle.syncTorqueLimits(upperLimit, lowerLimit);
            }
        }

        async function submitFailedBolt() {
            if (!confirm("Are you sure you want to log this bolt as FAILED and proceed to the next step? This will be recorded as a defect in quality reports.")) {
                return;
            }

            const currentNum = parseFloat(document.getElementById("reading-num")?.textContent) || (targetVal || 0);

            const payload = {
                SessionId: sessionId,
                Value: isNaN(currentNum) ? 0 : currentNum,
                InstrumentType: instrumentType,
                ForceFail: true,
                ReasonCode: "OPERATOR_FORCE_FAIL",
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to record failed bolt.');
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        async function sendSimulated(val) {
            if (isJobOnHold) {
                alert("Job is currently ON HOLD. Please click 'Resume Job' before confirming reading.");
                return;
            }
            updateGaugeNeedle(val);

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit reading.');
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        function sendCurrentLiveReading() {
            // Determine live reading:
            // 1. From device stream / needle position (latestLiveReadingValue)
            // 2. Or from displayed reading digits
            // 3. Or fall back to target value if waiting for signal
            let val = latestLiveReadingValue;
            if (val === null || isNaN(val)) {
                const readingEl = document.getElementById("reading-num");
                const parsed = readingEl ? parseFloat(readingEl.textContent) : NaN;
                val = !isNaN(parsed) ? parsed : (targetVal || 0);
            }
            sendSimulated(val);
        }

        function sendCustomSimulated() {
            sendCurrentLiveReading();
        }

        // --- Tohnichi Web Bluetooth Driver Integration ---
        function updateBleButtonUI(msg, variant) {
            const btn = document.getElementById("btn-ble-connect");
            const btnText = document.getElementById("ble-btn-text");
            const btnIcon = document.getElementById("ble-btn-icon");
            if (!btn) return;

            const isPaired = localStorage.getItem('assembl_ble_paired') === 'true' || localStorage.getItem('assembl_ble_auto_connect') === 'true';
            const savedName = localStorage.getItem('assembl_active_ble_tool') || localStorage.getItem('assembl_active_ble_serial');

            if (window.tohnichiBle && window.tohnichiBle.isConnected) {
                const name = window.tohnichiBle.toolSerial || savedName || "704620P";
                if (btnText) btnText.textContent = `${name} (Connected)`;
                btn.className = "btn btn-sm btn-success text-white d-flex align-items-center gap-1 shadow-sm";
                if (btnIcon) {
                    btnIcon.className = "bi bi-bluetooth text-white";
                    btnIcon.style.display = "";
                }
                btn.title = "Wrench Connected. Click to Disconnect";

                const readingLabel = document.getElementById("live-reading-label");
                if (readingLabel) {
                    readingLabel.textContent = `Live Reading (${name} • Bluetooth Direct)`;
                }

                const toolBadge = document.querySelector('.badge.bg-dark.font-monospace');
                if (toolBadge) {
                    toolBadge.textContent = name;
                }
            } else if (msg === "Connecting..." || (window.tohnichiBle && window.tohnichiBle._isReconnecting)) {
                if (btnText) btnText.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>Connecting ${savedName ? savedName : 'Wrench'}...`;
                btn.className = "btn btn-sm btn-primary text-white d-flex align-items-center gap-1 shadow-sm";
                if (btnIcon) btnIcon.style.display = "none";
                btn.title = "Connecting Bluetooth GATT link...";
            } else if (variant === "warning" || msg === "Reconnection Needed") {
                if (btnText) btnText.innerHTML = `<i class="bi bi-bluetooth me-1"></i>Reconnect ${savedName ? savedName : 'Wrench'}`;
                btn.className = "btn btn-sm btn-warning text-dark fw-bold d-flex align-items-center gap-1 shadow-sm";
                if (btnIcon) btnIcon.style.display = "none";
                btn.title = "Bluetooth link idle or disconnected. Click to re-activate connection.";
            } else if (isPaired) {
                if (btnText) btnText.innerHTML = `<i class="bi bi-bluetooth me-1"></i>Connect ${savedName ? savedName : 'Wrench'}`;
                btn.className = "btn btn-sm btn-primary text-white fw-bold d-flex align-items-center gap-1 shadow-sm";
                if (btnIcon) btnIcon.style.display = "none";
                btn.title = "Click to activate Bluetooth connection to your wrench";
                const readingLabel = document.getElementById("live-reading-label");
                if (readingLabel && savedName) {
                    readingLabel.textContent = `Live Reading (${savedName} • Bluetooth Direct)`;
                }
            } else {
                if (btnText) btnText.textContent = "Connect BLE Wrench";
                btn.className = "btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm";
                if (btnIcon) {
                    btnIcon.className = "bi bi-bluetooth text-primary";
                    btnIcon.style.display = "";
                }
                btn.title = "Connect Tohnichi CEM3-G-BT over Bluetooth";
            }
        }

        async function toggleBleWrenchConnection() {
            if (!window.tohnichiBle) {
                alert("Bluetooth driver not loaded.");
                return;
            }

            // Check if Web Bluetooth is available in this browser context (restricted on LAN HTTP)
            if (!navigator.bluetooth || !window.isSecureContext) {
                const modalEl = document.getElementById('bleInsecureHelpModal');
                if (modalEl) {
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                } else {
                    alert("Web Bluetooth requires a Secure Origin (HTTPS or localhost). On an Android tablet over HTTP LAN, enable chrome://flags/#unsafely-treat-insecure-origin-as-secure or use the on-screen Manual Entry / Confirm Reading.");
                }
                return;
            }

            // Only manual disconnect when user explicitly clicks the button while connected
            if (window.tohnichiBle.isConnected) {
                if (confirm("Do you want to manually disconnect the Bluetooth wrench?")) {
                    window.tohnichiBle.disconnect(true);
                    updateBleButtonUI("Disconnected", "secondary");
                }
                return;
            }

            try {
                window.tohnichiBle.onStatusChange = updateBleButtonUI;
                window.tohnichiBle.onReadingReceived = async function (reading) {
                    console.log("[AssemblIQ Execution] BLE Reading Received:", reading);
                    await processIncomingWrenchReading(reading);
                };

                updateBleButtonUI("Connecting...", "primary");
                const conn = await window.tohnichiBle.connect();
                updateBleButtonUI("Connected", "success");

                // Auto-sync torque limits to physical tool or ESP32 simulator via AT037
                if (upperLimit > 0 && lowerLimit > 0) {
                    console.log(`[AssemblIQ Execution] Syncing step limits to wrench: Lo=${lowerLimit}, Hi=${upperLimit}`);
                    await window.tohnichiBle.syncTorqueLimits(upperLimit, lowerLimit);
                }
            } catch (err) {
                console.warn("[BLE Connect]:", err);
                updateBleButtonUI("Disconnected", "secondary");
                if (err && err.message && (err.message.includes("not available") || err.message.includes("insecure"))) {
                    const modalEl = document.getElementById('bleInsecureHelpModal');
                    if (modalEl) {
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                }
            }
        }

        function setManualPreset(val) {
            const input = document.getElementById('manual-value');
            if (input) {
                input.readOnly = false;
                input.value = val;
            }
        }

        // =========================================================================
        // DYNAMIC ZERO-RELOAD PANEL SWITCHING (KEEPS BLUETOOTH CONNECTED PERMANENTLY)
        // =========================================================================
        async function switchComponentDynamically(jobId, productComponentId, unitNo) {
            try {
                const clickedBtn = document.getElementById(`comp-btn-${productComponentId}`);
                let origHtml = '';
                if (clickedBtn) {
                    origHtml = clickedBtn.innerHTML;
                    clickedBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>Loading...`;
                }

                const res = await fetch('/Worker/JobBoard/SwitchComponentAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobId, productComponentId, unitNo })
                });

                const data = await res.json();
                if (!data.success) {
                    alert(data.message || 'Failed to switch component.');
                    if (clickedBtn) clickedBtn.innerHTML = origHtml;
                    return;
                }

                // 1. Update session state variables
                sessionId = data.sessionId;
                currentStepSeq = data.currentStepSequence;
                targetVal = data.target;
                lowerLimit = data.lowerLimit;
                upperLimit = data.upperLimit;
                instrumentType = data.instrumentType;
                stepCount = data.steps.length;
                allSteps = data.steps;

                // 2. Rejoin SignalR group for new session if connected
                if (connection && isSignalRConnected && data.sessionId) {
                    try { connection.invoke("JoinSession", data.sessionId); } catch(e) {}
                }

                // 3. Re-render Assembly Order tabs
                renderAssemblyOrderTabs(jobId, data.components, unitNo);

                // 4. Update Blueprint Card Header
                const bpTitle = document.getElementById("bp-card-title");
                if (bpTitle) bpTitle.innerHTML = `<i class="bi bi-diagram-3 me-1"></i>${data.componentName} Blueprint`;
                const bpCode = document.getElementById("bp-template-code");
                if (bpCode) bpCode.textContent = data.templateCode;

                // 5. Update Blueprint Image & Pins
                updateBlueprintView(data);

                // 6. Update Checklist
                renderStepsChecklist(data.steps, data.currentStepSequence, data.unitSymbol);

                // 7. Update Step Header, Limits, Needle
                updateActiveStepDisplay(data);

                // 8. Reset live reading & needle
                updateGaugeNeedle(0);
                const readNum = document.getElementById("reading-num");
                if (readNum) readNum.textContent = "--.-";
                const liveStatus = document.getElementById("live-status-text");
                if (liveStatus) liveStatus.innerHTML = '<i class="bi bi-clock-history me-1"></i>Waiting for device transmission...';
                const banner = document.getElementById("result-banner");
                if (banner) banner.classList.add("d-none");

                // 9. Auto-sync new panel limits to the Bluetooth wrench!
                if (window.tohnichiBle && window.tohnichiBle.isConnected && upperLimit > 0 && lowerLimit > 0) {
                    console.log(`[AssemblIQ Execution] Synced new panel limits to wrench: Lo=${lowerLimit}, Hi=${upperLimit}`);
                    await window.tohnichiBle.syncTorqueLimits(upperLimit, lowerLimit);
                }

            } catch (err) {
                console.error("Dynamic component switch error:", err);
                alert("Error switching panel.");
            }
        }
        window.switchComponentDynamically = switchComponentDynamically;

        function renderAssemblyOrderTabs(jobId, components, unitNo) {
            const container = document.getElementById("assembly-order-tabs");
            if (!container) return;

            const currentComp = components.find(c => c.isCurrent);
            const titleEl = document.getElementById("assembly-order-title");
            if (titleEl && currentComp) {
                titleEl.textContent = `${currentComp.componentName} (${currentComp.assemblyOrder}/${components.length})`;
            }

            let html = '';
            components.forEach(c => {
                const isCurrent = c.isCurrent;
                const isDone = c.isDone;

                html += `<div class="d-flex align-items-center">`;
                if (isCurrent) {
                    html += `
                        <span class="btn btn-sm btn-dark active py-0 px-2 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;">
                            <span class="badge ${isDone ? 'bg-success text-white' : 'bg-secondary text-white'} rounded-circle" style="font-size: 0.65rem; padding: 0.15em 0.35em;">
                                ${isDone ? '<i class="bi bi-check-lg"></i>' : c.assemblyOrder}
                            </span>
                            <strong class="text-truncate" style="max-width: 130px;">${c.componentName}</strong>
                            ${isDone ? '<span class="badge bg-success text-white ms-1 fw-bold" style="font-size: 0.65rem;">✓ PASS</span>' : `<span class="badge bg-light text-dark ms-1" style="font-size: 0.65rem;">${c.stepCount} steps</span>`}
                        </span>`;
                } else {
                    html += `
                        <button type="button" id="comp-btn-${c.productComponentId}" class="btn btn-sm ${isDone ? 'btn-outline-success' : 'btn-outline-secondary'} py-0 px-2 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;" onclick="switchComponentDynamically(${jobId}, ${c.productComponentId}, ${unitNo})">
                            <span class="badge ${isDone ? 'bg-success text-white' : 'bg-secondary text-white'} rounded-circle" style="font-size: 0.65rem; padding: 0.15em 0.35em;">
                                ${isDone ? '<i class="bi bi-check"></i>' : c.assemblyOrder}
                            </span>
                            <span class="text-truncate" style="max-width: 120px;">${c.componentName}</span>
                            ${isDone ? '<span class="badge bg-success text-white ms-1" style="font-size: 0.6rem;">PASS</span>' : ''}
                        </button>`;
                }
                html += `</div>`;
            });

            container.innerHTML = html;
        }

        function updateBlueprintView(data) {
            const wrapper = document.getElementById("bp-wrapper");
            const img = document.getElementById("bp-img");
            if (img && data.imagePath) {
                let imgUrl = data.imagePath.trim();
                if (imgUrl.startsWith("~")) imgUrl = imgUrl.substring(1);
                if (!imgUrl.startsWith("/")) imgUrl = "/" + imgUrl;
                img.src = imgUrl;
                img.alt = data.componentName;
            }

            // Remove existing markers
            document.querySelectorAll(".bp-marker").forEach(m => m.remove());

            // Add new markers
            if (wrapper && data.steps) {
                data.steps.forEach(s => {
                    if (s.markerX !== null && s.markerY !== null && s.markerX !== undefined && s.markerY !== undefined) {
                        const isCurr = s.sequenceNo === data.currentStepSequence;
                        const isPass = s.isCompleted;
                        const markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                        const pinSize = Math.max(14, s.markerSize || 28);
                        const pinFont = Math.max(9, Math.floor(pinSize * 0.48));

                        const pin = document.createElement("div");
                        pin.id = "marker-pin-" + s.sequenceNo;
                        pin.className = `position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm ${markerClass} bp-marker`;
                        pin.setAttribute("data-seq", s.sequenceNo);
                        pin.setAttribute("data-base-size", pinSize);
                        pin.setAttribute("data-x", s.markerX);
                        pin.setAttribute("data-y", s.markerY);
                        pin.setAttribute("data-current", isCurr ? "true" : "false");
                        pin.style.left = s.markerX + "%";
                        pin.style.top = s.markerY + "%";
                        pin.style.width = pinSize + "px";
                        pin.style.height = pinSize + "px";
                        pin.style.fontSize = pinFont + "px";
                        pin.style.transform = "translate(-50%, -50%)";
                        pin.style.cursor = "pointer";
                        pin.style.zIndex = "5";
                        pin.title = `${s.label}: ${s.target} ${data.unitSymbol}`;
                        pin.onclick = () => highlightStepRow(s.sequenceNo);
                        pin.innerHTML = `<span class="bp-marker-label d-inline-block">${isPass ? "✓" : s.sequenceNo}</span>`;

                        wrapper.appendChild(pin);
                    }
                });
            }
        }

        function renderStepsChecklist(stepList, currentSeq, unitSymbol) {
            const countBadge = document.getElementById("steps-count-badge");
            if (countBadge) countBadge.textContent = `${stepList.length} steps`;

            const container = document.getElementById("steps-checklist-container");
            if (!container) return;

            let html = '';
            stepList.forEach(s => {
                const isCurr = s.sequenceNo === currentSeq;
                const isPass = s.isCompleted;
                const isDefect = !isPass && s.attemptCount > 0 && !isCurr;
                const rowClass = isCurr ? "bg-light border-start border-primary border-4" : "";

                let statusBadge = '';
                if (isPass) {
                    statusBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-lg me-1"></i>Pass</span>';
                } else if (isDefect) {
                    statusBadge = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Defect (${s.attemptCount} tries)</span>`;
                } else if (isCurr) {
                    statusBadge = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold"><i class="bi bi-arrow-right-circle me-1"></i>Active</span>';
                } else {
                    statusBadge = '<span class="badge bg-light text-muted border">Pending</span>';
                }

                html += `
                    <div id="step-row-${s.sequenceNo}" class="list-group-item d-flex justify-content-between align-items-center gap-2 py-1 px-2 ${rowClass}">
                        <div class="text-truncate" style="line-height: 1.25;">
                            <span class="fw-semibold small">#${s.sequenceNo} ${s.label}</span>
                            <span class="text-muted" style="font-size: 10px;">
                                ${s.target.toFixed(1)} [${s.lowerLimit.toFixed(1)} - ${s.upperLimit.toFixed(1)}] ${unitSymbol}
                                ${s.attemptCount > 0 ? `<span class="ms-1">(${s.attemptCount} attempt(s))</span>` : ''}
                            </span>
                        </div>
                        <div>${statusBadge}</div>
                    </div>`;
            });

            container.innerHTML = html;
        }

        function updateActiveStepDisplay(data) {
            const stepIdx = data.steps.findIndex(s => s.sequenceNo === data.currentStepSequence);
            const opNum = stepIdx >= 0 ? stepIdx + 1 : data.currentStepSequence;

            const opBadge = document.getElementById("operation-step-badge");
            if (opBadge) opBadge.textContent = `Operation ${opNum} of ${data.steps.length}`;

            const stepLabel = document.getElementById("step-label");
            if (stepLabel) stepLabel.textContent = data.stepLabel;

            const targetValEl = document.getElementById("target-value");
            if (targetValEl) targetValEl.innerHTML = `${data.target.toFixed(1)} <span class="small text-muted">${data.unitSymbol}</span>`;

            const lowerLimitEl = document.getElementById("lower-limit");
            if (lowerLimitEl) lowerLimitEl.innerHTML = `${data.lowerLimit.toFixed(1)} <span class="small text-muted">${data.unitSymbol}</span>`;

            const upperLimitEl = document.getElementById("upper-limit");
            if (upperLimitEl) upperLimitEl.innerHTML = `${data.upperLimit.toFixed(1)} <span class="small text-muted">${data.unitSymbol}</span>`;

            // Update Acceptance Band on gauge
            const minScale = targetVal > 0 ? Math.max(0, targetVal * 0.5) : 0;
            const maxScale = targetVal > 0 ? targetVal * 1.5 : 50;
            const gaugeRange = maxScale - minScale;
            if (gaugeRange > 0) {
                const zLeft = Math.max(0, Math.min(100, ((lowerLimit - minScale) / gaugeRange) * 100));
                const zRight = Math.max(0, Math.min(100, ((upperLimit - minScale) / gaugeRange) * 100));
                const zWidth = Math.max(2, zRight - zLeft);
                const gaugeZone = document.getElementById("gauge-zone");
                if (gaugeZone) {
                    gaugeZone.style.left = zLeft + "%";
                    gaugeZone.style.width = zWidth + "%";
                    gaugeZone.title = `Acceptance Band [${lowerLimit} - ${upperLimit}]`;
                }
            }

            const sendBtnText = document.getElementById("btn-send-reading-text");
            if (sendBtnText) sendBtnText.textContent = `Confirm Reading (${data.target.toFixed(1)} ${data.unitSymbol})`;
            const manualValInput = document.getElementById("manual-value");
            if (manualValInput) {
                manualValInput.placeholder = data.target.toFixed(1);
                manualValInput.value = data.target.toFixed(1);
            }
        }

        async function processIncomingWrenchReading(reading) {
            if (isJobOnHold) {
                console.warn("Wrench reading ignored because job is ON HOLD.");
                const statusText = document.getElementById("live-status-text");
                if (statusText) {
                    statusText.innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-pause-circle me-1"></i>Job is ON HOLD. Reading ignored. Click Resume to continue.</span>';
                }
                return;
            }
            updateGaugeNeedle(reading.torque);

            // Double-tightening poka-yoke detection (OD / LD)
            if (reading.isDoubleTightening) {
                triggerIndustrialFeedback(false, false);
                const banner = document.getElementById("result-banner");
                const bannerText = document.getElementById("banner-text");
                const statusText = document.getElementById("live-status-text");
                if (banner && bannerText) {
                    banner.classList.remove("d-none", "alert-success", "alert-danger");
                    banner.classList.add("alert-warning");
                    bannerText.innerHTML = '<i class="bi bi-shield-exclamation me-2"></i><strong>POKA-YOKE WARNING (OD): Double Tightening Detected!</strong> (Angle: ' + reading.angle + '° &lt; 5°). Fastener is already torqued.';
                }
                if (statusText) {
                    statusText.innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-shield-exclamation me-1"></i>Re-hit attempt blocked by Poka-Yoke.</span>';
                }
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const activeSerial = reading.toolSerial || (window.tohnichiBle ? window.tohnichiBle.toolSerial : null) || localStorage.getItem('assembl_active_ble_serial') || "704620P";
            const activeToolName = (window.tohnichiBle && window.tohnichiBle.device ? window.tohnichiBle.device.name : null) || localStorage.getItem('assembl_active_ble_tool') || "CEM3-G-BT_704620P_BLE";
            const equippedId = localStorage.getItem('assembl_active_ble_id') || localStorage.getItem('assembl_station_torque_id') || null;

            const payload = {
                SessionId: sessionId,
                DeviceId: equippedId && !isNaN(parseInt(equippedId)) ? parseInt(equippedId) : null,
                TransmitterId: activeSerial || activeToolName,
                DeviceSeq: reading.counter || 1,
                Value: reading.torque,
                InstrumentType: instrumentType,
                IsManualEntry: false,
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const result = await response.json();
                    handleReadingResult(result);
                    flushOfflineQueue(); // opportunistically flush any queued readings
                } else {
                    console.warn("Server unavailable, saving to local offline queue:", await response.text());
                    queueOfflineReading(payload, reading);
                }
            } catch (ex) {
                console.warn("[AssemblIQ Offline] Network down. Storing locally on tablet; guidance continues uninterrupted:", ex);
                queueOfflineReading(payload, reading);
            }
        }

        // --- Offline-First Local Storage Queue & Sync Engine ---
        function queueOfflineReading(payload, reading) {
            const queueKey = 'assembl_offline_queue_' + sessionId;
            let queue = [];
            try {
                queue = JSON.parse(localStorage.getItem(queueKey) || "[]");
            } catch (e) { queue = []; }

            queue.push(payload);
            localStorage.setItem(queueKey, JSON.stringify(queue));

            // Instant local evaluation: operator guidance, sounds and needles work smoothly!
            const isPass = reading.torque >= lowerLimit && reading.torque <= upperLimit;
            updateOfflineSyncBadge();

            handleReadingResult({
                actualValue: reading.torque,
                isStepPassed: isPass,
                attemptNo: 1,
                sessionId: sessionId,
                isSessionCompleted: false,
                isOfflineQueued: true
            });

            startOfflineQueueSync();
        }

        async function flushOfflineQueue() {
            const queueKey = 'assembl_offline_queue_' + sessionId;
            let queue = [];
            try {
                queue = JSON.parse(localStorage.getItem(queueKey) || "[]");
            } catch (e) { return; }

            if (!queue || !queue.length) return;

            console.log(`[AssemblIQ Sync] Flushing ${queue.length} offline readings to server...`);
            const remaining = [];

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            for (const item of queue) {
                try {
                    const res = await fetch('/Worker/JobBoard/SubmitReading', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(item)
                    });
                    if (!res.ok) {
                        remaining.push(item);
                    }
                } catch (netErr) {
                    remaining.push(item);
                }
            }

            localStorage.setItem(queueKey, JSON.stringify(remaining));
            updateOfflineSyncBadge();
        }

        let offlineSyncInterval = null;
        function startOfflineQueueSync() {
            if (offlineSyncInterval) return;
            offlineSyncInterval = setInterval(flushOfflineQueue, 5000);
            window.addEventListener('online', flushOfflineQueue);
        }

        function updateOfflineSyncBadge() {
            const queueKey = 'assembl_offline_queue_' + sessionId;
            let queue = [];
            try { queue = JSON.parse(localStorage.getItem(queueKey) || "[]"); } catch (e) { }
            const statusEl = document.getElementById("signalr-status");
            const textEl = document.getElementById("signalr-text");
            const iconEl = document.getElementById("signalr-icon");
            if (queue && queue.length > 0) {
                if (statusEl) statusEl.className = "badge bg-warning-subtle text-warning-emphasis border border-warning d-flex align-items-center gap-1 py-1";
                if (iconEl) iconEl.className = "bi bi-cloud-slash-fill text-warning";
                if (textEl) textEl.textContent = `Offline (${queue.length} queued)`;
            } else if (isSignalRConnected) {
                if (statusEl) statusEl.className = "badge bg-light text-secondary border d-flex align-items-center gap-1 py-1";
                if (iconEl) iconEl.className = "bi bi-broadcast text-success";
                if (textEl) textEl.textContent = "Live Connected";
            }
        }

        // Auto-reconnect if tool was paired
        async function initCockpitBle() {
            if (!window.tohnichiBle) return;

            window.tohnichiBle.onStatusChange = updateBleButtonUI;
            window.tohnichiBle.onReadingReceived = async function (reading) {
                console.log("[AssemblIQ Execution] BLE Reading Received:", reading);
                await processIncomingWrenchReading(reading);
            };
            window.tohnichiBle.onConnected = async function () {
                console.log("[AssemblIQ Execution] BLE Connected callback fired.");
                updateBleButtonUI("Connected", "success");
                if (upperLimit > 0 && lowerLimit > 0) {
                    console.log(`[AssemblIQ Execution] Auto-syncing step limits to wrench: Lo=${lowerLimit}, Hi=${upperLimit}`);
                    await window.tohnichiBle.syncTorqueLimits(upperLimit, lowerLimit);
                }
            };

            // Check if wrench is already connected from Job Board (Seamless Shell)
            if (window.tohnichiBle.isConnected) {
                console.log("[AssemblIQ Execution] BLE wrench already connected from shift shell!");
                updateBleButtonUI("Connected", "success");
                if (upperLimit > 0 && lowerLimit > 0) {
                    window.tohnichiBle.syncTorqueLimits(upperLimit, lowerLimit);
                }
                return;
            }

            const isPaired = localStorage.getItem('assembl_ble_paired') === 'true' || localStorage.getItem('assembl_ble_auto_connect') === 'true';
            if (isPaired) {
                updateBleButtonUI("Connecting...", "primary");
                try {
                    const reconnected = await window.tohnichiBle.autoReconnect();
                    if (reconnected) {
                        updateBleButtonUI("Connected", "success");
                    } else {
                        updateBleButtonUI("Reconnection Needed", "warning");
                    }
                } catch(e) {
                    updateBleButtonUI("Reconnection Needed", "warning");
                }
            } else {
                updateBleButtonUI("Disconnected", "secondary");
            }
        }

        async function syncStationToolWithCockpit() {
            try {
                const torqueId = localStorage.getItem('assembl_station_torque_id') || localStorage.getItem('assembl_sticky_torque_id') || localStorage.getItem('assembl_active_ble_id');
                const torqueName = localStorage.getItem('assembl_station_torque_name') || localStorage.getItem('assembl_active_ble_tool') || localStorage.getItem('assembl_active_ble_serial');
                const vernierId = localStorage.getItem('assembl_station_vernier_id') || localStorage.getItem('assembl_sticky_vernier_id');
                const vernierName = localStorage.getItem('assembl_station_vernier_name');

                if (torqueId || vernierId) {
                    const parsedTorque = torqueId && !isNaN(parseInt(torqueId)) ? parseInt(torqueId) : null;
                    const parsedVernier = vernierId && !isNaN(parseInt(vernierId)) ? parseInt(vernierId) : null;

                    const res = await fetch('/Worker/JobBoard/SyncSessionTool', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            sessionId: sessionId,
                            jobId: jobId,
                            torqueDeviceId: parsedTorque,
                            vernierDeviceId: parsedVernier
                        })
                    }).then(r => r.json()).catch(() => null);

                    const displayName = (res && res.success && res.transmitterId) ? res.transmitterId : (res && res.deviceName ? res.deviceName : (torqueName || vernierName));
                    if (displayName) {
                        const toolBadge = document.querySelector('#btn-cockpit-tool-pair .badge');
                        if (toolBadge) toolBadge.textContent = displayName;

                        const readingLabel = document.getElementById("live-reading-label");
                        if (readingLabel) {
                            const fullDevName = (res && res.deviceName) ? res.deviceName : displayName;
                            readingLabel.textContent = `Live Reading (${fullDevName})`;
                        }
                    }
                }
            } catch (err) {
                console.warn("[AssemblIQ Execution] Tool auto-sync notice:", err);
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            initCockpitBle();
            syncStationToolWithCockpit();
        });
        // Also run immediately if script loaded via seamless SPA swap
        initCockpitBle();
        syncStationToolWithCockpit();

        async function submitManualReading() {
            if (isJobOnHold) {
                alert("Job is currently ON HOLD. Please click 'Resume Job' before submitting manual reading.");
                return;
            }
            const valInput = document.getElementById("manual-value");
            const reasonInput = document.getElementById("manual-reason");
            const val = parseFloat(valInput.value);

            if (isNaN(val)) {
                alert("Please enter a valid numeric reading value.");
                return;
            }

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                IsManualEntry: true,
                ReasonCode: reasonInput.value,
                CapturedAt: new Date().toISOString()
            };

            const modalEl = document.getElementById('manualEntryModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit manual reading.');
                }
            } catch (ex) {
                console.error("Manual reading error:", ex);
            }
        }
    
        function highlightStepRow(seq) {
            const el = document.getElementById("step-row-" + seq);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                el.classList.add("bg-warning-subtle");
                setTimeout(() => el.classList.remove("bg-warning-subtle"), 1500);
            }
        }

        // Blueprint Pan, Zoom & Perspective Controller (In-Card)
        const bpState = {
            scale: 1,
            translateX: 0,
            translateY: 0,
            rotation: 0,
            flipH: 1,
            isDragging: false,
            startX: 0,
            startY: 0
        };

        function bpApplyTransform() {
            const canvas = document.getElementById("bp-canvas");
            const zoomLabel = document.getElementById("bp-zoom-label");
            if (!canvas) return;

            canvas.style.transform = `translate(calc(-50% + ${bpState.translateX}px), calc(-50% + ${bpState.translateY}px)) scale(${bpState.scale * bpState.flipH}, ${bpState.scale}) rotate(${bpState.rotation}deg)`;

            const labels = canvas.querySelectorAll(".bp-marker-label");
            labels.forEach(lbl => {
                lbl.style.transform = `rotate(${-bpState.rotation}deg) scale(${bpState.flipH}, 1)`;
            });

            if (zoomLabel) {
                zoomLabel.textContent = Math.round(bpState.scale * 100) + "%";
            }
        }

        function bpZoom(delta) {
            bpState.scale = Math.max(0.5, Math.min(5, bpState.scale + delta));
            bpApplyTransform();
        }

        function bpRotate(deg) {
            bpState.rotation = (bpState.rotation + deg + 360) % 360;
            bpApplyTransform();
        }

        function bpFlip() {
            bpState.flipH *= -1;
            bpApplyTransform();
        }

        function bpReset() {
            bpState.scale = 1;
            bpState.translateX = 0;
            bpState.translateY = 0;
            bpState.rotation = 0;
            bpState.flipH = 1;
            bpApplyTransform();
            bpFitImage();
        }

        function bpFocusCurrent() {
            const activePin = document.querySelector(".bp-marker[data-current='true']");
            if (activePin) {
                const xPct = parseFloat(activePin.getAttribute("data-x"));
                const yPct = parseFloat(activePin.getAttribute("data-y"));
                const img = document.getElementById("bp-img");
                if (img) {
                    const w = img.clientWidth || 250;
                    const h = img.clientHeight || 250;
                    const offsetX = (50 - xPct) / 100 * w;
                    const offsetY = (50 - yPct) / 100 * h;

                    bpState.scale = 2.2;
                    bpState.translateX = offsetX * bpState.scale;
                    bpState.translateY = offsetY * bpState.scale;
                    bpApplyTransform();
                    return;
                }
            }
            bpReset();
        }

        // Fit the whole cockpit into one screen; the blueprint box matches the left card and the image fills it
        function bpFitImage() {
            const row = document.getElementById("cockpit-row");
            const vp = document.getElementById("bp-viewport");
            const img = document.getElementById("bp-img");
            if (!row || !vp || !img || !img.naturalWidth || !img.naturalHeight) return;

            if (window.innerWidth >= 1200) {
                // document-anchored fit: the row bottom lands at (innerHeight - 10) in DOCUMENT space,
                // so the math is stable while the page is scrolled and self-corrects when content
                // above the cockpit settles late (fonts, banners, images)
                const rowTopDoc = Math.round(row.getBoundingClientRect().top + window.scrollY);
                row.style.height = Math.max(560, (window.innerHeight - 10) - rowTopDoc) + "px";
                vp.style.height = "";
            } else {
                row.style.height = "";
                vp.style.height = Math.min(Math.round(window.innerHeight * 0.75), 750) + "px";
            }

            // the right card stretches to the same height as the left card; contain-fit the image into its viewport
            const boxW = Math.max(240, vp.clientWidth);
            const boxH = Math.max(240, vp.clientHeight);
            const fit = Math.min(boxW / img.naturalWidth, boxH / img.naturalHeight, 2.5);
            img.style.width = Math.round(img.naturalWidth * fit) + "px";
            img.style.height = Math.round(img.naturalHeight * fit) + "px";
        }
        let bpFitRaf = 0;
        function bpFitSoon() {
            cancelAnimationFrame(bpFitRaf);
            bpFitRaf = requestAnimationFrame(() => requestAnimationFrame(bpFitImage));
        }
        const bpFitImgEl = document.getElementById("bp-img");
        if (bpFitImgEl) {
            bpFitImgEl.addEventListener("load", bpFitSoon);
            window.addEventListener("resize", bpFitSoon);
            if (bpFitImgEl.complete) bpFitSoon();
            setTimeout(bpFitSoon, 350);
            setTimeout(bpFitSoon, 1000);
        }

        // Initialize In-Card Viewport Event Listeners
        const bpViewport = document.getElementById("bp-viewport");
        if (bpViewport) {
            bpViewport.addEventListener("mousedown", (e) => {
                if (e.target.closest(".bp-marker") || e.button !== 0) return;
                bpState.isDragging = true;
                bpState.startX = e.clientX - bpState.translateX;
                bpState.startY = e.clientY - bpState.translateY;
                bpViewport.style.cursor = "grabbing";
            });

            window.addEventListener("mousemove", (e) => {
                if (!bpState.isDragging) return;
                bpState.translateX = e.clientX - bpState.startX;
                bpState.translateY = e.clientY - bpState.startY;
                bpApplyTransform();
            });

            window.addEventListener("mouseup", () => {
                if (bpState.isDragging) {
                    bpState.isDragging = false;
                    if (bpViewport) bpViewport.style.cursor = "grab";
                }
            });

            bpViewport.addEventListener("wheel", (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.2 : -0.2;
                bpZoom(delta);
            }, { passive: false });

            // Touch events for tablet/mobile operators
            let touchDist = 0;
            bpViewport.addEventListener("touchstart", (e) => {
                if (e.touches.length === 1) {
                    bpState.isDragging = true;
                    bpState.startX = e.touches[0].clientX - bpState.translateX;
                    bpState.startY = e.touches[0].clientY - bpState.translateY;
                } else if (e.touches.length === 2) {
                    touchDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            }, { passive: true });

            bpViewport.addEventListener("touchmove", (e) => {
                if (e.touches.length === 1 && bpState.isDragging) {
                    bpState.translateX = e.touches[0].clientX - bpState.startX;
                    bpState.translateY = e.touches[0].clientY - bpState.startY;
                    bpApplyTransform();
                } else if (e.touches.length === 2) {
                    const newDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    const factor = (newDist - touchDist) * 0.005;
                    bpZoom(factor);
                    touchDist = newDist;
                }
            }, { passive: true });

            bpViewport.addEventListener("touchend", () => {
                bpState.isDragging = false;
            });
        }

        // Modal Blueprint Pan & Zoom Controller
        const modalBpState = {
            scale: 1,
            translateX: 0,
            translateY: 0,
            rotation: 0,
            flipH: 1,
            isDragging: false,
            startX: 0,
            startY: 0
        };

        function modalBpApplyTransform() {
            const canvas = document.getElementById("modal-bp-canvas");
            const zoomLabel = document.getElementById("modal-bp-zoom-label");
            if (!canvas) return;

            canvas.style.transform = `translate(calc(-50% + ${modalBpState.translateX}px), calc(-50% + ${modalBpState.translateY}px)) scale(${modalBpState.scale * modalBpState.flipH}, ${modalBpState.scale}) rotate(${modalBpState.rotation}deg)`;

            const labels = canvas.querySelectorAll(".modal-bp-marker-label");
            labels.forEach(lbl => {
                lbl.style.transform = `rotate(${-modalBpState.rotation}deg) scale(${modalBpState.flipH}, 1)`;
            });

            if (zoomLabel) {
                zoomLabel.textContent = Math.round(modalBpState.scale * 100) + "%";
            }
        }

        function modalBpZoom(delta) {
            modalBpState.scale = Math.max(0.5, Math.min(5, modalBpState.scale + delta));
            modalBpApplyTransform();
        }

        function modalBpRotate(deg) {
            modalBpState.rotation = (modalBpState.rotation + deg + 360) % 360;
            modalBpApplyTransform();
        }

        function modalBpFlip() {
            modalBpState.flipH *= -1;
            modalBpApplyTransform();
        }

        function modalBpReset() {
            modalBpState.scale = 1;
            modalBpState.translateX = 0;
            modalBpState.translateY = 0;
            modalBpState.rotation = 0;
            modalBpState.flipH = 1;
            modalBpApplyTransform();
        }

        const modalViewport = document.getElementById("modal-bp-viewport");
        if (modalViewport) {
            modalViewport.addEventListener("mousedown", (e) => {
                if (e.target.closest(".modal-bp-marker") || e.button !== 0) return;
                modalBpState.isDragging = true;
                modalBpState.startX = e.clientX - modalBpState.translateX;
                modalBpState.startY = e.clientY - modalBpState.translateY;
                modalViewport.style.cursor = "grabbing";
            });

            window.addEventListener("mousemove", (e) => {
                if (!modalBpState.isDragging) return;
                modalBpState.translateX = e.clientX - modalBpState.startX;
                modalBpState.translateY = e.clientY - modalBpState.startY;
                modalBpApplyTransform();
            });

            window.addEventListener("mouseup", () => {
                if (modalBpState.isDragging) {
                    modalBpState.isDragging = false;
                    if (modalViewport) modalViewport.style.cursor = "grab";
                }
            });

            modalViewport.addEventListener("wheel", (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.2 : -0.2;
                modalBpZoom(delta);
            }, { passive: false });
        }

        // Sync modal when opened
        const bpModalEl = document.getElementById('blueprintModal');
        if (bpModalEl) {
            bpModalEl.addEventListener('shown.bs.modal', function () {
                modalBpState.rotation = bpState.rotation;
                modalBpState.flipH = bpState.flipH;
                modalBpState.scale = 1;
                modalBpState.translateX = 0;
                modalBpState.translateY = 0;
                modalBpApplyTransform();
            });
        }

            var bpMarkerSize = parseInt(localStorage.getItem('smarttorque_marker_size') || '28');
        function bpSetMarkerSize(size) {
            size = Math.max(16, Math.min(56, parseInt(size) || 28));
            bpMarkerSize = size;
            localStorage.setItem('smarttorque_marker_size', size);
            bpApplyMarkerScale();
        }
        // Blueprints carry their own per-step pin size; the +/- tools scale
        // every pin from its data-base-size (28px = 100%).
        function bpApplyMarkerScale() {
            var scale = bpMarkerSize / 28;
            var pct = Math.round(scale * 100) + '%';
            var lbl = document.getElementById('bp-marker-size-label');
            if (lbl) lbl.textContent = pct;
            var mlbl = document.getElementById('modal-bp-marker-size-label');
            if (mlbl) mlbl.textContent = pct;
            document.querySelectorAll('.bp-marker, .modal-bp-marker').forEach(function(m) {
                var base = parseInt(m.getAttribute('data-base-size') || '28');
                var sz = Math.max(12, Math.round(base * scale));
                m.style.width = sz + 'px';
                m.style.height = sz + 'px';
                m.style.fontSize = Math.max(10, Math.round(sz * 0.48)) + 'px';
            });
        }
        function bpStepMarkerSize(delta) {
            bpSetMarkerSize(bpMarkerSize + delta);
        }
        function bpCycleMarkerSize() {
            var presets = [18, 28, 36, 48];
            var idx = presets.indexOf(bpMarkerSize);
            var next = (idx === -1) ? 28 : presets[(idx + 1) % presets.length];
            bpSetMarkerSize(next);
        }
        document.addEventListener('DOMContentLoaded', function() {
            bpSetMarkerSize(bpMarkerSize);
        });

        /* ---- Calibration: change-tool modal alerts + daily paired-device banner ---- */
        function setExecPairCalAlert(selectEl, alertElId) {
            var alertEl = document.getElementById(alertElId);
            if (!selectEl || !alertEl) return;
            var opt = selectEl.options[selectEl.selectedIndex];
            var status = opt ? (opt.getAttribute("data-cal-status") || "") : "";
            var due = opt ? (opt.getAttribute("data-cal-due") || "") : "";
            if (!status) { alertEl.classList.add("d-none"); alertEl.innerHTML = ""; return; }
            if (status === "overdue") {
                alertEl.className = "alert alert-danger py-2 px-3 small mt-2 mb-3 border-danger d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong class="text-danger">Calibration overdue since <span class="badge bg-danger text-white ms-1">' + due + '</span></strong></span>';
            } else {
                alertEl.className = "alert alert-warning py-2 px-3 small mt-2 mb-3 border-warning d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-6"></i><span><strong class="text-dark">Calibration due on <span class="badge bg-warning text-dark ms-1">' + due + '</span></strong></span>';
            }
            alertEl.classList.remove("d-none");
        }
        var cockpitToolModal = document.getElementById("pairCockpitToolModal");
        if (cockpitToolModal) {
            var execTorqueSelect = cockpitToolModal.querySelector('select[name="torqueDeviceId"]');
            var execVernierSelect = cockpitToolModal.querySelector('select[name="vernierDeviceId"]');

            if (execTorqueSelect) {
                execTorqueSelect.addEventListener('change', function () {
                    if (this.value && execVernierSelect) {
                        execVernierSelect.value = '';
                        setExecPairCalAlert(execVernierSelect, "pairExecVernierCalAlert");
                    }
                    setExecPairCalAlert(this, "pairExecTorqueCalAlert");
                });
            }

            if (execVernierSelect) {
                execVernierSelect.addEventListener('change', function () {
                    if (this.value && execTorqueSelect) {
                        execTorqueSelect.value = '';
                        setExecPairCalAlert(execTorqueSelect, "pairExecTorqueCalAlert");
                    }
                    setExecPairCalAlert(this, "pairExecVernierCalAlert");
                });
            }

            cockpitToolModal.addEventListener("shown.bs.modal", function () {
                setExecPairCalAlert(execTorqueSelect, "pairExecTorqueCalAlert");
                setExecPairCalAlert(execVernierSelect, "pairExecVernierCalAlert");
            });

            var cockpitToolForm = cockpitToolModal.querySelector("form");
            if (cockpitToolForm) {
                cockpitToolForm.addEventListener("submit", function (e) {
                    if (execTorqueSelect && execVernierSelect && execTorqueSelect.value && execVernierSelect.value) {
                        e.preventDefault();
                        alert("You can only work with one instrument at a time (either Torque Wrench or Vernier Caliper).");
                        return false;
                    }
                    if (execTorqueSelect && execTorqueSelect.value) {
                        const optText = execTorqueSelect.options[execTorqueSelect.selectedIndex]?.text || '';
                        const cleanName = optText.split('•')[0].trim();
                        localStorage.setItem('assembl_station_torque_id', execTorqueSelect.value);
                        localStorage.setItem('assembl_station_torque_name', cleanName);
                        localStorage.setItem('assembl_station_tool_type', 'torque');
                        localStorage.setItem('assembl_sticky_torque_id', execTorqueSelect.value);
                        localStorage.removeItem('assembl_station_vernier_id');
                        localStorage.removeItem('assembl_station_vernier_name');
                    } else if (execVernierSelect && execVernierSelect.value) {
                        const optText = execVernierSelect.options[execVernierSelect.selectedIndex]?.text || '';
                        const cleanName = optText.split('•')[0].trim();
                        localStorage.setItem('assembl_station_vernier_id', execVernierSelect.value);
                        localStorage.setItem('assembl_station_vernier_name', cleanName);
                        localStorage.setItem('assembl_station_tool_type', 'vernier');
                        localStorage.setItem('assembl_sticky_vernier_id', execVernierSelect.value);
                        localStorage.removeItem('assembl_station_torque_id');
                        localStorage.removeItem('assembl_station_torque_name');
                    }
                });
            }
        }
        (function () {
            var banner = document.getElementById("calNoticeBanner");
            if (!banner) return;
            var notices;
            try { notices = (JSON.parse(banner.getAttribute("data-notices") || "[]") || []).filter(function (n) { return n && n.id; }); }
            catch (e) { notices = []; }
            var now = new Date();
            var todayKey = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
            var pending = notices.filter(function (n) {
                try { return !window.localStorage.getItem("calNotice_" + n.id + "_" + todayKey); } catch (e) { return true; }
            });
            if (!pending.length) return;
            var lines = pending.map(function (n) {
                var extra = "";
                var d = new Date(n.due + "T00:00:00");
                if (!isNaN(d.getTime())) {
                    var diff = Math.ceil((d.getTime() - new Date(todayKey + "T00:00:00").getTime()) / 86400000);
                    if (diff >= 0) extra = " (in " + diff + " day(s))";
                }
                return n.overdue
                    ? "<strong>" + n.name + "</strong> — calibration overdue since " + n.due + " (recalibration recommended; you may keep using it)"
                    : "<strong>" + n.name + "</strong> — calibration due on " + n.due + extra;
            });
            document.getElementById("calNoticeLines").innerHTML = lines.join("<br/>");
            banner.classList.remove("d-none");
            var dismiss = document.getElementById("calNoticeDismiss");
            if (dismiss) dismiss.addEventListener("click", function () {
                pending.forEach(function (n) {
                    try { window.localStorage.setItem("calNotice_" + n.id + "_" + todayKey, "1"); } catch (e) { }
                });
                banner.classList.add("d-none");
                window.dispatchEvent(new Event("resize"));
            });
        })();

        // =========================================================================
        // COCKPIT ACTIVE TIMER & PERSISTENT HOLD STATE MANAGEMENT
        // =========================================================================
        function formatTimer(sec) {
            const total = Math.max(0, Math.floor(sec));
            const h = Math.floor(total / 3600);
            const m = Math.floor((total % 3600) / 60);
            const s = total % 60;
            const pad = n => String(n).padStart(2, '0');
            return `${pad(h)}:${pad(m)}:${pad(s)}`;
        }

        function updateTimerDisplays(sec) {
            const text = formatTimer(sec);
            const timerEl = document.getElementById('job-active-timer');
            if (timerEl) timerEl.textContent = text;
            const bannerTimerEl = document.getElementById('hold-banner-time');
            if (bannerTimerEl) bannerTimerEl.textContent = text;
        }

        function startCockpitTimer() {
            if (activeTimerInterval) clearInterval(activeTimerInterval);
            updateTimerDisplays(activeSeconds);
            activeTimerInterval = setInterval(() => {
                if (!isJobOnHold) {
                    activeSeconds += 1;
                    updateTimerDisplays(activeSeconds);
                }
            }, 1000);
        }

        function pauseCockpitTimer() {
            if (activeTimerInterval) {
                clearInterval(activeTimerInterval);
                activeTimerInterval = null;
            }
            updateTimerDisplays(activeSeconds);
        }

        function updateHoldUi(onHold) {
            isJobOnHold = !!onHold;

            const banner = document.getElementById('hold-status-banner');
            const holdBtn = document.getElementById('btn-hold-toggle');
            const holdBtnText = document.getElementById('hold-btn-text');
            const holdBtnIcon = document.getElementById('hold-btn-icon');
            const timerIcon = document.getElementById('timer-icon');
            const manualBtn = document.getElementById('btn-cockpit-manual-entry');
            const sendBtn = document.getElementById('btn-send-reading');
            const bleBtn = document.getElementById('btn-ble-connect');

            if (isJobOnHold) {
                pauseCockpitTimer();
                if (banner) banner.classList.remove('d-none');
                if (holdBtn) {
                    holdBtn.className = 'btn btn-sm btn-warning text-dark fw-bold d-flex align-items-center gap-1 shadow-sm';
                    holdBtn.title = 'Resume this job';
                }
                if (holdBtnText) holdBtnText.textContent = 'Resume Job';
                if (holdBtnIcon) holdBtnIcon.className = 'bi bi-play-circle-fill text-dark';
                if (timerIcon) timerIcon.className = 'bi bi-pause-circle text-danger fs-6';

                if (manualBtn) manualBtn.setAttribute('disabled', 'disabled');
                if (sendBtn) sendBtn.setAttribute('disabled', 'disabled');
                if (bleBtn) bleBtn.setAttribute('disabled', 'disabled');
            } else {
                startCockpitTimer();
                if (banner) banner.classList.add('d-none');
                if (holdBtn) {
                    holdBtn.className = 'btn btn-sm btn-outline-warning d-flex align-items-center gap-1 shadow-sm';
                    holdBtn.title = 'Put this job on hold and pause timer';
                }
                if (holdBtnText) holdBtnText.textContent = 'Hold Job';
                if (holdBtnIcon) holdBtnIcon.className = 'bi bi-pause-circle text-warning';
                if (timerIcon) timerIcon.className = 'bi bi-stopwatch text-warning fs-6';

                if (manualBtn) manualBtn.removeAttribute('disabled');
                if (sendBtn) sendBtn.removeAttribute('disabled');
                if (bleBtn) bleBtn.removeAttribute('disabled');
            }
        }

        async function toggleJobHold() {
            if (isJobOnHold) {
                await resumeJobFromHold();
            } else {
                await placeJobOnHold();
            }
        }

        async function placeJobOnHold() {
            const holdBtn = document.getElementById('btn-hold-toggle');
            if (holdBtn) holdBtn.disabled = true;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('jobId', jobId);
                formData.append('sessionId', sessionId);
                formData.append('unitNo', currentUnitNo);
                formData.append('reason', 'Paused');
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Worker/JobBoard/HoldSession', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    if (data.accumulatedSeconds !== undefined) activeSeconds = data.accumulatedSeconds;
                    updateHoldUi(true);
                } else {
                    alert(data.message || 'Failed to place job on hold.');
                }
            } catch (e) {
                console.error('Error holding session:', e);
                alert('Network error while placing job on hold.');
            } finally {
                if (holdBtn) holdBtn.disabled = false;
            }
        }

        async function resumeJobFromHold() {
            const holdBtn = document.getElementById('btn-hold-toggle');
            if (holdBtn) holdBtn.disabled = true;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('jobId', jobId);
                formData.append('sessionId', sessionId);
                formData.append('unitNo', currentUnitNo);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Worker/JobBoard/ResumeSession', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    if (data.accumulatedSeconds !== undefined) activeSeconds = data.accumulatedSeconds;
                    updateHoldUi(false);
                } else {
                    alert(data.message || 'Failed to resume job.');
                }
            } catch (e) {
                console.error('Error resuming session:', e);
                alert('Network error while resuming job.');
            } finally {
                if (holdBtn) holdBtn.disabled = false;
            }
        }

        async function releaseJobToOpenPool() {
            if (!confirm("Release this job from your login and move it to Open Work?")) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('jobId', jobId);
                formData.append('sessionId', sessionId);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Worker/JobBoard/ReleaseToOpenPool', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    window.location.href = data.redirectUrl || '/Worker/JobBoard';
                } else {
                    alert(data.message || 'Failed to release job.');
                }
            } catch (e) {
                console.error('Error releasing job:', e);
                window.location.href = '/Worker/JobBoard';
            }
        }

        // Initialize hold UI and timer on cockpit load
        updateHoldUi(isJobOnHold);
    </script>
}
