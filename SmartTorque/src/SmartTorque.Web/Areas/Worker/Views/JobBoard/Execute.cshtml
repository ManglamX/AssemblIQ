                                    var isLocked = !isThisActiveTool && execLocks.ContainsKey(d.DeviceId);
                                    var lockText = isLocked ? $" • 🔒 [LOCKED by {execLocks[d.DeviceId]}]" : (isThisActiveTool ? " • [Currently Active]" : "");
                                    var isOverdue = d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                    var isDueSoon = !isOverdue && d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30);
                                    var calStatus = isOverdue ? "overdue" : (isDueSoon ? "due" : "");
                                    var calDue = d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "";
                                    var calText = isOverdue ? " • ⚠ OVERDUE since " + calDue : (isDueSoon ? " • ⚠ Cal due " + calDue : "");
                                    var optStyle = isLocked ? "color: #9ca3af; font-style: italic;" : (isOverdue ? "color: #dc3545; font-weight: 600;" : (isDueSoon ? "color: #d97706;" : ""));

                                    <option value="@d.DeviceId"
                                            selected="@isThisActiveTool"
                                            disabled="@(isLocked ? "disabled" : null)"
                                            class="@(isLocked ? "text-muted fst-italic" : (isOverdue ? "text-danger fw-bold" : (isDueSoon ? "text-warning" : "")))"
                                            style="@optStyle"
                                            data-cal-status="@calStatus"
                                            data-cal-due="@calDue">
                                        @d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")@lockText@calText
                                    </option>
                                }
                            }
                        </select>
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-3 d-none border-danger d-flex align-items-center" id="pairExecVernierCalAlert" role="alert"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-check2-circle me-1"></i>Pair & Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

