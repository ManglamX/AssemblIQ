@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const sessionId = @Model.SessionId;
        const jobId = @Model.JobId;
        const minScale = @minScale;
        const maxScale = @maxScale;
        const targetVal = @(currentStep?.Target ?? 0);
        const lowerLimit = @(currentStep?.LowerLimit ?? 0);
        const upperLimit = @(currentStep?.UpperLimit ?? 0);
        const currentStepSeq = @(currentStep?.SequenceNo ?? 1);
        const instrumentType = @((int)(currentStep?.Instrument ?? InstrumentType.Torque));
        const unitSymbol = "@unitSymbol";

        // Setup SignalR connection
        let connection = null;
        if (typeof signalR !== 'undefined') {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            // Real-time live torque/vernier values streamed from ESP32 (!isStable)
            connection.on("liveValue", function (data) {
                console.log("Live stream reading:", data);
                if (data && typeof data.value !== 'undefined') {
                    updateGaugeNeedle(data.value);
                    const statusText = document.getElementById("live-status-text");
                    if (statusText) {
                        if (data.inTolerance) {
                            statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-arrow-repeat spin me-1"></i>Torque in Target Range (' + Number(data.value).toFixed(2) + ' ' + (data.unit || unitSymbol) + ')</span>';
                        } else {
                            statusText.innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-wrench me-1"></i>Applying Torque... ' + Number(data.value).toFixed(2) + ' ' + (data.unit || unitSymbol) + '</span>';
                        }
                    }
                }
            });

            // Confirmed reading evaluated by backend (isStable == true)
            connection.on("stepResult", function (data) {
                console.log("Step result via SignalR:", data);
                handleReadingResult({
                    actualValue: data.actual,
                    isStepPassed: data.result === "Pass",
                    attemptNo: data.attemptNo,
                    sessionId: data.sessionId,
                    isSessionCompleted: false
                });
            });

            connection.on("ReadingProcessed", function (data) {
                console.log("Received reading processed via SignalR:", data);
                handleReadingResult(data);
            });

            connection.on("SessionCompleted", function (data) {
                console.log("Session completed via SignalR:", data);
                setTimeout(function () {
                    window.location.href = '/Worker/JobBoard/Summary/' + (data.sessionId || sessionId);
                }, 1000);
            });

            connection.start()
                .then(function () {
                    console.log("Connected to SignalR LiveReadingHub");
                    document.getElementById("signalr-text").textContent = "Live Connected";
                    document.getElementById("signalr-icon").className = "bi bi-broadcast text-success";
                    connection.invoke("JoinSession", sessionId);
                    connection.invoke("JoinJob", jobId);
                })
                .catch(function (err) {
                    console.warn("SignalR connection error:", err.toString());
                    document.getElementById("signalr-text").textContent = "Polling Mode";
                });
        }

        function updateGaugeNeedle(val) {
            const clamped = Math.max(minScale, Math.min(maxScale, val));
            const range = maxScale - minScale;
            const pct = range > 0 ? ((clamped - minScale) / range) * 100 : 50;
            const needle = document.getElementById("gauge-needle");
            if (needle) {
                needle.style.left = pct + "%";
            }

            const readingNum = document.getElementById("reading-num");
            if (readingNum) {
                readingNum.textContent = Number(val).toFixed(2);
            }

            const liveVal = document.getElementById("live-value");
            if (liveVal) {
                if (val >= lowerLimit && val <= upperLimit) {
                    liveVal.className = "live-value-display in-range text-success";
                } else {
                    liveVal.className = "live-value-display out-range text-danger";
                }
            }
        }

        function handleReadingResult(res) {
            updateGaugeNeedle(res.actualValue);

            const banner = document.getElementById("result-banner");
            const bannerText = document.getElementById("banner-text");
            const statusText = document.getElementById("live-status-text");
            const failAdvanceContainer = document.getElementById("fail-advance-btn-container");

            if (banner && bannerText) {
                banner.classList.remove("d-none", "alert-success", "alert-danger");
                if (res.isStepPassed) {
                    banner.classList.add("alert-success");
                    bannerText.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>PASS — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (failAdvanceContainer) failAdvanceContainer.classList.add("d-none");
                    if (statusText) statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Within acceptance limits</span>';
                } else {
                    banner.classList.add("alert-danger");
                    bannerText.innerHTML = '<i class="bi bi-x-circle-fill me-2"></i>FAIL (Attempt ' + res.attemptNo + ' — unlimited retries) — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    if (failAdvanceContainer) failAdvanceContainer.classList.remove("d-none");
                    if (statusText) statusText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Outside tolerance limits. Apply torque again to retry, or record defect to advance.</span>';
                }
            }

            // Auto-advance or redirect to summary if session completed
            if (res.isSessionCompleted) {
                setTimeout(function () {
                    window.location.href = '/Worker/JobBoard/Summary/' + res.sessionId;
                }, 900);
            } else if (res.isStepPassed || (res.nextStepSequence && res.nextStepSequence !== currentStepSeq)) {
                setTimeout(function () {
                    window.location.reload();
                }, 850);
            }
        }

        async function submitFailedBolt() {
            if (!confirm("Are you sure you want to log this bolt as FAILED and proceed to the next step? This will be recorded as a defect in quality reports.")) {
                return;
            }

            const currentNum = parseFloat(document.getElementById("reading-num")?.textContent) || (targetVal || 0);

            const payload = {
                SessionId: sessionId,
                Value: isNaN(currentNum) ? 0 : currentNum,
                InstrumentType: instrumentType,
                ForceFail: true,
                ReasonCode: "OPERATOR_FORCE_FAIL",
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to record failed bolt.');
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        async function sendSimulated(val) {
            updateGaugeNeedle(val);

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit reading.');
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        function sendCustomSimulated() {
            const input = document.getElementById("custom-sim-val");
            const val = parseFloat(input.value);
            if (isNaN(val)) {
                alert("Please enter a valid numeric reading value.");
                return;
            }
            sendSimulated(val);
        }

        async function submitManualReading() {
            const valInput = document.getElementById("manual-value");
            const reasonInput = document.getElementById("manual-reason");
            const val = parseFloat(valInput.value);

            if (isNaN(val)) {
                alert("Please enter a valid numeric reading value.");
                return;
            }

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                IsManualEntry: true,
                ReasonCode: reasonInput.value,
                CapturedAt: new Date().toISOString()
            };

            const modalEl = document.getElementById('manualEntryModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to submit manual reading.');
                }
            } catch (ex) {
                console.error("Manual reading error:", ex);
            }
        }
    
        function highlightStepRow(seq) {
            const el = document.getElementById("step-row-" + seq);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                el.classList.add("bg-warning-subtle");
                setTimeout(() => el.classList.remove("bg-warning-subtle"), 1500);
            }
        }

        // Blueprint Pan, Zoom & Perspective Controller (In-Card)
        const bpState = {
            scale: 1,
            translateX: 0,
            translateY: 0,
            rotation: 0,
            flipH: 1,
            isDragging: false,
            startX: 0,
            startY: 0
        };

        function bpApplyTransform() {
            const canvas = document.getElementById("bp-canvas");
            const zoomLabel = document.getElementById("bp-zoom-label");
            if (!canvas) return;

            canvas.style.transform = `translate(calc(-50% + ${bpState.translateX}px), calc(-50% + ${bpState.translateY}px)) scale(${bpState.scale * bpState.flipH}, ${bpState.scale}) rotate(${bpState.rotation}deg)`;

            const labels = canvas.querySelectorAll(".bp-marker-label");
            labels.forEach(lbl => {
                lbl.style.transform = `rotate(${-bpState.rotation}deg) scale(${bpState.flipH}, 1)`;
            });

            if (zoomLabel) {
                zoomLabel.textContent = Math.round(bpState.scale * 100) + "%";
            }
        }

        function bpZoom(delta) {
            bpState.scale = Math.max(0.5, Math.min(5, bpState.scale + delta));
            bpApplyTransform();
        }

        function bpRotate(deg) {
            bpState.rotation = (bpState.rotation + deg + 360) % 360;
            bpApplyTransform();
        }

        function bpFlip() {
            bpState.flipH *= -1;
            bpApplyTransform();
        }

        function bpReset() {
            bpState.scale = 1;
            bpState.translateX = 0;
            bpState.translateY = 0;
            bpState.rotation = 0;
            bpState.flipH = 1;
            bpApplyTransform();
        }

        function bpFocusCurrent() {
            const activePin = document.querySelector(".bp-marker[data-current='true']");
            if (activePin) {
                const xPct = parseFloat(activePin.getAttribute("data-x"));
                const yPct = parseFloat(activePin.getAttribute("data-y"));
                const img = document.getElementById("bp-img");
                if (img) {
                    const w = img.clientWidth || 250;
                    const h = img.clientHeight || 250;
                    const offsetX = (50 - xPct) / 100 * w;
                    const offsetY = (50 - yPct) / 100 * h;

                    bpState.scale = 2.2;
                    bpState.translateX = offsetX * bpState.scale;
                    bpState.translateY = offsetY * bpState.scale;
                    bpApplyTransform();
                    return;
                }
            }
            bpReset();
        }

        // Initialize In-Card Viewport Event Listeners
        const bpViewport = document.getElementById("bp-viewport");
        if (bpViewport) {
            bpViewport.addEventListener("mousedown", (e) => {
                if (e.target.closest(".bp-marker") || e.button !== 0) return;
                bpState.isDragging = true;
                bpState.startX = e.clientX - bpState.translateX;
                bpState.startY = e.clientY - bpState.translateY;
                bpViewport.style.cursor = "grabbing";
            });

            window.addEventListener("mousemove", (e) => {
                if (!bpState.isDragging) return;
                bpState.translateX = e.clientX - bpState.startX;
                bpState.translateY = e.clientY - bpState.startY;
                bpApplyTransform();
            });

            window.addEventListener("mouseup", () => {
                if (bpState.isDragging) {
                    bpState.isDragging = false;
                    if (bpViewport) bpViewport.style.cursor = "grab";
                }
            });

            bpViewport.addEventListener("wheel", (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.2 : -0.2;
                bpZoom(delta);
            }, { passive: false });

            // Touch events for tablet/mobile operators
            let touchDist = 0;
            bpViewport.addEventListener("touchstart", (e) => {
                if (e.touches.length === 1) {
                    bpState.isDragging = true;
                    bpState.startX = e.touches[0].clientX - bpState.translateX;
                    bpState.startY = e.touches[0].clientY - bpState.translateY;
                } else if (e.touches.length === 2) {
                    touchDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            }, { passive: true });

            bpViewport.addEventListener("touchmove", (e) => {
                if (e.touches.length === 1 && bpState.isDragging) {
                    bpState.translateX = e.touches[0].clientX - bpState.startX;
                    bpState.translateY = e.touches[0].clientY - bpState.startY;
                    bpApplyTransform();
                } else if (e.touches.length === 2) {
                    const newDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    const factor = (newDist - touchDist) * 0.005;
                    bpZoom(factor);
                    touchDist = newDist;
                }
            }, { passive: true });

            bpViewport.addEventListener("touchend", () => {
                bpState.isDragging = false;
            });
        }

        // Modal Blueprint Pan & Zoom Controller
        const modalBpState = {
            scale: 1,
            translateX: 0,
            translateY: 0,
            rotation: 0,
            flipH: 1,
            isDragging: false,
            startX: 0,
            startY: 0
        };

        function modalBpApplyTransform() {
            const canvas = document.getElementById("modal-bp-canvas");
            const zoomLabel = document.getElementById("modal-bp-zoom-label");
            if (!canvas) return;

            canvas.style.transform = `translate(calc(-50% + ${modalBpState.translateX}px), calc(-50% + ${modalBpState.translateY}px)) scale(${modalBpState.scale * modalBpState.flipH}, ${modalBpState.scale}) rotate(${modalBpState.rotation}deg)`;

            const labels = canvas.querySelectorAll(".modal-bp-marker-label");
            labels.forEach(lbl => {
                lbl.style.transform = `rotate(${-modalBpState.rotation}deg) scale(${modalBpState.flipH}, 1)`;
            });

            if (zoomLabel) {
                zoomLabel.textContent = Math.round(modalBpState.scale * 100) + "%";
            }
        }

        function modalBpZoom(delta) {
            modalBpState.scale = Math.max(0.5, Math.min(5, modalBpState.scale + delta));
            modalBpApplyTransform();
        }

        function modalBpRotate(deg) {
            modalBpState.rotation = (modalBpState.rotation + deg + 360) % 360;
            modalBpApplyTransform();
        }

        function modalBpFlip() {
            modalBpState.flipH *= -1;
            modalBpApplyTransform();
        }

        function modalBpReset() {
            modalBpState.scale = 1;
            modalBpState.translateX = 0;
            modalBpState.translateY = 0;
            modalBpState.rotation = 0;
            modalBpState.flipH = 1;
            modalBpApplyTransform();
        }

        const modalViewport = document.getElementById("modal-bp-viewport");
        if (modalViewport) {
            modalViewport.addEventListener("mousedown", (e) => {
                if (e.target.closest(".modal-bp-marker") || e.button !== 0) return;
                modalBpState.isDragging = true;
                modalBpState.startX = e.clientX - modalBpState.translateX;
                modalBpState.startY = e.clientY - modalBpState.translateY;
                modalViewport.style.cursor = "grabbing";
            });

            window.addEventListener("mousemove", (e) => {
                if (!modalBpState.isDragging) return;
                modalBpState.translateX = e.clientX - modalBpState.startX;
                modalBpState.translateY = e.clientY - modalBpState.startY;
                modalBpApplyTransform();
            });

            window.addEventListener("mouseup", () => {
                if (modalBpState.isDragging) {
                    modalBpState.isDragging = false;
                    if (modalViewport) modalViewport.style.cursor = "grab";
                }
            });

            modalViewport.addEventListener("wheel", (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.2 : -0.2;
                modalBpZoom(delta);
            }, { passive: false });
        }

        // Sync modal when opened
        const bpModalEl = document.getElementById('blueprintModal');
        if (bpModalEl) {
            bpModalEl.addEventListener('shown.bs.modal', function () {
                modalBpState.rotation = bpState.rotation;
                modalBpState.flipH = bpState.flipH;
                modalBpState.scale = 1;
                modalBpState.translateX = 0;
                modalBpState.translateY = 0;
                modalBpApplyTransform();
            });
        }

            var bpMarkerSize = parseInt(localStorage.getItem('smarttorque_marker_size') || '28');
        function bpSetMarkerSize(size) {
            size = Math.max(16, Math.min(56, parseInt(size) || 28));
            bpMarkerSize = size;
            localStorage.setItem('smarttorque_marker_size', size);
            var lbl = document.getElementById('bp-marker-size-label');
            if (lbl) lbl.textContent = size + 'px';
            var mlbl = document.getElementById('modal-bp-marker-size-label');
            if (mlbl) mlbl.textContent = size + 'px';
            var fontSize = Math.max(10, Math.round(size * 0.48));
            document.querySelectorAll('.bp-marker, .modal-bp-marker').forEach(function(m) {
                m.style.width = size + 'px';
                m.style.height = size + 'px';
                m.style.fontSize = fontSize + 'px';
            });
        }
        function bpStepMarkerSize(delta) {
            bpSetMarkerSize(bpMarkerSize + delta);
        }
        function bpCycleMarkerSize() {
            var presets = [18, 28, 36, 48];
            var idx = presets.indexOf(bpMarkerSize);
            var next = (idx === -1) ? 28 : presets[(idx + 1) % presets.length];
            bpSetMarkerSize(next);
        }
        document.addEventListener('DOMContentLoaded', function() {
            bpSetMarkerSize(bpMarkerSize);
        });
    </script>
}
