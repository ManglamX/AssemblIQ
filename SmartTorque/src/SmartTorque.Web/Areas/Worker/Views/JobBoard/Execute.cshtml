                                             style="position:absolute; left: @(x1)%; top: @(y1)%; width: 7px; height: 7px; background: #fff; border: 1.5px solid @(isCurr ? "#107c41" : "#168039"); border-radius: 1px; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;"
                                             title="@s.Label (Point 1)">
