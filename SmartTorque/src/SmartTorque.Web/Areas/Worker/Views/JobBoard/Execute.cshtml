@model SmartTorque.Services.ExecutionStateDto
@using SmartTorque.Core.Enums
@{
    var isAjax = Context.Request.Headers["X-Assembl-Shell"] == "1" || Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? "_WorkerSpaPartialLayout" : "_WorkerLayout";
    ViewData["Title"] = $"Assembly Cockpit — {Model.JobNo}";

    var currentStep = Model.CurrentStep;
    var instrumentName = currentStep?.Instrument == InstrumentType.Torque ? "Torque Wrench" : "Vernier Caliper";
    var unitSymbol = currentStep?.Instrument == InstrumentType.Torque ? "N·m" : "mm";
    var isManualToolMode = ViewBag.IsManualToolMode is bool bm && bm;
    var manualToolName = ViewBag.ManualToolName as string;
    var manualToolCode = ViewBag.ManualToolCode as string;
    var selectedDeviceName = isManualToolMode
        ? (manualToolName ?? "Manual Tool (Non-Digital)")
        : ((currentStep?.Instrument == InstrumentType.Vernier)
            ? (Model.VernierDeviceName ?? Model.VernierDeviceTransmitterId ?? Model.TorqueDeviceName ?? Model.TorqueDeviceTransmitterId ?? "No Tool Paired")
            : (Model.TorqueDeviceName ?? Model.TorqueDeviceTransmitterId ?? Model.VernierDeviceName ?? Model.VernierDeviceTransmitterId ?? "No Tool Paired"));
    var activeDevice = isManualToolMode
        ? (manualToolCode ?? "MANUAL")
        : ((currentStep?.Instrument == InstrumentType.Vernier)
            ? (Model.VernierDeviceTransmitterId ?? Model.TorqueDeviceTransmitterId ?? "")
            : (Model.TorqueDeviceTransmitterId ?? Model.VernierDeviceTransmitterId ?? ""));
    var workerJobs = ViewBag.WorkerJobs as IReadOnlyList<SmartTorque.Core.Entities.Job> ?? new List<SmartTorque.Core.Entities.Job>();
    var curUnit = Model.Units?.FirstOrDefault(u => u.UnitIndex == Model.UnitNo);
    var curUnitStatus = curUnit?.Status ?? UnitAssemblyStatus.Pending;

    decimal minScale = 0;
    decimal maxScale = 100;
    decimal zoneLeft = 30;
    decimal zoneWidth = 40;

    if (currentStep != null)
    {
        var span = Math.Max(currentStep.UpperLimit - currentStep.LowerLimit, currentStep.Target * 0.2m);
        minScale = Math.Max(0, currentStep.LowerLimit - (span * 1.5m));
        maxScale = currentStep.UpperLimit + (span * 1.5m);
        if (maxScale <= minScale) maxScale = minScale + 10;

        zoneLeft = Math.Max(0, Math.Min(100, ((currentStep.LowerLimit - minScale) / (maxScale - minScale)) * 100));
        var right = Math.Max(0, Math.Min(100, ((currentStep.UpperLimit - minScale) / (maxScale - minScale)) * 100));
        zoneWidth = Math.Max(1, right - zoneLeft);
    }
}

<style>
/* Industrial Precision Cockpit Styling */
.hover-track {
    transition: background-color 0.15s ease;
}
.hover-track:hover {
    background-color: #f1f5f9;
}
.hover-track:hover .track-num-label {
    display: none !important;
}
.hover-track:hover .track-play-hover {
    display: inline-block !important;
}
.active-playing-track {
    background-color: #f0fdf4 !important;
    border-color: #10b981 !important;
}
.playlist-tracks-container::-webkit-scrollbar {
    width: 6px;
}
.playlist-tracks-container::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
}

/* Industrial Cockpit Header Card */
.industrial-header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
.meta-chip {
    display: inline-flex;
    flex-direction: column;
    padding: 0.18rem 0.55rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    line-height: 1.25;
}
.meta-chip-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #64748b;
}
.meta-chip-val {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
}
.meta-divider {
    width: 1px;
    height: 28px;
    background-color: #e2e8f0;
    margin: 0 0.15rem;
}

/* Precision Active Bolt Marker (Clean Industrial Target Ring) */
@@keyframes target-ring {
    0%, 100% {
        box-shadow: 0 0 0 2px #ffffff, 0 0 0 6px rgba(14, 165, 233, 0.7), 0 3px 8px rgba(0,0,0,0.3);
    }
    50% {
        box-shadow: 0 0 0 2px #ffffff, 0 0 0 10px rgba(14, 165, 233, 0.25), 0 5px 12px rgba(0,0,0,0.4);
    }
}

.marker-current {
    background: #0284c7 !important;
    border: 2px solid #ffffff !important;
    animation: target-ring 1.8s ease-in-out infinite !important;
    position: relative;
    z-index: 10 !important;
}

@@keyframes vernier-line-pulse {
    0%, 100% { filter: drop-shadow(0 0 2.5px rgba(14, 165, 233, 0.95)); stroke: #0284c7; }
    50% { filter: drop-shadow(0 0 6px rgba(56, 189, 248, 1)); stroke: #38bdf8; }
}
.vernier-line-active {
    stroke: #0284c7 !important;
    stroke-width: 1.35 !important;
    animation: vernier-line-pulse 1.8s ease-in-out infinite !important;
}
.vernier-line-pass {
    stroke: #198754 !important;
    stroke-width: 0.85 !important;
    filter: none !important;
}
.vernier-line-pending {
    stroke: rgba(148, 163, 184, 0.65) !important;
    stroke-width: 0.6 !important;
    stroke-dasharray: 1.5 1 !important;
    filter: none !important;
}

#btn-send-reading {
    background: #1e293b !important;
    border: 1px solid #0f172a !important;
    color: #ffffff !important;
    letter-spacing: 0.3px;
    transition: all 0.15s ease-in-out;
}
#btn-send-reading:hover {
    background: #0f172a !important;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25) !important;
}

.live-value-display {
    font-family: 'SF Mono', Consolas, Monaco, monospace !important;
    font-size: 2.75rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    letter-spacing: -1px;
}
</style>

<div class="container-fluid px-0">
    <!-- Single Row Header: Job Info + Submit Work Button -->
    <div class="execute-header sticky-top bg-white border-bottom mb-2 px-3 py-2" style="top: 0; z-index: 1020;">
        <div class="d-flex align-items-center justify-content-between gap-3">
            <!-- Left: Back Button + Job Info -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a href="@Url.Action("Index", "JobBoard", new { area = "Worker" })" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 6px;" title="Back to Job Board">
                    <i class="bi bi-arrow-left"></i>
                    <span class="fw-semibold">Job @Model.JobNo.Replace("JOB-", "")</span>
                </a>

                <div class="d-flex flex-column" style="line-height: 1.3;">
                    <span class="text-muted small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Job Number</span>
                    <span class="fw-bold">@Model.JobNo</span>
                </div>

                <div class="d-flex flex-column" style="line-height: 1.3;">
                    <span class="text-muted small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Product</span>
                    <span class="fw-semibold">@Model.ProductCode <span class="text-muted fw-normal">(@Model.ProductName)</span></span>
                </div>

                <div class="d-flex flex-column" style="line-height: 1.3;">
                    <span class="text-muted small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Sales Order</span>
                    <span class="fw-semibold text-primary">@(string.IsNullOrWhiteSpace(Model.SalesOrder) ? "N/A" : Model.SalesOrder)</span>
                </div>

                <div class="d-flex flex-column" style="line-height: 1.3;">
                    <span class="text-muted small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">PO Number</span>
                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PONo) ? "N/A" : Model.PONo)</span>
                </div>
            </div>
        </div>
    </div>

    @{
        var calNoticeList = ViewBag.CalibrationNotices as List<object> ?? new List<object>();
    }
    @if (calNoticeList.Count > 0)
    {
        <div class="alert alert-warning py-2 px-3 small d-none mb-2" id="calNoticeBanner" role="alert" data-notices="@Json.Serialize(calNoticeList)">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-1 flex-shrink-0"></i>
            <div class="flex-grow-1">
                <strong>Calibration notice — the device(s) below remain fully usable:</strong>
                <div id="calNoticeLines"></div>
            </div>
            <button type="button" class="btn-close flex-shrink-0" aria-label="Remind me tomorrow" id="calNoticeDismiss"></button>
        </div>
    }

    @if (curUnitStatus == UnitAssemblyStatus.Rework)
    {
        <div class="alert alert-warning py-2 px-3 small d-flex align-items-center justify-content-between mb-2 shadow-sm border-start border-4 border-warning">
            <div class="d-flex align-items-center">
                <i class="bi bi-arrow-repeat text-warning fs-5 me-2 flex-shrink-0"></i>
                <div>
                    <strong>REWORK IN PROGRESS (Iteration #@(curUnit?.ReworkCount ?? 1)):</strong>
                    <span class="ms-1">@(curUnit?.LatestReworkReason ?? "Quality / Assembly Adjustment")</span>
                </div>
            </div>
            <span class="badge bg-dark text-warning font-monospace text-uppercase">CORRECTIVE REWORK ACTIVE</span>
        </div>
    }

    @if (Model.Status == JobStatus.Completed || Model.QuantityCompleted >= Model.Quantity)
    {
        <!-- Celebration Job Completed Banner -->
        <div class="alert alert-success border-success text-center py-5 shadow-sm rounded-3">
            <i class="bi bi-trophy-fill text-warning" style="font-size: 4rem;"></i>
            <h2 class="h3 fw-bold mt-3">Job Complete!</h2>
            <p class="fs-5 text-muted mb-4">All @Model.Quantity units have been assembled and verified through calibrated measurements.</p>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker" })" class="btn btn-success btn-lg px-4">
                <i class="bi bi-arrow-left-circle me-2"></i>Return to Job Board
            </a>
        </div>
    }
    else if (currentStep == null || Model.SessionFinalResult == SmartTorque.Core.Enums.SessionResult.Pass)
    {
        <!-- Component Passed State -->
        <div class="alert alert-success border-success text-center py-5 shadow-sm rounded-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
            <h2 class="h3 fw-bold mt-3">Component "@Model.CurrentComponent.ComponentName" Complete!</h2>
            <p class="fs-5 text-muted mb-4">All steps have passed acceptance criteria.</p>
            @{
                var nextComp = Model.Components.FirstOrDefault(c => c.AssemblyOrder > Model.CurrentComponent.AssemblyOrder && !c.IsCompletedForCurrentUnit)
                    ?? Model.Components.FirstOrDefault(c => !c.IsCompletedForCurrentUnit);
            }
            @if (nextComp != null)
            {
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <form asp-action="SwitchComponent" asp-route-id="@Model.JobId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productComponentId" value="@nextComp.ProductComponentId" />
                        <input type="hidden" name="unitNo" value="@Model.UnitNo" />
                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow">
                            Proceed to Next Component: @nextComp.ComponentName <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>
                    <form asp-action="CompleteUnitWork" method="post" class="d-inline" onsubmit="return confirm('Submit completed work for this unit and generate report?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@Model.JobId" />
                        <input type="hidden" name="unitNo" value="@Model.UnitNo" />
                        <button type="submit" class="btn btn-outline-success btn-lg px-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-all me-1"></i>Submit Completed Work &amp; Finalize Report
                        </button>
                    </form>
                </div>
            }
            else
            {
                <form asp-action="Start" asp-route-id="@Model.JobId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        Proceed to Unit @(Model.UnitNo + 1) <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </form>
            }
        </div>
    }
    else
    {
        <!-- Main Cockpit Layout: Tablet-First Responsive Grid -->
        <div class="execute-grid" id="cockpit-grid">
            <!-- Left Sidebar: Controls + Assembly + Operation Details -->
            <div class="execute-left" style="overflow-y: auto; padding: 0.25rem 0.5rem 0.75rem 0;">
                <!-- Tool Name + Status Indicator (Side by Side) -->
                <div class="d-flex gap-2 mb-2">
                    <!-- Tool Name Display - Clickable to Switch Tools -->
                    <button type="button"
                            class="card border shadow-sm flex-fill px-3 py-2 bg-white text-start m-0"
                            data-bs-toggle="modal"
                            data-bs-target="#pairCockpitToolModal"
                            id="btn-cockpit-tool-pair"
                            disabled="@(!Model.IsOnHold ? "disabled" : null)"
                            style="border: 1px solid #dee2e6; cursor: @(Model.IsOnHold ? "pointer" : "not-allowed"); opacity: @(Model.IsOnHold ? "1" : "0.65"); border-radius: 8px;"
                            title="@(Model.IsOnHold ? "Click to change paired tool" : "Put the job ON HOLD to change paired tool")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-tools" style="font-size: 0.95rem;"></i>
                            <div class="d-flex flex-column">
                                <span class="text-muted small" style="font-size: 0.6rem; line-height: 1;">Tool:</span>
                                <span class="fw-bold" style="font-size: 0.85rem; line-height: 1.2;">@activeDevice</span>
                            </div>
                        </div>
                    </button>

                    <!-- Connection Status Indicator -->
                    @{
                        var initConnected = (ViewBag.IsEquippedToolOnline is bool bOnline && bOnline) || (ViewBag.IsBleSessionActive is bool bBle && bBle);
                        var isManualMode = activeDevice.Contains("MANUAL", StringComparison.OrdinalIgnoreCase);
                        string statusBadgeClass, statusText, statusIcon;

                        if (isManualMode)
                        {
                            statusBadgeClass = "bg-warning";
                            statusText = "Manual";
                            statusIcon = "bi-hand-index-thumb";
                        }
                        else if (initConnected)
                        {
                            statusBadgeClass = "bg-success";
                            statusText = "Connected";
                            statusIcon = "bi-circle-fill";
                        }
                        else
                        {
                            statusBadgeClass = "bg-danger";
                            statusText = "Disconnected";
                            statusIcon = "bi-circle-fill";
                        }
                    }
                    <div class="card border-0 shadow-sm d-flex align-items-center justify-content-center @statusBadgeClass text-white px-3 py-2 m-0" style="border-radius: 8px; flex: 0 0 auto;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @statusIcon" style="font-size: 0.75rem;"></i>
                            <span class="fw-bold" style="font-size: 0.85rem; white-space: nowrap;">@statusText</span>
                        </div>
                    </div>
                </div>

                <!-- Timer + Resume/Hold + Submit Work (All Side by Side) -->
                <div class="d-flex align-items-stretch gap-2 mb-3">
                    <!-- Timer Display -->
                    <div class="card border-0 bg-dark text-white shadow-sm d-flex flex-row align-items-center justify-content-center px-2 py-2 m-0"
                         id="timer-container"
                         style="border-radius: 8px; flex: 0 0 auto; min-height: 44px;"
                         title="Active time spent working on this job">
                        <i class="bi bi-stopwatch text-warning me-1" style="font-size: 1rem;" id="timer-icon"></i>
                        <span class="fw-bold font-monospace text-warning" id="job-active-timer" style="font-size: 0.95rem; letter-spacing: 0.5px;">00:00:00</span>
                    </div>

                    <!-- Resume / Hold Button -->
                    <button type="button"
                            class="btn @(Model.IsOnHold ? "btn-success" : "btn-warning") fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1 py-2 px-3 m-0"
                            id="btn-hold-toggle"
                            onclick="toggleJobHold()"
                            style="border-radius: 8px; font-size: 0.9rem; flex: 0 0 auto; min-height: 44px;"
                            title="@(Model.IsOnHold ? "Resume this job" : "Put this job on hold and pause timer")">
                        <i class="bi @(Model.IsOnHold ? "bi-play-circle-fill" : "bi-pause-circle")" id="hold-btn-icon" style="font-size: 1rem;"></i>
                        <span id="hold-btn-text">@(Model.IsOnHold ? "Resume" : "Hold Job")</span>
                    </button>

                    <!-- Submit Work Button -->
                    <form asp-action="CompleteUnitWork" method="post" class="flex-fill d-flex m-0" onsubmit="return confirm('Submit completed work for Unit #@Model.UnitNo and finalize quality report?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@Model.JobId" />
                        <input type="hidden" name="unitNo" value="@Model.UnitNo" />
                        <button type="submit"
                                class="btn fw-bold shadow-sm w-100 h-100 py-2 d-flex align-items-center justify-content-center gap-2 m-0"
                                style="background-color: var(--brand, #BD1362); color: white; border-radius: 8px; border: none; font-size: 0.9rem; min-height: 44px;"
                                title="Submit completed components and steps for this unit">
                            <i class="bi bi-check2-circle" style="font-size: 1rem;"></i>Submit Work
                        </button>
                    </form>
                </div>

                <!-- Assembly Order — Components (Compact) -->
                <div class="card border shadow-sm px-2 py-1 mb-2 flex-shrink-0">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                            <i class="bi bi-diagram-2 me-1"></i>Assembly Order
                        </span>
                        <span id="assembly-order-title" class="text-muted" style="font-size: 0.68rem;">
                            @Model.CurrentComponent.ComponentName (@Model.CurrentComponent.AssemblyOrder/@Model.Components.Count)
                        </span>
                    </div>
                    <div id="assembly-order-tabs" class="d-flex flex-wrap gap-1">
                        @foreach (var c in Model.Components)
                        {
                            var isCurrent = c.ProductComponentId == Model.CurrentComponent.ProductComponentId;
                            var isDone = c.IsCompletedForCurrentUnit;

                            <div class="d-flex align-items-center">
                                @if (isCurrent)
                                {
                                    <span class="btn btn-sm btn-dark active py-0 px-2 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;">
                                        <span class="badge @(isDone ? "bg-success text-white" : "bg-secondary text-white") rounded-circle" style="font-size: 0.65rem; padding: 0.15em 0.35em;">
                                            @if (isDone) { <i class="bi bi-check-lg"></i> } else { @c.AssemblyOrder }
                                        </span>
                                        <strong class="text-truncate" style="max-width: 130px;">@c.ComponentName</strong>
                                        @if (isDone)
                                        {
                                            <span class="badge bg-success text-white ms-1 fw-bold" style="font-size: 0.65rem;">✓ PASS</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark ms-1" style="font-size: 0.65rem;">@c.StepCount steps</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <button type="button" id="comp-btn-@c.ProductComponentId" class="btn btn-sm @(isDone ? "btn-outline-success" : "btn-outline-secondary") py-0 px-2 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.75rem;" onclick="switchComponentDynamically(@Model.JobId, @c.ProductComponentId, @Model.UnitNo)">
                                        <span class="badge @(isDone ? "bg-success text-white" : "bg-secondary text-white") rounded-circle" style="font-size: 0.65rem; padding: 0.15em 0.35em;">
                                            @if (isDone) { <i class="bi bi-check"></i> } else { @c.AssemblyOrder }
                                        </span>
                                        <span class="text-truncate" style="max-width: 120px;">@c.ComponentName</span>
                                        @if (isDone)
                                        {
                                            <span class="badge bg-success text-white ms-1" style="font-size: 0.6rem;">PASS</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card border shadow-sm d-flex flex-column" style="flex: 1 1 auto; min-height: 0;">
                    <div class="card-body p-2 d-flex flex-column" style="overflow-y: auto; min-height: 0;">
                        <!-- Step Header (single row) -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                @{ var currentStepIdx = Model.Steps.IndexOf(currentStep); var opNum = currentStepIdx >= 0 ? currentStepIdx + 1 : currentStep.SequenceNo; }<span id="operation-step-badge" class="badge bg-secondary text-uppercase">Operation @opNum of @Model.Steps.Count</span>
                                <h2 class="h6 fw-bold mb-0" id="step-label">@currentStep.Label</h2>
                            </div>
                            <span id="instrument-type-badge" class="badge @(currentStep.Instrument == InstrumentType.Torque ? "bg-info text-dark" : "bg-warning text-dark")">
                                <i class="bi @(currentStep.Instrument == InstrumentType.Torque ? "bi-wrench" : "bi-rulers") me-1"></i>
                                @instrumentName
                            </span>
                        </div>

                        <!-- Target and Limits Bar -->
                        <div class="row g-1 text-center mb-2">
                                <div class="col-4">
                                    <div class="p-1 border rounded bg-light">
                                        <div class="text-muted small">Target</div>
                                        <div class="fw-bold fs-6 text-dark" id="target-value">@currentStep.Target.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-1 border rounded bg-light">
                                        <div class="text-muted small">Lower Limit</div>
                                        <div class="fw-bold fs-6 text-success" id="lower-limit">@currentStep.LowerLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-1 border rounded bg-light">
                                        <div class="text-muted small">Upper Limit</div>
                                        <div class="fw-bold fs-6 text-success" id="upper-limit">@currentStep.UpperLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Value Big Digits Display -->
                            <div class="text-center py-1 bg-light border rounded-3 position-relative mb-2 @(isManualToolMode ? "border-primary border-opacity-50" : "")"
                                 id="live-reading-box"
                                 style="@(isManualToolMode ? "cursor: pointer;" : "")"
                                 title="@(isManualToolMode ? "Click to type reading value and press Enter to submit" : "")">
                                <div class="text-muted small text-uppercase fw-semibold mb-1" id="live-reading-label">
                                    Live Reading (@selectedDeviceName)
                                </div>
                                <div class="live-value-display d-flex align-items-center justify-content-center gap-2" id="live-value" aria-live="polite" aria-atomic="true">
                                    <span id="reading-num">--.-</span>
                                    <input type="number" step="0.001" id="inline-manual-input"
                                           class="form-control form-control-lg font-monospace text-center fw-bold d-none"
                                           style="max-width: 155px; font-size: 1.65rem;"
                                           placeholder="@(currentStep?.Target.ToString("0.0##") ?? "0.0")" />
                                    <span class="live-value-unit">@unitSymbol</span>
                                </div>
                                <div id="live-status-text" class="text-muted small mt-1" aria-live="polite" aria-atomic="true">
                                    @if (isManualToolMode)
                                    {
                                        <i class="bi bi-pencil-square me-1 text-primary"></i><span>Click value above to type &amp; press Enter</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clock-history me-1"></i><span>Waiting for device transmission...</span>
                                    }
                                </div>
                            </div>

                            <!-- Gauge Bar -->
                            <div class="mb-1 px-1">
                                <div class="gauge-track position-relative" style="height: 18px; background: #e9ecef; border-radius: 9px; pointer-events: none; user-select: none; -webkit-user-select: none;">
                                    <!-- Accept Zone (Green) -->
                                    <div class="gauge-accept-zone" id="gauge-zone"
                                         style="position: absolute; top: 0; bottom: 0; left: @zoneLeft%; width: @zoneWidth%; background: #d1e7dd; border: 1px solid #198754; border-radius: 4px;"
                                         title="Acceptance Band [@(currentStep?.LowerLimit) - @(currentStep?.UpperLimit)]">
                                    </div>
                                    <!-- Needle Indicator -->
                                    <div class="gauge-needle" id="gauge-needle"
                                         style="position: absolute; top: -5px; width: 6px; height: 28px; background: #0d6efd; border-radius: 3px; transform: translateX(-50%); left: 0%; transition: left 0.15s ease;">
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mt-1">
                                    <span>@minScale.ToString("0.#")</span>
                                    <span class="text-success fw-bold">Acceptance Zone</span>
                                    <span>@maxScale.ToString("0.#")</span>
                                </div>
                            </div>

                            <!-- Cockpit Action Toolbar -->
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap" id="cockpit-reading-actions">
                                <!-- Manual entry removed - tablet-first design assumes hardware connectivity -->
                            </div>

                            <!-- Result Banner -->
                            <div id="result-banner" class="d-none alert mb-2 py-2 px-3 rounded-3 text-center fs-5 fw-bold" role="alert">
                                <span id="banner-text">PASS</span>
                                <div id="fail-advance-btn-container" class="d-none mt-2">
                                    <button type="button" class="btn btn-sm btn-danger fw-bold shadow-sm" onclick="submitFailedBolt()">
                                        <i class="bi bi-x-octagon me-1"></i>Record Defect & Proceed to Next Step
                                    </button>
                                </div>
                            </div>


                    <!-- Steps Checklist (same card, fills remaining height) -->
                    <div class="border-top pt-1 mt-1 d-flex flex-column" style="flex: 1 1 auto; min-height: 0;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-uppercase text-muted">
                                <i class="bi bi-list-check me-1"></i>Steps Checklist
                            </span>
                            <span id="steps-count-badge" class="badge bg-light text-dark border">@Model.Steps.Count steps</span>
                        </div>
                        <div id="steps-checklist-container" class="list-group list-group-flush" style="flex: 1 1 auto; min-height: 0; overflow-y: auto;">
                        @foreach (var s in Model.Steps)
                        {
                            var rowClass = s.IsCurrent ? "bg-light border-start border-primary border-4" : "";
                            var isDefect = !s.IsCompleted && s.Attempts != null && s.Attempts.Any(a => a.Result == StepResult.Fail) && !s.IsCurrent;
                            var statusBadge = s.IsCompleted
                                ? "<span class=\"badge bg-success-subtle text-success border border-success-subtle\"><i class=\"bi bi-check-lg me-1\"></i>Pass</span>"
                                : (isDefect
                                    ? "<span class=\"badge bg-danger-subtle text-danger border border-danger-subtle\"><i class=\"bi bi-x-circle me-1\"></i>Defect (" + s.AttemptCount + " tries)</span>"
                                    : (s.IsCurrent
                                        ? "<span class=\"badge bg-primary-subtle text-primary border border-primary-subtle fw-bold\"><i class=\"bi bi-arrow-right-circle me-1\"></i>Active</span>"
                                        : "<span class=\"badge bg-light text-muted border\">Pending</span>"));

                            <div id="step-row-@s.SequenceNo" data-instrument="@((int)s.Instrument)" class="list-group-item d-flex justify-content-between align-items-center gap-2 py-1 px-2 @rowClass">
                                <div class="text-truncate" style="line-height: 1.25;">
                                    <span class="fw-semibold small">#@s.SequenceNo @s.Label</span>
                                    <span class="text-muted" style="font-size: 10px;">
                                        @s.Target.ToString("0.0##") [@s.LowerLimit.ToString("0.0##") - @s.UpperLimit.ToString("0.0##")] @(s.Instrument == InstrumentType.Torque ? "N·m" : "mm")
                                        @if (s.AttemptCount > 0)
                                        {
                                            <span class="ms-1">(@s.AttemptCount attempt(s))</span>
                                        }
                                    </span>
                                </div>
                                <div>
                                    @Html.Raw(statusBadge)
                                </div>
                            </div>
                        }
                        </div>
                    </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Blueprint Viewer -->
            <div class="execute-right">
                <div class="card border shadow-sm w-100" id="bp-card" style="display: flex; flex-direction: column; min-width: 320px; height: 100%;">
                    <div class="card-header bg-white py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span id="bp-card-title" class="fw-bold small text-uppercase">
                                <i class="bi bi-diagram-3 me-1"></i>@Model.CurrentComponent.ComponentName Blueprint
                            </span>
                            <div class="d-flex align-items-center gap-1">
                                <span id="bp-template-code" class="badge bg-light text-dark border">@Model.CurrentComponent.TemplateCode</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-bs-toggle="modal" data-bs-target="#blueprintModal" title="Fullscreen Blueprint Modal">
                                    <i class="bi bi-zoom-in"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Blueprint Perspective & Zoom Controls Bar -->
                    <div class="bg-light border-bottom px-2 py-1 d-flex justify-content-between align-items-center flex-wrap gap-1 small">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Zoom controls">
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpZoom(0.25)" title="Zoom In (+)">
                                <i class="bi bi-zoom-in"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpZoom(-0.25)" title="Zoom Out (-)">
                                <i class="bi bi-zoom-out"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpReset()" title="Reset Zoom & Pan">
                                <span id="bp-zoom-label" class="font-monospace" style="font-size: 11px;">100%</span>
                            </button>
                        </div>

                        <div class="btn-group btn-group-sm" role="group" aria-label="Perspective controls">
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpRotate(-90)" title="Rotate Counter-Clockwise 90°">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpRotate(90)" title="Rotate Clockwise 90°">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="bpFlip()" title="Flip Horizontal (Mirror Perspective)">
                                <i class="bi bi-symmetry-vertical"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary py-0 px-2" onclick="bpFocusCurrent()" title="Center and Zoom to Active Bolt Marker">
                                <i class="bi bi-crosshair"></i> Focus
                            </button>
                        </div>
                    </div>

                    <div id="bp-viewport" class="card-body p-0 position-relative text-center user-select-none" style="flex: 1 1 auto; min-height: 480px; overflow: hidden; background: #0f172a; cursor: grab;">
                        <!-- Pan & Zoom Layer -->
                        <div id="bp-canvas" style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(1) rotate(0deg); transform-origin: center center; transition: transform 0.12s ease-out; will-change: transform;">
                            @if (!string.IsNullOrEmpty(Model.CurrentComponent.ImagePath))
                            {
                                var rawImg = Model.CurrentComponent.ImagePath.Trim();
                                var componentImg = rawImg.StartsWith("~") ? Url.Content(rawImg) : (rawImg.StartsWith("/") ? rawImg : "/" + rawImg);
                                <div id="bp-wrapper" class="position-relative d-inline-block" style="line-height: 0;">
                                    <img id="bp-img" src="@componentImg" alt="@Model.CurrentComponent.ComponentName" class="rounded border shadow-sm d-block" style="max-height: 90vh; width: auto; pointer-events: none; user-select: none;" />
                                    <svg class="vernier-svg-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:8;">
                                        @foreach (var ls in Model.Steps.Where(st => st.MarkerX.HasValue && st.MarkerY.HasValue && st.MarkerX2.HasValue && st.MarkerY2.HasValue))
                                        {
                                            var lx1 = ls.MarkerX!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                            var ly1 = ls.MarkerY!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                            var lx2 = ls.MarkerX2!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                            var ly2 = ls.MarkerY2!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                            var lCls = ls.IsCurrent ? "vernier-line-active" : (ls.IsCompleted ? "vernier-line-pass" : "vernier-line-pending");
                                            <line x1="@lx1" y1="@ly1" x2="@lx2" y2="@ly2" class="vernier-line @lCls" data-seq="@ls.SequenceNo" stroke-linecap="round" />
                                        }
                                    </svg>
                            @foreach (var s in Model.Steps)
                            {
                                if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                {
                                    var isCurr = s.IsCurrent;
                                    var isPass = s.IsCompleted;
                                    var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                    var pinSize = Math.Max(14, s.MarkerSize ?? 28);
                                    var pinFont = Math.Max(9, (int)(pinSize * 0.48m));
                                    var x1 = s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var y1 = s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                    if (s.MarkerX2.HasValue && s.MarkerY2.HasValue)
                                    {
                                        var x2 = s.MarkerX2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var y2 = s.MarkerY2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cx = ((s.MarkerX.Value + s.MarkerX2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cy = ((s.MarkerY.Value + s.MarkerY2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var epBg = isCurr ? "#38bdf8" : (isPass ? "#22c55e" : "#94a3b8");

                                        <!-- Clean CAD Vernier Line Endpoints & Dimension Label (No obstructive circles) -->
                                        <div class="vernier-endpoint"
                                             data-seq="@s.SequenceNo"
                                             style="position:absolute; left: @(x1)%; top: @(y1)%; width: 6px; height: 6px; background: @epBg; border: 1px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;">
                                        </div>
                                        <div class="vernier-endpoint"
                                             data-seq="@s.SequenceNo"
                                             style="position:absolute; left: @(x2)%; top: @(y2)%; width: 6px; height: 6px; background: @epBg; border: 1px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;">
                                        </div>
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute fw-bold bp-marker vernier-dim-text"
                                             data-seq="@s.SequenceNo"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(cx)%; top: @(cy)%; transform: translate(-50%, -40%); font-size: 11px; font-family: Consolas, monospace; color: @(isCurr ? "#38bdf8" : (isPass ? "#4ade80" : "#e2e8f0")); text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.95); cursor: pointer; z-index: 12; white-space: nowrap; pointer-events: auto;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                            @(isPass ? "✓ " : "")@(Model.Steps.IndexOf(s) + 1)
                                        </div>
                                    }
                                    else if (s.Instrument == InstrumentType.Vernier)
                                    {
                                        var dotBg = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                        <!-- Compact Vernier Radius Dot (Just one small highlighted dot, no giant circle) -->
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute rounded-circle @dotBg bp-marker vernier-radius-dot"
                                             data-seq="@s.SequenceNo"
                                             data-base-size="10"
                                             data-x="@x1"
                                             data-y="@y1"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(x1)%; top: @(y1)%; width: 10px; height: 10px; border: 1.5px solid #fff; transform: translate(-50%, -50%); cursor: pointer; z-index: 11;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                        </div>
                                        <div class="position-absolute fw-bold vernier-dim-text"
                                             data-seq="@s.SequenceNo"
                                             style="left: @(x1)%; top: @(y1)%; transform: translate(10px, -50%); font-size: 11px; font-family: Consolas, monospace; color: @(isCurr ? "#38bdf8" : (isPass ? "#4ade80" : "#e2e8f0")); text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.95); pointer-events: none; z-index: 12; white-space: nowrap;">
                                            R@(Model.Steps.IndexOf(s) + 1)
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass bp-marker"
                                             data-seq="@s.SequenceNo"
                                             data-base-size="@pinSize"
                                             data-x="@x1"
                                             data-y="@y1"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(x1)%; top: @(y1)%; width: @(pinSize)px; height: @(pinSize)px; font-size: @(pinFont)px; transform: translate(-50%, -50%); cursor: pointer; z-index: 5;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                            <span class="bp-marker-label d-inline-block">@(isPass ? "✓" : (Model.Steps.IndexOf(s) + 1).ToString())</span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Fallback Schematic Container with Visual Pins -->
                        <div id="bp-wrapper" class="position-relative rounded border bg-white shadow-sm d-inline-block" style="width: 320px; height: 240px; border-style: dashed !important; line-height: normal;">
                            <svg class="vernier-svg-overlay" viewBox="0 0 100 100" preserveAspectRatio="none" style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:8;">
                                @foreach (var ls in Model.Steps.Where(st => st.MarkerX.HasValue && st.MarkerY.HasValue && st.MarkerX2.HasValue && st.MarkerY2.HasValue))
                                {
                                    var lx1 = ls.MarkerX!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var ly1 = ls.MarkerY!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var lx2 = ls.MarkerX2!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var ly2 = ls.MarkerY2!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var lCls = ls.IsCurrent ? "vernier-line-active" : (ls.IsCompleted ? "vernier-line-pass" : "vernier-line-pending");
                                    <line x1="@lx1" y1="@ly1" x2="@lx2" y2="@ly2" class="vernier-line @lCls" data-seq="@ls.SequenceNo" stroke-linecap="round" />
                                }
                            </svg>
                            <div class="text-muted small position-absolute top-50 start-50 translate-middle">
                                <i class="bi bi-box fs-1 d-block mb-1 text-secondary"></i>
                                <span>@Model.CurrentComponent.ComponentName Schematic</span>
                            </div>
                            @foreach (var s in Model.Steps)
                            {
                                if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                {
                                    var isCurr = s.IsCurrent;
                                    var isPass = s.IsCompleted;
                                    var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                    var pinSize = Math.Max(14, s.MarkerSize ?? 28);
                                    var pinFont = Math.Max(9, (int)(pinSize * 0.48m));
                                    var x1 = s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var y1 = s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                    if (s.MarkerX2.HasValue && s.MarkerY2.HasValue)
                                    {
                                        var x2 = s.MarkerX2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var y2 = s.MarkerY2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cx = ((s.MarkerX.Value + s.MarkerX2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cy = ((s.MarkerY.Value + s.MarkerY2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var epBg = isCurr ? "#38bdf8" : (isPass ? "#22c55e" : "#94a3b8");

                                        <!-- Clean CAD Vernier Line Endpoints & Dimension Label (No obstructive circles) -->
                                        <div class="vernier-endpoint"
                                             data-seq="@s.SequenceNo"
                                             style="position:absolute; left: @(x1)%; top: @(y1)%; width: 6px; height: 6px; background: @epBg; border: 1px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;">
                                        </div>
                                        <div class="vernier-endpoint"
                                             data-seq="@s.SequenceNo"
                                             style="position:absolute; left: @(x2)%; top: @(y2)%; width: 6px; height: 6px; background: @epBg; border: 1px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;">
                                        </div>
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute fw-bold bp-marker vernier-dim-text"
                                             data-seq="@s.SequenceNo"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(cx)%; top: @(cy)%; transform: translate(-50%, -40%); font-size: 11px; font-family: Consolas, monospace; color: @(isCurr ? "#38bdf8" : (isPass ? "#4ade80" : "#e2e8f0")); text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.95); cursor: pointer; z-index: 12; white-space: nowrap; pointer-events: auto;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                            @(isPass ? "✓ " : "")@(Model.Steps.IndexOf(s) + 1)
                                        </div>
                                    }
                                    else if (s.Instrument == InstrumentType.Vernier)
                                    {
                                        var dotBg = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                        <!-- Compact Vernier Radius Dot (Just one small highlighted dot, no giant circle) -->
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute rounded-circle @dotBg bp-marker vernier-radius-dot"
                                             data-seq="@s.SequenceNo"
                                             data-base-size="10"
                                             data-x="@x1"
                                             data-y="@y1"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(x1)%; top: @(y1)%; width: 10px; height: 10px; border: 1.5px solid #fff; transform: translate(-50%, -50%); cursor: pointer; z-index: 11;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                        </div>
                                        <div class="position-absolute fw-bold vernier-dim-text"
                                             data-seq="@s.SequenceNo"
                                             style="left: @(x1)%; top: @(y1)%; transform: translate(10px, -50%); font-size: 11px; font-family: Consolas, monospace; color: @(isCurr ? "#38bdf8" : (isPass ? "#4ade80" : "#e2e8f0")); text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.95); pointer-events: none; z-index: 12; white-space: nowrap;">
                                            R@(Model.Steps.IndexOf(s) + 1)
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="marker-pin-@s.SequenceNo" class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass bp-marker"
                                             data-seq="@s.SequenceNo"
                                             data-base-size="@pinSize"
                                             data-x="@x1"
                                             data-y="@y1"
                                             data-current="@(isCurr ? "true" : "false")"
                                             style="left: @(x1)%; top: @(y1)%; width: @(pinSize)px; height: @(pinSize)px; font-size: @(pinFont)px; transform: translate(-50%, -50%); cursor: pointer; z-index: 5;"
                                             title="@s.Label: @s.Target @unitSymbol"
                                             onclick="highlightStepRow(@s.SequenceNo)">
                                            <span class="bp-marker-label d-inline-block">@(isPass ? "✓" : (Model.Steps.IndexOf(s) + 1).ToString())</span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                        </div>

                        <!-- Mini helper badge -->
                        <div class="position-absolute bottom-0 start-0 m-1 px-2 py-0 bg-dark bg-opacity-75 text-white rounded small" style="font-size: 10px; pointer-events: none; z-index: 6;">
                            <i class="bi bi-arrows-move me-1"></i>Drag to pan • Scroll to zoom
                        </div>
                    </div>
                </div>
            </div> <!-- end execute-right -->

        </div> <!-- end execute-grid -->
    }
</div>

<!-- Cockpit Tool Switch Modal -->
<div class="modal fade" id="pairCockpitToolModal" tabindex="-1" aria-labelledby="pairCockpitToolModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form method="post" action="@Url.Action("PairTool", "JobBoard", new { area = "Worker" })">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobId" value="@Model.JobId" />
                <input type="hidden" name="sessionId" value="@Model.SessionId" />
                <input type="hidden" name="unitNo" value="@Model.UnitNo" />
                <input type="hidden" name="isBleConnected" id="cockpit-is-ble-connected" value="false" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="pairCockpitToolModalLabel">
                        <i class="bi bi-tools me-2"></i>Change Paired Hardware Tool
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Camera QR Scan to Equip Tool -->
                    <div class="card border-primary border-opacity-25 bg-primary bg-opacity-10 shadow-sm mb-3">
                        <div class="card-body p-3 text-center">
                            <button type="button" class="btn btn-primary w-100 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 btn-open-tool-scanner" data-target-modal="cockpit">
                                <i class="bi bi-camera-fill fs-5"></i>
                                <span>Scan Tool QR to Equip</span>
                            </button>
                            <div class="mt-2 pt-2 border-top border-primary border-opacity-25 d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1.5" id="btn-ble-connect" onclick="toggleBleWrenchConnection()" style="border-radius: 6px;">
                                    <i class="bi bi-bluetooth text-primary" id="ble-btn-icon"></i>
                                    <span id="ble-btn-text">Or Connect via Bluetooth</span>
                                </button>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.78rem;">
                                Point camera at QR code on Torque Wrench or Vernier Caliper to auto-select.
                            </div>
                            <div id="cockpitScanSuccessAlert" class="alert alert-success py-2 px-3 small mt-2 mb-0 d-none text-start border-success">
                                <i class="bi bi-check-circle-fill me-1 text-success"></i>
                                <span id="cockpitScanSuccessText"></span>
                            </div>
                        </div>
                    </div>

                    @{
                        var execLocks = ViewBag.DeviceLocks as Dictionary<int, string> ?? new Dictionary<int, string>();
                    }
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase d-inline-flex align-items-center gap-1"
                               title="Select your registered ESP32 wrench (e.g. ESP 01, esp 02)."
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               style="cursor: help;">
                            <i class="bi bi-wrench text-primary"></i>
                            <span>Select Torque Wrench</span>
                            <i class="bi bi-info-circle text-muted ms-1" style="font-size: 0.85em;"></i>
                        </label>
                        <select name="torqueDeviceId" id="execTorqueSelect" class="form-select">
                            <option value="">-- Select Torque Wrench --</option>
                            <option value="-1" selected="@(isManualToolMode && manualToolCode == "MANUAL-TORQUE")" data-online="true" data-manual="true" data-ble="false">Manual Torque Wrench (Non-Digital) • [Manual Mode]</option>
                            @if (ViewBag.AvailableTorqueDevices is IEnumerable<SmartTorque.Core.Entities.Device> tDevs)
                            {
                                foreach (var d in tDevs)
                                {
                                    var isThisActiveTool = !isManualToolMode && d.TransmitterId == Model.TorqueDeviceTransmitterId;
                                    var isLocked = !isThisActiveTool && execLocks.ContainsKey(d.DeviceId);
                                    var isOffline = !d.IsOnline;
                                    var isUnavailable = isLocked || isOffline;
                                    var lockText = isLocked ? $" • 🔒 [LOCKED by {execLocks[d.DeviceId]}]" : (isThisActiveTool && d.IsOnline ? " • [Currently Active]" : "");
                                    var statusText = d.IsOnline ? " • [Online]" : " • [Offline]";
                                    var isOverdue = d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                    var isDueSoon = !isOverdue && d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30);
                                    var calStatus = isOverdue ? "overdue" : (isDueSoon ? "due" : "");
                                    var calDue = d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "";
                                    var calText = isOverdue ? " • ⚠ OVERDUE since " + calDue : (isDueSoon ? " • ⚠ Cal due " + calDue : "");
                                    var optStyle = isUnavailable ? "color: #9ca3af; font-style: italic;" : (isOverdue ? "color: #dc3545; font-weight: 600;" : (isDueSoon ? "color: #d97706;" : ""));

                                    <option value="@d.DeviceId"
                                            selected="@(isThisActiveTool && d.IsOnline)"
                                            disabled="@(isUnavailable ? "disabled" : null)"
                                            class="@(isUnavailable ? "text-muted fst-italic" : (isOverdue ? "text-danger fw-bold" : (isDueSoon ? "text-warning" : "")))"
                                            style="@optStyle"
                                            data-online="@(d.IsOnline ? "true" : "false")"
                                            data-ble="@(d.IsBluetoothDevice ? "true" : "false")"
                                            data-cal-status="@calStatus"
                                            data-cal-due="@calDue">
                                        @d.Name (@d.TransmitterId)@statusText@lockText@calText
                                    </option>
                                }
                            }
                        </select>
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-3 d-none border-danger d-flex align-items-center" id="pairExecTorqueCalAlert" role="alert"></div>
                    </div>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1 my-0 text-muted" />
                        <span class="px-3 text-muted small fw-bold text-uppercase">OR</span>
                        <hr class="flex-grow-1 my-0 text-muted" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase d-inline-flex align-items-center gap-1"
                               title="Select your registered Vernier Caliper tool."
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               style="cursor: help;">
                            <i class="bi bi-rulers text-primary"></i>
                            <span>Select Vernier Caliper</span>
                            <i class="bi bi-info-circle text-muted ms-1" style="font-size: 0.85em;"></i>
                        </label>
                        <select name="vernierDeviceId" id="execVernierSelect" class="form-select">
                            <option value="">-- Select Vernier Caliper --</option>
                            <option value="-2" selected="@(isManualToolMode && manualToolCode == "MANUAL-VERNIER")" data-online="true" data-manual="true" data-ble="false">Manual Vernier Caliper (Non-Digital) • [Manual Mode]</option>
                            @if (ViewBag.AvailableVernierDevices is IEnumerable<SmartTorque.Core.Entities.Device> vDevs)
                            {
                                foreach (var d in vDevs)
                                {
                                    var isThisActiveTool = !isManualToolMode && d.TransmitterId == Model.VernierDeviceTransmitterId;
                                    var isLocked = !isThisActiveTool && execLocks.ContainsKey(d.DeviceId);
                                    var isOffline = !d.IsOnline;
                                    var isUnavailable = isLocked || isOffline;
                                    var lockText = isLocked ? $" • 🔒 [LOCKED by {execLocks[d.DeviceId]}]" : (isThisActiveTool && d.IsOnline ? " • [Currently Active]" : "");
                                    var statusText = d.IsOnline ? " • [Online]" : " • [Offline]";
                                    var isOverdue = d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                    var isDueSoon = !isOverdue && d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30);
                                    var calStatus = isOverdue ? "overdue" : (isDueSoon ? "due" : "");
                                    var calDue = d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "";
                                    var calText = isOverdue ? " • ⚠ OVERDUE since " + calDue : (isDueSoon ? " • ⚠ Cal due " + calDue : "");
                                    var optStyle = isUnavailable ? "color: #9ca3af; font-style: italic;" : (isOverdue ? "color: #dc3545; font-weight: 600;" : (isDueSoon ? "color: #d97706;" : ""));

                                    <option value="@d.DeviceId"
                                            selected="@(isThisActiveTool && d.IsOnline)"
                                            disabled="@(isUnavailable ? "disabled" : null)"
                                            class="@(isUnavailable ? "text-muted fst-italic" : (isOverdue ? "text-danger fw-bold" : (isDueSoon ? "text-warning" : "")))"
                                            style="@optStyle"
                                            data-online="@(d.IsOnline ? "true" : "false")"
                                            data-ble="@(d.IsBluetoothDevice ? "true" : "false")"
                                            data-cal-status="@calStatus"
                                            data-cal-due="@calDue">
                                        @d.Name (@d.TransmitterId)@statusText@lockText@calText
                                    </option>
                                }
                            }
                        </select>
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-3 d-none border-danger d-flex align-items-center" id="pairExecVernierCalAlert" role="alert"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-check2-circle me-1"></i>Pair & Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

