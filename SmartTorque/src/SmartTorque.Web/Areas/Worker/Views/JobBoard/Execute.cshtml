                        var rawImg = Model.CurrentComponent.ImagePath.Trim();
                        var componentImg = rawImg.StartsWith("~") ? Url.Content(rawImg) : (rawImg.StartsWith("/") ? rawImg : "/" + rawImg);
                        <div class="position-relative d-inline-block" style="line-height: 0;">
