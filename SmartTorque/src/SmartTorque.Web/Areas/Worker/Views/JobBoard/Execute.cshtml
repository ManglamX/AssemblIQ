                const isVernier = devName.includes('VERNIER') || devName.includes('CALIPER') || devName.includes('MITUTOYO') || devName.includes('UWAVE') || devName.includes('U-WAVE');
                const targetSel = isVernier ? execVernierSelect : execTorqueSelect;
                const otherSel = isVernier ? execTorqueSelect : execVernierSelect;

                if (otherSel) otherSel.value = "";
                if (targetSel) {
                    const opts = Array.from(targetSel.options).filter(o => o.value && parseInt(o.value, 10) > 0);
                    let match = opts.find(o => {
                        const txt = o.text.toUpperCase();
                        return (serial && txt.includes(serial)) || (devName && txt.includes(devName));
