                                    <div class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass modal-bp-marker"
                                         style="left: @(s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; width: 32px; height: 32px; font-size: 14px; transform: translate(-50%, -50%); cursor: pointer; z-index: 5;"
                                         title="@s.Label: @s.Target @unitSymbol"
