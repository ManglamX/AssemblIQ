                                    var isPass = s.IsCompleted;
                                    var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                    var modalPinSize = Math.Max(14, s.MarkerSize ?? 32);
                                    var modalPinFont = Math.Max(9, (int)(modalPinSize * 0.45m));
                                    var x1 = s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var y1 = s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                    if (s.MarkerX2.HasValue && s.MarkerY2.HasValue)
                                    {
                                        var x2 = s.MarkerX2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var y2 = s.MarkerY2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cx = ((s.MarkerX.Value + s.MarkerX2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                        var cy = ((s.MarkerY.Value + s.MarkerY2.Value) / 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                        <!-- Caliper Dimension Badge & Precision Osnap Grips -->
