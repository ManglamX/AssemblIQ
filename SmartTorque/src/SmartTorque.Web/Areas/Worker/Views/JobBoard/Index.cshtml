@model SmartTorque.Web.ViewModels.Worker.WorkerJobBoardViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Job Board";

    var activeState = ViewBag.ActiveExecutionState as SmartTorque.Services.ExecutionStateDto;
    var currentStep = activeState?.CurrentStep;
    var unitSymbol = currentStep?.Instrument == InstrumentType.Torque ? "N·m" : "mm";
    var activeDevice = currentStep?.Instrument == InstrumentType.Torque 
        ? (activeState?.TorqueDeviceTransmitterId ?? "SIM-TORQUE-01") 
        : (activeState?.VernierDeviceTransmitterId ?? "SIM-VERNIER-01");

    decimal minScale = 0;
    decimal maxScale = 100;
    decimal zoneLeft = 30;
    decimal zoneWidth = 40;

    if (currentStep != null)
    {
        var span = Math.Max(currentStep.UpperLimit - currentStep.LowerLimit, currentStep.Target * 0.2m);
        minScale = Math.Max(0, currentStep.LowerLimit - (span * 1.5m));
        maxScale = currentStep.UpperLimit + (span * 1.5m);
        if (maxScale <= minScale) maxScale = minScale + 10;

        zoneLeft = Math.Max(0, Math.Min(100, ((currentStep.LowerLimit - minScale) / (maxScale - minScale)) * 100));
        var right = Math.Max(0, Math.Min(100, ((currentStep.UpperLimit - minScale) / (maxScale - minScale)) * 100));
        zoneWidth = Math.Max(1, right - zoneLeft);
    }
}

<style>
/* Spotify-Style Track Rows */
.hover-track {
    transition: background-color 0.15s ease, border-color 0.15s ease;
}
.hover-track:hover {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
}
.hover-track:hover .track-num-label {
    display: none !important;
}
.hover-track:hover .track-play-hover {
    display: inline-block !important;
}
.active-playing-track {
    background-color: #f0fdf4 !important;
    border-color: #10b981 !important;
}
.playlist-tracks-container::-webkit-scrollbar {
    width: 6px;
}
.playlist-tracks-container::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
}
.priority-dot {
    box-shadow: 0 0 0 1px rgba(0,0,0,0.15);
}
@@keyframes pulse-ring {
    0% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7); }
    70% { transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 0 0 10px rgba(234, 88, 12, 0); }
    100% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
}
.marker-current {
    animation: pulse-ring 1.4s infinite !important;
    background-color: #ea580c !important;
    border: 2px solid #ffffff !important;
}
</style>

<div class="container-fluid px-3 py-2">
    <!-- Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Production Jobs</h1>
            <p class="text-muted small mb-0">Welcome, <strong>@Model.WorkerName</strong>. Select an assigned job or claim an open job.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="/dev/simulator" target="_blank" class="btn btn-outline-warning text-dark btn-sm fw-semibold" title="Launch Dev Hardware Simulator">
                <i class="bi bi-cpu me-1"></i>Hardware Simulator
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter })" class="btn btn-outline-secondary btn-sm" id="btn-refresh-jobs">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </a>
        </div>
    </div>

    <!-- Assembly Station & Workload Status Banner -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle @(Model.CurrentAssemblyLineId.HasValue ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning")">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold d-block">Current Assembly Station</span>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="h5 fw-bold mb-0 text-dark">
                            @Model.CurrentAssemblyCode — @Model.CurrentAssemblyName
                        </div>
                    }
                    else
                    {
                        <div class="h6 fw-bold mb-0 text-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>No Assembly Line Selected — Select Station to Receive Tasks
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="text-end">
                    <span class="text-muted small text-uppercase fw-semibold d-block">My Active Workload</span>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">
                        @Model.WorkerActiveWorkload.ToString("F1") pts
                    </span>
                    <span class="text-muted small ms-1">(@Model.MyJobsCount active tasks)</span>
                </div>

                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#switchAssemblyLineModal">
                    <i class="bi bi-arrow-left-right me-1"></i>@(Model.CurrentAssemblyLineId.HasValue ? "Switch Station" : "Select Station")
                </button>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Pills: My Jobs & Open to Claim -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "my-jobs", selectedJobId = ViewBag.SelectedJobId })"
               class="btn btn-sm @(Model.ActiveFilter == "my-jobs" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-person-check me-1"></i>My Jobs <span class="badge bg-light text-dark ms-1">@Model.MyJobsCount</span>
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "open", selectedJobId = ViewBag.SelectedJobId })"
               class="btn btn-sm @(Model.ActiveFilter == "open" ? "btn-success" : "btn-outline-secondary")">
                <i class="bi bi-box-arrow-in-right me-1"></i>Open to Claim <span class="badge bg-light text-dark ms-1">@Model.OpenCount</span>
            </a>
        </div>
        <div>
            @if (Model.CanClaimJobs)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-2.5">
                    <i class="bi bi-check-circle-fill me-1"></i>Eligible to Claim: Current Workload Completed
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle py-1.5 px-2.5" title="Complete your current assigned workload to unlock claiming">
                    <i class="bi bi-lock-fill me-1 text-warning"></i>Claiming Locked: @Model.IncompleteAssignedJobsCount Active Job(s) Pending in My Jobs
                </span>
            }
        </div>
    </div>

    @if (Model.ActiveFilter == "open" && !Model.CanClaimJobs)
    {
        <div class="alert alert-warning py-2.5 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
            <div>
                <strong>Claiming Locked:</strong> You currently have <strong>@Model.IncompleteAssignedJobsCount</strong> active workload task(s) assigned to you. You must complete your assigned workload before claiming a new job from the open pool.
            </div>
        </div>

    }



    <!-- Job Rows Search & Filter Toolbar -->
@if (Model.Jobs.Any())
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-2 d-flex flex-wrap align-items-center gap-2">
            <div class="position-relative flex-grow-1" style="min-width:220px;">
                <i class="bi bi-search position-absolute top-50 translate-middle-y ms-2 text-muted small"></i>
                <input type="text" id="job-search-input" class="form-control form-control-sm ps-4" placeholder="Search job no, product code or name..." autocomplete="off" />
            </div>
            <select id="filter-status" class="form-select form-select-sm w-auto" title="Filter by status">
                <option value="">Status: All</option>
                <option value="InProgress">In Progress</option>
                <option value="Assigned">Assigned</option>
                <option value="OnHold">On Hold</option>
                <option value="Pending">Open</option>
            </select>
            <select id="filter-priority" class="form-select form-select-sm w-auto" title="Filter by priority">
                <option value="">Priority: All</option>
                <option value="1">Black</option>
                <option value="2">Red</option>
                <option value="3">Yellow</option>
                <option value="4">Green</option>
                <option value="5">Blue</option>
            </select>
            <select id="filter-line" class="form-select form-select-sm w-auto" title="Filter by assembly line">
                <option value="">Line: All</option>
                @foreach (var line in Model.AvailableAssemblyLines)
                {
                    <option value="@line.AssemblyCode">@line.AssemblyCode</option>
                }
                <option value="UNMAPPED">Unmapped</option>
            </select>
            <button type="button" id="btn-filter-clear" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i>Clear
            </button>
            <span class="text-muted small ms-auto" id="job-row-count"></span>
        </div>
    </div>
}

<!-- Job Rows List -->

@if (!Model.Jobs.Any())
{
    <div class="text-center py-5 text-muted border rounded-3 bg-white my-3" id="job-board-empty">
        <i class="bi bi-clipboard-check" style="font-size: 3.5rem; color: #adb5bd;"></i>
        <h2 class="h5 mt-3 mb-1">No jobs match this filter</h2>
        <p class="mb-0">Jobs will appear here when imported from BM workbooks or assigned by supervisors.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-3" id="job-rows-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="job-rows-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:105px;">Priority</th>
                        <th>Job / Product</th>
                        <th style="width:95px;">Line</th>
                        <th style="width:120px;">Due</th>
                        <th style="width:90px;">Workload</th>
                        <th style="width:150px;">Units</th>
                        <th style="width:115px;">Status</th>
                        <th style="width:125px;">Assigned</th>
                        <th style="width:150px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        var priorityClass = job.Priority switch
                        {
                            SmartTorque.Core.Enums.PriorityLevel.Black => "priority-1",
                            SmartTorque.Core.Enums.PriorityLevel.Red => "priority-2",
                            SmartTorque.Core.Enums.PriorityLevel.Yellow => "priority-3",
                            SmartTorque.Core.Enums.PriorityLevel.Green => "priority-4",
                            _ => ""
                        };
                        var pct = job.Quantity > 0 ? (job.QuantityCompleted * 100) / job.Quantity : 0;
                        var isOverdue = job.DueDate.HasValue && job.DueDate.Value < DateOnly.FromDateTime(DateTime.Today);
                        <tr class="job-row @priorityClass"
                            data-detail-url="/Job/Detail/@job.JobId"
                            data-priority="@((int)job.Priority)"
                            data-status="@job.Status"
                            data-line="@(string.IsNullOrWhiteSpace(job.AssemblyCode) ? "UNMAPPED" : job.AssemblyCode)"
                            data-search="@((job.JobNo + " " + job.ProductCode + " " + job.ProductName).ToLower())">
                            <td>
                                <span class="d-inline-flex align-items-center gap-1 text-nowrap">
                                    <span class="job-row-dot" style="background-color:@job.PriorityHex;"></span>
                                    <span class="small fw-semibold">@job.PriorityLabel</span>
                                </span>
                            </td>
                            <td>
                                <a href="/Job/Detail/@job.JobId" class="fw-bold text-decoration-none text-dark">@job.JobNo</a>
                                <div class="text-muted small"><strong>@job.ProductCode</strong> — @job.ProductName</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(job.AssemblyCode))
                                {
                                    <span class="badge bg-light text-dark border fw-semibold small">@job.AssemblyCode</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted small">Unmapped</span>
                                }
                            </td>
                            <td>
                                <span class="small text-nowrap @(isOverdue ? "text-danger fw-bold" : "fw-semibold")">
                                    <i class="bi bi-calendar-event me-1"></i>@(job.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                </span>
                                @if (isOverdue)
                                {
                                    <i class="bi bi-exclamation-circle-fill text-danger ms-1" title="Overdue"></i>
                                }
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary fw-bold small">@job.EstimatedWorkload.ToString("F1") pts</span></td>
                            <td>
                                <div class="d-flex small text-muted mb-1"><span>@job.QuantityCompleted / @job.Quantity</span></div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width:@pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                            <td>
                                @if (job.Status == SmartTorque.Core.Enums.JobStatus.InProgress)
                                {
                                    <span class="badge bg-warning text-dark small"><i class="bi bi-play-circle-fill me-1"></i>In Progress</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Assigned)
                                {
                                    <span class="badge bg-info text-dark small"><i class="bi bi-person-badge me-1"></i>Assigned</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Pending)
                                {
                                    <span class="badge bg-secondary small"><i class="bi bi-clock me-1"></i>Open</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                                {
                                    <span class="badge bg-danger small"><i class="bi bi-pause-circle me-1"></i>On Hold</span>
                                }
                            </td>
                            <td>
                                @if (job.IsAssignedToCurrentWorker)
                                {
                                    <span class="text-success small fw-semibold text-nowrap"><i class="bi bi-check-circle-fill me-1"></i>You</span>
                                }
                                else if (!string.IsNullOrEmpty(job.AssignedWorkerName))
                                {
                                    <span class="text-muted small text-nowrap"><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</span>
                                }
                                else
                                {
                                    <span class="text-primary small fw-semibold text-nowrap"><i class="bi bi-unlock me-1"></i>Unassigned</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (job.CanResume)
                                {
                                    <button type="button" class="btn btn-warning btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-play-circle-fill"></i> Resume
                                    </button>
                                }
                                else if (job.IsOpen)
                                {
                                    @if (Model.CanClaimJobs)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm fw-bold"
                                                data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                                data-job-id="@job.JobId"
                                                data-job-no="@job.JobNo"
                                                data-product="@job.ProductCode - @job.ProductName"
                                                data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                            <i class="bi bi-box-arrow-in-right"></i> Claim &amp; Start
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm disabled" disabled
                                                title="Complete your currently assigned workload before claiming new jobs">
                                            <i class="bi bi-lock-fill"></i> Claim Locked
                                        </button>
                                    }
                                }
                                else if (job.CanStart)
                                {
                                    <button type="button" class="btn btn-primary btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-wrench"></i> Start Assembly
                                    </button>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                                {
                                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-play-fill"></i> From Hold
                                    </button>
                                }
                                else
                                {
                                    <a href="/Job/Detail/@job.JobId" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3 d-none" id="job-rows-nomatch">
        <div class="card-body text-center py-4 text-muted">
            <i class="bi bi-funnel fs-2"></i>
            <h2 class="h6 mt-2 mb-1">No jobs match your search or filters</h2>
            <p class="mb-0 small">Adjust or clear the filters above to see all jobs.</p>
        </div>
    </div>
}

</div>

<!-- Tool Pairing Modal -->
<div class="modal fade" id="toolPairingModal" tabindex="-1" aria-labelledby="toolPairingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="toolPairingForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="toolPairingModalLabel">
                        <i class="bi bi-tools me-2"></i>Tool Pairing Setup
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle text-primary fs-5"></i>
                        <div class="small">
                            Job: <strong id="modalJobNo"></strong><br />
                            <span id="modalProduct" class="text-muted"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-upc-scan text-primary me-1"></i>Product Unit (40-char PRD Token)
                        </label>
                        <select name="unitNo" id="modalUnitSelect" class="form-select">
                            <option value="">-- Loading product units... --</option>
                        </select>
                        <div class="form-text small">Select the specific product unit to assemble from this job order.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-wrench text-primary me-1"></i>Torque Wrench (ESP32 / Calibrated Tool)
                        </label>
                        <select name="torqueDeviceId" id="modalTorqueSelect" class="form-select">
                            <option value="">-- Use Default / Any Connected Torque Wrench --</option>
                            @if (ViewBag.AvailableTorqueDevices is IEnumerable<SmartTorque.Core.Entities.Device> tDevices)
                            {
                                foreach (var d in tDevices)
                                {

                                    <option value="@d.DeviceId" data-cal-status="@(d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? "overdue" : (d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30) ? "due" : ""))" data-cal-due="@(d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "")">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")@(d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? " • ⚠ OVERDUE since " + d.CalibrationDue.Value.ToString("yyyy-MM-dd") : (d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30) ? " • ⚠ Cal due " + d.CalibrationDue.Value.ToString("yyyy-MM-dd") : ""))</option>

                                }
                            }
                        </select>
                        <div class="form-text small">Select your registered ESP32 wrench (e.g. ESP 01, SIM-TORQUE-01).</div>

                                                <div class="alert alert-warning py-2 px-3 small mb-3 d-none" id="pairToolTorqueCalAlert" role="alert"></div>

                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-rulers text-primary me-1"></i>Vernier Caliper (Optional)
                        </label>
                        <select name="vernierDeviceId" id="modalVernierSelect" class="form-select">
                            <option value="">-- Use Default / None --</option>
                            @if (ViewBag.AvailableVernierDevices is IEnumerable<SmartTorque.Core.Entities.Device> vDevices)
                            {
                                foreach (var d in vDevices)
                                {

                                    <option value="@d.DeviceId" data-cal-status="@(d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? "overdue" : (d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30) ? "due" : ""))" data-cal-due="@(d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "")">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")@(d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow) ? " • ⚠ OVERDUE since " + d.CalibrationDue.Value.ToString("yyyy-MM-dd") : (d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30) ? " • ⚠ Cal due " + d.CalibrationDue.Value.ToString("yyyy-MM-dd") : ""))</option>

                                }
                            }
                        </select>

                    <div class="alert alert-warning py-2 px-3 small mb-3 d-none" id="pairToolVernierCalAlert" role="alert"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-play-circle-fill me-1"></i>Confirm & Start Assembly
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Switch Assembly Line Modal -->
<div class="modal fade" id="switchAssemblyLineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SetAssemblyLine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Select Assembly Line Station</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Select the physical assembly line station you are currently operating. The system will route tasks designated for this line to your queue.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Assembly Line</label>
                        <select name="assemblyLineId" class="form-select" required>
                            <option value="">— Select an active assembly line —</option>
                            @foreach (var line in Model.AvailableAssemblyLines)
                            {
                                <option value="@line.AssemblyLineId" selected="@(line.AssemblyLineId == Model.CurrentAssemblyLineId)">
                                    @line.AssemblyCode — @line.AssemblyName (@line.Department)
                                </option>
                            }
                        </select>
                    </div>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Switching stations persists across your sessions. Tasks currently in-progress should be completed or placed on hold before switching stations.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Confirm Station Switch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>


        // ----- Calibration warnings while selecting a device (informational) -----
        function updatePairCalAlert(selectEl, alertElId) {
            var alertEl = document.getElementById(alertElId);
            if (!selectEl || !alertEl) return;
            var opt = selectEl.options[selectEl.selectedIndex];
            var status = opt ? (opt.getAttribute("data-cal-status") || "") : "";
            var due = opt ? (opt.getAttribute("data-cal-due") || "") : "";
            if (!status) {
                alertEl.classList.add("d-none");
                alertEl.innerHTML = "";
                return;
            }
            if (status === "overdue") {
                alertEl.className = "alert alert-danger py-2 px-3 small mb-3";
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Calibration overdue since ' + due + '.</strong> You can still use this device today, but recalibration is strongly recommended.';
            } else {
                alertEl.className = "alert alert-warning py-2 px-3 small mb-3";
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i><strong>Calibration due on ' + due + ' (within 30 days).</strong> The device may still be used normally.';
            }
            alertEl.classList.remove("d-none");
        }
        function syncToolPairCalAlerts() {
            updatePairCalAlert(document.getElementById("modalTorqueSelect"), "pairToolTorqueCalAlert");
            updatePairCalAlert(document.getElementById("modalVernierSelect"), "pairToolVernierCalAlert");
        }
        ["modalTorqueSelect", "modalVernierSelect"].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener("change", syncToolPairCalAlerts);
        });
        var toolPairAlertModal = document.getElementById("toolPairingModal");
        if (toolPairAlertModal) toolPairAlertModal.addEventListener("shown.bs.modal", syncToolPairCalAlerts);

        const toolModal = document.getElementById('toolPairingModal');
        if (toolModal) {
            toolModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const jobId = button.getAttribute('data-job-id') || '';
                const jobNo = button.getAttribute('data-job-no') || '';
                const product = button.getAttribute('data-product') || '';
                const startUrl = button.getAttribute('data-start-url') || '';
                
                document.getElementById('modalJobNo').textContent = jobNo;
                document.getElementById('modalProduct').textContent = product;
                document.getElementById('toolPairingForm').setAttribute('action', startUrl);

                const unitSelect = document.getElementById('modalUnitSelect');
                if (unitSelect && jobId) {
                    unitSelect.innerHTML = '<option value="">Loading units...</option>';
                    fetch(`/Worker/JobBoard/Units/${jobId}`)
                        .then(r => r.json())
                        .then(units => {
                            unitSelect.innerHTML = '';
                            if (!units || units.length === 0) {
                                unitSelect.innerHTML = '<option value="1">Unit #1 (Auto-generated)</option>';
                                return;
                            }
                            let selected = false;
                            units.forEach(u => {
                                const opt = document.createElement('option');
                                opt.value = u.unitIndex;
                                const isDone = u.status === 'Completed';
                                const isFail = u.status === 'Failed';
                                const badge = isDone ? ' [✓ Done]' : (isFail ? ' [⚠ Failed/Rework]' : ' [Pending]');
                                opt.textContent = `Unit #${u.unitIndex}: ${u.tokenNo}${badge}`;
                                if (!selected && !isDone) {
                                    opt.selected = true;
                                    selected = true;
                                }
                                unitSelect.appendChild(opt);
                            });
                            if (!selected && units.length > 0) {
                                unitSelect.options[0].selected = true;
                            }
                        })
                        .catch(() => {
                            unitSelect.innerHTML = '<option value="">-- Auto-select Next Unit --</option>';
                        });
                }
            });
        }

        @if (activeState != null && currentStep != null)
        {
            <text>
            const sessionId = @activeState.SessionId;
            const jobId = @activeState.JobId;
            const minScale = @minScale.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const maxScale = @maxScale.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const lowerLimit = @currentStep.LowerLimit.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const upperLimit = @currentStep.UpperLimit.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const targetVal = @currentStep.Target.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const instrumentType = @((int)currentStep.Instrument);
            const unitSymbol = "@unitSymbol";

            function updateGaugeNeedle(val) {
                const clamped = Math.max(minScale, Math.min(maxScale, val));
                const range = maxScale - minScale;
                const pct = range > 0 ? ((clamped - minScale) / range) * 100 : 50;
                const needle = document.getElementById("gauge-needle");
                if (needle) {
                    needle.style.left = pct + "%";
                }

                const readingNum = document.getElementById("reading-num");
                if (readingNum) {
                    readingNum.textContent = Number(val).toFixed(2);
                }
            }

            function handleReadingResult(res) {
                updateGaugeNeedle(res.actualValue);

                const banner = document.getElementById("result-banner");
                const bannerText = document.getElementById("banner-text");

                if (banner && bannerText) {
                    banner.classList.remove("d-none", "alert-success", "alert-danger");
                    if (res.isStepPassed) {
                        banner.classList.add("alert-success");
                        bannerText.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>PASS — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    } else {
                        banner.classList.add("alert-danger");
                        bannerText.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>FAIL (Attempt ' + res.attemptNo + ') — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                    }
                }

                if (res.isSessionCompleted || res.isStepPassed || (res.nextStepSequence && res.nextStepSequence !== @currentStep.SequenceNo)) {
                    setTimeout(function () {
                        window.location.reload();
                    }, 850);
                }
            }

            async function sendSimulated(val) {
                updateGaugeNeedle(val);

                const payload = {
                    SessionId: sessionId,
                    Value: val,
                    InstrumentType: instrumentType,
                    CapturedAt: new Date().toISOString()
                };

                try {
                    const response = await fetch('/Worker/JobBoard/SubmitReading', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const data = await response.json();
                        handleReadingResult(data);
                    }
                } catch (ex) {
                    console.error("Submission error:", ex);
                }
            }

            function sendCustomSimulated() {
                const inp = document.getElementById("custom-sim-val");
                if (!inp || !inp.value) return;
                const val = parseFloat(inp.value);
                if (isNaN(val)) return;
                sendSimulated(val);
            }

            async function submitFailedBolt() {
                if (!confirm("Record defect for this bolt and advance to the next step?")) {
                    return;
                }

                const currentNum = parseFloat(document.getElementById("reading-num")?.textContent) || (targetVal || 0);

                const payload = {
                    SessionId: sessionId,
                    Value: isNaN(currentNum) ? 0 : currentNum,
                    InstrumentType: instrumentType,
                    ForceFail: true,
                    ReasonCode: "OPERATOR_FORCE_FAIL",
                    CapturedAt: new Date().toISOString()
                };

                try {
                    const response = await fetch('/Worker/JobBoard/SubmitReading', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const data = await response.json();
                        handleReadingResult(data);
                    }
                } catch (ex) {
                    console.error("Failed bolt submission error:", ex);
                }
            }

            if (typeof signalR !== 'undefined') {
                const liveConn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/live")
                    .withAutomaticReconnect()
                    .build();

                liveConn.on("LiveReading", function (data) {
                    updateGaugeNeedle(data.actualValue);
                });

                liveConn.on("ReadingProcessed", function (data) {
                    handleReadingResult(data);
                });

                liveConn.start().then(function () {
                    liveConn.invoke("JoinSession", sessionId);
                    liveConn.invoke("JoinJob", jobId);
                    liveConn.invoke("JoinWorkers");
                }).catch(function (err) {
                    console.warn("SignalR error:", err);
                });
            }
            </text>
        }
        else
        {
            <text>
            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/live")
                    .withAutomaticReconnect()
                    .build();

            connection.start().then(function () {

                connection.invoke("JoinWorkers");

            }).catch(function (err) {

                console.warn("SignalR connection error:", err);

            });

        }


        // ---------------------------------------------------------------
        // Job rows: live search + status/priority/line filters (client-side)
        // ---------------------------------------------------------------

        function applyJobFilters() {
            var searchInput = document.getElementById("job-search-input");
            var statusSel = document.getElementById("filter-status");
            var prioSel = document.getElementById("filter-priority");
            var lineSel = document.getElementById("filter-line");
            if (!searchInput || !statusSel || !prioSel || !lineSel) return;

            var q = (searchInput.value || "").trim().toLowerCase();
            var st = statusSel.value;
            var pr = prioSel.value;
            var ln = lineSel.value;

            var rows = document.querySelectorAll("#job-rows-table tr.job-row");
            var visible = 0;
            for (var i = 0; i < rows.length; i++) {
                var tr = rows[i];
                var ok = true;
                if (st && tr.getAttribute("data-status") !== st) ok = false;
                if (ok && pr && tr.getAttribute("data-priority") !== pr) ok = false;
                if (ok && ln && tr.getAttribute("data-line") !== ln) ok = false;
                if (ok && q) {
                    var hay = tr.getAttribute("data-search") || "";
                    if (hay.indexOf(q) === -1) ok = false;
                }
                tr.classList.toggle("d-none", !ok);
                if (ok) visible++;
            }

            var countEl = document.getElementById("job-row-count");
            if (countEl) countEl.textContent = "Showing " + visible + " of " + rows.length + " job(s)";

            var nomatch = document.getElementById("job-rows-nomatch");
            if (nomatch) nomatch.classList.toggle("d-none", visible !== 0);

            var wrap = document.getElementById("job-rows-table-wrap");
            if (wrap) wrap.classList.toggle("d-none", visible === 0);
        }

        ["job-search-input", "filter-status", "filter-priority", "filter-line"].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener(el.tagName === "SELECT" ? "change" : "input", applyJobFilters);
        });

        var btnFilterClear = document.getElementById("btn-filter-clear");
        if (btnFilterClear) {
            btnFilterClear.addEventListener("click", function () {
                var s = document.getElementById("job-search-input");
                if (s) s.value = "";
                ["filter-status", "filter-priority", "filter-line"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = "";
                });
                applyJobFilters();
            });
        }

        // Clicking a row (outside its buttons/links) resumes/claims the job
        // via its tool-pairing button; details links stay on <a> elements
        // (/Job/Detail is Admin-only, so workers never get navigated there).
        (function () {
            var table = document.getElementById("job-rows-table");
            if (!table) return;
            table.addEventListener("click", function (e) {
                if (e.target.closest("a,button,select,input,label")) return;
                var tr = e.target.closest("tr.job-row");
                if (!tr) return;
                var actionBtn = tr.querySelector("button[data-bs-target='#toolPairingModal']");
                if (actionBtn) {
                    actionBtn.click();
                    return;
                }
                var href = tr.getAttribute("data-detail-url");
                if (href) window.location = href;
            });
        })();

        applyJobFilters();

    </script>
}
