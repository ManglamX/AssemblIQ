@model SmartTorque.Web.ViewModels.Worker.WorkerJobBoardViewModel
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Job Board";
}

<div class="container-fluid px-3 py-2">
    <!-- Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Production Jobs</h1>
            <p class="text-muted small mb-0">Welcome, <strong>@Model.WorkerName</strong>. Select an assigned job or claim an open job.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="/dev/simulator" target="_blank" class="btn btn-outline-warning text-dark btn-sm fw-semibold" title="Launch Dev Hardware Simulator">
                <i class="bi bi-cpu me-1"></i>Hardware Simulator
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter })" class="btn btn-outline-secondary btn-sm" id="btn-refresh-jobs">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </a>
        </div>
    </div>

    <!-- Assembly Station & Workload Status Banner -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle @(Model.CurrentAssemblyLineId.HasValue ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning")">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold d-block">Current Assembly Station</span>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="h5 fw-bold mb-0 text-dark">
                            @Model.CurrentAssemblyCode — @Model.CurrentAssemblyName
                        </div>
                    }
                    else
                    {
                        <div class="h6 fw-bold mb-0 text-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>No Assembly Line Selected — Select Station to Receive Tasks
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="text-end">
                    <span class="text-muted small text-uppercase fw-semibold d-block">My Active Workload</span>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">
                        @Model.WorkerActiveWorkload.ToString("F1") pts
                    </span>
                    <span class="text-muted small ms-1">(@Model.MyJobsCount active tasks)</span>
                </div>

                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#switchAssemblyLineModal">
                    <i class="bi bi-arrow-left-right me-1"></i>@(Model.CurrentAssemblyLineId.HasValue ? "Switch Station" : "Select Station")
                </button>
            </div>
        </div>
    </div>

    <!-- Real-Time Black Job Alert Banner (Populated via SignalR) -->
    <div id="live-black-job-alert" class="alert alert-danger d-none d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm border-start border-5 border-dark animate__animated animate__headShake" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-3 text-danger"></i>
            <div>
                <strong class="text-uppercase text-danger d-block">Urgent Black Priority Job Dispatched!</strong>
                <div id="black-alert-message" class="small">A critical job has been imported and requires immediate production.</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "black" })" class="btn btn-dark btn-sm fw-bold">
                <i class="bi bi-arrow-right-circle me-1"></i>View Black Jobs
            </a>
            <button type="button" class="btn-close" onclick="document.getElementById('live-black-job-alert').classList.add('d-none');"></button>
        </div>
    </div>

    <!-- Active Black Jobs Notice if any exist on the floor -->
    @if (Model.BlackCount > 0)
    {
        <div class="alert alert-dark d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm border-start border-5 border-black" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-4 text-warning"></i>
                <div>
                    <strong class="text-uppercase text-white">Attention: @Model.BlackCount Urgent Black Priority Job@(Model.BlackCount > 1 ? "s" : "") on Board!</strong>
                    <div class="small text-light">These critical jobs take highest precedence according to plant priority rules.</div>
                </div>
            </div>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "black" })" class="btn btn-danger btn-sm fw-bold">
                <i class="bi bi-lightning-fill me-1"></i>View Urgent Jobs (@Model.BlackCount)
            </a>
        </div>
    }

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "all" })"
           class="btn btn-sm @(Model.ActiveFilter == "all" ? "btn-dark" : "btn-outline-secondary")">
            All Jobs <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
        </a>
        <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "my-jobs" })"
           class="btn btn-sm @(Model.ActiveFilter == "my-jobs" ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-person-check me-1"></i>My Jobs <span class="badge bg-light text-dark ms-1">@Model.MyJobsCount</span>
        </a>
        <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "black" })"
           class="btn btn-sm @(Model.ActiveFilter == "black" ? "btn-danger" : "btn-outline-danger")">
            <i class="bi bi-exclamation-octagon-fill me-1"></i>Urgent (Black) <span class="badge bg-dark ms-1">@Model.BlackCount</span>
        </a>
        <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "open" })"
           class="btn btn-sm @(Model.ActiveFilter == "open" ? "btn-success" : "btn-outline-secondary")">
            <i class="bi bi-box-arrow-in-right me-1"></i>Open to Claim <span class="badge bg-light text-dark ms-1">@Model.OpenCount</span>
        </a>
    </div>

    <!-- Job Cards List -->
    @if (!Model.Jobs.Any())
    {
        <div class="text-center py-5 text-muted border rounded-3 bg-white my-3" id="job-board-empty">
            <i class="bi bi-clipboard-check" style="font-size: 3.5rem; color: #adb5bd;"></i>
            <h2 class="h5 mt-3 mb-1">No jobs match this filter</h2>
            <p class="mb-0">Jobs will appear here when imported from BM workbooks or assigned by supervisors.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var job in Model.Jobs)
            {
                var priorityClass = job.Priority switch
                {
                    SmartTorque.Core.Enums.PriorityLevel.Black => "priority-1",
                    SmartTorque.Core.Enums.PriorityLevel.Red => "priority-2",
                    SmartTorque.Core.Enums.PriorityLevel.Yellow => "priority-3",
                    SmartTorque.Core.Enums.PriorityLevel.Green => "priority-4",
                    _ => ""
                };

                <div class="col-12 col-lg-6 col-xl-4">
                    <div class="job-card @priorityClass h-100 d-flex flex-column justify-content-between p-3 border rounded-3 bg-white shadow-sm position-relative">
                        <div>
                            <!-- Header Row: Priority Badge & Status -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge text-uppercase" style="background-color: @job.PriorityHex; color: @(job.Priority == SmartTorque.Core.Enums.PriorityLevel.Black || job.Priority == SmartTorque.Core.Enums.PriorityLevel.Red || job.Priority == SmartTorque.Core.Enums.PriorityLevel.Blue ? "#ffffff" : "#000000");">
                                    @job.PriorityLabel Priority
                                </span>

                                @if (job.Status == SmartTorque.Core.Enums.JobStatus.InProgress)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-play-circle-fill me-1"></i>In Progress</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Assigned)
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-person-badge me-1"></i>Assigned</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Pending)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>Open</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-pause-circle me-1"></i>On Hold</span>
                                }
                            </div>

                            <!-- Job Number & Product Name -->
                            <h2 class="h5 fw-bold mb-1">
                                <a href="/Job/Detail/@job.JobId" class="text-decoration-none text-dark">
                                    @job.JobNo
                                </a>
                            </h2>
                            <div class="text-muted small mb-2">
                                <strong>@job.ProductCode</strong> — @job.ProductName
                            </div>

                            <!-- Assembly Line & Estimated Workload -->
                            <div class="d-flex justify-content-between align-items-center py-1 px-3 bg-white border rounded-2 mb-2 small">
                                <div>
                                    <span class="text-muted"><i class="bi bi-diagram-3 me-1"></i>Line:</span>
                                    @if (!string.IsNullOrWhiteSpace(job.AssemblyCode))
                                    {
                                        <span class="badge bg-light text-dark border fw-semibold">@job.AssemblyCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted">Unmapped</span>
                                    }
                                </div>
                                <div>
                                    <span class="text-muted"><i class="bi bi-speedometer2 me-1"></i>Workload:</span>
                                    <span class="badge bg-primary-subtle text-primary fw-bold">@job.EstimatedWorkload.ToString("F1") pts</span>
                                </div>
                            </div>

                            <!-- Due Date & Assignment Details -->
                            <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light rounded-2 mb-3 small">
                                <div>
                                    <span class="text-muted"><i class="bi bi-calendar-event me-1"></i>Due:</span>
                                    <span class="fw-semibold">@(job.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</span>
                                </div>
                                <div>
                                    @if (job.IsAssignedToCurrentWorker)
                                    {
                                        <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Assigned to You</span>
                                    }
                                    else if (!string.IsNullOrEmpty(job.AssignedWorkerName))
                                    {
                                        <span class="text-muted"><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</span>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-semibold"><i class="bi bi-unlock me-1"></i>Unassigned</span>
                                    }
                                </div>
                            </div>

                            <!-- Units Completion Progress -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Units Produced</span>
                                    <span class="fw-bold text-dark">@job.QuantityCompleted / @job.Quantity</span>
                                </div>
                                @{
                                    var pct = job.Quantity > 0 ? (job.QuantityCompleted * 100) / job.Quantity : 0;
                                }
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Button Bottom Row -->
                        <div class="pt-2 border-top mt-2">
                            @if (job.CanResume)
                            {
                                <button type="button" class="btn btn-warning w-100 py-2 fw-bold d-flex justify-content-center align-items-center gap-2"
                                        data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                        data-job-id="@job.JobId"
                                        data-job-no="@job.JobNo"
                                        data-product="@job.ProductCode - @job.ProductName"
                                        data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                    <i class="bi bi-play-circle-fill fs-5"></i> Resume Assembly
                                </button>
                            }
                            else if (job.CanStart)
                            {
                                <button type="button" class="btn @(job.IsOpen ? "btn-outline-primary" : "btn-primary") w-100 py-2 fw-bold d-flex justify-content-center align-items-center gap-2"
                                        data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                        data-job-id="@job.JobId"
                                        data-job-no="@job.JobNo"
                                        data-product="@job.ProductCode - @job.ProductName"
                                        data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                    <i class="bi @(job.IsOpen ? "bi-box-arrow-in-right" : "bi-wrench") fs-5"></i>
                                    @(job.IsOpen ? "Claim & Start Job" : "Start Assembly")
                                </button>
                            }
                            else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                            {
                                <button type="button" class="btn btn-outline-warning w-100 py-2 fw-bold"
                                        data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                        data-job-id="@job.JobId"
                                        data-job-no="@job.JobNo"
                                        data-product="@job.ProductCode - @job.ProductName"
                                        data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                    <i class="bi bi-play-fill me-1"></i> Resume From Hold
                                </button>
                            }
                            else
                            {
                                <a href="/Job/Detail/@job.JobId" class="btn btn-secondary w-100 py-2">
                                    <i class="bi bi-info-circle me-1"></i> View Details
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Tool Pairing Modal -->
<div class="modal fade" id="toolPairingModal" tabindex="-1" aria-labelledby="toolPairingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="toolPairingForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="toolPairingModalLabel">
                        <i class="bi bi-tools me-2"></i>Tool Pairing Setup
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle text-primary fs-5"></i>
                        <div class="small">
                            Job: <strong id="modalJobNo"></strong><br />
                            <span id="modalProduct" class="text-muted"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-upc-scan text-primary me-1"></i>Product Unit (40-char PRD Token)
                        </label>
                        <select name="unitNo" id="modalUnitSelect" class="form-select">
                            <option value="">-- Loading product units... --</option>
                        </select>
                        <div class="form-text small">Select the specific product unit to assemble from this job order.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-wrench text-primary me-1"></i>Torque Wrench (ESP32 / Calibrated Tool)
                        </label>
                        <select name="torqueDeviceId" id="modalTorqueSelect" class="form-select">
                            <option value="">-- Use Default / Any Connected Torque Wrench --</option>
                            @if (ViewBag.AvailableTorqueDevices is IEnumerable<SmartTorque.Core.Entities.Device> tDevices)
                            {
                                foreach (var d in tDevices)
                                {
                                    <option value="@d.DeviceId">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")</option>
                                }
                            }
                        </select>
                        <div class="form-text small">Select your registered ESP32 wrench (e.g. ESP 01, SIM-TORQUE-01).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-rulers text-primary me-1"></i>Vernier Caliper (Optional)
                        </label>
                        <select name="vernierDeviceId" id="modalVernierSelect" class="form-select">
                            <option value="">-- Use Default / None --</option>
                            @if (ViewBag.AvailableVernierDevices is IEnumerable<SmartTorque.Core.Entities.Device> vDevices)
                            {
                                foreach (var d in vDevices)
                                {
                                    <option value="@d.DeviceId">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-play-circle-fill me-1"></i>Confirm & Start Assembly
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Switch Assembly Line Modal -->
<div class="modal fade" id="switchAssemblyLineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SetAssemblyLine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Select Assembly Line Station</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Select the physical assembly line station you are currently operating. The system will route tasks designated for this line to your queue.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Assembly Line</label>
                        <select name="assemblyLineId" class="form-select" required>
                            <option value="">— Select an active assembly line —</option>
                            @foreach (var line in Model.AvailableAssemblyLines)
                            {
                                <option value="@line.AssemblyLineId" selected="@(line.AssemblyLineId == Model.CurrentAssemblyLineId)">
                                    @line.AssemblyCode — @line.AssemblyName (@line.Department)
                                </option>
                            }
                        </select>
                    </div>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Switching stations persists across your sessions. Tasks currently in-progress should be completed or placed on hold before switching stations.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Confirm Station Switch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const toolModal = document.getElementById('toolPairingModal');
        if (toolModal) {
            toolModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const jobId = button.getAttribute('data-job-id') || '';
                const jobNo = button.getAttribute('data-job-no') || '';
                const product = button.getAttribute('data-product') || '';
                const startUrl = button.getAttribute('data-start-url') || '';
                
                document.getElementById('modalJobNo').textContent = jobNo;
                document.getElementById('modalProduct').textContent = product;
                document.getElementById('toolPairingForm').setAttribute('action', startUrl);

                const unitSelect = document.getElementById('modalUnitSelect');
                if (unitSelect && jobId) {
                    unitSelect.innerHTML = '<option value="">Loading units...</option>';
                    fetch(`/Worker/JobBoard/Units/${jobId}`)
                        .then(r => r.json())
                        .then(units => {
                            unitSelect.innerHTML = '';
                            if (!units || units.length === 0) {
                                unitSelect.innerHTML = '<option value="1">Unit #1 (Auto-generated)</option>';
                                return;
                            }
                            let selected = false;
                            units.forEach(u => {
                                const opt = document.createElement('option');
                                opt.value = u.unitIndex;
                                const isDone = u.status === 'Completed';
                                const isFail = u.status === 'Failed';
                                const badge = isDone ? ' [✓ Done]' : (isFail ? ' [⚠ Failed/Rework]' : ' [Pending]');
                                opt.textContent = `Unit #${u.unitIndex}: ${u.tokenNo}${badge}`;
                                if (!selected && !isDone) {
                                    opt.selected = true;
                                    selected = true;
                                }
                                unitSelect.appendChild(opt);
                            });
                            if (!selected && units.length > 0) {
                                unitSelect.options[0].selected = true;
                            }
                        })
                        .catch(() => {
                            unitSelect.innerHTML = '<option value="">-- Auto-select Next Unit --</option>';
                        });
                }
            });
        }

        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            connection.on("BlackJobAlert", function (data) {
                console.log("BlackJobAlert received via SignalR:", data);
                const alertBox = document.getElementById("live-black-job-alert");
                const alertMsg = document.getElementById("black-alert-message");
                if (alertBox) {
                    if (data && data.message) alertMsg.textContent = data.message;
                    alertBox.classList.remove("d-none");
                }
            });

            connection.start().then(function () {
                connection.invoke("JoinWorkers");
            }).catch(function (err) {
                console.warn("SignalR connection error:", err);
            });
        }
    </script>
}
