@model SmartTorque.Web.ViewModels.Worker.WorkerJobBoardViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Job Board";

    var activeState = ViewBag.ActiveExecutionState as SmartTorque.Services.ExecutionStateDto;
    var currentStep = activeState?.CurrentStep;
    var unitSymbol = currentStep?.Instrument == InstrumentType.Torque ? "N·m" : "mm";
    var activeDevice = currentStep?.Instrument == InstrumentType.Torque 
        ? (activeState?.TorqueDeviceTransmitterId ?? "SIM-TORQUE-01") 
        : (activeState?.VernierDeviceTransmitterId ?? "SIM-VERNIER-01");

    decimal minScale = 0;
    decimal maxScale = 100;
    decimal zoneLeft = 30;
    decimal zoneWidth = 40;

    if (currentStep != null)
    {
        var span = Math.Max(currentStep.UpperLimit - currentStep.LowerLimit, currentStep.Target * 0.2m);
        minScale = Math.Max(0, currentStep.LowerLimit - (span * 1.5m));
        maxScale = currentStep.UpperLimit + (span * 1.5m);
        if (maxScale <= minScale) maxScale = minScale + 10;

        zoneLeft = Math.Max(0, Math.Min(100, ((currentStep.LowerLimit - minScale) / (maxScale - minScale)) * 100));
        var right = Math.Max(0, Math.Min(100, ((currentStep.UpperLimit - minScale) / (maxScale - minScale)) * 100));
        zoneWidth = Math.Max(1, right - zoneLeft);
    }
}

<style>
/* Spotify-Style Track Rows */
.hover-track {
    transition: background-color 0.15s ease, border-color 0.15s ease;
}
.hover-track:hover {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
}
.hover-track:hover .track-num-label {
    display: none !important;
}
.hover-track:hover .track-play-hover {
    display: inline-block !important;
}
.active-playing-track {
    background-color: #f0fdf4 !important;
    border-color: #10b981 !important;
}
.playlist-tracks-container::-webkit-scrollbar {
    width: 6px;
}
.playlist-tracks-container::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
}
.priority-dot {
    box-shadow: 0 0 0 1px rgba(0,0,0,0.15);
}
@@keyframes pulse-ring {
    0% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7); }
    70% { transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 0 0 10px rgba(234, 88, 12, 0); }
    100% { transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
}
.marker-current {
    animation: pulse-ring 1.4s infinite !important;
    background-color: #ea580c !important;
    border: 2px solid #ffffff !important;
}
</style>

<div class="container-fluid px-3 py-2">
    <!-- Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Production Jobs</h1>
            <p class="text-muted small mb-0">Welcome, <strong>@Model.WorkerName</strong>. Select an assigned job or claim an open job.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="/dev/simulator" target="_blank" class="btn btn-outline-warning text-dark btn-sm fw-semibold" title="Launch Dev Hardware Simulator">
                <i class="bi bi-cpu me-1"></i>Hardware Simulator
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter })" class="btn btn-outline-secondary btn-sm" id="btn-refresh-jobs">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </a>
        </div>
    </div>

    <!-- Assembly Station & Workload Status Banner -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle @(Model.CurrentAssemblyLineId.HasValue ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning")">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold d-block">Current Assembly Station</span>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="h5 fw-bold mb-0 text-dark">
                            @Model.CurrentAssemblyCode — @Model.CurrentAssemblyName
                        </div>
                    }
                    else
                    {
                        <div class="h6 fw-bold mb-0 text-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>No Assembly Line Selected — Select Station to Receive Tasks
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="text-end">
                    <span class="text-muted small text-uppercase fw-semibold d-block">My Active Workload</span>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">
                        @Model.WorkerActiveWorkload.ToString("F1") pts
                    </span>
                    <span class="text-muted small ms-1">(@Model.MyJobsCount active tasks)</span>
                </div>

                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#switchAssemblyLineModal">
                    <i class="bi bi-arrow-left-right me-1"></i>@(Model.CurrentAssemblyLineId.HasValue ? "Switch Station" : "Select Station")
                </button>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Pills: My Jobs & Open to Claim -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "my-jobs", selectedJobId = ViewBag.SelectedJobId })"
               class="btn btn-sm @(Model.ActiveFilter == "my-jobs" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-person-check me-1"></i>My Jobs <span class="badge bg-light text-dark ms-1">@Model.MyJobsCount</span>
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "open", selectedJobId = ViewBag.SelectedJobId })"
               class="btn btn-sm @(Model.ActiveFilter == "open" ? "btn-success" : "btn-outline-secondary")">
                <i class="bi bi-box-arrow-in-right me-1"></i>Open to Claim <span class="badge bg-light text-dark ms-1">@Model.OpenCount</span>
            </a>
        </div>
        <div>
            @if (Model.CanClaimJobs)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-2.5">
                    <i class="bi bi-check-circle-fill me-1"></i>Eligible to Claim: Current Workload Completed
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle py-1.5 px-2.5" title="Complete your current assigned workload to unlock claiming">
                    <i class="bi bi-lock-fill me-1 text-warning"></i>Claiming Locked: @Model.IncompleteAssignedJobsCount Active Job(s) Pending in My Jobs
                </span>
            }
        </div>
    </div>

    @if (Model.ActiveFilter == "open" && !Model.CanClaimJobs)
    {
        <div class="alert alert-warning py-2.5 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
            <div>
                <strong>Claiming Locked:</strong> You currently have <strong>@Model.IncompleteAssignedJobsCount</strong> active workload task(s) assigned to you. You must complete your assigned workload before claiming a new job from the open pool.
            </div>
        </div>
    }

    <!-- 50/50 SPLIT SCREEN: SPOTIFY SONGS PLAYLIST ON LEFT, ASSEMBLY COCKPIT ON RIGHT -->
    <div class="row g-3">
        <!-- LEFT HALF (50%): SPOTIFY SONGS PLAYLIST -->
        <div class="@(activeState != null ? "col-12 col-lg-6" : "col-12 col-lg-8 mx-auto")">
            <div class="card border shadow-sm bg-white d-flex flex-column" style="border-radius: 12px; overflow: hidden; height: 100%;">
                <!-- Spotify Playlist Header -->
                <div class="card-header bg-dark text-white p-3 border-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px;">
                                <i class="bi bi-play-fill fs-5"></i>
                            </span>
                            <div>
                                <h2 class="h6 fw-bold mb-0 text-white">Production Jobs Queue</h2>
                                <span class="text-white-50" style="font-size: 0.72rem;">Click any job to select / start assembly</span>
                            </div>
                        </div>
                        <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 font-monospace">
                            @Model.Jobs.Count @(Model.Jobs.Count == 1 ? "Job" : "Jobs")
                        </span>
                    </div>
                </div>

                <!-- Song Track List -->
                <div class="playlist-tracks-container flex-grow-1 p-2" style="max-height: 720px; overflow-y: auto;">
                    @if (!Model.Jobs.Any())
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-secondary"></i>
                            No jobs match this filter.
                        </div>
                    }
                    else
                    {
                        var trackIndex = 1;
                        foreach (var job in Model.Jobs)
                        {
                            var isCurrentlyAssembling = activeState != null && activeState.JobId == job.JobId;
                            var priColor = job.Priority switch
                            {
                                PriorityLevel.Black => "#111827",
                                PriorityLevel.Red => "#ef4444",
                                PriorityLevel.Yellow => "#f59e0b",
                                PriorityLevel.Green => "#10b981",
                                PriorityLevel.Blue => "#3b82f6",
                                _ => "#9ca3af"
                            };

                            <div class="playlist-track-row d-flex align-items-center p-2.5 mb-2 rounded text-decoration-none text-dark position-relative border @(isCurrentlyAssembling ? "active-playing-track border-success border-2 shadow-sm" : "hover-track bg-white")"
                                 style="cursor: pointer;"
                                 onclick="window.location.href='@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter, selectedJobId = job.JobId })'">

                                <!-- Track # / Play Icon -->
                                <div class="track-number-box text-center me-2" style="width: 28px; flex-shrink: 0;">
                                    @if (isCurrentlyAssembling)
                                    {
                                        <span class="badge bg-success rounded-circle p-1 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 22px; height: 22px;" title="Assembling Now">
                                            <i class="bi bi-play-fill text-white fs-6"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-bold small track-num-label">@trackIndex</span>
                                        <i class="bi bi-play-circle-fill text-primary track-play-hover d-none fs-5"></i>
                                    }
                                </div>

                                <!-- Track Info -->
                                <div class="flex-grow-1 min-w-0 me-2">
                                    <div class="d-flex align-items-center gap-1.5">
                                        <span class="priority-dot" style="background-color: @priColor; width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex-shrink: 0;" title="@job.PriorityLabel Priority"></span>
                                        <span class="fw-bold text-truncate d-block text-dark small" style="font-size: 0.88rem;">@job.ProductName</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5 text-muted text-truncate mt-0.5" style="font-size: 0.73rem;">
                                        <span class="font-monospace fw-semibold text-dark-emphasis">@job.JobNo</span>
                                        <span>&bull;</span>
                                        <span>@job.ProductCode</span>
                                        <span>&bull;</span>
                                        <span class="fw-semibold text-dark">@job.QuantityCompleted/@job.Quantity Units</span>
                                        @if (!string.IsNullOrEmpty(job.AssemblyCode))
                                        {
                                            <span>&bull;</span>
                                            <span>Line: @job.AssemblyCode</span>
                                        }
                                        @if (job.DueDate.HasValue)
                                        {
                                            <span>&bull;</span>
                                            <span>Due: @job.DueDate.Value.ToString("dd MMM")</span>
                                        }
                                    </div>
                                </div>

                                <!-- Status / Action -->
                                <div class="d-flex align-items-center gap-1" style="flex-shrink: 0;">
                                    @if (isCurrentlyAssembling)
                                    {
                                        <span class="badge bg-success text-white py-1 px-2 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.7rem;">
                                            <span class="spinner-grow spinner-grow-sm" style="width: 7px; height: 7px;" role="status"></span>
                                            ACTIVE
                                        </span>
                                    }
                                    else if (job.CanResume)
                                    {
                                        <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter, selectedJobId = job.JobId })" 
                                           class="btn btn-warning btn-sm py-0.5 px-2 fw-bold text-dark shadow-sm" style="font-size: 0.72rem;"
                                           onclick="event.stopPropagation();">
                                            <i class="bi bi-play-fill me-0.5"></i>Resume
                                        </a>
                                    }
                                    else if (job.IsOpen)
                                    {
                                        @if (Model.CanClaimJobs)
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2 fw-semibold shadow-sm" style="font-size: 0.72rem;"
                                                    data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                                    data-job-id="@job.JobId"
                                                    data-job-no="@job.JobNo"
                                                    data-product="@job.ProductCode - @job.ProductName"
                                                    data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId, returnUrl = Url.Action("Index", "JobBoard", new { area = "Worker", selectedJobId = job.JobId }) })"
                                                    onclick="event.stopPropagation();">
                                                <i class="bi bi-box-arrow-in-right me-0.5"></i>Claim
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border" style="font-size: 0.68rem;" title="Claiming Locked">Locked</span>
                                        }
                                    }
                                    else if (job.CanStart)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm py-0.5 px-2 fw-semibold shadow-sm" style="font-size: 0.72rem;"
                                                data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                                data-job-id="@job.JobId"
                                                data-job-no="@job.JobNo"
                                                data-product="@job.ProductCode - @job.ProductName"
                                                data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId, returnUrl = Url.Action("Index", "JobBoard", new { area = "Worker", selectedJobId = job.JobId }) })"
                                                onclick="event.stopPropagation();">
                                            <i class="bi bi-wrench me-0.5"></i>Start
                                        </button>
                                    }
                                    else if (job.Status == JobStatus.OnHold)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-1.5" style="font-size: 0.68rem;">On Hold</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border py-1 px-1.5" style="font-size: 0.68rem;">@job.Status</span>
                                    }
                                </div>
                            </div>
                            trackIndex++;
                        }
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT HALF (50%): FOCUSED ASSEMBLY COCKPIT -->
        @if (activeState != null && currentStep != null)
        {
            <div class="col-12 col-lg-6">
                <div class="card border shadow-sm bg-white d-flex flex-column h-100" style="border-radius: 12px; overflow: hidden;">
                    <!-- Cockpit Header: Step Info & Expand Button -->
                    <div class="card-header bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <span class="badge bg-primary text-uppercase" style="font-size: 0.75rem;">
                                Step @currentStep.SequenceNo of @activeState.Steps.Count
                            </span>
                            <span class="fw-bold text-truncate text-white" style="font-size: 0.88rem;" title="@currentStep.Label">
                                @currentStep.Label
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="flex-shrink: 0;">
                            <a href="@Url.Action("Execute", "JobBoard", new { area = "Worker", id = activeState.JobId })" 
                               class="btn btn-warning btn-sm fw-bold shadow-sm d-flex align-items-center gap-1"
                               title="Click to Expand into the full assembly cockpit window">
                                <i class="bi bi-arrows-fullscreen"></i>
                                <span>Expand</span>
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-3 d-flex flex-column justify-content-between gap-2.5">
                        <!-- 1. ACTIVE MARKER IMAGE -->
                        <div class="position-relative rounded border bg-dark text-center overflow-hidden" style="height: 250px; background: #0f172a;">
                            <div class="position-absolute top-50 start-50 translate-middle w-100 h-100 d-flex align-items-center justify-content-center">
                                @if (!string.IsNullOrEmpty(activeState.CurrentComponent.ImagePath))
                                {
                                    var rawImg = activeState.CurrentComponent.ImagePath.Trim();
                                    var compImg = rawImg.StartsWith("~") ? Url.Content(rawImg) : (rawImg.StartsWith("/") ? rawImg : "/" + rawImg);
                                    <div class="position-relative d-inline-block" style="line-height: 0;">
                                        <img src="@compImg" alt="@activeState.CurrentComponent.ComponentName" 
                                             class="rounded shadow-sm d-block" 
                                             style="max-height: 235px; max-width: 100%; object-fit: contain; pointer-events: none; user-select: none;" />
                                        @foreach (var s in activeState.Steps)
                                        {
                                            if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                            {
                                                var isCurr = s.IsCurrent;
                                                var isPass = s.IsCompleted;
                                                var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                                var pinSize = Math.Max(14, s.MarkerSize ?? 24);
                                                var pinFont = Math.Max(9, (int)(pinSize * 0.48m));
                                                <div id="marker-pin-@s.SequenceNo" 
                                                     class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass bp-marker"
                                                     style="left: @(s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; width: @(pinSize)px; height: @(pinSize)px; font-size: @(pinFont)px; transform: translate(-50%, -50%); z-index: 5;"
                                                     title="@s.Label: @s.Target @unitSymbol">
                                                    <span>@(isPass ? "✓" : s.SequenceNo.ToString())</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="position-relative rounded border bg-white shadow-sm d-inline-block" style="width: 280px; height: 210px; border-style: dashed !important;">
                                        <div class="text-muted small position-absolute top-50 start-50 translate-middle">
                                            <i class="bi bi-box fs-1 d-block mb-1 text-secondary"></i>
                                            <span>@activeState.CurrentComponent.ComponentName Schematic</span>
                                        </div>
                                        @foreach (var s in activeState.Steps)
                                        {
                                            if (s.MarkerX.HasValue && s.MarkerY.HasValue)
                                            {
                                                var isCurr = s.IsCurrent;
                                                var isPass = s.IsCompleted;
                                                var markerClass = isCurr ? "marker-current" : (isPass ? "bg-success" : "bg-secondary");
                                                var pinSize = Math.Max(14, s.MarkerSize ?? 24);
                                                var pinFont = Math.Max(9, (int)(pinSize * 0.48m));
                                                <div id="marker-pin-@s.SequenceNo" 
                                                     class="position-absolute rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm @markerClass bp-marker"
                                                     style="left: @(s.MarkerX.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(s.MarkerY.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; width: @(pinSize)px; height: @(pinSize)px; font-size: @(pinFont)px; transform: translate(-50%, -50%); z-index: 5;"
                                                     title="@s.Label: @s.Target @unitSymbol">
                                                    <span>@(isPass ? "✓" : s.SequenceNo.ToString())</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-1 px-2 py-0.5 bg-dark bg-opacity-75 text-white rounded small" style="font-size: 11px;">
                                <i class="bi bi-pin-map-fill me-1 text-warning"></i>Active Pin: Bolt #@currentStep.SequenceNo
                            </div>
                        </div>

                        <!-- 2. TARGET, MIN & MAX LIMITS -->
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <div class="text-muted small" style="font-size: 0.72rem;">Target</div>
                                    <div class="fw-bold fs-6 text-dark" id="target-value">@currentStep.Target.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <div class="text-muted small" style="font-size: 0.72rem;">Min Limit</div>
                                    <div class="fw-bold fs-6 text-success" id="lower-limit">@currentStep.LowerLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <div class="text-muted small" style="font-size: 0.72rem;">Max Limit</div>
                                    <div class="fw-bold fs-6 text-success" id="upper-limit">@currentStep.UpperLimit.ToString("0.0##") <span class="small text-muted">@unitSymbol</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. LIVE TORQUE READING & GAUGE -->
                        <div class="text-center py-2 px-3 bg-light border rounded-3 position-relative">
                            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem;">
                                Live Reading (@activeDevice)
                            </div>
                            <div class="d-flex align-items-baseline justify-content-center gap-2 mb-2">
                                <span class="display-6 fw-bold font-monospace text-dark" id="reading-num">--.-</span>
                                <span class="fs-5 text-muted fw-bold" id="reading-unit">@unitSymbol</span>
                            </div>

                            <!-- Acceptance zone bar -->
                            <div class="position-relative mx-auto" style="height: 16px; background: #e9ecef; border-radius: 8px; max-width: 90%;">
                                <div class="position-absolute h-100 bg-success bg-opacity-50 rounded"
                                     style="left: @zoneLeft.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @zoneWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                                <div class="gauge-needle" id="gauge-needle"
                                     style="position: absolute; top: -4px; width: 5px; height: 24px; background: #0d6efd; border-radius: 3px; transform: translateX(-50%); left: 0%; transition: left 0.15s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mt-1 px-3" style="font-size: 0.7rem;">
                                <span>@minScale.ToString("0.#")</span>
                                <span class="text-success fw-bold">Acceptance Zone</span>
                                <span>@maxScale.ToString("0.#")</span>
                            </div>

                            <!-- Result Banner -->
                            <div id="result-banner" class="d-none alert my-2 py-1.5 px-3 rounded-2 text-center small fw-bold" role="alert">
                                <span id="banner-text">PASS</span>
                            </div>
                        </div>

                        <!-- 4. SEND READING BUTTON & SIMULATOR -->
                        <div class="border-top pt-2">
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 sim-btn" style="font-size: 0.73rem;" onclick="sendSimulated(@currentStep.Target)">
                                    <i class="bi bi-bullseye me-1"></i>Target (@currentStep.Target.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 sim-btn" style="font-size: 0.73rem;" onclick="sendSimulated(@currentStep.LowerLimit)">
                                    <i class="bi bi-chevron-bar-right me-1"></i>Min (@currentStep.LowerLimit.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 sim-btn" style="font-size: 0.73rem;" onclick="sendSimulated(@currentStep.UpperLimit)">
                                    <i class="bi bi-chevron-bar-left me-1"></i>Max (@currentStep.UpperLimit.ToString("0.0##"))
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 sim-btn" style="font-size: 0.73rem;" onclick="sendSimulated(@(currentStep.LowerLimit - 2.0m))">
                                    Fail Low
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 sim-btn" style="font-size: 0.73rem;" onclick="sendSimulated(@(currentStep.UpperLimit + 2.0m))">
                                    Fail High
                                </button>
                            </div>

                            <div class="input-group input-group-sm">
                                <span class="input-group-text" style="font-size: 0.75rem;">@unitSymbol:</span>
                                <input type="number" step="0.01" id="custom-sim-val" class="form-control" placeholder="@currentStep.Target" value="@currentStep.Target" />
                                <button class="btn btn-primary fw-bold px-3" type="button" onclick="sendCustomSimulated()">
                                    <i class="bi bi-send me-1"></i>Send Reading
                                </button>
                                <button class="btn btn-outline-danger" type="button" onclick="submitFailedBolt()" title="Log bolt as defective and advance">
                                    <i class="bi bi-x-octagon"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (activeState != null && (activeState.Status == JobStatus.Completed || activeState.QuantityCompleted >= activeState.Quantity))
        {
            <div class="col-12 col-lg-6">
                <div class="card border shadow-sm bg-white d-flex flex-column h-100 justify-content-center text-center p-5 rounded-3">
                    <i class="bi bi-trophy-fill text-warning fs-1 mb-2"></i>
                    <h3 class="h5 fw-bold">Job @activeState.JobNo Completed!</h3>
                    <p class="text-muted small">All product units have been assembled and verified.</p>
                    <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter })" class="btn btn-success btn-sm px-3 mt-2">
                        <i class="bi bi-arrow-clockwise me-1"></i>Select Next Job
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Tool Pairing Modal -->
<div class="modal fade" id="toolPairingModal" tabindex="-1" aria-labelledby="toolPairingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="toolPairingForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="toolPairingModalLabel">
                        <i class="bi bi-tools me-2"></i>Tool Pairing Setup
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle text-primary fs-5"></i>
                        <div class="small">
                            Job: <strong id="modalJobNo"></strong><br />
                            <span id="modalProduct" class="text-muted"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-upc-scan text-primary me-1"></i>Product Unit (40-char PRD Token)
                        </label>
                        <select name="unitNo" id="modalUnitSelect" class="form-select">
                            <option value="">-- Loading product units... --</option>
                        </select>
                        <div class="form-text small">Select the specific product unit to assemble from this job order.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-wrench text-primary me-1"></i>Torque Wrench (ESP32 / Calibrated Tool)
                        </label>
                        <select name="torqueDeviceId" id="modalTorqueSelect" class="form-select">
                            <option value="">-- Use Default / Any Connected Torque Wrench --</option>
                            @if (ViewBag.AvailableTorqueDevices is IEnumerable<SmartTorque.Core.Entities.Device> tDevices)
                            {
                                foreach (var d in tDevices)
                                {
                                    <option value="@d.DeviceId">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")</option>
                                }
                            }
                        </select>
                        <div class="form-text small">Select your registered ESP32 wrench (e.g. ESP 01, SIM-TORQUE-01).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">
                            <i class="bi bi-rulers text-primary me-1"></i>Vernier Caliper (Optional)
                        </label>
                        <select name="vernierDeviceId" id="modalVernierSelect" class="form-select">
                            <option value="">-- Use Default / None --</option>
                            @if (ViewBag.AvailableVernierDevices is IEnumerable<SmartTorque.Core.Entities.Device> vDevices)
                            {
                                foreach (var d in vDevices)
                                {
                                    <option value="@d.DeviceId">@d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-play-circle-fill me-1"></i>Confirm & Start Assembly
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Switch Assembly Line Modal -->
<div class="modal fade" id="switchAssemblyLineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SetAssemblyLine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Select Assembly Line Station</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Select the physical assembly line station you are currently operating. The system will route tasks designated for this line to your queue.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Assembly Line</label>
                        <select name="assemblyLineId" class="form-select" required>
                            <option value="">— Select an active assembly line —</option>
                            @foreach (var line in Model.AvailableAssemblyLines)
                            {
                                <option value="@line.AssemblyLineId" selected="@(line.AssemblyLineId == Model.CurrentAssemblyLineId)">
                                    @line.AssemblyCode — @line.AssemblyName (@line.Department)
                                </option>
                            }
                        </select>
                    </div>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Switching stations persists across your sessions. Tasks currently in-progress should be completed or placed on hold before switching stations.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Confirm Station Switch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const toolModal = document.getElementById('toolPairingModal');
        if (toolModal) {
            toolModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const jobId = button.getAttribute('data-job-id') || '';
                const jobNo = button.getAttribute('data-job-no') || '';
                const product = button.getAttribute('data-product') || '';
                const startUrl = button.getAttribute('data-start-url') || '';
                
                document.getElementById('modalJobNo').textContent = jobNo;
                document.getElementById('modalProduct').textContent = product;
                document.getElementById('toolPairingForm').setAttribute('action', startUrl);

                const unitSelect = document.getElementById('modalUnitSelect');
                if (unitSelect && jobId) {
                    unitSelect.innerHTML = '<option value="">Loading units...</option>';
                    fetch('/Worker/JobBoard/Units/' + jobId)
                        .then(function(r) { return r.json(); })
                        .then(function(units) {
                            unitSelect.innerHTML = '';
                            if (!units || units.length === 0) {
                                unitSelect.innerHTML = '<option value="1">Unit #1 (Auto-generated)</option>';
                                return;
                            }
                            let selected = false;
                            units.forEach(function(u) {
                                const opt = document.createElement('option');
                                opt.value = u.unitIndex;
                                const isDone = u.status === 'Completed';
                                const isFail = u.status === 'Failed';
                                const badge = isDone ? ' [✓ Done]' : (isFail ? ' [⚠ Failed/Rework]' : ' [Pending]');
                                opt.textContent = 'Unit #' + u.unitIndex + ': ' + u.tokenNo + badge;
                                if (!selected && !isDone) {
                                    opt.selected = true;
                                    selected = true;
                                }
                                unitSelect.appendChild(opt);
                            });
                            if (!selected && units.length > 0) {
                                unitSelect.options[0].selected = true;
                            }
                        })
                        .catch(function() {
                            unitSelect.innerHTML = '<option value="">-- Auto-select Next Unit --</option>';
                        });
                }
            });
        }

        const hasActiveCockpit = @(activeState != null && currentStep != null ? "true" : "false");
        const sessionId = @(activeState?.SessionId ?? 0);
        const jobId = @(activeState?.JobId ?? 0);
        const minScale = @(minScale.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const maxScale = @(maxScale.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const lowerLimit = @((currentStep?.LowerLimit ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const upperLimit = @((currentStep?.UpperLimit ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const targetVal = @((currentStep?.Target ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const instrumentType = @((int)(currentStep?.Instrument ?? 0));
        const unitSymbol = "@unitSymbol";
        const currentStepSeq = @(currentStep?.SequenceNo ?? 0);

        function updateGaugeNeedle(val) {
            const clamped = Math.max(minScale, Math.min(maxScale, val));
            const range = maxScale - minScale;
            const pct = range > 0 ? ((clamped - minScale) / range) * 100 : 50;
            const needle = document.getElementById("gauge-needle");
            if (needle) {
                needle.style.left = pct + "%";
            }

            const readingNum = document.getElementById("reading-num");
            if (readingNum) {
                readingNum.textContent = Number(val).toFixed(2);
            }
        }

        function handleReadingResult(res) {
            updateGaugeNeedle(res.actualValue);

            const banner = document.getElementById("result-banner");
            const bannerText = document.getElementById("banner-text");

            if (banner && bannerText) {
                banner.classList.remove("d-none", "alert-success", "alert-danger");
                if (res.isStepPassed) {
                    banner.classList.add("alert-success");
                    bannerText.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>PASS — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                } else {
                    banner.classList.add("alert-danger");
                    bannerText.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>FAIL (Attempt ' + res.attemptNo + ') — ' + Number(res.actualValue).toFixed(2) + ' ' + unitSymbol;
                }
            }

            if (res.isSessionCompleted || res.isStepPassed || (res.nextStepSequence && res.nextStepSequence !== currentStepSeq)) {
                setTimeout(function () {
                    window.location.reload();
                }, 850);
            }
        }

        async function sendSimulated(val) {
            updateGaugeNeedle(val);

            const payload = {
                SessionId: sessionId,
                Value: val,
                InstrumentType: instrumentType,
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                }
            } catch (ex) {
                console.error("Submission error:", ex);
            }
        }

        function sendCustomSimulated() {
            const inp = document.getElementById("custom-sim-val");
            if (!inp || !inp.value) return;
            const val = parseFloat(inp.value);
            if (isNaN(val)) return;
            sendSimulated(val);
        }

        async function submitFailedBolt() {
            if (!confirm("Record defect for this bolt and advance to the next step?")) {
                return;
            }

            const currentNum = parseFloat(document.getElementById("reading-num")?.textContent) || (targetVal || 0);

            const payload = {
                SessionId: sessionId,
                Value: isNaN(currentNum) ? 0 : currentNum,
                InstrumentType: instrumentType,
                ForceFail: true,
                ReasonCode: "OPERATOR_FORCE_FAIL",
                CapturedAt: new Date().toISOString()
            };

            try {
                const response = await fetch('/Worker/JobBoard/SubmitReading', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    handleReadingResult(data);
                }
            } catch (ex) {
                console.error("Failed bolt submission error:", ex);
            }
        }

        if (typeof signalR !== 'undefined') {
            const conn = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            if (hasActiveCockpit) {
                conn.on("LiveReading", function (data) {
                    updateGaugeNeedle(data.actualValue);
                });

                conn.on("ReadingProcessed", function (data) {
                    handleReadingResult(data);
                });
            }

            conn.start().then(function () {
                if (hasActiveCockpit) {
                    conn.invoke("JoinSession", sessionId);
                    conn.invoke("JoinJob", jobId);
                }
                conn.invoke("JoinWorkers");
            }).catch(function (err) {
                console.warn("SignalR error:", err);
            });
        }
    </script>
}
