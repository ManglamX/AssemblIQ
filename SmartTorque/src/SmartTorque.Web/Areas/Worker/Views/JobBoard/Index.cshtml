@model SmartTorque.Web.ViewModels.Worker.WorkerJobBoardViewModel
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Job Board";
}

<div class="container-fluid px-3 py-2">
    <!-- Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Production Jobs</h1>
            <p class="text-muted small mb-0">Welcome, <strong>@Model.WorkerName</strong>. Select an assigned job or claim an open job.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = Model.ActiveFilter })" class="btn btn-outline-secondary btn-sm" id="btn-refresh-jobs">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </a>
        </div>
    </div>

    <!-- Assembly Station & Workload Status Banner -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle @(Model.CurrentAssemblyLineId.HasValue ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning")">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold d-block">Current Assembly Line & Station</span>
                    @if (Model.CurrentAssemblyLineId.HasValue)
                    {
                        <div class="h5 fw-bold mb-0 text-dark">
                            @Model.CurrentAssemblyCode — @Model.CurrentAssemblyName
                        </div>
                    }
                    else
                    {
                        <div class="h6 fw-bold mb-0 text-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>No Assembly Line Selected — Select Station to Receive Tasks
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="text-end">
                    <span class="text-muted small text-uppercase fw-semibold d-block">My Active Workload</span>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">
                        @Model.WorkerActiveWorkload.ToString("F1") pts
                    </span>
                    <span class="text-muted small ms-1">(@Model.MyJobsCount active tasks)</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-dark btn-sm shadow-sm d-flex align-items-center gap-1.5" onclick="openPrdScannerModal()">
                        <i class="bi bi-qr-code-scan text-warning"></i>
                        <span class="fw-bold">Scan PRD Unit QR</span>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#switchAssemblyLineModal">
                        <i class="bi bi-arrow-left-right me-1"></i>@(Model.CurrentAssemblyLineId.HasValue ? "Switch" : "Select Station")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Pills: My Jobs & Open to Claim -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "my-jobs" })"
               class="btn btn-sm @(Model.ActiveFilter == "my-jobs" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-person-check me-1"></i>My Jobs <span class="badge bg-light text-dark ms-1">@Model.MyJobsCount</span>
            </a>
            <a href="@Url.Action("Index", "JobBoard", new { area = "Worker", filter = "open" })"
               class="btn btn-sm @(Model.ActiveFilter == "open" ? "btn-success" : "btn-outline-secondary")">
                <i class="bi bi-box-arrow-in-right me-1"></i>Open to Claim <span class="badge bg-light text-dark ms-1">@Model.OpenCount</span>
            </a>
        </div>
        <div>
            @if (Model.CanClaimJobs)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-2.5">
                    <i class="bi bi-check-circle-fill me-1"></i>Eligible to Claim: Current Workload Completed
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle py-1.5 px-2.5" title="Complete your current assigned workload to unlock claiming">
                    <i class="bi bi-lock-fill me-1 text-warning"></i>Claiming Locked: @Model.IncompleteAssignedJobsCount Active Job(s) Pending in My Jobs
                </span>
            }
        </div>
    </div>

    @if (Model.ActiveFilter == "open" && !Model.CanClaimJobs)
    {
        <div class="alert alert-warning py-2.5 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
            <div>
                <strong>Claiming Locked:</strong> You currently have <strong>@Model.IncompleteAssignedJobsCount</strong> active workload task(s) assigned to you. You must complete your assigned workload before claiming a new job from the open pool.
            </div>
        </div>
    }

    <!-- Job Rows Search & Filter Toolbar -->
@if (Model.Jobs.Any())
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-2 d-flex flex-wrap align-items-center gap-2">
            <div class="position-relative flex-grow-1" style="min-width:220px;">
                <i class="bi bi-search position-absolute top-50 translate-middle-y ms-2 text-muted small"></i>
                <input type="text" id="job-search-input" class="form-control form-control-sm ps-4" placeholder="Search job no, product code or name..." autocomplete="off" />
            </div>
            <select id="filter-status" class="form-select form-select-sm w-auto" title="Filter by status">
                <option value="">Status: All</option>
                <option value="InProgress">In Progress</option>
                <option value="Pending">Open</option>
            </select>
            <select id="filter-priority" class="form-select form-select-sm w-auto" title="Filter by priority">
                <option value="">Priority: All</option>
                <option value="1">Black</option>
                <option value="2">Red</option>
                <option value="3">Yellow</option>
                <option value="4">Green</option>
                <option value="5">Blue</option>
            </select>

            <button type="button" id="btn-filter-clear" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i>Clear
            </button>
            <span class="text-muted small ms-auto" id="job-row-count"></span>
        </div>
    </div>
}

<!-- Job Rows List -->

@if (!Model.Jobs.Any())
{
    <div class="text-center py-5 text-muted border rounded-3 bg-white my-3" id="job-board-empty">
        <i class="bi bi-clipboard-check" style="font-size: 3.5rem; color: #adb5bd;"></i>
        <h2 class="h5 mt-3 mb-1">No jobs match this filter</h2>
        <p class="mb-0">Jobs will appear here when imported from BM workbooks or assigned by supervisors.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-3" id="job-rows-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="job-rows-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:105px;">Priority</th>
                        <th>Job / Product</th>
                        <th style="width:95px;">Line</th>
                        <th style="width:120px;">Due</th>
                        <th style="width:90px;">Workload</th>
                        <th style="width:150px;">Units</th>
                        <th style="width:115px;">Status</th>
                        <th style="width:125px;">Assigned</th>
                        <th style="width:150px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        var priorityClass = job.Priority switch
                        {
                            SmartTorque.Core.Enums.PriorityLevel.Black => "priority-1",
                            SmartTorque.Core.Enums.PriorityLevel.Red => "priority-2",
                            SmartTorque.Core.Enums.PriorityLevel.Yellow => "priority-3",
                            SmartTorque.Core.Enums.PriorityLevel.Green => "priority-4",
                            _ => ""
                        };
                        var pct = job.Quantity > 0 ? (job.QuantityCompleted * 100) / job.Quantity : 0;
                        var isOverdue = job.DueDate.HasValue && job.DueDate.Value < DateOnly.FromDateTime(DateTime.Today);
                        <tr class="job-row @priorityClass"
                            data-detail-url="/Job/Detail/@job.JobId"
                            data-priority="@((int)job.Priority)"
                            data-status="@job.Status"
                            data-line="@(string.IsNullOrWhiteSpace(job.AssemblyCode) ? "UNMAPPED" : job.AssemblyCode)"
                            data-search="@((job.JobNo + " " + job.ProductCode + " " + job.ProductName).ToLower())">
                            <td>
                                <span class="d-inline-flex align-items-center gap-1 text-nowrap">
                                    <span class="job-row-dot" style="background-color:@job.PriorityHex;"></span>
                                    <span class="small fw-semibold">@job.PriorityLabel</span>
                                </span>
                            </td>
                            <td>
                                <a href="/Job/Detail/@job.JobId" class="fw-bold text-decoration-none text-dark">@job.JobNo</a>
                                <div class="text-muted small"><strong>@job.ProductCode</strong> — @job.ProductName</div>
                                @if (!string.IsNullOrEmpty(job.ScopeSummary))
                                {
                                    <span class="badge bg-light text-dark border mt-1" style="font-size:0.68rem;" title="Assigned Work Package Scope">
                                        <i class="bi bi-diagram-3-fill me-1"></i>@job.ScopeSummary
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(job.AssemblyCode))
                                {
                                    <span class="badge bg-light text-dark border fw-semibold small">@job.AssemblyCode</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted small">Unmapped</span>
                                }
                            </td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger fw-bold small text-nowrap" title="Overdue">
                                        <i class="bi bi-exclamation-circle-fill me-1"></i>@(job.DueDate?.ToString("dd MMM yyyy") ?? "Overdue")
                                    </span>
                                }
                                else
                                {
                                    <span class="small text-nowrap fw-semibold text-dark">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>@(job.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </span>
                                }
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary fw-bold small">@job.EstimatedWorkload.ToString("F1") pts</span></td>
                            <td>
                                <div class="d-flex small text-muted mb-1"><span>@job.QuantityCompleted / @job.Quantity</span></div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width:@pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                            <td>
                                @if (job.Status == SmartTorque.Core.Enums.JobStatus.InProgress)
                                {
                                    <span class="badge bg-warning text-dark small"><i class="bi bi-play-circle-fill me-1"></i>In Progress</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Assigned)
                                {
                                    <span class="badge bg-info text-dark small"><i class="bi bi-person-badge me-1"></i>Assigned</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.Pending)
                                {
                                    <span class="badge bg-secondary small"><i class="bi bi-clock me-1"></i>Open</span>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                                {
                                    <span class="badge bg-danger small"><i class="bi bi-pause-circle me-1"></i>On Hold</span>
                                }
                            </td>
                            <td>
                                @if (job.IsAssignedToCurrentWorker)
                                {
                                    <span class="text-success small fw-semibold text-nowrap"><i class="bi bi-check-circle-fill me-1"></i>You</span>
                                }
                                else if (!string.IsNullOrEmpty(job.AssignedWorkerName))
                                {
                                    <span class="text-muted small text-nowrap"><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</span>
                                }
                                else
                                {
                                    <span class="text-primary small fw-semibold text-nowrap"><i class="bi bi-unlock me-1"></i>Unassigned</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (job.CanResume)
                                {
                                    <button type="button" class="btn btn-warning btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-play-circle-fill"></i> Resume
                                    </button>
                                }
                                else if (job.IsOpen)
                                {
                                    @if (Model.CanClaimJobs)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm fw-bold"
                                                data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                                data-job-id="@job.JobId"
                                                data-job-no="@job.JobNo"
                                                data-product="@job.ProductCode - @job.ProductName"
                                                data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                            <i class="bi bi-box-arrow-in-right"></i> Claim &amp; Start
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm disabled" disabled
                                                title="Complete your currently assigned workload before claiming new jobs">
                                            <i class="bi bi-lock-fill"></i> Claim Locked
                                        </button>
                                    }
                                }
                                else if (job.CanStart)
                                {
                                    <button type="button" class="btn btn-primary btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-wrench"></i> Start Assembly
                                    </button>
                                }
                                else if (job.Status == SmartTorque.Core.Enums.JobStatus.OnHold)
                                {
                                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#toolPairingModal"
                                            data-job-id="@job.JobId"
                                            data-job-no="@job.JobNo"
                                            data-product="@job.ProductCode - @job.ProductName"
                                            data-start-url="@Url.Action("Start", "JobBoard", new { area = "Worker", id = job.JobId })">
                                        <i class="bi bi-play-fill"></i> From Hold
                                    </button>
                                }
                                else
                                {
                                    <a href="/Job/Detail/@job.JobId" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3 d-none" id="job-rows-nomatch">
        <div class="card-body text-center py-4 text-muted">
            <i class="bi bi-funnel fs-2"></i>
            <h2 class="h6 mt-2 mb-1">No jobs match your search or filters</h2>
            <p class="mb-0 small">Adjust or clear the filters above to see all jobs.</p>
        </div>
    </div>
}

</div>



<!-- Tool Pairing Modal -->
<div class="modal fade" id="toolPairingModal" tabindex="-1" aria-labelledby="toolPairingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="toolPairingForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="toolPairingModalLabel">
                        <i class="bi bi-tools me-2"></i>Tool Pairing Setup
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle text-primary fs-5"></i>
                        <div class="small">
                            Job: <strong id="modalJobNo"></strong><br />
                            <span id="modalProduct" class="text-muted"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase d-inline-flex align-items-center gap-1"
                               title="Select the specific product unit to assemble from this job order."
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               style="cursor: help;">
                            <i class="bi bi-upc-scan text-primary"></i>
                            <span>Select Product Unit</span>
                            <i class="bi bi-info-circle text-muted ms-1" style="font-size: 0.85em;"></i>
                        </label>
                        <select name="unitNo" id="modalUnitSelect" class="form-select">
                            <option value="">-- Loading product units... --</option>
                        </select>
                    </div>

                    <div class="alert alert-danger py-2 px-3 small mb-3 d-none border-danger d-flex align-items-center" id="toolSelectionRequiredAlert" role="alert">
                        <i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i>
                        <span><strong>Tool Selection Required:</strong> Please select either a Torque Wrench or a Vernier Caliper to proceed.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase d-inline-flex align-items-center gap-1"
                               title="Select your registered ESP32 wrench (e.g. ESP 01, SIM-TORQUE-01)."
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               style="cursor: help;">
                            <i class="bi bi-wrench text-primary"></i>
                            <span>Select Torque Wrench</span>
                            <i class="bi bi-info-circle text-muted ms-1" style="font-size: 0.85em;"></i>
                        </label>
                        <select name="torqueDeviceId" id="modalTorqueSelect" class="form-select">
                            <option value="">-- Select Torque Wrench --</option>
                            @if (ViewBag.AvailableTorqueDevices is IEnumerable<SmartTorque.Core.Entities.Device> tDevices)
                            {
                                foreach (var d in tDevices)
                                {
                                    var isOverdue = d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                    var isDueSoon = !isOverdue && d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30);
                                    var calStatus = isOverdue ? "overdue" : (isDueSoon ? "due" : "");
                                    var calDue = d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "";
                                    var calText = isOverdue ? " • ⚠ OVERDUE since " + calDue : (isDueSoon ? " • ⚠ Cal due " + calDue : "");
                                    var optStyle = isOverdue ? "color: #dc3545; font-weight: 600;" : (isDueSoon ? "color: #d97706;" : "");

                                    <option value="@d.DeviceId"
                                            class="@(isOverdue ? "text-danger fw-bold" : (isDueSoon ? "text-warning" : ""))"
                                            style="@optStyle"
                                            data-cal-status="@calStatus"
                                            data-cal-due="@calDue">
                                        @d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")@calText
                                    </option>
                                }
                            }
                        </select>
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-3 d-none border-danger d-flex align-items-center" id="pairToolTorqueCalAlert" role="alert"></div>
                    </div>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1 my-0 text-muted" />
                        <span class="px-3 text-muted small fw-bold text-uppercase">OR</span>
                        <hr class="flex-grow-1 my-0 text-muted" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase d-inline-flex align-items-center gap-1"
                               title="Select your registered Vernier Caliper tool."
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               style="cursor: help;">
                            <i class="bi bi-rulers text-primary"></i>
                            <span>Select Vernier Caliper</span>
                            <i class="bi bi-info-circle text-muted ms-1" style="font-size: 0.85em;"></i>
                        </label>
                        <select name="vernierDeviceId" id="modalVernierSelect" class="form-select">
                            <option value="">-- Select Vernier Caliper --</option>
                            @if (ViewBag.AvailableVernierDevices is IEnumerable<SmartTorque.Core.Entities.Device> vDevices)
                            {
                                foreach (var d in vDevices)
                                {
                                    var isOverdue = d.CalibrationDue.HasValue && d.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                    var isDueSoon = !isOverdue && d.CalibrationDue.HasValue && d.CalibrationDue.Value <= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(30);
                                    var calStatus = isOverdue ? "overdue" : (isDueSoon ? "due" : "");
                                    var calDue = d.CalibrationDue?.ToString("yyyy-MM-dd") ?? "";
                                    var calText = isOverdue ? " • ⚠ OVERDUE since " + calDue : (isDueSoon ? " • ⚠ Cal due " + calDue : "");
                                    var optStyle = isOverdue ? "color: #dc3545; font-weight: 600;" : (isDueSoon ? "color: #d97706;" : "");

                                    <option value="@d.DeviceId"
                                            class="@(isOverdue ? "text-danger fw-bold" : (isDueSoon ? "text-warning" : ""))"
                                            style="@optStyle"
                                            data-cal-status="@calStatus"
                                            data-cal-due="@calDue">
                                        @d.Name (@d.TransmitterId) @(d.IsOnline ? "• [Online]" : "")@calText
                                    </option>
                                }
                            }
                        </select>
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-3 d-none border-danger d-flex align-items-center" id="pairToolVernierCalAlert" role="alert"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-play-circle-fill me-1"></i>Confirm & Start Assembly
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Switch Assembly Line Modal -->
<div class="modal fade" id="switchAssemblyLineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="overflow: visible;">
            <form asp-action="SetAssemblyLine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Select the assembly line and workstation you are currently operating. The system will route tasks designated for this station to your queue.">
                        Select Assembly Line Station <i class="bi bi-info-circle text-muted small"></i>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @{
                        var currentLine = Model.AvailableAssemblyLines.FirstOrDefault(l => l.AssemblyLineId == Model.CurrentAssemblyLineId);
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Assembly Line</label>
                        <input type="hidden" name="assemblyLineId" id="stationLineValue" value="@Model.CurrentAssemblyLineId" />
                        <div class="dropdown">
                            <button type="button" id="stationLineBtn" class="form-select text-start" data-bs-toggle="dropdown" aria-expanded="false">
                                @(currentLine == null
                                    ? "— Select an active assembly line —"
                                    : $"{currentLine.AssemblyCode} — {currentLine.AssemblyName} ({currentLine.Department})")
                            </button>
                            <ul class="dropdown-menu w-100" aria-labelledby="stationLineBtn">
                                @foreach (var line in Model.AvailableAssemblyLines)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item @(line.AssemblyLineId == Model.CurrentAssemblyLineId ? "active" : "")" data-value="@line.AssemblyLineId">
                                            @line.AssemblyCode — @line.AssemblyName (@line.Department)
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" data-bs-toggle="tooltip" data-bs-placement="right" title="Select the specific workstation where you're positioned">
                            Workstation / Subcell <i class="bi bi-info-circle text-muted" style="font-size: 0.85rem;"></i>
                        </label>
                        <input type="hidden" name="workStationId" id="workStationValue" value="" />
                        <div class="dropdown">
                            <button type="button" id="workStationBtn" class="form-select text-start" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                — Select a workstation —
                            </button>
                            <ul class="dropdown-menu w-100" aria-labelledby="workStationBtn" id="workStationMenu">
                                <li><span class="dropdown-item text-muted">Select an assembly line first</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Confirm Switch</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- PRD QR Scanner Modal -->
<div class="modal fade" id="prdScannerModal" tabindex="-1" aria-labelledby="prdScannerModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2.5">
                <h6 class="modal-title fw-bold" id="prdScannerModalLabel">
                    <i class="bi bi-qr-code-scan text-warning me-2"></i>Scan PRD Unit QR Code
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="stopPrdCamera()" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Camera Viewfinder -->
                <div class="position-relative bg-black rounded-3 overflow-hidden shadow-sm" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                    <video id="prdScannerVideo" playsinline autoplay muted style="width: 100%; height: 100%; object-fit: cover;"></video>
                    <canvas id="prdScannerCanvas" style="display: none;"></canvas>

                    <!-- Scanning Overlay Target Frame -->
                    <div class="position-absolute" style="width: 170px; height: 170px; border: 2.5px solid #38bdf8; border-radius: 12px; box-shadow: 0 0 15px rgba(56, 189, 248, 0.5); pointer-events: none;">
                        <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: #38bdf8; box-shadow: 0 0 8px #38bdf8; animation: prdScanBeam 2s infinite ease-in-out;"></div>
                    </div>

                    <!-- Camera Fallback / Notice -->
                    <div id="cameraUnavailableNotice" class="position-absolute text-white text-center p-3" style="display: none; background: rgba(0,0,0,0.85); inset: 0;">
                        <i class="bi bi-camera-video-off fs-2 text-warning mb-2 d-block"></i>
                        <div class="small fw-semibold mb-1">Camera Stream Inactive</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Camera permission was denied or not available. Please enter the token below or connect a scanner.</div>
                    </div>
                </div>

                <div id="prdScannerFeedback" class="small text-muted text-center py-2">
                    <i class="bi bi-view-finder me-1 text-primary"></i>Align the PRD Unit QR label within the frame
                </div>

                <!-- Manual Input Fallback -->
                <div class="border-top pt-2.5 mt-1">
                    <label class="form-label small text-muted fw-semibold mb-1">Or Enter / Barcode Scan Token:</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light font-monospace text-muted"><i class="bi bi-upc"></i></span>
                        <input type="text" id="prdManualTokenInput" class="form-control font-monospace" placeholder="e.g. PRD-E7CF37B1..." />
                        <button class="btn btn-primary" type="button" id="btnSubmitManualPrd" onclick="submitManualPrdToken()">
                            <i class="bi bi-arrow-right"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Work Breakdown Structure (WBS) Scope Modal (Image 3) -->
<div class="modal fade" id="customWorkloadModal" tabindex="-1" aria-labelledby="customWorkloadModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2.5">
                <h6 class="modal-title fw-bold text-dark" id="customWorkloadModalLabel">
                    <i class="bi bi-sliders text-primary me-2"></i>Configure Workload for Scanned PRD Unit
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Notice Banner -->
                <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                    <div>
                        This product is <strong>not pre-mapped</strong> to your current line (<strong id="cwCurrentLineName">Line</strong>).
                        Please specify your exact workload scope below for guidance and reporting.
                    </div>
                </div>

                <!-- Scanned PRD Unit Details Summary -->
                <div class="card bg-light border-0 mb-3">
                    <div class="card-body p-2.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <span class="badge bg-primary fs-6 me-2" id="cwUnitBadge">Unit 1</span>
                            <strong class="text-dark" id="cwProductCode">CODE</strong>
                            <span class="text-muted ms-1" id="cwProductName">— Name</span>
                        </div>
                        <div class="font-monospace small text-muted text-break" id="cwTokenBadge">PRD-...</div>
                    </div>
                </div>

                <!-- Work Breakdown Structure (WBS) Scope Selection (Exact Image 3) -->
                <div class="card border p-3 mb-3">
                    <div class="fw-bold small text-dark mb-2">
                        <i class="bi bi-sliders me-1 text-primary"></i>Work Breakdown Structure (WBS) Scope
                    </div>
                    <div class="d-flex flex-wrap gap-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cwScopeRadio" id="cwScopeFull" value="1" checked onchange="onCwScopeChanged()" />
                            <label class="form-check-label small fw-semibold" for="cwScopeFull">
                                <i class="bi bi-box-seam me-1 text-primary"></i>Entire Product (All Templates &amp; Steps)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cwScopeRadio" id="cwScopeTemplates" value="2" onchange="onCwScopeChanged()" />
                            <label class="form-check-label small fw-semibold" for="cwScopeTemplates">
                                <i class="bi bi-collection me-1 text-info"></i>Single / Specific Template(s)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cwScopeRadio" id="cwScopeSteps" value="3" onchange="onCwScopeChanged()" />
                            <label class="form-check-label small fw-semibold" for="cwScopeSteps">
                                <i class="bi bi-list-check me-1 text-warning"></i>Specific Steps from Template
                            </label>
                        </div>
                    </div>

                    <!-- Dynamic Container for Templates -->
                    <div id="cwTemplatesContainer" style="display: none;" class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Select templates you will execute:</label>
                        <div id="cwTemplatesList" class="row g-2"></div>
                    </div>

                    <!-- Dynamic Container for Steps -->
                    <div id="cwStepsContainer" style="display: none;" class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-secondary mb-0">Select exact operations/steps to execute:</label>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="selectAllCwSteps(true)">Select All</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="selectAllCwSteps(false)">Clear</button>
                            </div>
                        </div>
                        <div id="cwStepsList" class="p-2 border rounded bg-white" style="max-height: 220px; overflow-y: auto;"></div>
                    </div>
                </div>

                <!-- Scope Summary / Work Package Label Input (Image 3) -->
                <div class="mb-2">
                    <label class="form-label fw-semibold small">Scope Summary / Work Package Label</label>
                    <input type="text" id="cwScopeSummaryInput" class="form-control form-control-sm" placeholder="e.g. Full Product or Frame Assembly" />
                    <div class="form-text text-muted small" style="font-size: 0.72rem;">
                        When confirmed, guidance will be generated strictly for this workload and your inspection report will record these results.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="btnSubmitCustomWorkload" onclick="submitCustomWorkload()">
                    <i class="bi bi-check2-circle me-1"></i>Save Workload &amp; Start Guidance
                </button>
            </div>
        </div>
    </div>
</div>

