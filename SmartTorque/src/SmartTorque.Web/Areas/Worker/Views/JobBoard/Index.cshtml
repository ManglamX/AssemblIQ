        window.openChooseUnitModal = function(jobId, jobNo, product, startUrl, pendingUnits) {
            const modalEl = document.getElementById('chooseUnitModal');
            if (!modalEl) return;

            document.getElementById('chooseUnitJobNo').textContent = jobNo || ('Job #' + jobId);
            document.getElementById('chooseUnitProduct').textContent = product || '';
            document.getElementById('chooseUnitCountBadge').textContent = (pendingUnits?.length || 0) + ' Units In Order';

            const listEl = document.getElementById('chooseUnitList');
            listEl.innerHTML = '';

            if (!pendingUnits || pendingUnits.length === 0) {
                listEl.innerHTML = '<div class="text-center text-muted py-3">No unit records found for this job.</div>';
            } else {
                pendingUnits.forEach(u => {
                    const isDone = u.Status === 3 || u.Status === 'Completed' || (!u.HasFailedStep && u.CompletedSteps >= u.TotalSteps && u.TotalSteps > 0);
                    const isRework = !isDone && (u.Status === 5 || u.Status === 'Rework' || u.HasFailedStep);
                    const isInProgress = !isDone && !isRework && (u.CompletedSteps > 0 || u.Status === 2 || u.Status === 'InProgress');

                    const item = document.createElement('div');
                    item.className = 'd-flex align-items-center justify-content-between p-3 rounded border ' +
                        (isDone ? 'bg-success-subtle border-success' : isRework ? 'bg-danger-subtle border-danger' : isInProgress ? 'bg-warning-subtle border-warning' : 'bg-light border-secondary-subtle');

                    let statusBadge = '';
                    if (isDone) {
                        statusBadge = '<span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Pass (Completed)</span>';
                    } else if (isRework) {
                        statusBadge = '<span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle me-1"></i>Needs Rework</span>';
                    } else if (isInProgress) {
                        statusBadge = '<span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>In Progress</span>';
                    } else {
                        statusBadge = '<span class="badge bg-secondary text-white">Not Started</span>';
                    }

                    const tokenDisplay = u.TokenNo ? `<span class="badge bg-dark font-monospace text-white py-1 px-2" style="font-size:0.75rem;">${u.TokenNo}</span>` : '<span class="text-muted fst-italic small">Token pending</span>';
                    const progressDisplay = `<span class="small fw-semibold text-muted">Progress: <strong>${u.CompletedSteps || 0} / ${u.TotalSteps || 0}</strong> bolts</span>`;

                    let actionBtn = '';
                    if (isDone) {
                        actionBtn = '<button type="button" class="btn btn-outline-success btn-sm disabled" disabled><i class="bi bi-check-circle-fill me-1"></i>Passed</button>';
                    } else {
                        const btnLabel = (isInProgress || isRework) ? 'Resume Unit #' + u.UnitIndex : 'Start Unit #' + u.UnitIndex;
                        const btnClass = isRework ? 'btn-danger' : (isInProgress ? 'btn-warning text-dark' : 'btn-primary');
                        actionBtn = `<button type="button" class="btn ${btnClass} btn-sm fw-bold shadow-sm" onclick="selectAndLaunchUnit(${jobId}, '${startUrl}', ${u.UnitIndex})">
                            <i class="bi bi-play-circle-fill me-1"></i>${btnLabel}
                        </button>`;
                    }

                    item.innerHTML = `
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width:42px; height:42px; min-width:42px;">
                                #${u.UnitIndex}
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    ${tokenDisplay}
                                    ${statusBadge}
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    ${progressDisplay}
                                </div>
                            </div>
                        </div>
                        <div>
                            ${actionBtn}
                        </div>
                    `;
                    listEl.appendChild(item);
                });
            }

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        };

        window.selectAndLaunchUnit = function(jobId, startUrl, unitNo) {
            const modalEl = document.getElementById('chooseUnitModal');
            if (modalEl) {
                bootstrap.Modal.getInstance(modalEl)?.hide();
            }

            const equipped = getEquippedStationTool();
            if (equipped && equipped.type === 'ble') {
                if (!window.tohnichiBle || !window.tohnichiBle.isConnected) {
                    showToastAlert('<div class="spinner-border spinner-border-sm me-2 text-primary"></div>Connecting to ' + equipped.name + ' via Bluetooth...', 'info');
                    window.tohnichiBle.connect().then(() => {
                        if (window.tohnichiBle) {
                            window.tohnichiBle.onStatusChange = updateStationToolBanner;
                        }
                        updateStationToolBanner();
                        launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, unitNo);
                    }).catch(bleErr => {
                        console.warn("BLE connect deferred:", bleErr);
                        launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, unitNo);
                    });
                    return;
                }
                launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, unitNo);
            } else if (equipped && (equipped.torqueId || equipped.vernierId)) {
                launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, unitNo);
            } else {
                showToastAlert('<i class="bi bi-exclamation-triangle-fill text-warning me-2"></i><strong>Tool Required:</strong> Please connect a hardware tool before starting the job.', 'warning');
                const unitStartUrl = startUrl + (startUrl.includes('?') ? '&' : '?') + 'unitNo=' + unitNo;
                openToolPairingModal(jobId, null, null, unitStartUrl);
            }
        };

        async function handleJobActionClick(event, btn) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const jobId = btn.getAttribute('data-job-id');
            const jobNo = btn.getAttribute('data-job-no');
            const product = btn.getAttribute('data-product');
            const startUrl = btn.getAttribute('data-start-url') || `/Worker/JobBoard/Start/${jobId}`;
            const pendingUnitsJson = btn.getAttribute('data-pending-units');
            let pendingUnits = [];
            try {
                if (pendingUnitsJson) pendingUnits = JSON.parse(pendingUnitsJson);
            } catch(e) {}

            // If job has multiple units, open unit selection modal so worker chooses which unit to resume
            const incompleteUnits = pendingUnits.filter(u => !(u.Status === 3 || u.Status === 'Completed' || (!u.HasFailedStep && u.CompletedSteps >= u.TotalSteps && u.TotalSteps > 0)));
            if (pendingUnits.length > 1) {
                openChooseUnitModal(jobId, jobNo, product, startUrl, pendingUnits);
                return;
            }

            // Single unit: proceed directly
            const singleUnitNo = (incompleteUnits.length === 1) ? incompleteUnits[0].UnitIndex : (pendingUnits.length === 1 ? pendingUnits[0].UnitIndex : null);

            const equipped = getEquippedStationTool();

            if (equipped && equipped.type === 'ble') {
                // Ensure Bluetooth is actively connected before entering cockpit
                if (!window.tohnichiBle || !window.tohnichiBle.isConnected) {
                    showToastAlert('<div class="spinner-border spinner-border-sm me-2 text-primary"></div>Connecting to ' + equipped.name + ' via Bluetooth...', 'info');
                    try {
                        await window.tohnichiBle.connect();
                        if (window.tohnichiBle) {
                            window.tohnichiBle.onStatusChange = updateStationToolBanner;
                        }
                        updateStationToolBanner();
                    } catch(bleErr) {
                        console.warn("BLE connect deferred:", bleErr);
                    }
                }
                launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, singleUnitNo);
            } else if (equipped && (equipped.torqueId || equipped.vernierId)) {
                launchJobDirectly(jobId, startUrl, equipped.torqueId, equipped.vernierId, equipped.name, singleUnitNo);
            } else {
                // NOT EQUIPPED: First-time modal prompt to equip tool and start job
                showToastAlert('<i class="bi bi-exclamation-triangle-fill text-warning me-2"></i><strong>Tool Required:</strong> Please connect a hardware tool before starting the job.', 'warning');
                const finalStartUrl = singleUnitNo ? (startUrl + (startUrl.includes('?') ? '&' : '?') + 'unitNo=' + singleUnitNo) : startUrl;
                openToolPairingModal(btn, jobNo, product, finalStartUrl);
            }
        }

        async function launchJobDirectly(jobId, startUrl, torqueDeviceId, vernierDeviceId, toolName, unitNo) {
            btnDisableAllActions(true);
            showToastAlert('Starting assembly...', 'loading');

            let targetUrl = startUrl || `/Worker/JobBoard/Start/${jobId}`;
            if (unitNo && !targetUrl.includes('unitNo=')) {
                targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'unitNo=' + unitNo;
            }
            const formData = new FormData();
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);
            if (torqueDeviceId) formData.append('torqueDeviceId', torqueDeviceId);
            if (vernierDeviceId) formData.append('vernierDeviceId', vernierDeviceId);
            if (unitNo) formData.append('unitNo', unitNo);
            const isBleConnected = !!(window.tohnichiBle && window.tohnichiBle.isConnected);
            formData.append('isBleConnected', isBleConnected ? 'true' : 'false');

            try {
                const response = await fetch(targetUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Assembl-Shell': '1'
                    }
                });

                if (!response.ok) {
                    showToastAlert("Failed to start job (" + response.status + ")", "danger");
                    btnDisableAllActions(false);
                    return;
                }

                const contentType = response.headers.get("content-type") || "";
                if (contentType.includes("application/json")) {
                    const data = await response.json();
                    if (!data.success) {
                        showToastAlert(data.message || "Failed to start job.", "warning");
                        btnDisableAllActions(false);
                        return;
                    }
                    const executeUrl = data.executeUrl || `/Worker/JobBoard/Execute/${jobId}`;
                    if (window.assemblWorkerShell) {
                        await window.assemblWorkerShell.loadUrl(executeUrl);
                    } else {
                        window.location.href = executeUrl;
                    }
                } else {
                    const finalUrl = response.url || `/Worker/JobBoard/Execute/${jobId}`;
                    if (window.assemblWorkerShell) {
                        await window.assemblWorkerShell.loadUrl(finalUrl);
                    } else {
                        window.location.href = finalUrl;
                    }
                }
            } catch (err) {
                console.error("Direct launch error:", err);
                btnDisableAllActions(false);
                showToastAlert("Error launching assembly: " + err.message, "danger");
            }
        }

        async function pairBluetoothWrenchInModal() {
            if (!window.tohnichiBle) {
                alert("Bluetooth driver not loaded. Please refresh.");
                return;
            }

            const btn = document.getElementById("btn-modal-pair-ble");
            const btnText = document.getElementById("btn-modal-pair-ble-text");
            const alertBox = document.getElementById("pairingBleSuccessAlert");
            const alertText = document.getElementById("pairingBleSuccessText");
            const torqueSelect = document.getElementById("modalTorqueSelect");
            const vernierSelect = document.getElementById("modalVernierSelect");

            if (!navigator.bluetooth) {
                if (alertBox && alertText) {
                    alertText.innerHTML = `<strong>Direct Mode:</strong> Telemetry streams automatically via your Station Node Gateway. Select your wrench in the dropdown below or scan the Tool QR code.`;
                    alertBox.className = "alert alert-info py-2 px-3 small mt-2 mb-0 text-start border-info";
                    alertBox.classList.remove("d-none");
                }
                return;
            }

            try {
                if (btn) btn.disabled = true;
                if (btnText) btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Scanning...';

                const conn = await window.tohnichiBle.connect();
                const toolName = conn.name || ("CEM3-G-BT_" + conn.serial + "_BLE");
                const serial = conn.serial || "704620P";

                // Save auto-connect flag for seamless transition to Execute page
                localStorage.setItem('assembl_ble_auto_connect', 'true');
                localStorage.setItem('assembl_active_ble_tool', toolName);
                localStorage.setItem('assembl_active_ble_serial', serial);
                localStorage.setItem('assembl_ble_paired', 'true');
                localStorage.setItem('assembl_station_torque_name', toolName);
                localStorage.setItem('assembl_station_tool_type', 'ble');
                if (window.tohnichiBle) {
                window.tohnichiBle.onStatusChange = updateStationToolBanner;
            }
            updateStationToolBanner();

                // Deselect vernier caliper (rule: only one instrument at a time)
                if (vernierSelect) vernierSelect.value = "";

                // Select or inject into the torque wrench dropdown
                let matched = false;
                if (torqueSelect) {
                    for (let i = 0; i < torqueSelect.options.length; i++) {
                        const opt = torqueSelect.options[i];
                        const text = opt.text.toLowerCase();
                        if (text.includes(serial.toLowerCase()) || text.includes("cem3") || text.includes("tohnichi") || opt.value === "6") {
                            torqueSelect.selectedIndex = i;
                            matched = true;
                            break;
                        }
                    }

                    if (!matched) {
                        const newOpt = document.createElement("option");
                        newOpt.value = "6";
                        newOpt.text = `Tohnichi BLE Wrench (${serial}) • [Bluetooth Connected]`;
                        newOpt.selected = true;
                        torqueSelect.appendChild(newOpt);
                    }

                    if (torqueSelect.value) {
                        localStorage.setItem('assembl_active_ble_id', torqueSelect.value);
                        localStorage.setItem('assembl_station_torque_id', torqueSelect.value);
                    }

                    torqueSelect.classList.remove('is-invalid');
                    document.getElementById('toolSelectionRequiredAlert')?.classList.add('d-none');
                }

                // UI State: Hide dropdowns and display the connected Bluetooth info card
                const bleCard = document.getElementById("bleConnectedInfoCard");
                const bleCardName = document.getElementById("bleCardToolName");
                const manualArea = document.getElementById("manualToolSelectionArea");

                if (bleCard && bleCardName && manualArea) {
                    bleCardName.textContent = toolName;
                    bleCard.classList.remove("d-none");
                    manualArea.classList.add("d-none");
                }

                if (alertBox && alertText) {
                    alertText.innerHTML = `<strong>Bluetooth Connected:</strong> ${toolName} (Ready for Assembly)`;
                    alertBox.classList.remove("d-none");
                }

                if (btn) {
                    btn.className = "btn btn-sm btn-success fw-semibold px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1.5";
                    if (btnText) btnText.innerHTML = '<i class="bi bi-check2-circle me-1"></i>BLE Connected';
                }

                if (typeof playOperatorFeedback === 'function') {
                    playOperatorFeedback(true);
                }

            } catch (err) {
                console.warn("[BLE Pair]:", err);
                if (btn) {
                    btn.className = "btn btn-sm btn-outline-primary fw-semibold px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1.5";
                    if (btnText) btnText.textContent = 'Or Connect via Bluetooth';
                }
                if (alertBox && alertText) {
                    if (err.name !== 'NotFoundError') {
                        alertText.innerHTML = `<strong>Bluetooth Note:</strong> ${err.message || 'Connection cancelled'}`;
                        alertBox.className = "alert alert-warning py-1.5 px-3 small mt-2 mb-0 text-start border-warning";
                        alertBox.classList.remove("d-none");
                    }
                }
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        function disconnectBleInModal() {
            if (window.tohnichiBle) {
                window.tohnichiBle.disconnect();
            }
            localStorage.removeItem('assembl_ble_auto_connect');
            localStorage.removeItem('assembl_active_ble_tool');
            localStorage.removeItem('assembl_active_ble_serial');

            const bleCard = document.getElementById("bleConnectedInfoCard");
            const manualArea = document.getElementById("manualToolSelectionArea");
            const btn = document.getElementById("btn-modal-pair-ble");
            const btnText = document.getElementById("btn-modal-pair-ble-text");
            const alertBox = document.getElementById("pairingBleSuccessAlert");

            if (bleCard) bleCard.classList.add("d-none");
            if (manualArea) manualArea.classList.remove("d-none");
            if (alertBox) alertBox.classList.add("d-none");
            if (btn) {
                btn.className = "btn btn-sm btn-outline-primary fw-semibold px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1.5";
                if (btnText) btnText.innerHTML = '<i class="bi bi-bluetooth"></i><span>Or Connect via Bluetooth</span>';
            }
        }

        // ----- Calibration warnings while selecting a device (informational) -----
        function updatePairCalAlert(selectEl, alertElId) {
            var alertEl = document.getElementById(alertElId);
            if (!selectEl || !alertEl) return;
            var opt = selectEl.options[selectEl.selectedIndex];
            var status = opt ? (opt.getAttribute("data-cal-status") || "") : "";
            var due = opt ? (opt.getAttribute("data-cal-due") || "") : "";
            if (!status) {
                alertEl.classList.add("d-none");
                alertEl.innerHTML = "";
                return;
            }
            if (status === "overdue") {
                alertEl.className = "alert alert-danger py-2 px-3 small mt-2 mb-3 border-danger d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong class="text-danger">Calibration overdue since <span class="badge bg-danger text-white ms-1">' + due + '</span></strong></span>';
            } else {
                alertEl.className = "alert alert-warning py-2 px-3 small mt-2 mb-3 border-warning d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-6"></i><span><strong class="text-dark">Calibration due on <span class="badge bg-warning text-dark ms-1">' + due + '</span></strong></span>';
            }
            alertEl.classList.remove("d-none");
        }
        function syncToolPairCalAlerts() {
            updatePairCalAlert(document.getElementById("modalTorqueSelect"), "pairToolTorqueCalAlert");
            updatePairCalAlert(document.getElementById("modalVernierSelect"), "pairToolVernierCalAlert");
        }
        var toolPairAlertModal = document.getElementById("toolPairingModal");
        if (toolPairAlertModal) toolPairAlertModal.addEventListener("shown.bs.modal", syncToolPairCalAlerts);

        function setupToolPairingModal(jobId, jobNo, product, startUrl) {
            const modalJobNo = document.getElementById('modalJobNo');
            const modalProduct = document.getElementById('modalProduct');
            const form = document.getElementById('toolPairingForm');
            const reqAlert = document.getElementById('toolSelectionRequiredAlert');
            const jobAlert = document.getElementById('modalJobContextAlert');
            const titleEl = document.getElementById('toolPairingModalLabel');
            const submitText = document.getElementById('text-submit-tool-pairing');
            const submitIcon = document.getElementById('icon-submit-tool-pairing');

            if (jobId) {
                if (!jobNo || !product) {
                    const triggerBtn = document.querySelector(`button[data-job-id="${jobId}"]`);
                    if (triggerBtn) {
                        jobNo = jobNo || triggerBtn.getAttribute('data-job-no') || '';
                        product = product || triggerBtn.getAttribute('data-product') || '';
                        startUrl = startUrl || triggerBtn.getAttribute('data-start-url') || '';
                    }
                }

                if (jobAlert) jobAlert.classList.remove('d-none');
                if (modalJobNo) modalJobNo.textContent = jobNo || ('Job #' + jobId);
                if (modalProduct) modalProduct.textContent = product || '';
                if (titleEl) titleEl.innerHTML = '<i class="bi bi-tools me-2"></i>Tool Pairing Setup';
                if (submitText) submitText.textContent = 'Confirm & Start Assembly';
                if (submitIcon) submitIcon.className = 'bi bi-play-circle-fill me-1';

                const targetUrl = startUrl || `/Worker/JobBoard/Start/${jobId}`;
                if (form) {
                    form.setAttribute('action', targetUrl);
                    form.dataset.mode = 'job';
                }
            } else {
                if (jobAlert) jobAlert.classList.add('d-none');
                if (titleEl) titleEl.innerHTML = '<i class="bi bi-tools me-2"></i>Station Hardware Tool Pairing';
                if (submitText) submitText.textContent = 'Equip Station Tool';
                if (submitIcon) submitIcon.className = 'bi bi-check2-circle me-1';
                if (form) {
                    form.setAttribute('action', '#');
                    form.dataset.mode = 'station';
                }
            }

            // Reset validation alerts
            if (reqAlert) reqAlert.classList.add('d-none');
            document.getElementById('modalTorqueSelect')?.classList.remove('is-invalid');
            document.getElementById('modalVernierSelect')?.classList.remove('is-invalid');

            // Pre-select equipped or sticky tool ONLY if available (online & unlocked)
            const torqueSelect = document.getElementById('modalTorqueSelect');
            const vernierSelect = document.getElementById('modalVernierSelect');
            const equipped = getEquippedStationTool();
            const stickyTorque = equipped?.torqueId || localStorage.getItem('assembl_sticky_torque_id');
            const stickyVernier = equipped?.vernierId || localStorage.getItem('assembl_sticky_vernier_id');

            if (torqueSelect && stickyTorque && isDeviceOptionAvailable('modalTorqueSelect', stickyTorque)) {
                torqueSelect.value = stickyTorque;
                if (vernierSelect) vernierSelect.value = '';
            } else if (vernierSelect && stickyVernier && isDeviceOptionAvailable('modalVernierSelect', stickyVernier)) {
                vernierSelect.value = stickyVernier;
                if (torqueSelect) torqueSelect.value = '';
            } else {
                // Only auto-select an online, unlocked digital option; otherwise leave blank ("-- Select --")
                if (torqueSelect) torqueSelect.value = '';
                if (vernierSelect) vernierSelect.value = '';
                if (torqueSelect) {
                    const firstOnlineOpt = Array.from(torqueSelect.options).find(o => o.value && !o.disabled && o.dataset.online === 'true' && o.dataset.manual !== 'true');
                    if (firstOnlineOpt) {
                        torqueSelect.value = firstOnlineOpt.value;
                    }
                }
            }
            syncToolPairCalAlerts();

            // Save sticky tool choice on form submit
            if (form && !form.dataset.stickyBound) {
                form.dataset.stickyBound = "true";
                form.addEventListener('submit', function() {
                    const tSel = document.getElementById('modalTorqueSelect');
                    const vSel = document.getElementById('modalVernierSelect');
                    if (tSel && tSel.value) {
                        localStorage.setItem('assembl_sticky_torque_id', tSel.value);
                        localStorage.removeItem('assembl_sticky_vernier_id');
                    } else if (vSel && vSel.value) {
                        localStorage.setItem('assembl_sticky_vernier_id', vSel.value);
                        localStorage.removeItem('assembl_sticky_torque_id');
                    }
                });
            }

            // Bluetooth state sync: if Bluetooth is already connected, show card and hide dropdowns
            const bleCard = document.getElementById("bleConnectedInfoCard");
            const bleCardName = document.getElementById("bleCardToolName");
            const manualArea = document.getElementById("manualToolSelectionArea");
            const isBleConnected = !!(window.tohnichiBle && window.tohnichiBle.isConnected);

            if (isBleConnected && bleCard && manualArea) {
                if (bleCardName) bleCardName.textContent = window.tohnichiBle.device?.name || "Tohnichi CEM3-G-BT (Connected)";
                bleCard.classList.remove("d-none");
                manualArea.classList.add("d-none");
            } else if (bleCard && manualArea) {
                bleCard.classList.add("d-none");
                manualArea.classList.remove("d-none");
            }
        }

        window.openToolPairingModal = function(triggerEl, jobNo, product, startUrl) {
            let jobId = '';
            if (typeof triggerEl === 'object' && triggerEl !== null) {
                const btn = triggerEl.closest('[data-job-id]') || triggerEl;
                jobId = btn.getAttribute('data-job-id') || '';
                jobNo = btn.getAttribute('data-job-no') || jobNo || '';
                product = btn.getAttribute('data-product') || product || '';
                startUrl = btn.getAttribute('data-start-url') || startUrl || '';
            } else if (typeof triggerEl === 'string' || typeof triggerEl === 'number') {
                jobId = String(triggerEl);
            }

            setupToolPairingModal(jobId, jobNo, product, startUrl);

            const modalEl = document.getElementById('toolPairingModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        };

        const toolModal = document.getElementById('toolPairingModal');
        if (toolModal) {
            toolModal.addEventListener('show.bs.modal', function (event) {
                const form = document.getElementById('toolPairingForm');
                if (form && form.dataset.mode === 'station') {
                    // Strictly station pairing mode, do not attach any job
                    return;
                }
                let target = event.relatedTarget ? (event.relatedTarget.closest('[data-job-id]') || event.relatedTarget) : null;
                if (!target) {
                    const activeEl = document.activeElement;
                    if (activeEl && activeEl.closest) {
                        target = activeEl.closest('[data-job-id]');
                    }
                }
                if (target && target.hasAttribute('data-job-id')) {
                    const jobId = target.getAttribute('data-job-id') || '';
                    const jobNo = target.getAttribute('data-job-no') || '';
                    const product = target.getAttribute('data-product') || '';
                    const startUrl = target.getAttribute('data-start-url') || '';
                    if (jobId) {
                        setupToolPairingModal(jobId, jobNo, product, startUrl);
                    }
                }
            });
        }

        // Mutual tool exclusivity: selecting Torque clears Vernier and vice-versa
        const modalTorqueSelectEl = document.getElementById('modalTorqueSelect');
        const modalVernierSelectEl = document.getElementById('modalVernierSelect');

        function clearToolPairingValidation() {
            const torqueVal = modalTorqueSelectEl?.value;
            const vernierVal = modalVernierSelectEl?.value;
            if ((torqueVal || vernierVal) && !(torqueVal && vernierVal)) {
                const reqAlert = document.getElementById('toolSelectionRequiredAlert');
                if (reqAlert) reqAlert.classList.add('d-none');
                modalTorqueSelectEl?.classList.remove('is-invalid');
                modalVernierSelectEl?.classList.remove('is-invalid');
            }
        }

        if (modalTorqueSelectEl) {
            modalTorqueSelectEl.addEventListener('change', function () {
                if (this.value && modalVernierSelectEl) {
                    modalVernierSelectEl.value = '';
                    updatePairCalAlert(modalVernierSelectEl, 'pairToolVernierCalAlert');
                    modalVernierSelectEl.classList.remove('is-invalid');
                }
                syncToolPairCalAlerts();
                clearToolPairingValidation();
            });
        }

        if (modalVernierSelectEl) {
            modalVernierSelectEl.addEventListener('change', function () {
                if (this.value && modalTorqueSelectEl) {
                    modalTorqueSelectEl.value = '';
                    updatePairCalAlert(modalTorqueSelectEl, 'pairToolTorqueCalAlert');
                    modalTorqueSelectEl.classList.remove('is-invalid');
                }
                syncToolPairCalAlerts();
                clearToolPairingValidation();
            });
        }

        // Validate that exactly one tool (either Torque Wrench OR Vernier Caliper) is selected before starting
        const pairingForm = document.getElementById('toolPairingForm');
        if (pairingForm) {
            pairingForm.addEventListener('submit', async function (e) {
                const torqueVal = modalTorqueSelectEl?.value;
                const vernierVal = modalVernierSelectEl?.value;
                const reqAlert = document.getElementById('toolSelectionRequiredAlert');
                const isBleActive = !!(window.tohnichiBle && window.tohnichiBle.isConnected);

                if (!torqueVal && !vernierVal && !isBleActive) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                    if (reqAlert) {
                        reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong>No Active Tool Selected:</strong> Please connect an online hardware tool or pair via Bluetooth before proceeding.</span>';
                        reqAlert.classList.remove('d-none');
                    }
                    modalTorqueSelectEl?.classList.add('is-invalid');
                    modalVernierSelectEl?.classList.add('is-invalid');
                    return false;
                }

                // Validate that manually selected tool is actually online/available (unless connected via live Web Bluetooth)
                if (!isBleActive) {
                    const selectedSel = torqueVal ? modalTorqueSelectEl : (vernierVal ? modalVernierSelectEl : null);
                    const selectedOpt = selectedSel && selectedSel.selectedIndex >= 0 ? selectedSel.options[selectedSel.selectedIndex] : null;
                    if (selectedOpt && (selectedOpt.disabled || selectedOpt.dataset.online !== 'true')) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                        if (reqAlert) {
                            reqAlert.innerHTML = '<i class="bi bi-wifi-off text-danger me-2 fs-6"></i><span><strong>Tool Unavailable / Offline:</strong> The selected tool is currently offline. Only active online ESP32 nodes or paired Bluetooth tools can be equipped.</span>';
                            reqAlert.classList.remove('d-none');
                        }
                        selectedSel.classList.add('is-invalid');
                        return false;
                    }
                }

                // If BLE connected and no select value was chosen, select Bluetooth device option so server model binds correctly
                if (isBleActive && !torqueVal && !vernierVal && modalTorqueSelectEl && modalTorqueSelectEl.options.length > 1) {
                    let bleOptionIdx = -1;
                    const activeBleSerial = localStorage.getItem('assembl_active_ble_serial') || '704620P';
                    for (let i = 1; i < modalTorqueSelectEl.options.length; i++) {
                        const opt = modalTorqueSelectEl.options[i];
                        if (opt.value === '6' || opt.text.includes(activeBleSerial) || opt.text.includes('CEM3') || opt.text.includes('Tohnichi')) {
                            bleOptionIdx = i;
                            break;
                        }
                    }
                    modalTorqueSelectEl.selectedIndex = bleOptionIdx !== -1 ? bleOptionIdx : 1;
                }

                const finalTorqueVal = modalTorqueSelectEl?.value;
                const finalVernierVal = modalVernierSelectEl?.value;

                if (finalTorqueVal && finalVernierVal) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                    if (reqAlert) {
                        reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong>Single Tool Only:</strong> Please select either a Torque Wrench OR a Vernier Caliper, not both.</span>';
                        reqAlert.classList.remove('d-none');
                    }
                    modalTorqueSelectEl?.classList.add('is-invalid');
                    modalVernierSelectEl?.classList.add('is-invalid');
                    return false;
                }

                if (pairingForm.dataset.mode === 'station') {
                    e.preventDefault();
                    e.stopPropagation();

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    try {
                        const resp = await fetch('/Worker/JobBoard/SetStationTool', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                torqueDeviceId: finalTorqueVal ? parseInt(finalTorqueVal) : null,
                                vernierDeviceId: finalVernierVal ? parseInt(finalVernierVal) : null,
                                isBleConnected: isBleActive
                            })
                        });
                        const resData = await resp.json();
                        if (!resData.success) {
                            if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                            if (reqAlert) {
                                reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span>' + (resData.message || 'Tool is currently unavailable.') + '</span>';
                                reqAlert.classList.remove('d-none');
                            }
                            return false;
                        }
                    } catch (err) {
                        console.warn('SetStationTool error:', err);
                        if (reqAlert) {
                            reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span>Failed to verify tool availability with server.</span>';
                            reqAlert.classList.remove('d-none');
                        }
                        return false;
                    }

                    // Persist only after server confirmed tool is available
                    if (finalTorqueVal) {
                        const optText = modalTorqueSelectEl.options[modalTorqueSelectEl.selectedIndex]?.text || '';
                        const cleanName = optText.split('•')[0].trim();
                        localStorage.setItem('assembl_station_torque_id', finalTorqueVal);
                        localStorage.setItem('assembl_station_torque_name', cleanName);
                        localStorage.setItem('assembl_station_tool_type', isBleActive ? 'ble' : 'torque');
                        localStorage.setItem('assembl_sticky_torque_id', finalTorqueVal);
                        localStorage.removeItem('assembl_station_vernier_id');
                        localStorage.removeItem('assembl_station_vernier_name');
                        localStorage.removeItem('assembl_sticky_vernier_id');
                    } else if (finalVernierVal) {
                        const optText = modalVernierSelectEl.options[modalVernierSelectEl.selectedIndex]?.text || '';
                        const cleanName = optText.split('•')[0].trim();
                        localStorage.setItem('assembl_station_vernier_id', finalVernierVal);
                        localStorage.setItem('assembl_station_vernier_name', cleanName);
                        localStorage.setItem('assembl_station_tool_type', 'vernier');
                        localStorage.setItem('assembl_sticky_vernier_id', finalVernierVal);
                        localStorage.removeItem('assembl_station_torque_id');
                        localStorage.removeItem('assembl_station_torque_name');
                        localStorage.removeItem('assembl_sticky_torque_id');
                    }

                    if (window.tohnichiBle) {
                        window.tohnichiBle.onStatusChange = updateStationToolBanner;
                    }
                    updateStationToolBanner();

                    const modalEl = document.getElementById('toolPairingModal');
                    if (modalEl) {
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                    }
                    showToastAlert('Station tool successfully equipped! All assembly jobs will now use this tool without prompting.', 'success');
                    return false;
                } else {
                    // 'job' mode: Equip tool and start job directly via seamless SPA without page reload
                    e.preventDefault();
                    e.stopPropagation();

                    const modalEl = document.getElementById('toolPairingModal');
                    if (modalEl) {
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                    }

                    const jobId = pairingForm.dataset.jobId;
                    const startUrl = pairingForm.action;
                    const toolDisplayName = (finalTorqueVal ? modalTorqueSelectEl.options[modalTorqueSelectEl.selectedIndex]?.text : modalVernierSelectEl.options[modalVernierSelectEl.selectedIndex]?.text) || 'equipped tool';
                    launchJobDirectly(jobId, startUrl, finalTorqueVal, finalVernierVal, toolDisplayName);
                    return false;
                }
            });
        }

        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            connection.on("BlackJobAlert", function (data) {
                console.log("BlackJobAlert received via SignalR:", data);
                const alertBox = document.getElementById("live-black-job-alert");
                const alertMsg = document.getElementById("black-alert-message");
                if (alertBox) {
                    if (data && data.message) alertMsg.textContent = data.message;
                    alertBox.classList.remove("d-none");
                }
            });

            connection.start().then(function () {
                connection.invoke("JoinWorkers");
            }).catch(function (err) {
                console.warn("SignalR connection error:", err);
            });
        }

        // ---------------------------------------------------------------
        // Job rows: live search + status/priority/line filters (client-side)
        // ---------------------------------------------------------------

        function applyJobFilters() {
            var searchInput = document.getElementById("job-search-input");
            var statusSel = document.getElementById("filter-status");
            var prioSel = document.getElementById("filter-priority");
            if (!searchInput || !statusSel || !prioSel) return;

            var q = (searchInput.value || "").trim().toLowerCase();
            var st = statusSel.value;
            var pr = prioSel.value;

            var rows = document.querySelectorAll("#job-rows-table tr.job-row");
            var visible = 0;
            for (var i = 0; i < rows.length; i++) {
                var tr = rows[i];
                var ok = true;
                if (st && tr.getAttribute("data-status") !== st) ok = false;
                if (ok && pr && tr.getAttribute("data-priority") !== pr) ok = false;
                if (ok && q) {
                    var hay = tr.getAttribute("data-search") || "";
                    if (hay.indexOf(q) === -1) ok = false;
                }
                tr.classList.toggle("d-none", !ok);
                if (ok) visible++;
            }

            var countEl = document.getElementById("job-row-count");
            if (countEl) countEl.textContent = "Showing " + visible + " of " + rows.length + " job(s)";

            var nomatch = document.getElementById("job-rows-nomatch");
            if (nomatch) nomatch.classList.toggle("d-none", visible !== 0);

            var wrap = document.getElementById("job-rows-table-wrap");
            if (wrap) wrap.classList.toggle("d-none", visible === 0);
        }

        ["job-search-input", "filter-status", "filter-priority"].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener(el.tagName === "SELECT" ? "change" : "input", applyJobFilters);
        });

        var btnFilterClear = document.getElementById("btn-filter-clear");
        if (btnFilterClear) {
            btnFilterClear.addEventListener("click", function () {
                var s = document.getElementById("job-search-input");
                if (s) s.value = "";
                ["filter-status", "filter-priority"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = "";
                });
                applyJobFilters();
            });
        }

        // Clicking a row (outside its buttons/links) resumes/claims the job
        // via its tool-pairing button; details links stay on <a> elements
        // (/Job/Detail is Admin-only, so workers never get navigated there).
        (function () {
            var table = document.getElementById("job-rows-table");
            if (!table) return;
            table.addEventListener("click", function (e) {
                if (e.target.closest("a,button,select,input,label")) return;
                var tr = e.target.closest("tr.job-row");
                if (!tr) return;
                var actionBtn = tr.querySelector(".btn-job-action");
                if (actionBtn && !actionBtn.disabled) {
                    actionBtn.click();
                    return;
                }
                var href = tr.getAttribute("data-detail-url");
                if (href) window.location = href;
            });
        })();

        applyJobFilters();

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // ----- Station switch: Searchable line and workstation selector -----
        (function () {
            var lineInput = document.getElementById("stationLineValue");
            var lineBtn = document.getElementById("stationLineBtn");
            var lineBtnText = document.getElementById("stationLineBtnText");
            var lineList = document.getElementById("lineDropdownItemsList");
            var searchLineInput = document.getElementById("searchLineFilterInput");
            var noLinesMsg = document.getElementById("noLinesFoundMsg");

            var workStationInput = document.getElementById("workStationValue");
            var workStationBtn = document.getElementById("workStationBtn");
            var workStationBtnText = document.getElementById("workStationBtnText");
            var workStationContainer = document.getElementById("workStationListContainer");
            var searchStationInput = document.getElementById("searchStationFilterInput");

            var form = document.getElementById("switchAssemblyLineForm") || document.querySelector("#switchAssemblyLineModal form");
            if (!lineInput || !lineBtn || !lineList) return;

            // Stop propagation on search inputs so clicking / typing inside does NOT close Bootstrap dropdown
            [searchLineInput, searchStationInput].forEach(function (inp) {
                if (!inp) return;
                inp.addEventListener("click", function (e) { e.stopPropagation(); });
                inp.addEventListener("mousedown", function (e) { e.stopPropagation(); });
                inp.addEventListener("keydown", function (e) { e.stopPropagation(); });
                inp.addEventListener("keyup", function (e) { e.stopPropagation(); });
            });

            // Do NOT auto-focus search input on dropdown open so soft keyboard stays closed until tapped
            // Real-time filter for assembly lines
            if (searchLineInput && lineList) {
                searchLineInput.addEventListener("input", function () {
                    var q = (this.value || "").trim().toLowerCase();
                    var items = lineList.querySelectorAll(".filterable-line-item");
                    var visibleCount = 0;
                    items.forEach(function (item) {
                        var text = (item.getAttribute("data-search-text") || item.textContent || "").toLowerCase();
                        if (!q || text.indexOf(q) !== -1) {
                            item.classList.remove("d-none");
                            visibleCount++;
                        } else {
                            item.classList.add("d-none");
                        }
                    });
                    if (noLinesMsg) {
                        if (visibleCount === 0) {
                            noLinesMsg.classList.remove("d-none");
                        } else {
                            noLinesMsg.classList.add("d-none");
                        }
                    }
                });
            }

            // Handle assembly line selection
            lineList.querySelectorAll(".filterable-line-item").forEach(function (item) {
                item.addEventListener("click", function () {
                    lineList.querySelectorAll(".filterable-line-item.active").forEach(function (el) {
                        el.classList.remove("active", "fw-bold");
                    });
                    item.classList.add("active", "fw-bold");
                    var val = item.getAttribute("data-value") || "";
                    var isDept = item.getAttribute("data-is-dept") === "true";
                    lineInput.value = val;
                    if (lineBtnText) {
                        lineBtnText.textContent = item.textContent.trim();
                    } else {
                        lineBtn.textContent = item.textContent.trim();
                    }
                    lineBtn.classList.remove("is-invalid", "border-danger");

                    // Close dropdown
                    var bsLineDropdown = bootstrap.Dropdown.getInstance(lineBtn);
                    if (bsLineDropdown) bsLineDropdown.hide();

                    if (isDept || !val) {
                        // Department Mode: Workstation is not applicable
                        if (workStationBtn) {
                            workStationBtn.disabled = true;
                            if (workStationBtnText) {
                                workStationBtnText.textContent = "— Department-wide (All Workstations) —";
                            }
                        }
                        if (workStationContainer) {
                            workStationContainer.innerHTML = '<div class="dropdown-item text-muted text-center py-2">All workstations accessible in Department mode</div>';
                        }
                        if (workStationInput) workStationInput.value = "";
                    } else {
                        // Load workstations for selected assembly line
                        loadWorkStations(val, "");
                    }
                });
            });

            // Do NOT auto-focus search input on workstation dropdown open so soft keyboard stays closed until tapped
            // Real-time filter for workstations
            if (searchStationInput && workStationContainer) {
                searchStationInput.addEventListener("input", function () {
                    var q = (this.value || "").trim().toLowerCase();
                    var items = workStationContainer.querySelectorAll(".filterable-station-item");
                    var visibleCount = 0;
                    items.forEach(function (item) {
                        var text = (item.getAttribute("data-search-text") || item.textContent || "").toLowerCase();
                        if (!q || text.indexOf(q) !== -1) {
                            item.classList.remove("d-none");
                            visibleCount++;
                        } else {
                            item.classList.add("d-none");
                        }
                    });
                    var noStationEl = workStationContainer.querySelector("#noStationsFoundMsg");
