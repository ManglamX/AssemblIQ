                </div>

                <div class="mb-2">
                    <label class="form-label small fw-bold text-dark">Rework Reason &amp; Issue Description <span class="text-danger">*</span></label>
                    <textarea class="form-control form-control-sm" id="purReasonInput" rows="3" required
                              placeholder="Describe why this unit needs rework (e.g. QC found loose lock screw, scratch touchup re-tightening)..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning btn-sm fw-bold px-3 shadow-sm" id="btnSubmitPassedUnitRework" onclick="proceedToReworkScope()">
                    <i class="bi bi-arrow-repeat me-1"></i> Configure Rework Workload &amp; Scope &rarr;
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes prdScanBeam {
        0% { top: 0%; opacity: 0.2; }
        50% { top: 100%; opacity: 1; }
        100% { top: 0%; opacity: 0.2; }
    }
</style>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>

        // ----- Calibration warnings while selecting a device (informational) -----
        function updatePairCalAlert(selectEl, alertElId) {
            var alertEl = document.getElementById(alertElId);
            if (!selectEl || !alertEl) return;
            var opt = selectEl.options[selectEl.selectedIndex];
            var status = opt ? (opt.getAttribute("data-cal-status") || "") : "";
            var due = opt ? (opt.getAttribute("data-cal-due") || "") : "";
            if (!status) {
                alertEl.classList.add("d-none");
                alertEl.innerHTML = "";
                return;
            }
            if (status === "overdue") {
                alertEl.className = "alert alert-danger py-2 px-3 small mt-2 mb-3 border-danger d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong class="text-danger">Calibration overdue since <span class="badge bg-danger text-white ms-1">' + due + '</span></strong></span>';
            } else {
                alertEl.className = "alert alert-warning py-2 px-3 small mt-2 mb-3 border-warning d-flex align-items-center";
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-6"></i><span><strong class="text-dark">Calibration due on <span class="badge bg-warning text-dark ms-1">' + due + '</span></strong></span>';
            }
            alertEl.classList.remove("d-none");
        }
        function syncToolPairCalAlerts() {
            updatePairCalAlert(document.getElementById("modalTorqueSelect"), "pairToolTorqueCalAlert");
            updatePairCalAlert(document.getElementById("modalVernierSelect"), "pairToolVernierCalAlert");
        }
        var toolPairAlertModal = document.getElementById("toolPairingModal");
        if (toolPairAlertModal) toolPairAlertModal.addEventListener("shown.bs.modal", syncToolPairCalAlerts);

        function setupToolPairingModal(jobId, jobNo, product, startUrl) {
            if (!jobId) return;

            const modalJobNo = document.getElementById('modalJobNo');
            const modalProduct = document.getElementById('modalProduct');
            const form = document.getElementById('toolPairingForm');
            const unitSelect = document.getElementById('modalUnitSelect');
            const reqAlert = document.getElementById('toolSelectionRequiredAlert');

            if (!jobNo || !product) {
                const triggerBtn = document.querySelector(`button[data-job-id="${jobId}"]`);
                if (triggerBtn) {
                    jobNo = jobNo || triggerBtn.getAttribute('data-job-no') || '';
                    product = product || triggerBtn.getAttribute('data-product') || '';
                    startUrl = startUrl || triggerBtn.getAttribute('data-start-url') || '';
                }
            }

            if (modalJobNo) modalJobNo.textContent = jobNo || ('Job #' + jobId);
            if (modalProduct) modalProduct.textContent = product || '';

            const targetUrl = startUrl || `/Worker/JobBoard/Start/${jobId}`;
            if (form) form.setAttribute('action', targetUrl);

            // Reset validation alerts
            if (reqAlert) reqAlert.classList.add('d-none');
            document.getElementById('modalTorqueSelect')?.classList.remove('is-invalid');
            document.getElementById('modalVernierSelect')?.classList.remove('is-invalid');

            // Sticky Tool auto-recall from localStorage
            const torqueSelect = document.getElementById('modalTorqueSelect');
            const vernierSelect = document.getElementById('modalVernierSelect');
            const stickyTorque = localStorage.getItem('assembl_sticky_torque_id');
            const stickyVernier = localStorage.getItem('assembl_sticky_vernier_id');

            if (torqueSelect && stickyTorque && Array.from(torqueSelect.options).some(o => o.value === stickyTorque)) {
                torqueSelect.value = stickyTorque;
                if (vernierSelect) vernierSelect.value = '';
            } else if (vernierSelect && stickyVernier && Array.from(vernierSelect.options).some(o => o.value === stickyVernier)) {
                vernierSelect.value = stickyVernier;
                if (torqueSelect) torqueSelect.value = '';
            } else if (torqueSelect && !torqueSelect.value && (!vernierSelect || !vernierSelect.value)) {
                if (torqueSelect.options.length >= 2 && torqueSelect.options[1].value) {
                    torqueSelect.selectedIndex = 1;
                }
            }
            syncToolPairCalAlerts();

            // Save sticky tool choice on form submit
            if (form && !form.dataset.stickyBound) {
                form.dataset.stickyBound = "true";
                form.addEventListener('submit', function() {
                    const tSel = document.getElementById('modalTorqueSelect');
                    const vSel = document.getElementById('modalVernierSelect');
                    if (tSel && tSel.value) {
                        localStorage.setItem('assembl_sticky_torque_id', tSel.value);
                        localStorage.removeItem('assembl_sticky_vernier_id');
                    } else if (vSel && vSel.value) {
                        localStorage.setItem('assembl_sticky_vernier_id', vSel.value);
                        localStorage.removeItem('assembl_sticky_torque_id');
                    }
                });
            }

            // Populate units dropdown
            if (unitSelect) {
                unitSelect.disabled = false;
                unitSelect.innerHTML = '<option value="">Loading product units...</option>';

                fetch(`/Worker/JobBoard/Units/${jobId}`)
                    .then(r => {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.json();
                    })
                    .then(units => {
                        unitSelect.innerHTML = '';
                        if (!units || units.length === 0) {
                            unitSelect.innerHTML = '<option value="1">Unit #1 (Default)</option>';
                            return;
                        }
                        let selected = false;
                        units.forEach(u => {
                            const opt = document.createElement('option');
                            const uIdx = u.unitIndex || u.UnitIndex || 1;
                            const tNo = u.tokenNo || u.TokenNo || '';
                            const st = u.status || u.Status || 'Pending';
                            const rCount = u.reworkCount || u.ReworkCount || 0;
                            opt.value = uIdx;
                            const isDone = st === 'Completed';
                            const isRework = st === 'Rework' || rCount > 0;
                            const isFail = st === 'Failed';
                            let badge = ' [Pending]';
                            if (isRework) {
                                badge = ` [⚠ Rework #${rCount || 1}]`;
                            } else if (isDone) {
                                badge = ' [✓ Done/Passed]';
                            } else if (isFail) {
                                badge = ' [⚠ Failed]';
                            }
                            opt.textContent = `Unit #${uIdx}: ${tNo}${badge}`;
                            if (!selected && (!isDone || isRework)) {
                                opt.selected = true;
                                selected = true;
                            }
                            unitSelect.appendChild(opt);
                        });
                        if (!selected && unitSelect.options.length > 0) {
                            unitSelect.options[0].selected = true;
                        }
                    })
                    .catch(err => {
                        console.warn('Error loading units for job ' + jobId, err);
                        unitSelect.innerHTML = `
                            <option value="1" selected>Unit #1 (Default)</option>
                            <option value="2">Unit #2</option>
                            <option value="3">Unit #3</option>
                        `;
                    });
            }
        }

        window.openToolPairingModal = function(triggerEl, jobNo, product, startUrl) {
            let jobId = '';
            if (typeof triggerEl === 'object' && triggerEl !== null) {
                const btn = triggerEl.closest('[data-job-id]') || triggerEl;
                jobId = btn.getAttribute('data-job-id') || '';
                jobNo = btn.getAttribute('data-job-no') || jobNo || '';
                product = btn.getAttribute('data-product') || product || '';
                startUrl = btn.getAttribute('data-start-url') || startUrl || '';
            } else if (typeof triggerEl === 'string' || typeof triggerEl === 'number') {
                jobId = String(triggerEl);
            }

            setupToolPairingModal(jobId, jobNo, product, startUrl);

            const modalEl = document.getElementById('toolPairingModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        };

        const toolModal = document.getElementById('toolPairingModal');
        if (toolModal) {
            toolModal.addEventListener('show.bs.modal', function (event) {
                let target = event.relatedTarget ? (event.relatedTarget.closest('[data-job-id]') || event.relatedTarget) : null;
                if (!target) {
                    const activeEl = document.activeElement;
                    if (activeEl && activeEl.closest) {
                        target = activeEl.closest('[data-job-id]');
                    }
                }
                if (!target) {
                    target = document.querySelector('button[data-job-id]');
                }
                if (target) {
                    const jobId = target.getAttribute('data-job-id') || '';
                    const jobNo = target.getAttribute('data-job-no') || '';
                    const product = target.getAttribute('data-product') || '';
                    const startUrl = target.getAttribute('data-start-url') || '';
                    if (jobId) {
                        setupToolPairingModal(jobId, jobNo, product, startUrl);
                    }
                }
            });
        }

        // Mutual tool exclusivity: selecting Torque clears Vernier and vice-versa
        const modalTorqueSelectEl = document.getElementById('modalTorqueSelect');
        const modalVernierSelectEl = document.getElementById('modalVernierSelect');

        function clearToolPairingValidation() {
            const torqueVal = modalTorqueSelectEl?.value;
            const vernierVal = modalVernierSelectEl?.value;
            if ((torqueVal || vernierVal) && !(torqueVal && vernierVal)) {
                const reqAlert = document.getElementById('toolSelectionRequiredAlert');
                if (reqAlert) reqAlert.classList.add('d-none');
                modalTorqueSelectEl?.classList.remove('is-invalid');
                modalVernierSelectEl?.classList.remove('is-invalid');
            }
        }

        if (modalTorqueSelectEl) {
            modalTorqueSelectEl.addEventListener('change', function () {
                if (this.value && modalVernierSelectEl) {
                    modalVernierSelectEl.value = '';
                    updatePairCalAlert(modalVernierSelectEl, 'pairToolVernierCalAlert');
                    modalVernierSelectEl.classList.remove('is-invalid');
                }
                syncToolPairCalAlerts();
                clearToolPairingValidation();
            });
        }

        if (modalVernierSelectEl) {
            modalVernierSelectEl.addEventListener('change', function () {
                if (this.value && modalTorqueSelectEl) {
                    modalTorqueSelectEl.value = '';
                    updatePairCalAlert(modalTorqueSelectEl, 'pairToolTorqueCalAlert');
                    modalTorqueSelectEl.classList.remove('is-invalid');
                }
                syncToolPairCalAlerts();
                clearToolPairingValidation();
            });
        }

        // Validate that exactly one tool (either Torque Wrench OR Vernier Caliper) is selected before starting
        const pairingForm = document.getElementById('toolPairingForm');
        if (pairingForm) {
            pairingForm.addEventListener('submit', function (e) {
                const torqueVal = modalTorqueSelectEl?.value;
                const vernierVal = modalVernierSelectEl?.value;
                const reqAlert = document.getElementById('toolSelectionRequiredAlert');

                if (!torqueVal && !vernierVal) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                    if (reqAlert) {
                        reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong>Tool Selection Required:</strong> Please select either a Torque Wrench or a Vernier Caliper to proceed.</span>';
                        reqAlert.classList.remove('d-none');
                    }
                    modalTorqueSelectEl?.classList.add('is-invalid');
                    modalVernierSelectEl?.classList.add('is-invalid');
                    return false;
                }

                if (torqueVal && vernierVal) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (typeof playOperatorFeedback === 'function') playOperatorFeedback(false);
                    if (reqAlert) {
                        reqAlert.innerHTML = '<i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-6"></i><span><strong>Single Tool Only:</strong> Please select either a Torque Wrench OR a Vernier Caliper, not both.</span>';
                        reqAlert.classList.remove('d-none');
                    }
                    modalTorqueSelectEl?.classList.add('is-invalid');
                    modalVernierSelectEl?.classList.add('is-invalid');
                    return false;
                }

                const unitSelect = document.getElementById('modalUnitSelect');
                if (unitSelect && !unitSelect.value) {
                    if (unitSelect.options.length > 0 && unitSelect.options[0].value) {
                        unitSelect.options[0].selected = true;
                    }
                }
            });
        }

        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live")
                .withAutomaticReconnect()
                .build();

            connection.on("BlackJobAlert", function (data) {
                console.log("BlackJobAlert received via SignalR:", data);
                const alertBox = document.getElementById("live-black-job-alert");
                const alertMsg = document.getElementById("black-alert-message");
                if (alertBox) {
                    if (data && data.message) alertMsg.textContent = data.message;
                    alertBox.classList.remove("d-none");
                }
            });

            connection.start().then(function () {
                connection.invoke("JoinWorkers");
            }).catch(function (err) {
                console.warn("SignalR connection error:", err);
            });
        }

        // ---------------------------------------------------------------
        // Job rows: live search + status/priority/line filters (client-side)
        // ---------------------------------------------------------------

        function applyJobFilters() {
            var searchInput = document.getElementById("job-search-input");
            var statusSel = document.getElementById("filter-status");
            var prioSel = document.getElementById("filter-priority");
            if (!searchInput || !statusSel || !prioSel) return;

            var q = (searchInput.value || "").trim().toLowerCase();
            var st = statusSel.value;
            var pr = prioSel.value;

            var rows = document.querySelectorAll("#job-rows-table tr.job-row");
            var visible = 0;
            for (var i = 0; i < rows.length; i++) {
                var tr = rows[i];
                var ok = true;
                if (st && tr.getAttribute("data-status") !== st) ok = false;
                if (ok && pr && tr.getAttribute("data-priority") !== pr) ok = false;
                if (ok && q) {
                    var hay = tr.getAttribute("data-search") || "";
                    if (hay.indexOf(q) === -1) ok = false;
                }
                tr.classList.toggle("d-none", !ok);
                if (ok) visible++;
            }

            var countEl = document.getElementById("job-row-count");
            if (countEl) countEl.textContent = "Showing " + visible + " of " + rows.length + " job(s)";

            var nomatch = document.getElementById("job-rows-nomatch");
            if (nomatch) nomatch.classList.toggle("d-none", visible !== 0);

            var wrap = document.getElementById("job-rows-table-wrap");
            if (wrap) wrap.classList.toggle("d-none", visible === 0);
        }

        ["job-search-input", "filter-status", "filter-priority"].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener(el.tagName === "SELECT" ? "change" : "input", applyJobFilters);
        });

        var btnFilterClear = document.getElementById("btn-filter-clear");
        if (btnFilterClear) {
            btnFilterClear.addEventListener("click", function () {
                var s = document.getElementById("job-search-input");
                if (s) s.value = "";
                ["filter-status", "filter-priority"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = "";
                });
                applyJobFilters();
            });
        }

        // Clicking a row (outside its buttons/links) resumes/claims the job
        // via its tool-pairing button; details links stay on <a> elements
        // (/Job/Detail is Admin-only, so workers never get navigated there).
        (function () {
            var table = document.getElementById("job-rows-table");
            if (!table) return;
            table.addEventListener("click", function (e) {
                if (e.target.closest("a,button,select,input,label")) return;
                var tr = e.target.closest("tr.job-row");
                if (!tr) return;
                var actionBtn = tr.querySelector("button[data-bs-target='#toolPairingModal']");
                if (actionBtn && !actionBtn.disabled) {
                    if (window.openToolPairingModal) {
                        window.openToolPairingModal(actionBtn);
                    } else {
                        actionBtn.click();
                    }
                    return;
                }
                var href = tr.getAttribute("data-detail-url");
                if (href) window.location = href;
            });
        })();

        applyJobFilters();

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // ----- Station switch: Searchable line and workstation selector -----
        (function () {
            var lineInput = document.getElementById("stationLineValue");
            var lineBtn = document.getElementById("stationLineBtn");
            var lineBtnText = document.getElementById("stationLineBtnText");
            var lineList = document.getElementById("lineDropdownItemsList");
            var searchLineInput = document.getElementById("searchLineFilterInput");
            var noLinesMsg = document.getElementById("noLinesFoundMsg");

            var workStationInput = document.getElementById("workStationValue");
            var workStationBtn = document.getElementById("workStationBtn");
            var workStationBtnText = document.getElementById("workStationBtnText");
            var workStationContainer = document.getElementById("workStationListContainer");
            var searchStationInput = document.getElementById("searchStationFilterInput");

            var form = document.getElementById("switchAssemblyLineForm") || document.querySelector("#switchAssemblyLineModal form");
            if (!lineInput || !lineBtn || !lineList) return;

            // Stop propagation on search inputs so clicking / typing inside does NOT close Bootstrap dropdown
            [searchLineInput, searchStationInput].forEach(function (inp) {
                if (!inp) return;
                inp.addEventListener("click", function (e) { e.stopPropagation(); });
                inp.addEventListener("mousedown", function (e) { e.stopPropagation(); });
                inp.addEventListener("keydown", function (e) { e.stopPropagation(); });
                inp.addEventListener("keyup", function (e) { e.stopPropagation(); });
            });

            // Auto-focus search input when line dropdown opens
            if (lineBtn && searchLineInput) {
                lineBtn.addEventListener("shown.bs.dropdown", function () {
                    searchLineInput.focus();
                    searchLineInput.select();
                });
            }

            // Real-time filter for assembly lines
            if (searchLineInput && lineList) {
                searchLineInput.addEventListener("input", function () {
                    var q = (this.value || "").trim().toLowerCase();
                    var items = lineList.querySelectorAll(".filterable-line-item");
                    var visibleCount = 0;
                    items.forEach(function (item) {
                        var text = (item.getAttribute("data-search-text") || item.textContent || "").toLowerCase();
                        if (!q || text.indexOf(q) !== -1) {
                            item.classList.remove("d-none");
                            visibleCount++;
                        } else {
                            item.classList.add("d-none");
                        }
                    });
                    if (noLinesMsg) {
                        if (visibleCount === 0) {
                            noLinesMsg.classList.remove("d-none");
                        } else {
                            noLinesMsg.classList.add("d-none");
                        }
                    }
                });
            }

            // Handle assembly line selection
            lineList.querySelectorAll(".filterable-line-item").forEach(function (item) {
                item.addEventListener("click", function () {
                    lineList.querySelectorAll(".filterable-line-item.active").forEach(function (el) {
                        el.classList.remove("active", "fw-bold");
                    });
                    item.classList.add("active", "fw-bold");
                    var val = item.getAttribute("data-value") || "";
                    var isDept = item.getAttribute("data-is-dept") === "true";
                    lineInput.value = val;
                    if (lineBtnText) {
                        lineBtnText.textContent = item.textContent.trim();
                    } else {
                        lineBtn.textContent = item.textContent.trim();
                    }
                    lineBtn.classList.remove("is-invalid", "border-danger");

                    // Close dropdown
                    var bsLineDropdown = bootstrap.Dropdown.getInstance(lineBtn);
                    if (bsLineDropdown) bsLineDropdown.hide();

                    if (isDept || !val) {
                        // Department Mode: Workstation is not applicable
                        if (workStationBtn) {
                            workStationBtn.disabled = true;
                            if (workStationBtnText) {
                                workStationBtnText.textContent = "— Department-wide (All Workstations) —";
                            }
                        }
                        if (workStationContainer) {
                            workStationContainer.innerHTML = '<div class="dropdown-item text-muted text-center py-2">All workstations accessible in Department mode</div>';
                        }
                        if (workStationInput) workStationInput.value = "";
                    } else {
                        // Load workstations for selected assembly line
                        loadWorkStations(val, "");
                    }
                });
            });

            // Auto-focus search input when workstation dropdown opens
            if (workStationBtn && searchStationInput) {
                workStationBtn.addEventListener("shown.bs.dropdown", function () {
                    searchStationInput.focus();
                    searchStationInput.select();
                });
            }

            // Real-time filter for workstations
            if (searchStationInput && workStationContainer) {
                searchStationInput.addEventListener("input", function () {
                    var q = (this.value || "").trim().toLowerCase();
                    var items = workStationContainer.querySelectorAll(".filterable-station-item");
                    var visibleCount = 0;
                    items.forEach(function (item) {
                        var text = (item.getAttribute("data-search-text") || item.textContent || "").toLowerCase();
                        if (!q || text.indexOf(q) !== -1) {
                            item.classList.remove("d-none");
                            visibleCount++;
                        } else {
                            item.classList.add("d-none");
                        }
                    });
                    var noStationEl = workStationContainer.querySelector("#noStationsFoundMsg");
                    if (noStationEl) {
                        if (visibleCount === 0) {
                            noStationEl.classList.remove("d-none");
                        } else {
                            noStationEl.classList.add("d-none");
                        }
                    }
                });
            }

            function selectStation(val, text) {
                if (workStationContainer) {
                    workStationContainer.querySelectorAll(".filterable-station-item.active").forEach(function (el) {
                        el.classList.remove("active", "fw-bold");
                    });
                    var activeEl = workStationContainer.querySelector('.filterable-station-item[data-value="' + val + '"]');
                    if (activeEl) activeEl.classList.add("active", "fw-bold");
                }
                if (workStationInput) workStationInput.value = val;
                if (workStationBtnText) {
                    workStationBtnText.textContent = text;
                } else if (workStationBtn) {
                    workStationBtn.textContent = text;
                }
                if (workStationBtn) workStationBtn.classList.remove("is-invalid", "border-danger");

                var bsStationDropdown = bootstrap.Dropdown.getInstance(workStationBtn);
                if (bsStationDropdown) bsStationDropdown.hide();
            }

            // Function to load workstations
            async function loadWorkStations(lineId, selectedStationId) {
                if (!lineId || !workStationBtn || !workStationContainer) return;

                workStationBtn.disabled = true;
                if (workStationBtnText) workStationBtnText.textContent = "Loading workstations...";
                workStationContainer.innerHTML = '<div class="dropdown-item text-muted text-center py-2"><span class="spinner-border spinner-border-sm me-1"></span>Loading...</div>';
                if (workStationInput) workStationInput.value = selectedStationId || "";

                try {
                    const response = await fetch('/Worker/JobBoard/GetStationsForLine?lineId=' + lineId);
                    if (response.ok) {
                        const stations = await response.json();
                        workStationContainer.innerHTML = '';

                        // Option 1: Line-Wide (All Stations / Entire Line)
                        var isLineWideActive = !selectedStationId;
                        var lineWideBtn = document.createElement('button');
                        lineWideBtn.type = 'button';
                        lineWideBtn.className = 'dropdown-item py-2 px-3 filterable-station-item fw-semibold text-primary' + (isLineWideActive ? ' active fw-bold' : '');
                        lineWideBtn.setAttribute('data-value', '');
                        lineWideBtn.setAttribute('data-search-text', 'line-wide all stations entire line');
                        lineWideBtn.innerHTML = '<i class="bi bi-diagram-3 me-1.5"></i>— Line-Wide (All Stations / Entire Line) —';
                        lineWideBtn.addEventListener('click', function () {
                            selectStation('', '— Line-Wide (All Stations / Entire Line) —');
                        });
                        workStationContainer.appendChild(lineWideBtn);

                        if (stations && stations.length > 0) {
                            var hr = document.createElement('hr');
                            hr.className = 'dropdown-divider my-1';
                            workStationContainer.appendChild(hr);

                            var matchedStationName = null;

                            // Option 2..N: Child Workstations
                            stations.forEach(function (station) {
                                var sId = String(station.workStationId || station.id);
                                var sCode = station.stationCode || station.code || "";
                                var sName = station.stationName || station.name || "";
                                var displayText = sCode + ' — ' + sName;
                                var isMatch = (selectedStationId && String(selectedStationId) === sId);
                                if (isMatch) matchedStationName = displayText;

                                var btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'dropdown-item py-2 px-3 filterable-station-item' + (isMatch ? ' active fw-bold' : '');
                                btn.setAttribute('data-value', sId);
                                btn.setAttribute('data-search-text', (sCode + ' ' + sName).toLowerCase());
                                btn.textContent = displayText;
                                btn.addEventListener('click', function () {
                                    selectStation(sId, displayText);
                                });
                                workStationContainer.appendChild(btn);
                            });

                            var noMsg = document.createElement('div');
                            noMsg.id = 'noStationsFoundMsg';
                            noMsg.className = 'dropdown-item text-muted text-center py-2 d-none';
                            noMsg.textContent = 'No matching workstations found';
                            workStationContainer.appendChild(noMsg);

                            workStationBtn.disabled = false;
                            if (matchedStationName) {
                                if (workStationBtnText) workStationBtnText.textContent = matchedStationName;
                                if (workStationInput) workStationInput.value = selectedStationId;
                            } else {
                                if (workStationBtnText) workStationBtnText.textContent = '— Line-Wide (All Stations / Entire Line) —';
                                if (workStationInput) workStationInput.value = '';
                            }
                        } else {
                            workStationBtn.disabled = false;
                            if (workStationBtnText) workStationBtnText.textContent = '— Line-Wide (All Stations / Entire Line) —';
                            if (workStationInput) workStationInput.value = '';
                        }
                    } else {
                        workStationContainer.innerHTML = '<div class="dropdown-item text-danger py-2">Error loading workstations</div>';
                        if (workStationBtnText) workStationBtnText.textContent = "Error loading workstations";
                        workStationBtn.disabled = true;
                    }
                } catch (error) {
                    console.error('Failed to load workstations:', error);
                    workStationContainer.innerHTML = '<div class="dropdown-item text-danger py-2">Error loading workstations</div>';
                    if (workStationBtnText) workStationBtnText.textContent = "Error loading workstations";
                    workStationBtn.disabled = true;
                }
            }

            // If modal opens and an assembly line is already selected, populate its workstations
            const switchModalEl = document.getElementById('switchAssemblyLineModal');
            if (switchModalEl) {
                switchModalEl.addEventListener('show.bs.modal', function () {
                    // Reset line filter input
                    if (searchLineInput) {
                        searchLineInput.value = '';
                        lineList.querySelectorAll('.filterable-line-item').forEach(function (el) {
                            el.classList.remove('d-none');
                        });
                        if (noLinesMsg) noLinesMsg.classList.add('d-none');
                    }
                    if (searchStationInput) {
                        searchStationInput.value = '';
                    }

                    if (lineInput && lineInput.value) {
                        loadWorkStations(lineInput.value, '@(Model.CurrentWorkStationId?.ToString() ?? "")');
                    }
                });
            }

            // Form validation - Department mode (isDeptActive) or assembly line is required
            if (form && lineBtn) {
                form.addEventListener("submit", function (e) {
                    var isDeptActive = lineList.querySelector('.filterable-line-item[data-is-dept="true"].active') !== null;
                    if (!lineInput.value && !isDeptActive) {
                        e.preventDefault();
                        e.stopPropagation();
                        lineBtn.classList.add("is-invalid", "border-danger");
                        lineBtn.focus();
                    }
                });
            }
        })();
    </script>

    <!-- jsQR Library for Real-Time Camera QR Decoding -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script>
        let prdCameraStream = null;
        let prdScanAnimationId = null;
        let activeScannedJobData = null;

        function openPrdScannerModal() {
            const modal = new bootstrap.Modal(document.getElementById('prdScannerModal'));
            modal.show();
            startPrdCamera();
            setTimeout(() => {
                document.getElementById('prdManualTokenInput').focus();
            }, 500);
        }

        async function startPrdCamera() {
            const video = document.getElementById('prdScannerVideo');
            const feedback = document.getElementById('prdScannerFeedback');
            const notice = document.getElementById('cameraUnavailableNotice');
            notice.style.display = 'none';

            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                notice.style.display = 'flex';
                feedback.innerText = "Camera stream restricted over HTTP. Use 'Snap QR with Phone Camera' above.";
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: { ideal: "environment" } },
                    audio: false
                });
                prdCameraStream = stream;
                video.srcObject = stream;
                await video.play();
                requestAnimationFrame(tickPrdQrScanning);
            } catch (err) {
                console.warn("Camera access failed:", err);
                notice.style.display = 'flex';
                feedback.innerText = "Camera stream restricted over HTTP. Use 'Snap QR with Phone Camera' above.";
            }
        }

        function stopPrdCamera() {
            if (prdScanAnimationId) {
                cancelAnimationFrame(prdScanAnimationId);
                prdScanAnimationId = null;
            }
            if (prdCameraStream) {
                prdCameraStream.getTracks().forEach(track => track.stop());
                prdCameraStream = null;
            }
            const video = document.getElementById('prdScannerVideo');
            if (video) video.srcObject = null;
        }

        document.getElementById('prdScannerModal').addEventListener('hidden.bs.modal', stopPrdCamera);

        function handleMobileQrFile(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const feedback = document.getElementById('prdScannerFeedback');
            if (feedback) feedback.innerHTML = '<span class="text-primary"><i class="bi bi-hourglass-split me-1"></i>Scanning QR code from photo...</span>';

            const reader = new FileReader();
            reader.onload = function (e) {
                const img = new Image();
                img.onload = async function () {
                    const canvas = document.getElementById('prdScannerCanvas') || document.createElement('canvas');
                    
                    // Downscale large phone photos (e.g. 12MP/48MP) to 1280px for instant QR decoding
                    let maxDim = 1280;
                    let w = img.width;
                    let h = img.height;
                    if (w > maxDim || h > maxDim) {
                        if (w > h) {
                            h = Math.round(h * (maxDim / w));
                            w = maxDim;
                        } else {
                            w = Math.round(w * (maxDim / h));
                            h = maxDim;
                        }
                    }
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext('2d', { willReadFrequently: true });
                    ctx.drawImage(img, 0, 0, w, h);

                    let qrContent = null;
                    if ('BarcodeDetector' in window) {
                        try {
                            const detector = new BarcodeDetector({ formats: ['qr_code'] });
                            const barcodes = await detector.detect(canvas);
                            if (barcodes && barcodes.length > 0) {
                                qrContent = barcodes[0].rawValue;
                            }
                        } catch (err) { }
                    }

                    if (!qrContent && typeof jsQR !== 'undefined') {
                        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                        const code = jsQR(imageData.data, imageData.width, imageData.height, {
                            inversionAttempts: "dontInvert"
                        }) || jsQR(imageData.data, imageData.width, imageData.height, {
                            inversionAttempts: "invertFirst"
                        });
                        if (code && code.data) {
                            qrContent = code.data;
                        }
                    }

                    if (qrContent && qrContent.trim()) {
                        stopPrdCamera();
                        const modalEl = document.getElementById('prdScannerModal');
                        if (modalEl) {
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                        }
                        handleScannedPrdToken(qrContent.trim());
                    } else {
                        playOperatorFeedback(false);
                        if (feedback) feedback.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>No QR code detected in image. Please try again.</span>';
                        alert("No QR code detected in the photo. Please align the QR label clearly and ensure good lighting, or enter the token manually below.");
                    }
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
            input.value = '';
        }

        async function tickPrdQrScanning() {
            const video = document.getElementById('prdScannerVideo');
            const canvas = document.getElementById('prdScannerCanvas');
            if (!video || video.readyState !== video.HAVE_ENOUGH_DATA) {
                prdScanAnimationId = requestAnimationFrame(tickPrdQrScanning);
                return;
            }

            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            let qrContent = null;

            // 1. Try Native BarcodeDetector API if supported
            if ('BarcodeDetector' in window) {
                try {
                    const detector = new BarcodeDetector({ formats: ['qr_code'] });
                    const barcodes = await detector.detect(canvas);
                    if (barcodes.length > 0) {
                        qrContent = barcodes[0].rawValue;
                    }
                } catch (e) { }
            }

            // 2. Fallback to jsQR
            if (!qrContent && typeof jsQR === 'function') {
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: "dontInvert"
                }) || jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: "invertFirst"
                });
                if (code) {
                    qrContent = code.data;
                }
            }

            if (qrContent && qrContent.trim().length > 0) {
                handleScannedPrdToken(qrContent.trim());
                return; // Stop scanning loop on detection
            }

            prdScanAnimationId = requestAnimationFrame(tickPrdQrScanning);
        }

        // -------------------------------------------------------------------------
        // Industrial Ergonomics: Dual Audio & Haptic Feedback (Synthetic Web Audio)
        // -------------------------------------------------------------------------
        let operatorAudioCtx = null;
        function getOperatorAudioContext() {
            if (!operatorAudioCtx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) operatorAudioCtx = new AudioCtx();
            }
            if (operatorAudioCtx && operatorAudioCtx.state === 'suspended') {
                operatorAudioCtx.resume().catch(() => {});
            }
            return operatorAudioCtx;
        }

        function playOperatorFeedback(isPass) {
            // 1. Haptic Vibration Pulse for Rugged Android / Industrial Tablets
            if (navigator.vibrate) {
                try {
                    if (isPass) {
                        navigator.vibrate([100, 50, 100]);
                    } else {
                        navigator.vibrate([200, 80, 200, 80, 250]);
                    }
                } catch (e) { }
            }

            // 2. Synthetic Audio Feedback (Web Audio API)
            const ctx = getOperatorAudioContext();
            if (ctx) {
                try {
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    if (isPass) {
                        // Pass Chime: Crisp high-frequency chime (880 Hz, 120 ms)
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(880, now);
                        osc.frequency.exponentialRampToValueAtTime(1175, now + 0.12);
                        gain.gain.setValueAtTime(0.35, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
                        osc.start(now);
                        osc.stop(now + 0.12);
                    } else {
                        // Fail / Reject: Low-frequency warning double-buzz (220 Hz, 250 ms)
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(220, now);
                        osc.frequency.linearRampToValueAtTime(160, now + 0.25);
                        gain.gain.setValueAtTime(0.40, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                        osc.start(now);
                        osc.stop(now + 0.25);
                    }
                } catch (e) { }
            }
        }

        function submitManualPrdToken() {
            const input = document.getElementById('prdManualTokenInput');
            const token = input.value.trim();
            if (!token) {
                playOperatorFeedback(false);
                alert("Please enter a valid PRD Unit Token, last 4 digits, or unit number.");
                input.focus();
                return;
            }
            handleScannedPrdToken(token);
        }

        document.getElementById('prdManualTokenInput').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitManualPrdToken();
            }
        });

        async function handleScannedPrdToken(token) {
            stopPrdCamera();
            const feedback = document.getElementById('prdScannerFeedback');
            feedback.innerHTML = '<span class="text-primary fw-bold"><i class="bi bi-hourglass-split me-1"></i>Resolving PRD unit ' + token + '...</span>';

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrfToken = tokenInput ? tokenInput.value : '';

            try {
                const response = await fetch('/Worker/JobBoard/ScanPrdUnit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    body: JSON.stringify({ token: token })
                });

                const data = await response.json();

                if (!data.success) {
                    playOperatorFeedback(false);
                    feedback.innerHTML = '<span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i>' + data.message + '</span>';
                    setTimeout(() => { startPrdCamera(); }, 2000);
                    return;
                }

                // Play affirmative pass chime + haptic vibration
                playOperatorFeedback(true);

                // If unit was already completed with PASS: prompt worker for rework!
                if (data.action === 'completed_prompt_rework') {
                    bootstrap.Modal.getInstance(document.getElementById('prdScannerModal')).hide();
                    openPassedUnitReworkModal(data);
                    return;
                }

                // If already mapped to worker's current line: direct execute!
                if (data.action === 'execute') {
                    bootstrap.Modal.getInstance(document.getElementById('prdScannerModal')).hide();
                    feedback.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Mapped to line: ' + data.lineName + '. Starting guidance...</span>';
                    window.location.href = data.redirectUrl;
                    return;
                }

                // If NOT mapped to current line: open Custom Workload Scope modal (Image 3)
                if (data.action === 'prompt_workload') {
                    bootstrap.Modal.getInstance(document.getElementById('prdScannerModal')).hide();
                    openCustomWorkloadModal(data);
                }
            } catch (err) {
                console.error("Scan resolution failed:", err);
                playOperatorFeedback(false);
                feedback.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Failed to resolve PRD token. Please try again.</span>';
                setTimeout(() => { startPrdCamera(); }, 2000);
            }
        }
        window.resolvePrdToken = handleScannedPrdToken;

        async function switchToDeptAndScan(tokenNo) {
            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const csrfToken = tokenInput ? tokenInput.value : '';
                const form = new FormData();
                form.append('assemblyLineId', '');
                if (csrfToken) form.append('__RequestVerificationToken', csrfToken);

                await fetch('/Worker/JobBoard/SetAssemblyLine', {
                    method: 'POST',
                    body: form
                });

                // Dismiss custom workload modal if open
                const cwModalEl = document.getElementById('customWorkloadModal');
                if (cwModalEl) {
                    const m = bootstrap.Modal.getInstance(cwModalEl);
                    if (m) m.hide();
                }

                // Re-resolve the scanned token in Department Mode
                resolvePrdToken(tokenNo);
            } catch (err) {
                console.error("Switch to dept error:", err);
                window.location.reload();
            }
        }

        function openCustomWorkloadModal(data, isRework) {
            isRework = !!isRework || !!data.isRework;
            data.isRework = isRework;
            activeScannedJobData = data;
            document.getElementById('cwUnitBadge').innerText = (isRework ? '↺ Rework: ' : '') + 'PRD Unit #' + data.unitIndex;
            document.getElementById('cwProductCode').innerText = data.productCode;
            document.getElementById('cwProductName').innerText = '— ' + (data.productName || '');
            document.getElementById('cwTokenBadge').innerText = data.tokenNo;

            // Configure dynamic notice banner & mapped scope option
            const banner = document.getElementById('cwNoticeBanner');
            const noticeIcon = document.getElementById('cwNoticeIcon');
            const noticeText = document.getElementById('cwNoticeText');
            const allModeWrap = document.getElementById('cwAllModeWrap');
            const mappedWrap = document.getElementById('cwMappedOptionWrap');
            const mappedLabel = document.getElementById('cwMappedSummaryLabel');
            const modalTitle = document.getElementById('customWorkloadModalLabel');
            const btnFastAllMode = document.getElementById('btnStartAllModeFast');
            const btnSubmit = document.getElementById('btnSubmitCustomWorkload');

            const reworkIter = (data.reworkCount || 0) + 1;

            if (isRework) {
                if (!data.isDeptMode) {
                    // WORKER IS ON AN ASSEMBLY LINE (REWORK):
                    if (allModeWrap) allModeWrap.style.display = 'none';
                    if (btnFastAllMode) btnFastAllMode.style.display = 'none';
                    if (mappedWrap) mappedWrap.style.display = 'block';
                    if (modalTitle) modalTitle.innerHTML = `<i class="bi bi-arrow-repeat text-warning me-2"></i>Configure Rework Workload (Unit #${data.unitIndex}) — ${data.currentLineName}`;

                    if (data.isMapped) {
                        if (banner) banner.className = 'alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning';
                        if (noticeIcon) noticeIcon.className = 'bi bi-arrow-repeat fs-5 text-warning flex-shrink-0';
                        if (noticeText) noticeText.innerHTML = `<strong>Rework Scope (${data.currentLineName}):</strong> Select operations requiring rework. Unselected steps retain original passed values in the report.`;
                        if (mappedLabel) mappedLabel.textContent = `Rework Station Operations (${data.mappedScopeSummary || data.currentLineName})`;

                        const mappedRadio = document.getElementById('cwScopeMapped');
                        if (mappedRadio) mappedRadio.checked = true;
                        document.getElementById('cwScopeSummaryInput').value = `Rework #${reworkIter}: ${data.currentLineName} Scope`;

                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = `<i class="bi bi-arrow-repeat me-1"></i>Start Rework Guidance (${data.currentLineName})`;
                        }
                    } else {
                        if (banner) banner.className = 'alert alert-danger py-2 px-3 small d-flex align-items-center justify-content-between gap-2 mb-3 shadow-sm border-start border-4 border-danger';
                        if (noticeIcon) noticeIcon.className = 'bi bi-exclamation-octagon-fill fs-5 text-danger flex-shrink-0';
                        if (noticeText) noticeText.innerHTML = `
                            <div class="d-flex flex-column gap-2">
                                <div><strong>Not Mapped:</strong> Product <strong>${data.productCode}</strong> has no operations assigned to <strong>${data.currentLineName}</strong>.</div>
                                <div class="text-dark">To rework all components without restrictions, switch to <strong>Department Mode</strong>:</div>
                                <div>
                                    <button type="button" class="btn btn-warning btn-sm fw-bold px-3 shadow-sm" onclick="switchToDeptAndScan('${data.tokenNo}')">
                                        <i class="bi bi-building me-1"></i>Switch to Department Mode &amp; Rework
                                    </button>
                                </div>
                            </div>`;
                        if (mappedWrap) mappedWrap.style.display = 'none';
                        if (btnSubmit) btnSubmit.disabled = true;
                        const tmplRadio = document.getElementById('cwScopeTemplates');
                        if (tmplRadio) tmplRadio.checked = true;
                    }
                } else {
                    // WORKER IS IN DEPARTMENT MODE (REWORK):
                    if (allModeWrap) allModeWrap.style.display = 'block';
                    if (btnFastAllMode) {
                        btnFastAllMode.style.display = 'inline-block';
                        btnFastAllMode.className = 'btn btn-warning btn-sm fw-bold px-3 shadow-sm';
                        btnFastAllMode.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Rework Entire Unit';
                    }
                    if (mappedWrap) mappedWrap.style.display = 'none';
                    if (modalTitle) modalTitle.innerHTML = `<i class="bi bi-arrow-repeat text-warning me-2"></i>Configure Rework Workload (Unit #${data.unitIndex})`;

                    if (banner) banner.className = 'alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning';
                    if (noticeIcon) noticeIcon.className = 'bi bi-arrow-repeat fs-5 text-warning flex-shrink-0';
                    if (noticeText) noticeText.innerHTML = `<strong>Rework Mode (Department):</strong> Choose whether to rework the entire unit or willingly select specific templates/steps. Only selected items will be re-guided; untouched steps keep their previous passed values.`;

                    const fullRadio = document.getElementById('cwScopeFull');
                    if (fullRadio) fullRadio.checked = true;
                    document.getElementById('cwScopeSummaryInput').value = `Rework #${reworkIter}: Full Product Rework`;

                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = `<i class="bi bi-arrow-repeat me-1"></i>Start Rework Guidance`;
                    }
                }
            } else if (data.isPartiallyCompleted) {
                // PARTIALLY COMPLETED UNIT (Remaining Work to be Done):
                if (modalTitle) modalTitle.innerHTML = `<i class="bi bi-hourglass-split text-warning me-2"></i>Unit #${data.unitIndex} — Incomplete (${data.passedStepCount}/${data.totalStepCount} Operations Done)`;

                if (banner) banner.className = 'alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-warning';
                if (noticeIcon) noticeIcon.className = 'bi bi-hourglass-split fs-5 text-warning flex-shrink-0';
                if (noticeText) noticeText.innerHTML = `<div><strong>Remaining Work to be Done:</strong> <strong>${data.passedStepCount} of ${data.totalStepCount} operations</strong> have passed. <strong>${data.remainingStepCount} operations remain</strong>. Choose to complete all remaining bolts or select specific operations below:</div>`;

                // ALWAYS show All Mode so worker can choose full unit completion unrestricted
                if (allModeWrap) allModeWrap.style.display = 'block';
                const allLabel = document.getElementById('cwAllModeLabel');
                const allDesc = document.getElementById('cwAllModeDesc');
                if (allLabel) allLabel.innerHTML = `<i class="bi bi-unlock-fill me-1"></i>All Mode: Complete All Remaining Work (${data.remainingStepCount} bolts across product)`;
                if (allDesc) allDesc.textContent = `Execute and verify all ${data.remainingStepCount} remaining operations across the entire unit without line restrictions.`;

                if (btnFastAllMode) {
                    btnFastAllMode.style.display = 'inline-block';
                    btnFastAllMode.className = 'btn btn-success btn-sm fw-bold px-3 shadow-sm';
                    btnFastAllMode.innerHTML = `<i class="bi bi-unlock-fill me-1"></i>Complete All Remaining (${data.remainingStepCount} bolts)`;
                }

                if (mappedWrap) {
                    mappedWrap.style.display = data.isMapped ? 'block' : 'none';
                    if (mappedLabel) mappedLabel.textContent = `Station Scope: ${data.mappedScopeSummary || 'Station Scope'} (${data.stationRemainingStepCount || 0} remaining)`;
                    const mappedDesc = document.getElementById('cwMappedOptionDesc');
                    if (mappedDesc) mappedDesc.textContent = `Execute only the remaining operations assigned to ${data.currentLineName}.`;
                }

                const stepsLabel = document.getElementById('cwStepsOptionLabel');
                if (stepsLabel) stepsLabel.innerHTML = `<i class="bi bi-list-check me-1 text-warning"></i>Choose Specific Bolts / Operations (${data.remainingStepCount} remaining)`;

                const stepsRadio = document.getElementById('cwScopeSteps');
                if (stepsRadio) stepsRadio.checked = true;

                document.getElementById('cwScopeSummaryInput').value = `Completing Remaining Operations (${data.remainingStepCount} steps)`;
            } else {
                // NORMAL FIRST-PASS ASSEMBLY (Not Rework, Not Partially Completed):
                if (!data.isDeptMode) {
                    if (allModeWrap) allModeWrap.style.display = 'none';
                    if (btnFastAllMode) btnFastAllMode.style.display = 'none';
                    if (mappedWrap) mappedWrap.style.display = 'block';
                    if (modalTitle) modalTitle.innerHTML = `<i class="bi bi-diagram-3-fill text-primary me-2"></i>Assembly Line Workload: ${data.currentLineName}`;

                    if (data.isMapped) {
                        if (banner) banner.className = 'alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-info';
                        if (noticeIcon) noticeIcon.className = 'bi bi-info-circle-fill fs-5 text-info flex-shrink-0';
                        if (noticeText) noticeText.innerHTML = `Showing operations assigned to <strong>${data.currentLineName}</strong> (${data.mappedScopeSummary || 'Line Scope'}).`;
                        if (mappedLabel) mappedLabel.textContent = data.mappedScopeSummary || `${data.currentLineName} Assigned Operations`;

                        const mappedRadio = document.getElementById('cwScopeMapped');
                        if (mappedRadio) mappedRadio.checked = true;
                        document.getElementById('cwScopeSummaryInput').value = data.mappedScopeSummary || `${data.currentLineName} Line Scope`;

                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = `<i class="bi bi-play-circle-fill me-1"></i>Start Line Assembly (${data.currentLineName})`;
                        }
                    } else {
                        if (banner) banner.className = 'alert alert-danger py-2 px-3 small d-flex align-items-center justify-content-between gap-2 mb-3 shadow-sm border-start border-4 border-danger';
                        if (noticeIcon) noticeIcon.className = 'bi bi-exclamation-octagon-fill fs-5 text-danger flex-shrink-0';
                        if (noticeText) noticeText.innerHTML = `
                            <div class="d-flex flex-column gap-2">
                                <div><strong>Not Mapped to Line:</strong> Product <strong>${data.productCode}</strong> has no assembly operations assigned to <strong>${data.currentLineName}</strong>.</div>
                                <div class="text-dark">To assemble all components without line restrictions, switch to <strong>Department Mode</strong>:</div>
                                <div>
                                    <button type="button" class="btn btn-warning btn-sm fw-bold px-3 shadow-sm" onclick="switchToDeptAndScan('${data.tokenNo}')">
                                        <i class="bi bi-building me-1"></i>Switch to Department Mode &amp; Open Product
                                    </button>
                                </div>
                            </div>`;
                        if (mappedWrap) mappedWrap.style.display = 'none';
                        if (btnSubmit) btnSubmit.disabled = true;
                        const tmplRadio = document.getElementById('cwScopeTemplates');
                        if (tmplRadio) tmplRadio.checked = true;
                    }
                } else {
                    if (allModeWrap) allModeWrap.style.display = 'block';
                    if (btnFastAllMode) {
                        btnFastAllMode.style.display = 'inline-block';
                        btnFastAllMode.className = 'btn btn-success btn-sm fw-bold px-3 shadow-sm';
                        btnFastAllMode.innerHTML = '<i class="bi bi-unlock-fill me-1"></i>Start in All Mode (Unrestricted)';
                    }
                    if (mappedWrap) mappedWrap.style.display = 'none';
                    if (modalTitle) modalTitle.innerHTML = `<i class="bi bi-unlock-fill text-success me-2"></i>Department Mode: Full Workload &amp; Custom Scope`;

                    if (banner) banner.className = 'alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-success';
                    if (noticeIcon) noticeIcon.className = 'bi bi-unlock-fill fs-5 text-success flex-shrink-0';
                    if (noticeText) noticeText.innerHTML = `You are in <strong>Department Mode</strong> (Unrestricted). You can assemble the full product (All Mode) or willingly pick specific operations below.`;

                    const fullRadio = document.getElementById('cwScopeFull');
                    if (fullRadio) fullRadio.checked = true;
                    document.getElementById('cwScopeSummaryInput').value = 'All Mode (Full Product Assembly)';

                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = `<i class="bi bi-play-circle-fill me-1"></i>Apply Scope &amp; Start`;
                    }
                }
            }

            // Populate Templates List
            const tList = document.getElementById('cwTemplatesList');
            tList.innerHTML = '';
            (data.components || []).forEach(c => {
                const col = document.createElement('div');
                col.className = 'col-md-6';
                col.innerHTML = `
                    <div class="form-check p-2 border rounded bg-white h-100">
                        <input class="form-check-input ms-1 me-2 cw-template-checkbox" type="checkbox" value="${c.templateId}" id="cwT_${c.templateId}" checked />
                        <label class="form-check-label small fw-semibold" for="cwT_${c.templateId}">
                            ${c.templateName} <span class="badge bg-light text-muted border">${c.stepCount} ops</span>
                        </label>
                    </div>`;
                tList.appendChild(col);
            });

            // Populate Steps List (ALL bolts across the entire product)
            const sList = document.getElementById('cwStepsList');
            sList.innerHTML = '';
            (data.components || []).forEach(c => {
                const header = document.createElement('div');
                header.className = 'fw-bold small text-primary mb-1 mt-2 d-flex justify-content-between align-items-center bg-light p-1.5 rounded';
                header.innerHTML = `
                    <span><i class="bi bi-collection me-1"></i>${c.templateName} <span class="text-muted fw-normal">(${c.templateCode})</span></span>
                    <span class="badge ${c.remainingStepCount === 0 ? 'bg-success text-white' : 'bg-secondary text-white'}">${c.passedStepCount}/${c.totalStepCount} Passed</span>`;
                sList.appendChild(header);

                (c.steps || []).forEach(s => {
                    const row = document.createElement('div');
                    row.className = 'form-check py-1.5 px-2 border-bottom d-flex align-items-center justify-content-between';

                    const isPassed = !!s.isPassed;
                    const isStation = !!s.isStationScope;
                    const isRemaining = !isPassed;
                    const isChecked = isRework ? true : isRemaining;

                    const badgePassed = '<span class="badge bg-success-subtle text-success border border-success-subtle ms-1"><i class="bi bi-check-circle-fill me-1"></i>Passed</span>';
                    const badgeRemaining = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1"><i class="bi bi-hourglass-split me-1"></i>Remaining</span>';
                    const badgeStation = !data.isDeptMode
                        ? (isStation
                            ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1"><i class="bi bi-geo-alt-fill me-1"></i>Station Scope</span>'
                            : '<span class="badge bg-light text-muted border ms-1">Other Station</span>')
                        : '';

                    row.innerHTML = `
                        <div class="d-flex align-items-center">
                            <input class="form-check-input cw-step-checkbox me-2" type="checkbox" value="${s.stepId}" id="cwS_${s.stepId}"
                                   data-passed="${isPassed}" data-remaining="${isRemaining}" data-station="${isStation}"
                                   ${isChecked ? 'checked' : ''} onchange="updateCwStepCount()" />
                            <label class="form-check-label small ${isPassed && data.isPartiallyCompleted && !isRework ? 'text-muted' : ''}" for="cwS_${s.stepId}">
                                <strong>#${s.sequenceNo} ${s.label}</strong>
                                <span class="badge bg-light text-dark border ms-1">${s.target}</span>
                                <span class="badge bg-secondary-subtle text-secondary small ms-1">${s.toolType}</span>
                            </label>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            ${data.isPartiallyCompleted ? (isPassed ? badgePassed : badgeRemaining) : ''}
                            ${badgeStation}
                        </div>`;
                    sList.appendChild(row);
                });
            });

            onCwScopeChanged();

            new bootstrap.Modal(document.getElementById('customWorkloadModal')).show();
        }

        function updateCwStepCount() {
            const isSteps = document.getElementById('cwScopeSteps')?.checked;
            if (!isSteps) return;

            const checkedBoxes = document.querySelectorAll('.cw-step-checkbox:checked');
            const count = checkedBoxes.length;
            const btnSubmit = document.getElementById('btnSubmitCustomWorkload');
            const summaryInput = document.getElementById('cwScopeSummaryInput');
            const isRework = activeScannedJobData && !!activeScannedJobData.isRework;
            const rwkIter = activeScannedJobData ? ((activeScannedJobData.reworkCount || 0) + 1) : 1;

            if (summaryInput) {
                summaryInput.value = isRework
                    ? `Rework #${rwkIter}: Specific Operations (${count} steps)`
                    : `Completing Selected Operations (${count} steps)`;
            }

            if (btnSubmit) {
                if (count === 0) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i>Select at least 1 bolt`;
                } else {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = isRework
                        ? `<i class="bi bi-arrow-repeat me-1"></i>Start Rework (${count} bolt${count > 1 ? 's' : ''})`
                        : `<i class="bi bi-play-circle-fill me-1"></i>Complete Selected Work (${count} bolt${count > 1 ? 's' : ''})`;
                }
            }
        }

        function selectCwStepsFilter(filter) {
            document.querySelectorAll('.cw-step-checkbox').forEach(cb => {
                if (filter === 'remaining') {
                    cb.checked = (cb.dataset.remaining === 'true');
                } else if (filter === 'station') {
                    cb.checked = (cb.dataset.station === 'true' && cb.dataset.remaining === 'true');
                } else if (filter === 'all') {
                    cb.checked = true;
                } else if (filter === 'clear') {
                    cb.checked = false;
                }
            });
            updateCwStepCount();
        }

        function selectAllCwSteps(check) {
            selectCwStepsFilter(check ? 'all' : 'clear');
        }

        function onCwScopeChanged() {
            const isFull = document.getElementById('cwScopeFull')?.checked;
            const isMapped = document.getElementById('cwScopeMapped')?.checked;
            const isTemplates = document.getElementById('cwScopeTemplates')?.checked;
            const isSteps = document.getElementById('cwScopeSteps')?.checked;

            document.getElementById('cwTemplatesContainer').style.display = isTemplates ? 'block' : 'none';
            document.getElementById('cwStepsContainer').style.display = isSteps ? 'block' : 'none';

            const summaryInput = document.getElementById('cwScopeSummaryInput');
            const btnSubmit = document.getElementById('btnSubmitCustomWorkload');
            const isRework = activeScannedJobData && !!activeScannedJobData.isRework;
            const rwkIter = activeScannedJobData ? ((activeScannedJobData.reworkCount || 0) + 1) : 1;

            if (isFull) {
                summaryInput.value = isRework
                    ? `Rework #${rwkIter}: Full Product Rework`
                    : ((activeScannedJobData && activeScannedJobData.isPartiallyCompleted)
                        ? `Completing All Remaining Operations (${activeScannedJobData.remainingStepCount} steps)`
                        : 'All Mode (Full Product Assembly)');
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = isRework
                        ? `<i class="bi bi-arrow-repeat me-1"></i>Start Rework (${activeScannedJobData?.totalStepCount || ''} steps)`
                        : ((activeScannedJobData && activeScannedJobData.isPartiallyCompleted)
                            ? `<i class="bi bi-play-circle-fill me-1"></i>Complete All Remaining Work (${activeScannedJobData.remainingStepCount} steps)`
                            : `<i class="bi bi-play-circle-fill me-1"></i>Start in All Mode (Unrestricted)`);
                }
            } else if (isMapped) {
                summaryInput.value = isRework
                    ? `Rework #${rwkIter}: Line Scope`
                    : ((activeScannedJobData && activeScannedJobData.isPartiallyCompleted)
                        ? `Completing Station Scope (${activeScannedJobData.stationRemainingStepCount || 0} steps)`
                        : ((activeScannedJobData && activeScannedJobData.mappedScopeSummary) || 'Assembly Line Pre-mapped Scope'));
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = isRework
                        ? `<i class="bi bi-arrow-repeat me-1"></i>Start Line Rework`
                        : ((activeScannedJobData && activeScannedJobData.isPartiallyCompleted)
                            ? `<i class="bi bi-play-circle-fill me-1"></i>Start Station Scope (${activeScannedJobData.stationRemainingStepCount || 0} remaining)`
                            : `<i class="bi bi-play-circle-fill me-1"></i>Start Line Assembly (${activeScannedJobData?.currentLineName || ''})`);
                }
            } else if (isTemplates) {
                summaryInput.value = isRework ? `Rework #${rwkIter}: Specific Templates` : 'Specific Templates Assembly';
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = `<i class="bi bi-play-circle-fill me-1"></i>Start Selected Templates`;
                }
            } else if (isSteps) {
                updateCwStepCount();
            }
        }

        async function startInAllModeFast() {
            if (!activeScannedJobData) return;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrfToken = tokenInput ? tokenInput.value : '';

            const isRework = !!activeScannedJobData.isRework;
            const btn = document.getElementById('btnStartAllModeFast');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = isRework
                    ? '<span class="spinner-border spinner-border-sm me-1"></span>Starting Rework...'
                    : '<span class="spinner-border spinner-border-sm me-1"></span>Starting in All Mode...';
            }

            try {
                const response = await fetch('/Worker/JobBoard/ApplyCustomWorkload', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    body: JSON.stringify({
                        jobId: activeScannedJobData.jobId,
                        unitIndex: activeScannedJobData.unitIndex,
                        scopeType: 1,
                        isAllMode: true,
                        isRework: isRework,
                        reworkReason: activeScannedJobData.reworkReason || 'Full Product Rework',
                        allowedTemplateIds: null,
                        allowedStepIds: null,
                        scopeSummary: isRework
                            ? `Rework #${(activeScannedJobData.reworkCount || 0) + 1}: Full Product Rework`
                            : 'All Mode (Full Product Assembly)'
                    })
                });
                const res = await response.json();
                if (res.success && res.redirectUrl) {
                    window.location.href = res.redirectUrl;
                } else {
                    alert(res.message || 'Failed to start guidance.');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = isRework
                            ? '<i class="bi bi-arrow-repeat me-1"></i>Rework Entire Unit'
                            : '<i class="bi bi-unlock-fill me-1"></i>Start in All Mode (Unrestricted)';
                    }
                }
            } catch (err) {
                console.error('Start error:', err);
                alert('An error occurred while starting guidance.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = isRework
                        ? '<i class="bi bi-arrow-repeat me-1"></i>Rework Entire Unit'
                        : '<i class="bi bi-unlock-fill me-1"></i>Start in All Mode (Unrestricted)';
                }
            }
        }

        async function submitCustomWorkload() {
            if (!activeScannedJobData) return;

            const isFull = document.getElementById('cwScopeFull')?.checked;
            const isMapped = document.getElementById('cwScopeMapped')?.checked;
            const isTemplates = document.getElementById('cwScopeTemplates')?.checked;
            const isSteps = document.getElementById('cwScopeSteps')?.checked;
            const isRework = !!activeScannedJobData.isRework;
            const rwkIter = (activeScannedJobData.reworkCount || 0) + 1;

            let scopeType = 1;
            let allowedTemplates = null;
            let allowedSteps = null;
            let isAllMode = false;

            if (isFull) {
                scopeType = 1;
                isAllMode = true;
            } else if (isMapped && activeScannedJobData) {
                scopeType = activeScannedJobData.mappedScopeType || 1;
                allowedTemplates = activeScannedJobData.mappedTemplateIds;
                allowedSteps = activeScannedJobData.mappedStepIds;
            } else if (isTemplates) {
                scopeType = 2;
                const selectedT = Array.from(document.querySelectorAll('.cw-template-checkbox:checked')).map(cb => cb.value);
                if (selectedT.length === 0) {
                    alert('Please select at least one template.');
                    return;
                }
                allowedTemplates = selectedT.join(',');
            } else if (isSteps) {
                scopeType = 3;
                const selectedS = Array.from(document.querySelectorAll('.cw-step-checkbox:checked')).map(cb => cb.value);
                if (selectedS.length === 0) {
                    alert('Please select at least one operation/step.');
                    return;
                }
                allowedSteps = selectedS.join(',');
            }

            const defaultSummary = isRework
                ? `Rework #${rwkIter}: ` + (isFull ? 'Full Product Rework' : (isTemplates ? 'Specific Templates' : (isSteps ? 'Specific Steps' : 'Line Scope')))
                : (isFull ? 'All Mode (Full Product Assembly)' : (isMapped ? (activeScannedJobData.mappedScopeSummary || 'Station Line Scope') : 'Custom Worker Scope'));

            const scopeSummary = document.getElementById('cwScopeSummaryInput').value.trim() || defaultSummary;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrfToken = tokenInput ? tokenInput.value : '';

            const btn = document.getElementById('btnSubmitCustomWorkload');
            btn.disabled = true;
            btn.innerHTML = isRework
                ? '<span class="spinner-border spinner-border-sm me-1"></span>Starting Rework Guidance...'
                : '<span class="spinner-border spinner-border-sm me-1"></span>Starting Guidance...';

            try {
                const response = await fetch('/Worker/JobBoard/ApplyCustomWorkload', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    body: JSON.stringify({
                        jobId: activeScannedJobData.jobId,
                        unitIndex: activeScannedJobData.unitIndex,
                        scopeType: scopeType,
                        isAllMode: isAllMode,
                        isRework: isRework,
                        reworkReason: activeScannedJobData.reworkReason || 'Worker rework',
                        allowedTemplateIds: allowedTemplates,
                        allowedStepIds: allowedSteps,
                        scopeSummary: scopeSummary
                    })
                });

                const data = await response.json();
                if (data.success && data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert(data.message || 'Failed to configure workload.');
                    btn.disabled = false;
                    btn.innerHTML = isRework
                        ? '<i class="bi bi-arrow-repeat me-1"></i>Start Rework Guidance'
                        : '<i class="bi bi-play-circle-fill me-1"></i>Apply Scope &amp; Start';
                }
            } catch (err) {
                console.error("Apply workload error:", err);
                alert('An error occurred while saving custom workload.');
                btn.disabled = false;
                btn.innerHTML = isRework
                    ? '<i class="bi bi-arrow-repeat me-1"></i>Start Rework Guidance'
                    : '<i class="bi bi-play-circle-fill me-1"></i>Apply Scope &amp; Start';
            }
        }

        let activePurData = null;
        function openPassedUnitReworkModal(data) {
            activePurData = data;
            document.getElementById('purCompletedAt').innerText = data.completedAt || 'earlier';
            document.getElementById('purProductSummary').innerText = `Unit #${data.unitIndex} — ${data.productCode} (${data.productName || ''})`;
            document.getElementById('purToken').innerText = data.tokenNo;
            document.getElementById('purReasonInput').value = '';

            const purModal = new bootstrap.Modal(document.getElementById('passedUnitReworkModal'));
            purModal.show();
        }

        function proceedToReworkScope() {
            if (!activePurData) return;
            const reason = document.getElementById('purReasonInput').value.trim();
            const category = document.getElementById('purCategorySelect').value;

            if (!reason) {
                alert('Please enter a rework reason / issue description.');
                document.getElementById('purReasonInput').focus();
                return;
            }

            const purModalEl = document.getElementById('passedUnitReworkModal');
            if (purModalEl) {
                const m = bootstrap.Modal.getInstance(purModalEl);
                if (m) m.hide();
            }

            activePurData.isRework = true;
            activePurData.reworkReason = `${category}: ${reason}`;
            activePurData.reworkCategory = category;

            // Open custom workload selector in Rework Mode
            openCustomWorkloadModal(activePurData, true);
        }
    </script>
}
