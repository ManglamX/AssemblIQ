@model SmartTorque.Services.WorkerProfileStatsDto
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Profile";
}

<div class="container-fluid px-3 py-4" style="max-width: 1040px;" id="worker-profile-root">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Profile Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-2 flex-shrink-0" style="width:72px;height:72px;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "W" : Model.FullName.Substring(0, 1).ToUpperInvariant())
                </div>
                <div class="flex-grow-1">
                    <h1 class="h4 fw-bold mb-1">@Model.FullName</h1>
                    <div class="text-muted small">
                        <i class="bi bi-person-badge me-1"></i>Employee No: <strong>@(Model.EmployeeNo ?? "N/A")</strong> &middot;
                        <i class="bi bi-envelope me-1"></i>@Model.Email
                    </div>
                    <div class="small text-muted mt-1">
                        Role: <span class="badge bg-secondary">Worker</span> &middot;
                        Member since: <strong>@(Model.JoinedAt?.ToString("MMM yyyy") ?? "2026")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Production KPI Cards Row -->
    <h2 class="h5 fw-bold mb-3">Performance &amp; Quality Metrics</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Total Sessions</div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalSessions</div>
                <div class="small text-muted">Completed sessions</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Quality Pass Rate</div>
                <div class="fs-3 fw-bold text-success">@Model.PassRate.ToString("F1")%</div>
                <div class="small text-muted">@Model.PassedSessions passed &middot; @Model.FailedSessions rework</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Units Manufactured</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalUnitsCompleted</div>
                <div class="small text-muted">Fully verified units</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Today's Output</div>
                <div class="fs-3 fw-bold text-info">@Model.TodaySessions</div>
                <div class="small text-muted">@Model.TodayPassed passed today</div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1: FPY Trend + Session Donut -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="fw-bold small text-uppercase text-muted mb-3">
                        <i class="bi bi-graph-up text-success me-1"></i>First-Pass Yield — Last 30 Days
                    </div>
                    <div style="height:220px; position:relative;"><canvas id="fpyChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="fw-bold small text-uppercase text-muted mb-3">
                        <i class="bi bi-pie-chart text-primary me-1"></i>Session Results
                    </div>
                    <div class="flex-grow-1 d-flex align-items-center justify-content-center" style="min-height:180px; position:relative;">
                        <canvas id="donutChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2: Weekly Volume Stacked Bar + vs Plant Average -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="fw-bold small text-uppercase text-muted mb-3">
                        <i class="bi bi-bar-chart-fill text-info me-1"></i>Weekly Session Volume (Last 8 Weeks)
                    </div>
                    <div style="height:220px; position:relative;"><canvas id="weeklyChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="fw-bold small text-uppercase text-muted mb-3">
                        <i class="bi bi-people-fill me-1 text-secondary"></i>Quality vs Plant Average
                    </div>
                    <div class="flex-grow-1" style="min-height:160px; position:relative;">
                        <canvas id="vsPlantChart"></canvas>
                    </div>
                    <div class="text-center mt-3 pt-2 border-top">
                        <span class="badge bg-success-subtle text-success border border-success-subtle me-2 px-3 py-2" id="myPassBadge">
                            You: @Model.PassRate.ToString("F1")%
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2" id="plantPassBadge">
                            Plant Average: ...
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<div id="spa-page-scripts">
<script>
(function () {
    function safeCreateChart(canvasId, config) {
        try {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return null;
            if (typeof Chart === 'undefined') {
                console.warn('[Profile Analytics] Chart.js not ready yet.');
                return null;
            }
            const existing = Chart.getChart(canvas);
            if (existing) {
                existing.destroy();
            }
            return new Chart(canvas, config);
        } catch (err) {
            console.error('[Profile Analytics] Error creating chart ' + canvasId, err);
            return null;
        }
    }

    async function initProfile() {
        // Wait up to 2 seconds for Chart.js if needed
        let attempts = 0;
        while (typeof Chart === 'undefined' && attempts < 20) {
            await new Promise(r => setTimeout(r, 100));
            attempts++;
        }

        // 1. Static Donut from Razor Model (instant display)
        const passedSessions = @Model.PassedSessions;
        const failedSessions = @Model.FailedSessions;
        const totalSessions = @Model.TotalSessions;
        const incomplete = Math.max(0, totalSessions - passedSessions - failedSessions);

        safeCreateChart('donutChart', {
            type: 'doughnut',
            data: {
                labels: ['Pass', 'Rework / Fail', 'Incomplete'],
                datasets: [{
                    data: [passedSessions, failedSessions, incomplete],
                    backgroundColor: ['#198754', '#dc3545', '#adb5bd'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 } } },
                    tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.raw} sessions` } }
                }
            }
        });

        // 2. Fetch Chart Data from server
        let d = null;
        try {
            const res = await fetch('/Worker/Profile/ChartData');
            if (res.ok) {
                d = await res.json();
            }
        } catch (e) {
            console.error('[Profile Analytics] ChartData fetch failed', e);
        }

        if (!d) return;

        // 3. FPY 30-Day Line Chart
        if (d.dailyFpyLabels && d.dailyFpyLabels.length > 0) {
            const fpyFiltered = (d.dailyFpyValues || []).map(v => v < 0 ? null : v);
            safeCreateChart('fpyChart', {
                type: 'line',
                data: {
                    labels: d.dailyFpyLabels,
                    datasets: [{
                        label: 'FPY %',
                        data: fpyFiltered,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25,135,84,0.08)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3,
                        spanGaps: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { min: 0, max: 100, ticks: { callback: v => v + '%', font: { size: 10 } }, grid: { color: '#f0f0f0' } },
                        x: { ticks: { maxTicksLimit: 10, font: { size: 10 } }, grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // 4. Weekly Stacked Bar
        if (d.weeklyLabels && d.weeklyLabels.length > 0) {
            safeCreateChart('weeklyChart', {
                type: 'bar',
                data: {
                    labels: d.weeklyLabels,
                    datasets: [
                        { label: 'Pass', data: d.weeklyPassed || [], backgroundColor: 'rgba(25,135,84,0.75)', stack: 'wk' },
                        { label: 'Rework', data: d.weeklyFailed || [], backgroundColor: 'rgba(220,53,69,0.65)', stack: 'wk' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { stacked: true, ticks: { font: { size: 10 } } }, y: { stacked: true, ticks: { font: { size: 10 } } } },
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
                }
            });
        }

        // 5. vs Plant Average
        const myPass = @Model.PassRate;
        const plantPass = d.plantAvgPassRate || 0;
        const plantEl = document.getElementById('plantPassBadge');
        if (plantEl) plantEl.textContent = `Plant Average: ${plantPass.toFixed(1)}%`;

        safeCreateChart('vsPlantChart', {
            type: 'bar',
            data: {
                labels: ['You', 'Plant Avg'],
                datasets: [{
                    data: [myPass, plantPass],
                    backgroundColor: [myPass >= plantPass ? 'rgba(25,135,84,0.75)' : 'rgba(255,193,7,0.75)', 'rgba(108,117,125,0.55)'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { min: 0, max: 100, ticks: { callback: v => v + '%', font: { size: 10 } } },
                    y: { ticks: { font: { size: 11, weight: 'bold' } } }
                }
            }
        });
    }

    // Run immediately if DOM ready, otherwise wait for DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProfile);
    } else {
        initProfile();
    }
})();
</script>
</div>
}
