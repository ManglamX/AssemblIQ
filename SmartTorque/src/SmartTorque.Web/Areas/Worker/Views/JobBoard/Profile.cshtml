@model SmartTorque.Services.WorkerProfileStatsDto
@{
    Layout = "_WorkerLayout";
    ViewData["Title"] = "Worker Profile";
}

<div class="container-fluid px-3 py-4" style="max-width: 960px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Shop-Floor Placement Card -->
    @{
        var workerUser = ViewBag.WorkerUser as SmartTorque.Core.Entities.ApplicationUser;
        var availableUnits = ViewBag.AvailableUnits as List<SmartTorque.Core.Entities.AssemblyLine> ?? new List<SmartTorque.Core.Entities.AssemblyLine>();
        var availableStations = ViewBag.AvailableStations as List<SmartTorque.Core.Entities.WorkStation> ?? new List<SmartTorque.Core.Entities.WorkStation>();
    }
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt-fill text-primary"></i>
                <h3 class="h6 fw-bold mb-0">Shop-Floor Assignment (Line &amp; Station / Subcell)</h3>
            </div>
            @if (workerUser?.Department != null)
            {
                <span class="badge bg-light text-dark border">
                    <i class="bi bi-building me-1 text-primary"></i>Dept: @workerUser.Department.Name
                </span>
            }
        </div>
        <div class="card-body p-3">
            <form asp-action="UpdatePlacement" asp-controller="JobBoard" asp-area="Worker" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted mb-1" for="profileUnit">Assigned Line or Cell</label>
                        <select name="assemblyLineId" id="profileUnit" class="form-select form-select-sm">
                            <option value="">-- No Line Assigned --</option>
                            @foreach (var u in availableUnits)
                            {
                                <option value="@u.AssemblyLineId" selected="@(workerUser?.CurrentAssemblyLineId == u.AssemblyLineId ? "selected" : null)">
                                    @u.AssemblyName (@u.AssemblyCode) — @u.UnitType
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted mb-1" for="profileStation">Assigned Station or Subcell</label>
                        <select name="workStationId" id="profileStation" class="form-select form-select-sm">
                            <option value="">-- No Station Assigned --</option>
                            @foreach (var s in availableStations)
                            {
                                <option value="@s.WorkStationId" selected="@(workerUser?.WorkStationId == s.WorkStationId ? "selected" : null)">
                                    @s.StationName (@s.StationCode) — @s.StationType
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-save me-1"></i> Save
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Profile Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-2" style="width:72px;height:72px;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "W" : Model.FullName.Substring(0, 1).ToUpperInvariant())
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-1">@Model.FullName</h1>
                        <div class="text-muted small">
                            <i class="bi bi-person-badge me-1"></i>Employee No: <strong>@(Model.EmployeeNo ?? "N/A")</strong> &middot;
                            <i class="bi bi-envelope me-1"></i>@Model.Email
                        </div>
                        <div class="small text-muted mt-1">
                            Role: <span class="badge bg-secondary">Worker</span> &middot;
                            Member since: <strong>@(Model.JoinedAt?.ToString("MMM yyyy") ?? "2026")</strong>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Worker/JobBoard" class="btn btn-primary btn-sm">
                        <i class="bi bi-kanban me-1"></i> Job Board
                    </a>
                    <a href="/Worker/History" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-clock-history me-1"></i> History
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Production KPI Cards -->
    <h2 class="h5 fw-bold mb-3">Performance &amp; Quality Metrics</h2>
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Total Sessions</div>
                <div class="fs-3 fw-bold num text-dark">@Model.TotalSessions</div>
                <div class="small text-muted">Archived sessions</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Quality Pass Rate</div>
                <div class="fs-3 fw-bold num text-success">@Model.PassRate.ToString("F1")%</div>
                <div class="small text-muted">@Model.PassedSessions passed &middot; @Model.FailedSessions rework</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Units Manufactured</div>
                <div class="fs-3 fw-bold num text-primary">@Model.TotalUnitsCompleted</div>
                <div class="small text-muted">Fully verified units</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 p-3 shadow-sm border-0 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Today's Output</div>
                <div class="fs-3 fw-bold num text-info">@Model.TodaySessions</div>
                <div class="small text-muted">@Model.TodayPassed passed today</div>
            </div>
        </div>
    </div>

    <!-- Quality Summary Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h3 class="h6 fw-bold mb-0">Operator Guidelines &amp; Quality Standards</h3>
        </div>
        <div class="card-body">
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                <li><i class="bi bi-check-circle-fill text-success me-2"></i> Always confirm the visual marker on the component schematic matches your physical assembly bolt.</li>
                <li><i class="bi bi-check-circle-fill text-success me-2"></i> Ensure digital torque wrench or vernier caliper displays <strong>Live Connected</strong> before tightening or measuring.</li>
                <li><i class="bi bi-check-circle-fill text-success me-2"></i> If a measurement falls outside the tolerance band, inspect bolt threading and perform an authorized retry before exceeding limits.</li>
            </ul>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const unitSelect = document.getElementById('profileUnit');
    const stationSelect = document.getElementById('profileStation');
    if (!unitSelect || !stationSelect) return;

    unitSelect.addEventListener('change', async function () {
        const lineId = this.value;
        stationSelect.innerHTML = '<option value="">-- No Station Assigned --</option>';
        if (!lineId) return;

        try {
            const res = await fetch('/Worker/Profile/GetStationsForLine?lineId=' + lineId);
            if (res.ok) {
                const stations = await res.json();
                stations.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.name + ' (' + s.code + ')';
                    stationSelect.appendChild(opt);
                });
            }
        } catch (e) {
            console.error('Failed to load stations:', e);
        }
    });
});
</script>
