@model SmartTorque.Web.ViewModels.QrRepository.QrRepositoryViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "PRD QR Code Repository";
    ViewData["ActiveNav"] = "QrRepository";
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                <i class="bi bi-qr-code-scan me-1"></i>Central Traceability Index
            </span>
            @if (!Model.IsPlantHead && !string.IsNullOrEmpty(Model.CurrentUserDepartmentName))
            {
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 small">
                    <i class="bi bi-building me-1"></i>Dept: @Model.CurrentUserDepartmentName
                </span>
            }
        </div>
        <h1 class="h4 fw-bold text-dark mb-0">PRD QR Code Repository &amp; Directory</h1>
        <p class="text-muted small mb-0">Search, verify, and reprint 40-character unique PRD QR codes across all products and work packages</p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btnOpenScanner">
            <i class="bi bi-camera me-1"></i> Scan QR to Locate
        </button>
        <button type="button" class="btn btn-dark btn-sm shadow-sm d-none" id="btnPrintSelectedQr">
            <i class="bi bi-printer me-1"></i> Print Selected (<span id="selectedCountBadge">0</span>)
        </button>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total PRD Units</div>
                        <div class="h3 fw-bold text-dark mb-0">@Model.TotalCount</div>
                        <span class="text-muted small">Across @Model.TotalJobs active jobs</span>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-qr-code fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Passed / Assembled</div>
                        <div class="h3 fw-bold text-success mb-0">@Model.TotalPassed</div>
                        <span class="badge bg-success-subtle text-success">Quality Compliant</span>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">In Progress</div>
                        <div class="h3 fw-bold text-warning mb-0">@Model.TotalInProgress</div>
                        <span class="badge bg-warning-subtle text-warning">Active on Station</span>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-secondary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Pending Assembly</div>
                        <div class="h3 fw-bold text-secondary mb-0">@Model.TotalPending</div>
                        <span class="text-muted small">Awaiting shop floor build</span>
                    </div>
                    <div class="bg-secondary-subtle text-secondary p-3 rounded-circle">
                        <i class="bi bi-box fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card border-0 shadow-sm bg-white rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end" id="qrFilterForm">
            <div class="col-md-4 col-lg-4">
                <label class="form-label small fw-semibold text-muted">Search Token, Job No, Product, Serial</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" id="repoSearchInput" value="@Model.Search" class="form-control border-start-0" placeholder="e.g. PRD-E7CF..., 46171506..., JOB-..." />
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Clear Search"><i class="bi bi-x"></i></a>
                    }
                </div>
            </div>

            @if (Model.IsPlantHead && Model.AvailableDepartments.Count > 0)
            {
                <div class="col-6 col-md-2 col-lg-2">
                    <label class="form-label small fw-semibold text-muted">Department</label>
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var d in Model.AvailableDepartments)
                        {
                            <option value="@d.Value" selected="@d.Selected">@d.Text</option>
                        }
                    </select>
                </div>
            }

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label small fw-semibold text-muted">Assembly Line</label>
                <select name="assemblyLineId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Lines</option>
                    @foreach (var l in Model.AvailableLines)
                    {
                        <option value="@l.Value" selected="@l.Selected">@l.Text</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2 col-lg-2">
                <label class="form-label small fw-semibold text-muted">Unit Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed / Pass</option>
                    <option value="InProgress" selected="@(Model.Status == "InProgress")">In Progress</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Failed" selected="@(Model.Status == "Failed")">Failed</option>
                </select>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>

            <div class="col text-end small text-muted">
                Showing <strong>@Model.Units.Count</strong> results
            </div>
        </form>
    </div>
</div>

<!-- Bulk Selection Floating Bar -->
<div id="repoBulkBar" class="alert alert-dark d-none py-2 px-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm rounded-3">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-check2-square fs-5 text-warning"></i>
        <span class="fw-bold" id="repoBulkCount">0 PRD units selected</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-primary shadow-sm" id="btnPrintSelectedRepo">
            <i class="bi bi-printer me-1"></i>Print Selected QR Labels
        </button>
        <button type="button" class="btn btn-sm btn-outline-light" id="btnClearSelectedRepo">
            Deselect All
        </button>
    </div>
</div>

<!-- View Mode Tabs & Select All -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="selectAllRepo">
            <label class="form-check-label small fw-semibold text-muted" for="selectAllRepo">
                Select All on Page
            </label>
        </div>
    </div>
    <ul class="nav nav-pills nav-pills-sm gap-1" id="viewModeTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active py-1 px-3 small" id="grid-view-tab" data-bs-toggle="pill" data-bs-target="#grid-view" type="button">
                <i class="bi bi-grid-fill me-1"></i> Cards Grid
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1 px-3 small" id="table-view-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button">
                <i class="bi bi-list-ul me-1"></i> Detailed Table
            </button>
        </li>
    </ul>
</div>

@if (Model.Units.Count == 0)
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-qr-code fs-1 text-muted mb-2 d-block"></i>
            <h5 class="fw-bold text-dark">No PRD QR Codes Found</h5>
            <p class="text-muted small mb-0">No product units match the specified search query or filters.</p>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="mt-3">
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Clear Filters &amp; View All
                    </a>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="tab-content" id="viewModeContent">
        <!-- 1. CARDS GRID VIEW -->
        <div class="tab-pane fade show active" id="grid-view" role="tabpanel">
            <div class="row g-3">
                @foreach (var unit in Model.Units)
                {
                    var statusBadge = unit.Status switch
                    {
                        SmartTorque.Core.Enums.UnitAssemblyStatus.Completed => "bg-success text-white",
                        SmartTorque.Core.Enums.UnitAssemblyStatus.Failed => "bg-danger text-white",
                        SmartTorque.Core.Enums.UnitAssemblyStatus.InProgress => "bg-warning text-dark",
                        _ => "bg-secondary text-white"
                    };

                    var statusText = unit.Status switch
                    {
                        SmartTorque.Core.Enums.UnitAssemblyStatus.Completed => "PASS",
                        SmartTorque.Core.Enums.UnitAssemblyStatus.Failed => "FAIL",
                        SmartTorque.Core.Enums.UnitAssemblyStatus.InProgress => "IN PROGRESS",
                        _ => "PENDING"
                    };

                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 border shadow-sm rounded-3 hover-shadow transition">
                            <div class="card-header bg-white border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <input type="checkbox" class="form-check-input repo-unit-check m-0" value="@unit.TokenNo" data-token="@unit.TokenNo" />
                                    <span class="fw-bold text-dark fs-6">PRD-@unit.UnitIndex</span>
                                </div>
                                <span class="badge @statusBadge small text-uppercase">@statusText</span>
                            </div>
                            <div class="card-body p-3 text-center d-flex flex-column align-items-center">
                                <!-- QR Thumbnail -->
                                <div class="p-2 border rounded bg-white shadow-sm mb-2" style="width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                     onclick="previewQrModal('@unit.TokenNo', 'PRD-@unit.UnitIndex', '@unit.ProductCode', '@unit.JobNo');" title="Click to enlarge & print">
                                    <img src="@Url.Action("UnitQrCode", "Job", new { token = unit.TokenNo, pixels = 8 })" alt="QR Code" style="width: 100%; height: 100%; object-fit: contain;" />
                                </div>

                                <!-- 40-digit Token with Copy Button -->
                                <div class="input-group input-group-sm mb-2 w-100">
                                    <input type="text" class="form-control form-control-sm font-monospace text-center small bg-light" value="@unit.TokenNo" readonly id="tok-@unit.JobUnitId" style="font-size: 0.68rem;" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('@unit.TokenNo'); alert('Copied token to clipboard: @unit.TokenNo');" title="Copy Token">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>

                                <!-- Product Info -->
                                <div class="w-100 text-start small mb-2 border-top pt-2">
                                    <div class="d-flex justify-content-between text-truncate mb-1">
                                        <span class="text-muted">Product:</span>
                                        <strong class="text-dark text-truncate" title="@unit.ProductName">@unit.ProductCode</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-truncate mb-1">
                                        <span class="text-muted">Job:</span>
                                        <a href="@Url.Action("Detail", "Job", new { id = unit.JobId })" class="fw-semibold font-monospace text-decoration-none">@unit.JobNo</a>
                                    </div>
                                    <div class="d-flex justify-content-between text-truncate">
                                        <span class="text-muted">Line:</span>
                                        <span class="text-dark text-truncate" title="@unit.AssemblyLineName">@unit.AssemblyLineName</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-light border-top p-2 d-flex justify-content-between gap-1">
                                <a href="@Url.Action("PrintUnitQrs", "Job", new { id = unit.JobId, unitNo = unit.UnitIndex })" target="_blank" class="btn btn-sm btn-outline-dark flex-grow-1" title="Print QR Label">
                                    <i class="bi bi-printer me-1"></i> Print
                                </a>
                                <a href="@Url.Action("Traceability", "Report", new { q = unit.TokenNo })" class="btn btn-sm btn-outline-primary flex-grow-1" title="Quality Traceability">
                                    <i class="bi bi-search me-1"></i> Trace
                                </a>
                                @if (unit.Status == SmartTorque.Core.Enums.UnitAssemblyStatus.Completed)
                                {
                                    <a href="@Url.Action("ExportProductUnitPdfByToken", "Report", new { token = unit.TokenNo })" target="_blank" class="btn btn-sm btn-outline-danger" title="Download QA Report (PDF)">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 2. DETAILED TABLE VIEW -->
        <div class="tab-pane fade" id="table-view" role="tabpanel">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;"></th>
                                <th style="width: 70px;">QR</th>
                                <th>PRD Unit &amp; Token</th>
                                <th>Product</th>
                                <th>Job Work Order</th>
                                <th>Target Line</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in Model.Units)
                            {
                                var statusBadge = unit.Status switch
                                {
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.Completed => "bg-success text-white",
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.Failed => "bg-danger text-white",
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.InProgress => "bg-warning text-dark",
                                    _ => "bg-secondary text-white"
                                };

                                var statusText = unit.Status switch
                                {
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.Completed => "PASS",
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.Failed => "FAIL",
                                    SmartTorque.Core.Enums.UnitAssemblyStatus.InProgress => "IN PROGRESS",
                                    _ => "PENDING"
                                };

                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input repo-unit-check" value="@unit.TokenNo" data-token="@unit.TokenNo" />
                                    </td>
                                    <td>
                                        <img src="@Url.Action("UnitQrCode", "Job", new { token = unit.TokenNo, pixels = 5 })" alt="QR" style="width: 44px; height: 44px; cursor: pointer;"
                                             onclick="previewQrModal('@unit.TokenNo', 'PRD-@unit.UnitIndex', '@unit.ProductCode', '@unit.JobNo');" title="Enlarge" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">PRD-@unit.UnitIndex <span class="text-muted small fw-normal">of @unit.TotalQuantity</span></div>
                                        <div class="font-monospace small text-muted text-truncate" style="max-width: 280px;" title="@unit.TokenNo">@unit.TokenNo</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@unit.ProductCode</div>
                                        <div class="small text-muted text-truncate" style="max-width: 200px;">@unit.ProductName</div>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Detail", "Job", new { id = unit.JobId })" class="fw-semibold font-monospace text-decoration-none">@unit.JobNo</a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@unit.AssemblyLineName</span>
                                    </td>
                                    <td>
                                        <span class="badge @statusBadge px-2 py-1">@statusText</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a href="@Url.Action("PrintUnitQrs", "Job", new { id = unit.JobId, unitNo = unit.UnitIndex })" target="_blank" class="btn btn-sm btn-outline-dark" title="Print QR Label">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                            <a href="@Url.Action("Traceability", "Report", new { q = unit.TokenNo })" class="btn btn-sm btn-outline-primary" title="Quality Traceability">
                                                <i class="bi bi-search"></i>
                                            </a>
                                            @if (unit.Status == SmartTorque.Core.Enums.UnitAssemblyStatus.Completed)
                                            {
                                                <a href="@Url.Action("ExportProductUnitPdfByToken", "Report", new { token = unit.TokenNo })" target="_blank" class="btn btn-sm btn-outline-danger" title="Download QA Report (PDF)">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- Hidden Form for Batch Print in New Tab -->
<form id="repoBatchPrintForm" action="/Job/PrintBatchQrs" method="post" target="_blank" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="tokens" id="repoBatchTokens" />
</form>

<!-- Modal: QR Code Preview & Enlarged View -->
<div class="modal fade" id="previewQrModalDialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content border-0 shadow-lg text-center p-3" style="border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0 text-dark" id="modalPrdTitle">PRD-1</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="p-3 bg-white border rounded shadow-sm my-2">
                <img id="modalQrImg" src="" alt="QR Code" style="width: 220px; height: 220px; object-fit: contain;" />
            </div>
            <div class="font-monospace small bg-light p-2 rounded text-truncate border my-2" id="modalTokenText"></div>
            <div class="small text-muted mb-3" id="modalMetaText"></div>
            <div class="d-flex gap-2">
                <a id="modalPrintLink" href="#" target="_blank" class="btn btn-primary btn-sm flex-grow-1 shadow-sm">
                    <i class="bi bi-printer me-1"></i> Print Label
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Camera QR Scanner -->
<div class="modal fade" id="repoScannerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white" style="border-radius: 16px 16px 0 0;">
                <div>
                    <h5 class="modal-title h6 fw-bold mb-0">
                        <i class="bi bi-camera text-primary me-2"></i>Scan PRD QR Code
                    </h5>
                    <small class="text-white-50">Point camera at physical PRD label or enter token manually</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseRepoScanner"></button>
            </div>
            <div class="modal-body p-3 text-center">
                <div class="position-relative mx-auto bg-black rounded-3 overflow-hidden shadow" style="max-width: 380px; height: 280px;">
                    <video id="repoScannerVideo" playsinline autoplay muted style="width: 100%; height: 100%; object-fit: cover;"></video>
                    <div id="repoScannerReticle" style="position: absolute; top: 15%; left: 15%; width: 70%; height: 70%; border: 2px dashed rgba(255,255,255,0.7); border-radius: 12px; pointer-events: none; box-shadow: 0 0 0 1000px rgba(0,0,0,0.45);">
                        <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background: #dc2626; animation: scanLine 2s infinite ease-in-out;"></div>
                    </div>
                    <div id="repoScannerCameraError" class="position-absolute top-50 start-50 translate-middle text-white p-3 d-none w-100">
                        <i class="bi bi-camera-video-off fs-1 text-danger mb-2 d-block"></i>
                        <span class="small">Camera access not available. Use manual token input below.</span>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label small fw-semibold text-muted">Or enter 40-character PRD Token manually:</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control font-monospace" id="repoManualTokenInput" placeholder="PRD-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" />
                        <button type="button" class="btn btn-primary" id="btnSubmitRepoManualToken">
                            <i class="bi bi-search me-1"></i> Locate
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scanLine {
        0% { top: 5%; opacity: 0.8; }
        50% { top: 90%; opacity: 1; }
        100% { top: 5%; opacity: 0.8; }
    }
    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
    }
    .transition {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
</style>

@section Scripts {
    <script>
        (function() {
            // Preview QR Modal
            window.previewQrModal = function(token, title, productCode, jobNo) {
                document.getElementById('modalPrdTitle').textContent = title;
                document.getElementById('modalQrImg').src = '/Job/UnitQrCode?token=' + encodeURIComponent(token) + '&pixels=12';
                document.getElementById('modalTokenText').textContent = token;
                document.getElementById('modalMetaText').textContent = productCode + ' • ' + jobNo;
                document.getElementById('modalPrintLink').href = '/Job/PrintBatchQrs?tokens=' + encodeURIComponent(token);
                new bootstrap.Modal(document.getElementById('previewQrModalDialog')).show();
            };

            // Bulk Checkbox Handling
            const checks = document.querySelectorAll('.repo-unit-check');
            const selectAll = document.getElementById('selectAllRepo');
            const bulkBar = document.getElementById('repoBulkBar');
            const bulkCount = document.getElementById('repoBulkCount');
            const btnPrintSelected = document.getElementById('btnPrintSelectedRepo');
            const btnClearSelected = document.getElementById('btnClearSelectedRepo');

            function updateBulk() {
                const checked = Array.from(checks).filter(c => c.checked);
                if (checked.length > 0) {
                    bulkBar.classList.remove('d-none');
                    bulkCount.textContent = checked.length + ' PRD units selected';
                    document.getElementById('btnPrintSelectedQr')?.classList.remove('d-none');
                    document.getElementById('selectedCountBadge').textContent = checked.length;
                } else {
                    bulkBar.classList.add('d-none');
                    document.getElementById('btnPrintSelectedQr')?.classList.add('d-none');
                }
                if (selectAll) {
                    selectAll.checked = checked.length > 0 && checked.length === checks.length;
                    selectAll.indeterminate = checked.length > 0 && checked.length < checks.length;
                }
            }

            selectAll?.addEventListener('change', function() {
                checks.forEach(c => c.checked = selectAll.checked);
                updateBulk();
            });

            checks.forEach(c => c.addEventListener('change', updateBulk));

            btnClearSelected?.addEventListener('click', function() {
                checks.forEach(c => c.checked = false);
                updateBulk();
            });

            function printSelectedTokens() {
                const checked = Array.from(checks).filter(c => c.checked);
                if (checked.length === 0) return;
                const tokens = checked.map(c => c.value);
                document.getElementById('repoBatchTokens').value = tokens.join(',');
                document.getElementById('repoBatchPrintForm').submit();
            }

            btnPrintSelected?.addEventListener('click', printSelectedTokens);
            document.getElementById('btnPrintSelectedQr')?.addEventListener('click', printSelectedTokens);

            // Scanner Camera Logic
            let videoStream = null;
            let scanInterval = null;
            const scannerModalEl = document.getElementById('repoScannerModal');
            const scannerModal = scannerModalEl ? new bootstrap.Modal(scannerModalEl) : null;
            const videoEl = document.getElementById('repoScannerVideo');
            const cameraErrorEl = document.getElementById('repoScannerCameraError');

            document.getElementById('btnOpenScanner')?.addEventListener('click', () => {
                scannerModal?.show();
                startCamera();
            });

            document.getElementById('btnCloseRepoScanner')?.addEventListener('click', stopCamera);
            scannerModalEl?.addEventListener('hidden.bs.modal', stopCamera);

            async function startCamera() {
                if (cameraErrorEl) cameraErrorEl.classList.add('d-none');
                try {
                    videoStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
                    });
                    if (videoEl) {
                        videoEl.srcObject = videoStream;
                        videoEl.play();
                    }
                    startDecoding();
                } catch (err) {
                    console.warn('Camera stream error:', err);
                    if (cameraErrorEl) cameraErrorEl.classList.remove('d-none');
                }
            }

            function stopCamera() {
                if (scanInterval) { clearInterval(scanInterval); scanInterval = null; }
                if (videoStream) {
                    videoStream.getTracks().forEach(t => t.stop());
                    videoStream = null;
                }
            }

            function onTokenFound(token) {
                stopCamera();
                scannerModal?.hide();
                // Put in search and submit
                const searchInp = document.getElementById('repoSearchInput');
                if (searchInp) {
                    searchInp.value = token;
                    document.getElementById('qrFilterForm')?.submit();
                }
            }

            function startDecoding() {
                if ('BarcodeDetector' in window) {
                    const detector = new BarcodeDetector({ formats: ['qr_code'] });
                    scanInterval = setInterval(async () => {
                        if (!videoEl || videoEl.readyState !== videoEl.HAVE_ENOUGH_DATA) return;
                        try {
                            const barcodes = await detector.detect(videoEl);
                            if (barcodes.length > 0) {
                                const raw = barcodes[0].rawValue || '';
                                if (raw.trim()) {
                                    onTokenFound(raw.trim());
                                }
                            }
                        } catch (e) {}
                    }, 250);
                }
            }

            document.getElementById('btnSubmitRepoManualToken')?.addEventListener('click', () => {
                const tok = document.getElementById('repoManualTokenInput')?.value.trim();
                if (tok) {
                    onTokenFound(tok);
                } else {
                    alert('Please enter a PRD token.');
                }
            });
        })();
    </script>
}
