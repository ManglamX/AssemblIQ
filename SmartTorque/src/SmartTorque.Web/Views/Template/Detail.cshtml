@model SmartTorque.Web.ViewModels.Template.TemplateDetailViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["ActiveNav"] = "Templates";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <code class="fs-6">@Model.TemplateCode</code>
            <span class="badge-status @(Model.Mode == TemplateMode.Mixed ? "badge-inprogress" : Model.Mode == TemplateMode.Vernier ? "badge-assigned" : "badge-completed")">
                @Model.Mode
            </span>
            <span class="badge-status @(Model.IsActive ? "badge-completed" : "badge-cancelled")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
            @if (!Model.IsLatest)
            {
                <span class="badge-status badge-pending">Not Latest</span>
            }
        </div>
        <h1 class="h4 fw-bold mb-1">@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted mb-0">@Model.Description</p>
        }
        <small class="text-muted">
            v@(Model.Version) — Created by @(Model.CreatedBy ?? "—")
            on @Model.CreatedAt.ToIstString("dd MMM yyyy HH:mm")
        </small>
    </div>
    @if (Model.IsLatest)
    {
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-id="@Model.TemplateId" class="btn btn-secondary" id="btn-edit">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form asp-action="SetActive" method="post" class="d-inline" onsubmit="return @(Model.IsActive ? "confirm('Are you sure you want to deactivate template \\'@Model.TemplateCode\\'? This will prevent it from being used in new products.')" : "true");">
                <input type="hidden" name="id" value="@Model.TemplateId" />
                <input type="hidden" name="isActive" value="@(!Model.IsActive ? "true" : "false")" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Detail", new { id = Model.TemplateId })" />
                <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-secondary")" id="btn-toggle-active">
                    @(Model.IsActive ? "Deactivate" : "Activate")
                </button>
            </form>
        </div>
    }
</div>

<div class="row g-4">

    <!-- Steps table with tolerance band -->
    <div class="col-md-@(string.IsNullOrEmpty(Model.ImagePath) ? "12" : "7")">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-list-check"></i>
                @Model.Steps.Count Step@(Model.Steps.Count != 1 ? "s" : "")
            </div>
            <div class="card-body p-0">
                <table class="table mb-0" id="steps-detail-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Label</th>
                            <th>Instrument</th>
                            <th class="text-center">Target</th>
                            <th class="text-center">Lower</th>
                            <th class="text-center">Upper</th>
                            <th class="text-center">Mode</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in Model.Steps)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">@step.SequenceNo</td>
                                <td class="fw-semibold">@step.Label</td>
                                <td>
                                    <span class="badge-status @(step.Instrument == InstrumentType.Torque ? "badge-completed" : "badge-assigned")">
                                        <i class="bi @(step.Instrument == InstrumentType.Torque ? "bi-wrench" : "bi-rulers") me-1"></i>@step.Instrument
                                    </span>
                                </td>
                                <td class="text-center num fw-bold">
                                    @step.Target.ToString("F3") <span class="text-muted small">@step.Unit</span>
                                </td>
                                <td class="text-center num" style="color:var(--pass-text)">
                                    @step.Lower.ToString("F3")
                                </td>
                                <td class="text-center num" style="color:var(--pass-text)">
                                    @step.Upper.ToString("F3")
                                </td>
                                <td class="text-center">
                                    <span class="badge-status badge-pending">
                                        @(step.ToleranceMode == ToleranceMode.Percent ? "%" : "Abs")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Version history -->
        @if (Model.OtherVersions.Count > 1)
        {
            <div class="card mt-4">
                <div class="card-header"><i class="bi bi-clock-history me-2"></i>Version History</div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>Created</th>
                                <th>By</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.OtherVersions)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        v@v.Version
                                        @if (v.IsLatest)
                                        {
                                            <span class="badge-status badge-completed ms-1">Latest</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@v.CreatedAt.ToIstString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-muted small">@(v.CreatedBy ?? "—")</td>
                                    <td>
                                        <a asp-action="Detail" asp-route-id="@v.TemplateId"
                                           class="btn btn-sm btn-secondary" id="btn-ver-@v.Version">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Image panel with markers & perspective viewer -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="col-md-5">
            <div class="card border shadow-sm">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-image me-2"></i>Component Image</span>
                    <span class="badge bg-light text-dark border">@Model.TemplateCode</span>
                </div>
                <!-- Perspective & Zoom Controls -->
                <div class="bg-light border-bottom px-2 py-1 d-flex justify-content-between align-items-center flex-wrap gap-1 small">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpZoom(0.25)" title="Zoom In (+)">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpZoom(-0.25)" title="Zoom Out (-)">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpReset()" title="Reset Zoom">
                            <span id="tmpl-zoom-label" class="font-monospace" style="font-size: 11px;">100%</span>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="text-muted small me-1" title="Marker Size"><i class="bi bi-pin-map"></i></span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary py-0 px-1" onclick="tmplStepMarkerSize(-3)" title="Smaller Markers"><i class="bi bi-dash"></i></button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplCycleMarkerSize()" title="Toggle Marker Size">
                                <span id="tmpl-marker-size-label" class="font-monospace" style="font-size: 11px;">100%</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-0 px-1" onclick="tmplStepMarkerSize(3)" title="Larger Markers"><i class="bi bi-plus"></i></button>
                        </div>
                    </div>

                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpRotate(-90)" title="Rotate Counter-Clockwise 90°">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpRotate(90)" title="Rotate Clockwise 90°">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="tmplBpFlip()" title="Flip Horizontal">
                            <i class="bi bi-symmetry-vertical"></i>
                        </button>
                    </div>
                </div>
                <div id="tmpl-bp-viewport" class="card-body p-0 position-relative text-center user-select-none" style="height: 320px; overflow: hidden; background: #0f172a; cursor: grab;">
                    <div id="tmpl-bp-canvas" style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(1) rotate(0deg); transform-origin: center center; transition: transform 0.12s ease-out; will-change: transform;">
                        <div id="image-container" class="position-relative d-inline-block" style="line-height: 0;">
                            <img id="tmpl-bp-img" src="/@Model.ImagePath" alt="Component" class="rounded border shadow-sm d-block" style="max-height: 290px; width: auto; pointer-events: none; user-select: none;" />
                            <svg id="tmpl-cad-svg" style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; overflow:visible; z-index:8;"></svg>
                            @foreach (var step in Model.Steps.Where(s => s.MarkerX.HasValue && s.MarkerY.HasValue))
                            {
                                var markerSize = step.MarkerSize ?? 24;
                                var markerFontSize = Math.Max(9, (int)Math.Round(markerSize * 0.48));
                                var x1 = step.MarkerX!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var y1 = step.MarkerY!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                if (step.MarkerX2.HasValue && step.MarkerY2.HasValue)
                                {
                                    var x2 = step.MarkerX2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var y2 = step.MarkerY2.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                    <!-- Precision AutoCAD Osnap Snap Grips (No big circular bubbles) -->
                                    <div class="cad-snap-grip" style="position:absolute; left:@(x1)%; top:@(y1)%; width:7px; height:7px; background:#fff; border:1.5px solid #168039; border-radius:1px; transform:translate(-50%, -50%); z-index:10; pointer-events:none;" title="Step @step.SequenceNo (Point 1)"></div>
                                    <div class="cad-snap-grip" style="position:absolute; left:@(x2)%; top:@(y2)%; width:7px; height:7px; background:#fff; border:1.5px solid #168039; border-radius:1px; transform:translate(-50%, -50%); z-index:10; pointer-events:none;" title="Step @step.SequenceNo (Point 2)"></div>
                                }
                                else
                                {
                                    <div class="marker-current tmpl-marker shadow-sm"
                                         data-base-size="@markerSize"
                                         style="position:absolute; width:@(markerSize)px; height:@(markerSize)px; border-radius:50%;
                                                left:@(x1)%;
                                                top:@(y1)%;
                                                transform: translate(-50%, -50%);
                                                display:flex; align-items:center; justify-content:center;
                                                font-size:@(markerFontSize)px; font-weight:700; color:#fff;
                                                background:var(--brand); border:2px solid #fff; cursor: pointer; z-index: 5;
                                                transition: width 0.15s ease, height 0.15s ease, font-size 0.15s ease;"
                                         title="Step @step.SequenceNo: @step.Label (@step.Target @Model.Mode)">
                                        <span class="tmpl-marker-label d-inline-block">@step.SequenceNo</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="position-absolute bottom-0 start-0 m-1 px-2 py-0 bg-dark bg-opacity-75 text-white rounded small" style="font-size: 10px; pointer-events: none; z-index: 6;">
                        <i class="bi bi-arrows-move me-1"></i>Drag to pan • Scroll to zoom
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary" id="btn-back-list">
        <i class="bi bi-arrow-left me-1"></i>Back to Template Catalogue
    </a>
</div>


@section Scripts {
    <script>
        const tmplBpState = {
            scale: 1,
            translateX: 0,
            translateY: 0,
            rotation: 0,
            flipH: 1,
            isDragging: false,
            startX: 0,
            startY: 0
        };

        function tmplBpApplyTransform() {
            const canvas = document.getElementById("tmpl-bp-canvas");
            const zoomLabel = document.getElementById("tmpl-zoom-label");
            if (!canvas) return;

            canvas.style.transform = `translate(calc(-50% + ${tmplBpState.translateX}px), calc(-50% + ${tmplBpState.translateY}px)) scale(${tmplBpState.scale * tmplBpState.flipH}, ${tmplBpState.scale}) rotate(${tmplBpState.rotation}deg)`;

            const labels = canvas.querySelectorAll(".tmpl-marker-label");
            labels.forEach(lbl => {
                lbl.style.transform = `rotate(${-tmplBpState.rotation}deg) scale(${tmplBpState.flipH}, 1)`;
            });

            if (zoomLabel) {
                zoomLabel.textContent = Math.round(tmplBpState.scale * 100) + "%";
            }
        }

        function tmplBpZoom(delta) {
            tmplBpState.scale = Math.max(0.5, Math.min(5, tmplBpState.scale + delta));
            tmplBpApplyTransform();
        }

        function tmplBpRotate(deg) {
            tmplBpState.rotation = (tmplBpState.rotation + deg + 360) % 360;
            tmplBpApplyTransform();
        }

        function tmplBpFlip() {
            tmplBpState.flipH *= -1;
            tmplBpApplyTransform();
        }

        function tmplBpReset() {
            tmplBpState.scale = 1;
            tmplBpState.translateX = 0;
            tmplBpState.translateY = 0;
            tmplBpState.rotation = 0;
            tmplBpState.flipH = 1;
            tmplBpApplyTransform();
        }

        const tmplViewport = document.getElementById("tmpl-bp-viewport");
        if (tmplViewport) {
            tmplViewport.addEventListener("mousedown", (e) => {
                if (e.target.closest(".tmpl-marker") || e.button !== 0) return;
                tmplBpState.isDragging = true;
                tmplBpState.startX = e.clientX - tmplBpState.translateX;
                tmplBpState.startY = e.clientY - tmplBpState.translateY;
                tmplViewport.style.cursor = "grabbing";
            });

            window.addEventListener("mousemove", (e) => {
                if (!tmplBpState.isDragging) return;
                tmplBpState.translateX = e.clientX - tmplBpState.startX;
                tmplBpState.translateY = e.clientY - tmplBpState.startY;
                tmplBpApplyTransform();
            });

            window.addEventListener("mouseup", () => {
                if (tmplBpState.isDragging) {
                    tmplBpState.isDragging = false;
                    if (tmplViewport) tmplViewport.style.cursor = "grab";
                }
            });

            tmplViewport.addEventListener("wheel", (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.2 : -0.2;
                tmplBpZoom(delta);
            }, { passive: false });
        }
            var tmplMarkerSize = parseInt(localStorage.getItem('smarttorque_marker_size') || '24');
        function tmplSetMarkerSize(size) {
            size = Math.max(14, Math.min(52, parseInt(size) || 24));
            tmplMarkerSize = size;
            localStorage.setItem('smarttorque_marker_size', size);
            tmplApplyMarkerScale();
        }
        // Markers carry their own template-authored size; the +/- tools scale
        // every pin from its data-base-size (24px = 100%).
        function tmplApplyMarkerScale() {
            var scale = tmplMarkerSize / 24;
            var fontSize = Math.max(9, Math.round(tmplMarkerSize * 0.48));
            document.querySelectorAll('.tmpl-marker').forEach(function(m) {
                var base = parseInt(m.getAttribute('data-base-size') || '24');
                var sz = Math.max(12, Math.round(base * scale));
                m.style.width = sz + 'px';
                m.style.height = sz + 'px';
                m.style.fontSize = fontSize + 'px';
            });
            var lbl = document.getElementById('tmpl-marker-size-label');
            if (lbl) lbl.textContent = Math.round(scale * 100) + '%';
        }
        function tmplStepMarkerSize(delta) {
            tmplSetMarkerSize(tmplMarkerSize + delta);
        }
        function tmplCycleMarkerSize() {
            var presets = [16, 24, 32, 42];
            var idx = presets.indexOf(tmplMarkerSize);
            var next = (idx === -1) ? 24 : presets[(idx + 1) % presets.length];
            tmplSetMarkerSize(next);
        }
        const tmplSteps = [
            @foreach (var s in Model.Steps.Where(s => s.MarkerX.HasValue && s.MarkerY.HasValue))
            {
                <text>{
                    seq: @s.SequenceNo,
                    label: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(s.Label))",
                    target: "@s.Target.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)",
                    unit: "@s.Unit",
                    x1: @s.MarkerX!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    y1: @s.MarkerY!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    x2: @(s.MarkerX2.HasValue ? s.MarkerX2.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null"),
                    y2: @(s.MarkerY2.HasValue ? s.MarkerY2.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null")
                },</text>
            }
        ];

        function getCadDimType(label) {
            if (!label) return "distance";
            var l = label.trim().toLowerCase();
            if (/^(r\b|r\d|radius|rad)/i.test(l) || /\bradius\b/i.test(l)) return "radius";
            if (/^(ø|dia|diameter|bore|hole|circle)/i.test(l) || /\b(dia|diameter|bore|hole|circle)\b/i.test(l)) return "diameter";
            return "distance";
        }

        function renderTmplCadSvg() {
            var svg = document.getElementById("tmpl-cad-svg");
            var img = document.getElementById("tmpl-bp-img");
            if (!svg || !img) return;
            var w = img.clientWidth;
            var h = img.clientHeight;
            if (w <= 0 || h <= 0) return;
            svg.setAttribute("viewBox", "0 0 " + w + " " + h);
            svg.innerHTML = "";

            var CAD_GREEN = "#168039";
            var CAD_TEXT_RED = "#d32f2f";
            var CAD_BLUE = "#2563eb";

            tmplSteps.forEach(function (s) {
                if (s.x1 != null && s.y1 != null && s.x2 != null && s.y2 != null) {
                    var px1 = (s.x1 / 100) * w;
                    var py1 = (s.y1 / 100) * h;
                    var px2 = (s.x2 / 100) * w;
                    var py2 = (s.y2 / 100) * h;
                    var dx = px2 - px1;
                    var dy = py2 - py1;
                    var dist = Math.hypot(dx, dy) || 1;
                    var ux = dx / dist;
                    var uy = dy / dist;
                    var nx = -uy;
                    var ny = ux;
                    var dimType = getCadDimType(s.label);

                    if (dimType === "radius") {
                        var rad = dist < 6 ? 25 : dist;
                        var ang = Math.atan2(dy, dx);
                        var cx = px1 + rad * Math.cos(ang);
                        var cy = py1 + rad * Math.sin(ang);
                        var shDir = Math.cos(ang) >= 0 ? 1 : -1;
                        var shX = cx + shDir * 16;
                        var shY = cy;

                        svg.innerHTML += '<line x1="' + (px1 - 5) + '" y1="' + py1 + '" x2="' + (px1 + 5) + '" y2="' + py1 + '" stroke="' + CAD_BLUE + '" stroke-width="1.2" />' +
                                         '<line x1="' + px1 + '" y1="' + (py1 - 5) + '" x2="' + px1 + '" y2="' + (py1 + 5) + '" stroke="' + CAD_BLUE + '" stroke-width="1.2" />' +
                                         '<circle cx="' + px1 + '" cy="' + py1 + '" r="' + rad + '" fill="none" stroke="' + CAD_GREEN + '" stroke-width="1.2" stroke-dasharray="4,3" opacity="0.85" />' +
                                         '<path d="M ' + px1 + ' ' + py1 + ' L ' + cx + ' ' + cy + ' L ' + shX + ' ' + shY + '" fill="none" stroke="' + CAD_GREEN + '" stroke-width="1.4" />';

                        var b1 = (cx - Math.cos(ang) * 7 - Math.sin(ang) * 2.5) + ',' + (cy - Math.sin(ang) * 7 + Math.cos(ang) * 2.5);
                        var b2 = (cx - Math.cos(ang) * 7 + Math.sin(ang) * 2.5) + ',' + (cy - Math.sin(ang) * 7 - Math.cos(ang) * 2.5);
                        svg.innerHTML += '<polygon points="' + cx + ',' + cy + ' ' + b1 + ' ' + b2 + '" fill="' + CAD_GREEN + '" />';

                        svg.innerHTML += '<text x="' + ((cx + shX) / 2) + '" y="' + (shY - 4) + '" fill="' + CAD_TEXT_RED + '" font-family="Consolas, monospace" font-size="11" font-weight="700" text-anchor="middle" dominant-baseline="central" style="paint-order:stroke fill; stroke:#fff; stroke-width:2.5px;">R ' + s.target + '</text>';
                    } else if (dimType === "diameter") {
                        var mx = (px1 + px2) / 2;
                        var my = (py1 + py2) / 2;
                        var dRad = dist / 2;
                        var angD = Math.atan2(dy, dx) * 180 / Math.PI;
                        if (angD > 90) angD -= 180; else if (angD < -90) angD += 180;

                        svg.innerHTML += '<line x1="' + (mx - 5) + '" y1="' + my + '" x2="' + (mx + 5) + '" y2="' + my + '" stroke="' + CAD_BLUE + '" stroke-width="1.2" />' +
                                         '<line x1="' + mx + '" y1="' + (my - 5) + '" x2="' + mx + '" y2="' + (my + 5) + '" stroke="' + CAD_BLUE + '" stroke-width="1.2" />' +
                                         '<circle cx="' + mx + '" cy="' + my + '" r="' + dRad + '" fill="none" stroke="' + CAD_GREEN + '" stroke-width="1.2" stroke-dasharray="4,3" opacity="0.85" />' +
                                         '<line x1="' + px1 + '" y1="' + py1 + '" x2="' + px2 + '" y2="' + py2 + '" stroke="' + CAD_GREEN + '" stroke-width="1.4" />';

                        var ad1 = (px1 + ux * 7 + nx * 2.5) + ',' + (py1 + uy * 7 + ny * 2.5);
                        var ad2 = (px1 + ux * 7 - nx * 2.5) + ',' + (py1 + uy * 7 - ny * 2.5);
                        var bd1 = (px2 - ux * 7 + nx * 2.5) + ',' + (py2 - uy * 7 + ny * 2.5);
                        var bd2 = (px2 - ux * 7 - nx * 2.5) + ',' + (py2 - uy * 7 - ny * 2.5);
                        svg.innerHTML += '<polygon points="' + px1 + ',' + py1 + ' ' + ad1 + ' ' + ad2 + '" fill="' + CAD_GREEN + '" />' +
                                         '<polygon points="' + px2 + ',' + py2 + ' ' + bd1 + ' ' + bd2 + '" fill="' + CAD_GREEN + '" />';

                        svg.innerHTML += '<text x="' + (mx + nx * 6) + '" y="' + (my + ny * 6) + '" transform="rotate(' + angD + ', ' + (mx + nx * 6) + ', ' + (my + ny * 6) + ')" fill="' + CAD_TEXT_RED + '" font-family="Consolas, monospace" font-size="11" font-weight="700" text-anchor="middle" dominant-baseline="central" style="paint-order:stroke fill; stroke:#fff; stroke-width:2.5px;">Ø ' + s.target + '</text>';
                    } else {
                        var tick = 9;
                        var angL = Math.atan2(dy, dx) * 180 / Math.PI;
                        if (angL > 90) angL -= 180; else if (angL < -90) angL += 180;
                        var midX = (px1 + px2) / 2;
                        var midY = (py1 + py2) / 2;

                        svg.innerHTML += '<line x1="' + (px1 - nx * tick) + '" y1="' + (py1 - ny * tick) + '" x2="' + (px1 + nx * (tick + 3)) + '" y2="' + (py1 + ny * (tick + 3)) + '" stroke="' + CAD_GREEN + '" stroke-width="1.4" />' +
                                         '<line x1="' + (px2 - nx * tick) + '" y1="' + (py2 - ny * tick) + '" x2="' + (px2 + nx * (tick + 3)) + '" y2="' + (py2 + ny * (tick + 3)) + '" stroke="' + CAD_GREEN + '" stroke-width="1.4" />' +
                                         '<line x1="' + px1 + '" y1="' + py1 + '" x2="' + px2 + '" y2="' + py2 + '" stroke="' + CAD_GREEN + '" stroke-width="1.4" />';

                        var al1 = (px1 + ux * 7 + nx * 2.5) + ',' + (py1 + uy * 7 + ny * 2.5);
                        var al2 = (px1 + ux * 7 - nx * 2.5) + ',' + (py1 + uy * 7 - ny * 2.5);
                        var bl1 = (px2 - ux * 7 + nx * 2.5) + ',' + (py2 - uy * 7 + ny * 2.5);
                        var bl2 = (px2 - ux * 7 - nx * 2.5) + ',' + (py2 - uy * 7 - ny * 2.5);
                        svg.innerHTML += '<polygon points="' + px1 + ',' + py1 + ' ' + al1 + ' ' + al2 + '" fill="' + CAD_GREEN + '" />' +
                                         '<polygon points="' + px2 + ',' + py2 + ' ' + bl1 + ' ' + bl2 + '" fill="' + CAD_GREEN + '" />';

                        svg.innerHTML += '<text x="' + (midX + nx * 6) + '" y="' + (midY + ny * 6) + '" transform="rotate(' + angL + ', ' + (midX + nx * 6) + ', ' + (midY + ny * 6) + ')" fill="' + CAD_TEXT_RED + '" font-family="Consolas, monospace" font-size="11" font-weight="700" text-anchor="middle" dominant-baseline="central" style="paint-order:stroke fill; stroke:#fff; stroke-width:2.5px;">' + s.target + ' mm</text>';
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            tmplSetMarkerSize(tmplMarkerSize);
            var img = document.getElementById("tmpl-bp-img");
            if (img) {
                if (img.complete && img.naturalWidth > 0) renderTmplCadSvg();
                else img.onload = renderTmplCadSvg;
            }
            window.addEventListener("resize", renderTmplCadSvg);
        });
    </script>
}
