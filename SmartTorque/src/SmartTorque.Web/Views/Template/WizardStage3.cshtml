@model SmartTorque.Web.ViewModels.Template.Stage3ViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["ActiveNav"] = "Templates";
}

<!-- Wizard progress -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-3 mb-2">
        @{
            string[] stages = ["Basic Info", "Image & Steps", "Values & Tolerances"];
            for (int i = 0; i < stages.Length; i++)
            {
                bool current = i == 2; bool done = i < 2;
                <div class="d-flex align-items-center gap-2 @(i < stages.Length - 1 ? "flex-grow-1" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                             style="width:32px;height:32px;font-size:13px;
                             background:@(current ? "var(--brand)" : done ? "var(--pass)" : "var(--border)");
                             color:@(current || done ? "#fff" : "var(--text-muted)")">
                            @if (done) { <i class="bi bi-check"></i> } else { <span>@(i + 1)</span> }
                        </div>
                        <span class="small fw-@(current ? "bold" : "normal") @(current ? "text-brand" : "text-muted")">@stages[i]</span>
                    </div>
                    @if (i < stages.Length - 1) { <hr class="flex-grow-1 my-0" style="border-color:var(--border)" /> }
                </div>
            }
        }
    </div>
</div>

<form asp-action="Save" method="post" id="wizard-stage3-form">
    <!-- Pass-through hidden fields -->
    <input type="hidden" asp-for="TemplateCode" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="Mode" />
    <input type="hidden" asp-for="ImagePath" />
    <input type="hidden" asp-for="EditingTemplateId" />

    <div class="row g-4">

        <!-- Image panel + markers -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header"><i class="bi bi-image me-2"></i>Component Image — Click to place markers</div>
                    <div class="card-body p-2" style="position:relative">
                        <div id="image-container" style="position:relative;display:inline-block;width:100%">
                            <img src="/@Model.ImagePath" id="component-image"
                                 alt="Component image"
                                 style="width:100%;display:block;border-radius:var(--radius-sm)"
                                 onclick="placeMarker(event)" />

                            <!-- Step markers will be rendered here by JS -->
                        </div>
                        <p class="text-muted small mt-2 mb-0 text-center">
                            <i class="bi bi-cursor me-1"></i>Click on image to place the selected step's marker
                        </p>
                    </div>
                </div>
            </div>
        }

        <!-- Step rows -->
        <div class="@(!string.IsNullOrEmpty(Model.ImagePath) ? "col-md-7" : "col-12")">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-list-ol me-2"></i>Step Configuration</span>
                    <span class="small text-muted">@Model.Steps.Count step@(Model.Steps.Count != 1 ? "s" : "")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="steps-table">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th style="width:100px">Instrument</th>
                                    <th>Label</th>
                                    <th style="width:90px">Target</th>
                                    <th style="width:80px">Tol +</th>
                                    <th style="width:80px">Tol −</th>
                                    <th style="width:80px">Mode</th>
                                    <th style="width:70px">Retries</th>
                                    <th style="width:70px">Marker</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Steps.Count; i++)
                                {
                                    var step = Model.Steps[i];
                                    <tr id="step-row-@i" class="step-row" data-index="@i"
                                        onclick="selectStep(@i)"
                                        style="cursor:pointer">
                                        <input type="hidden" name="Steps[@i].SequenceNo" value="@step.SequenceNo" />
                                        <input type="hidden" name="Steps[@i].MarkerX" id="markerX-@i" value="@step.MarkerX" />
                                        <input type="hidden" name="Steps[@i].MarkerY" id="markerY-@i" value="@step.MarkerY" />
                                        <td class="fw-bold text-muted">@step.SequenceNo</td>
                                        <td>
                                            <select name="Steps[@i].Instrument" class="form-select form-select-sm instrument-select"
                                                    onchange="updateUnit(@i, this.value)">
                                                @foreach (InstrumentType inst in Enum.GetValues<InstrumentType>())
                                                {
                                                    <option value="@((int)inst)" selected="@(step.Instrument == inst)">@inst</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" name="Steps[@i].Label"
                                                   class="form-control form-control-sm"
                                                   value="@step.Label"
                                                   placeholder="e.g. Bolt 1 – Top Left" required />
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" name="Steps[@i].Target"
                                                       class="form-control"
                                                       value="@step.Target"
                                                       step="0.001" min="0.001" required />
                                                <span class="input-group-text unit-badge-@i" style="font-size:11px">
                                                    @step.Unit
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].TolerancePlus"
                                                   class="form-control form-control-sm"
                                                   value="@step.TolerancePlus"
                                                   step="0.001" min="0" required />
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].ToleranceMinus"
                                                   class="form-control form-control-sm"
                                                   value="@step.ToleranceMinus"
                                                   step="0.001" min="0" required />
                                        </td>
                                        <td>
                                            <select name="Steps[@i].ToleranceMode" class="form-select form-select-sm">
                                                @foreach (ToleranceMode tm in Enum.GetValues<ToleranceMode>())
                                                {
                                                    <option value="@((int)tm)" selected="@(step.ToleranceMode == tm)">
                                                        @(tm == ToleranceMode.Absolute ? "Abs" : "%")
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].MaxRetries"
                                                   class="form-control form-control-sm"
                                                   value="@step.MaxRetries"
                                                   min="1" max="20" required />
                                        </td>
                                        <td class="text-center">
                                            @if (step.MarkerX.HasValue)
                                            {
                                                <span class="badge rounded-pill text-bg-success small" id="marker-badge-@i">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary small" id="marker-badge-@i" style="opacity:.4">
                                                    <i class="bi bi-geo-alt"></i>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer actions -->
    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-secondary" onclick="history.back()" id="btn-back-2">
            <i class="bi bi-arrow-left me-1"></i> Back
        </button>
        <button type="submit" class="btn btn-primary px-5" id="btn-save">
            <i class="bi bi-floppy me-2"></i>
            @(Model.EditingTemplateId.HasValue ? "Save Changes" : "Create Template")
        </button>
    </div>
</form>

@section Scripts {
<script>
let selectedStep = 0;

function selectStep(index) {
    document.querySelectorAll('.step-row').forEach(r => r.style.background = '');
    const row = document.getElementById('step-row-' + index);
    if (row) row.style.background = 'var(--brand-light)';
    selectedStep = index;
}

function placeMarker(event) {
    const img = document.getElementById('component-image');
    const rect = img.getBoundingClientRect();
    const x = ((event.clientX - rect.left) / rect.width * 100).toFixed(3);
    const y = ((event.clientY - rect.top) / rect.height * 100).toFixed(3);

    document.getElementById('markerX-' + selectedStep).value = x;
    document.getElementById('markerY-' + selectedStep).value = y;

    // Update marker badge
    const badge = document.getElementById('marker-badge-' + selectedStep);
    if (badge) {
        badge.className = 'badge rounded-pill text-bg-success small';
        badge.innerHTML = '<i class="bi bi-geo-alt-fill"></i>';
    }

    renderMarkers();
}

function renderMarkers() {
    const container = document.getElementById('image-container');
    if (!container) return;
    // Remove old markers
    container.querySelectorAll('.step-marker').forEach(m => m.remove());
    // Draw each placed marker
    @for (int i = 0; i < Model.Steps.Count; i++)
    {
        <text>
        (function() {
            const mx = document.getElementById('markerX-@i');
            const my = document.getElementById('markerY-@i');
            if (mx && my && mx.value && my.value) {
                addMarkerDot(@i, parseFloat(mx.value), parseFloat(my.value));
            }
        })();
        </text>
    }
}

function addMarkerDot(index, x, y) {
    const container = document.getElementById('image-container');
    if (!container) return;
    const dot = document.createElement('div');
    dot.className = 'step-marker marker-current';
    dot.style.cssText = `position:absolute;width:20px;height:20px;border-radius:50%;
        left:calc(${x}% - 10px);top:calc(${y}% - 10px);
        display:flex;align-items:center;justify-content:center;
        font-size:11px;font-weight:700;color:#fff;cursor:pointer;
        background:var(--brand);border:2px solid #fff;`;
    dot.textContent = index + 1;
    dot.onclick = (e) => { e.stopPropagation(); selectStep(index); };
    container.appendChild(dot);
}

function updateUnit(index, instrumentValue) {
    const unitEl = document.querySelector('.unit-badge-' + index);
    if (unitEl) unitEl.textContent = parseInt(instrumentValue) === 1 ? 'N·m' : 'mm';
}

// Init on load
document.addEventListener('DOMContentLoaded', () => {
    selectStep(0);
    renderMarkers();
});
</script>
}
