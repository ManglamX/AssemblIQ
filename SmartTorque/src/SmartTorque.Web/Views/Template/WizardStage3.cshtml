@model SmartTorque.Web.ViewModels.Template.Stage3ViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["ActiveNav"] = "Templates";
}

<!-- Wizard progress -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-3 mb-2">
        @{
            string[] stages = ["Basic Info", "Image & Steps", "Values & Tolerances"];
            for (int i = 0; i < stages.Length; i++)
            {
                bool current = i == 2; bool done = i < 2;
                <div class="d-flex align-items-center gap-2 @(i < stages.Length - 1 ? "flex-grow-1" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                             style="width:32px;height:32px;font-size:13px;
                             background:@(current ? "var(--brand)" : done ? "var(--pass)" : "var(--border)");
                             color:@(current || done ? "#fff" : "var(--text-muted)")">
                            @if (done) { <i class="bi bi-check"></i> } else { <span>@(i + 1)</span> }
                        </div>
                        <span class="small fw-@(current ? "bold" : "normal") @(current ? "text-brand" : "text-muted")">@stages[i]</span>
                    </div>
                    @if (i < stages.Length - 1) { <hr class="flex-grow-1 my-0" style="border-color:var(--border)" /> }
                </div>
            }
        }
    </div>
</div>

<form asp-action="Save" method="post" id="wizard-stage3-form">
    <!-- Pass-through hidden fields -->
    <input type="hidden" asp-for="TemplateCode" id="hidden-template-code" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="Mode" id="hidden-mode" />
    <input type="hidden" asp-for="ImagePath" />
    <input type="hidden" asp-for="EditingTemplateId" id="hidden-edit-id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    @if (ViewBag.MatchingNotice != null)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <div>@ViewBag.MatchingNotice</div>
        </div>
    }

    <!-- Generated Template Code Bar -->
    <div class="card mb-4 border-primary-subtle bg-light">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <span class="text-muted small d-block">Uniquely Generated Template Code:</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="fs-5 font-monospace fw-bold text-primary" id="generated-code-display">
                        @(Model.GeneratedTemplateCode ?? Model.TemplateCode)
                    </span>
                    <span id="code-status-badge" class="badge bg-secondary-subtle text-secondary">
                        <i class="bi bi-gear-fill me-1"></i>Checking...
                    </span>
                </div>
            </div>
            <div class="text-end small text-muted">
                <div>Based on instrument specifications:</div>
                <div class="fw-semibold text-dark">
                    @if (Model.Mode == TemplateMode.Torque)
                    {
                        <span>Torque Wrench · @Model.Steps.Count Bolt@(Model.Steps.Count != 1 ? "s" : "") &amp; Target Torque</span>
                    }
                    else if (Model.Mode == TemplateMode.Vernier)
                    {
                        <span>Vernier Caliper · @Model.Steps.Count Side@(Model.Steps.Count != 1 ? "s" : "") &amp; Target Dimension</span>
                    }
                    else
                    {
                        <span>Mixed Assembly · Torque Bolts &amp; Vernier Dimensions</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Existing Matching Template Alert -->
    <div id="matching-template-alert" class="card border-warning bg-warning-subtle mb-4 @(Model.ExistingMatchingTemplate != null ? "" : "d-none")">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <strong class="text-dark">Matching Template Already Present in Library</strong>
                </div>
                <span class="badge bg-warning text-dark">Existing Specification</span>
            </div>
            <p class="mb-2 text-dark">
                A template with these exact specifications already exists:
                <strong id="match-name">@Model.ExistingMatchingTemplate?.Name</strong>
                (Code: <code id="match-code">@Model.ExistingMatchingTemplate?.TemplateCode</code> · v<span id="match-ver">@Model.ExistingMatchingTemplate?.Version</span> · <span id="match-count">@Model.ExistingMatchingTemplate?.StepCount</span> steps).
            </p>
            <p class="small text-muted mb-3">
                You can use this existing template directly when you build products in the Product Builder.
            </p>

            <div class="table-responsive bg-white rounded border mb-3">
                <table class="table table-sm table-hover mb-0" id="match-steps-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px">#</th>
                            <th>Label</th>
                            <th style="width:110px">Instrument</th>
                            <th style="width:120px">Target</th>
                            <th style="width:140px">Tolerance</th>
                        </tr>
                    </thead>
                    <tbody id="match-steps-tbody">
                        @if (Model.ExistingMatchingTemplate != null)
                        {
                            foreach (var s in Model.ExistingMatchingTemplate.Steps)
                            {
                                <tr>
                                    <td class="fw-bold">@s.SequenceNo</td>
                                    <td>@s.Label</td>
                                    <td>@s.Instrument</td>
                                    <td>@s.Target @s.Unit</td>
                                    <td>+@s.TolerancePlus / -@s.ToleranceMinus @(s.ToleranceMode == ToleranceMode.Percent ? "%" : s.Unit)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a id="btn-use-in-product"
                   href="/Product/Create?templateCode=@(Model.ExistingMatchingTemplate?.TemplateCode)"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-boxes me-1"></i>Use This Template in Product Builder
                </a>
                <a id="btn-view-existing"
                   href="/Template/Detail/@(Model.ExistingMatchingTemplate?.TemplateId)"
                   target="_blank"
                   class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>View Template Details
                </a>
                <button type="submit" name="saveAnyway" value="true" class="btn btn-sm btn-outline-primary" id="btn-save-anyway">
                    <i class="bi bi-floppy me-1"></i>Save as New Revision Anyway
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Image panel + markers -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header"><i class="bi bi-image me-2"></i>Component Image — Click to place markers</div>
                    <div class="card-body p-2" style="position:relative">
                        <div id="image-container" style="position:relative;display:inline-block;width:100%">
                            <img src="/@Model.ImagePath" id="component-image"
                                 alt="Component image"
                                 style="width:100%;display:block;border-radius:var(--radius-sm)"
                                 onclick="placeMarker(event)" />

                            <!-- Step markers will be rendered here by JS -->
                        </div>
                        <p class="text-muted small mt-2 mb-0 text-center">
                            <i class="bi bi-cursor me-1"></i>Click on image to place the selected step's marker
                        </p>
                    </div>
                </div>
            </div>
        }

        <!-- Step rows -->
        <div class="@(!string.IsNullOrEmpty(Model.ImagePath) ? "col-md-7" : "col-12")">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-list-ol me-2"></i>Step Configuration</span>
                    <span class="small text-muted">@Model.Steps.Count step@(Model.Steps.Count != 1 ? "s" : "")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="steps-table">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th style="width:100px">Instrument</th>
                                    <th>Label</th>
                                    <th style="width:90px">Target</th>
                                    <th style="width:80px">Tol +</th>
                                    <th style="width:80px">Tol −</th>
                                    <th style="width:80px">Mode</th>
                                    <th style="width:70px">Retries</th>
                                    <th style="width:70px">Marker</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Steps.Count; i++)
                                {
                                    var step = Model.Steps[i];
                                    <tr id="step-row-@i" class="step-row" data-index="@i"
                                        onclick="selectStep(@i)"
                                        style="cursor:pointer">
                                        <input type="hidden" name="Steps[@i].SequenceNo" value="@step.SequenceNo" />
                                        <input type="hidden" name="Steps[@i].MarkerX" id="markerX-@i" value="@step.MarkerX" />
                                        <input type="hidden" name="Steps[@i].MarkerY" id="markerY-@i" value="@step.MarkerY" />
                                        <td class="fw-bold text-muted">@step.SequenceNo</td>
                                        <td>
                                            <select name="Steps[@i].Instrument" class="form-select form-select-sm instrument-select step-instrument"
                                                    onchange="updateUnit(@i, this.value); scheduleCodeCheck();">
                                                @foreach (InstrumentType inst in Enum.GetValues<InstrumentType>())
                                                {
                                                    <option value="@((int)inst)" selected="@(step.Instrument == inst)">@inst</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" name="Steps[@i].Label"
                                                   class="form-control form-control-sm step-label"
                                                   value="@step.Label"
                                                   placeholder="e.g. Bolt 1 – Top Left" required />
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" name="Steps[@i].Target"
                                                       class="form-control step-target"
                                                       value="@step.Target"
                                                       step="any" min="0.001" required
                                                       oninput="scheduleCodeCheck()" />
                                                <span class="input-group-text unit-badge-@i" style="font-size:11px">
                                                    @step.Unit
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].TolerancePlus"
                                                   class="form-control form-control-sm step-tol-plus"
                                                   value="@step.TolerancePlus"
                                                   step="any" min="0" required
                                                   oninput="scheduleCodeCheck()" />
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].ToleranceMinus"
                                                   class="form-control form-control-sm step-tol-minus"
                                                   value="@step.ToleranceMinus"
                                                   step="any" min="0" required
                                                   oninput="scheduleCodeCheck()" />
                                        </td>
                                        <td>
                                            <select name="Steps[@i].ToleranceMode" class="form-select form-select-sm step-tol-mode"
                                                    onchange="scheduleCodeCheck()">
                                                @foreach (ToleranceMode tm in Enum.GetValues<ToleranceMode>())
                                                {
                                                    <option value="@((int)tm)" selected="@(step.ToleranceMode == tm)">
                                                        @(tm == ToleranceMode.Absolute ? "Abs" : "%")
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="Steps[@i].MaxRetries"
                                                   class="form-control form-control-sm"
                                                   value="@step.MaxRetries"
                                                   min="1" max="20" required />
                                        </td>
                                        <td class="text-center">
                                            @if (step.MarkerX.HasValue)
                                            {
                                                <span class="badge rounded-pill text-bg-success small" id="marker-badge-@i">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary small" id="marker-badge-@i" style="opacity:.4">
                                                    <i class="bi bi-geo-alt"></i>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer actions -->
    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-secondary" onclick="history.back()" id="btn-back-2">
            <i class="bi bi-arrow-left me-1"></i> Back
        </button>
        <button type="submit" class="btn btn-primary px-5" id="btn-save">
            <i class="bi bi-floppy me-2"></i>
            @(Model.EditingTemplateId.HasValue ? "Save Changes" : "Create Template")
        </button>
    </div>
</form>

@section Scripts {
<script>
let selectedStep = 0;

function selectStep(index) {
    document.querySelectorAll('.step-row').forEach(r => r.style.background = '');
    const row = document.getElementById('step-row-' + index);
    if (row) row.style.background = 'var(--brand-light)';
    selectedStep = index;
}

function placeMarker(event) {
    const img = document.getElementById('component-image');
    const rect = img.getBoundingClientRect();
    const x = ((event.clientX - rect.left) / rect.width * 100).toFixed(3);
    const y = ((event.clientY - rect.top) / rect.height * 100).toFixed(3);

    document.getElementById('markerX-' + selectedStep).value = x;
    document.getElementById('markerY-' + selectedStep).value = y;

    // Update marker badge
    const badge = document.getElementById('marker-badge-' + selectedStep);
    if (badge) {
        badge.className = 'badge rounded-pill text-bg-success small';
        badge.innerHTML = '<i class="bi bi-geo-alt-fill"></i>';
    }

    renderMarkers();
}

function renderMarkers() {
    const container = document.getElementById('image-container');
    if (!container) return;
    // Remove old markers
    container.querySelectorAll('.step-marker').forEach(m => m.remove());
    // Draw each placed marker
    @for (int i = 0; i < Model.Steps.Count; i++)
    {
        <text>
        (function() {
            const mx = document.getElementById('markerX-@i');
            const my = document.getElementById('markerY-@i');
            if (mx && my && mx.value && my.value) {
                addMarkerDot(@i, parseFloat(mx.value), parseFloat(my.value));
            }
        })();
        </text>
    }
}

function addMarkerDot(index, x, y) {
    const container = document.getElementById('image-container');
    if (!container) return;
    const dot = document.createElement('div');
    dot.className = 'step-marker marker-current';
    dot.style.cssText = `position:absolute;width:20px;height:20px;border-radius:50%;
        left:calc(${x}% - 10px);top:calc(${y}% - 10px);
        display:flex;align-items:center;justify-content:center;
        font-size:11px;font-weight:700;color:#fff;cursor:pointer;
        background:var(--brand);border:2px solid #fff;`;
    dot.textContent = index + 1;
    dot.onclick = (e) => { e.stopPropagation(); selectStep(index); };
    container.appendChild(dot);
}

function updateUnit(index, instrumentValue) {
    const unitEl = document.querySelector('.unit-badge-' + index);
    if (unitEl) unitEl.textContent = parseInt(instrumentValue) === 1 ? 'N·m' : 'mm';
}

let checkTimeout = null;

function scheduleCodeCheck() {
    if (checkTimeout) clearTimeout(checkTimeout);
    checkTimeout = setTimeout(checkCodeAndDuplicate, 250);
}

async function checkCodeAndDuplicate() {
    const rows = document.querySelectorAll('.step-row');
    if (!rows.length) return;

    const steps = [];
    rows.forEach((r, idx) => {
        const inst = r.querySelector('.step-instrument')?.value || '1';
        const target = parseFloat(r.querySelector('.step-target')?.value || '0');
        const tolPlus = parseFloat(r.querySelector('.step-tol-plus')?.value || '0');
        const tolMinus = parseFloat(r.querySelector('.step-tol-minus')?.value || '0');
        const tolMode = r.querySelector('.step-tol-mode')?.value || '1';
        const label = r.querySelector('input[name$=".Label"]')?.value || ('Step ' + (idx + 1));

        steps.push({
            sequenceNo: idx + 1,
            instrument: parseInt(inst),
            target: isNaN(target) ? 0 : target,
            tolerancePlus: isNaN(tolPlus) ? 0 : tolPlus,
            toleranceMinus: isNaN(tolMinus) ? 0 : tolMinus,
            toleranceMode: parseInt(tolMode),
            label: label
        });
    });

    const modeVal = parseInt(document.getElementById('hidden-mode')?.value || '1');
    const editIdVal = document.getElementById('hidden-edit-id')?.value;
    const editingTemplateId = editIdVal ? parseInt(editIdVal) : null;

    try {
        const res = await fetch('/Template/GenerateAndCheckCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mode: modeVal,
                editingTemplateId: editingTemplateId,
                steps: steps
            })
        });

        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.code) return;

        // Update code display & hidden input
        const codeDisplay = document.getElementById('generated-code-display');
        if (codeDisplay) codeDisplay.textContent = data.code;
        const hiddenInput = document.getElementById('hidden-template-code');
        if (hiddenInput) hiddenInput.value = data.code;

        const badge = document.getElementById('code-status-badge');
        const alertBox = document.getElementById('matching-template-alert');

        if (data.exists && data.template) {
            if (badge) {
                badge.className = 'badge bg-warning text-dark';
                badge.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>Already in Library';
            }

            if (alertBox) alertBox.classList.remove('d-none');
            const nameEl = document.getElementById('match-name');
            if (nameEl) nameEl.textContent = data.template.name;
            const codeEl = document.getElementById('match-code');
            if (codeEl) codeEl.textContent = data.template.templateCode;
            const verEl = document.getElementById('match-ver');
            if (verEl) verEl.textContent = data.template.version;
            const countEl = document.getElementById('match-count');
            if (countEl) countEl.textContent = data.template.stepCount;

            // Render existing steps
            const tbody = document.getElementById('match-steps-tbody');
            if (tbody && data.template.steps) {
                tbody.innerHTML = '';
                data.template.steps.forEach(s => {
                    const tr = document.createElement('tr');
                    const tolStr = '+' + s.tolerancePlus + ' / -' + s.toleranceMinus + ' ' + (s.toleranceMode === 'Percent' ? '%' : s.unit);
                    tr.innerHTML = `<td class="fw-bold">${s.sequenceNo}</td><td>${escapeHtml(s.label)}</td><td>${s.instrument}</td><td>${s.target} ${s.unit}</td><td>${tolStr}</td>`;
                    tbody.appendChild(tr);
                });
            }

            // Update action buttons
            const btnUse = document.getElementById('btn-use-in-product');
            if (btnUse) {
                btnUse.href = '/Product/Create?templateCode=' + encodeURIComponent(data.template.templateCode);
            }
            const btnView = document.getElementById('btn-view-existing');
            if (btnView) {
                btnView.href = '/Template/Detail/' + data.template.templateId;
            }
        } else {
            if (badge) {
                badge.className = 'badge bg-success-subtle text-success';
                badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Unique Code Available';
            }
            if (alertBox) alertBox.classList.add('d-none');
        }
    } catch (e) {
        console.error('Failed to check template code:', e);
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>"']/g, function(m) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
    });
}

// Init on load
document.addEventListener('DOMContentLoaded', () => {
    selectStep(0);
    renderMarkers();
    scheduleCodeCheck();
});
</script>
}
