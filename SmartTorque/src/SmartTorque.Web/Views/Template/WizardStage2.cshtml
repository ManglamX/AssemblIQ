@model SmartTorque.Web.ViewModels.Template.Stage2ViewModel
@{
    Layout = "_AdminLayout";
    ViewData["ActiveNav"] = "Templates";
}

@section HeadLinks {
<link rel="stylesheet" href="~/lib/cropperjs/cropper.min.css" />
}

<!-- Wizard progress -->
<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        @{
            string[] stages = ["Basic Info", "Image & Steps", "Values & Tolerances"];
            for (int i = 0; i < stages.Length; i++)
            {
                bool current = i == 1; bool done = i == 0;
                <div class="d-flex align-items-center gap-2 @(i < stages.Length - 1 ? "flex-grow-1" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                             style="width:32px;height:32px;font-size:13px;
                             background:@(current ? "var(--brand)" : done ? "var(--pass)" : "var(--border)");
                             color:@(current || done ? "#fff" : "var(--text-muted)")">
                            @if (done) { <i class="bi bi-check"></i> } else { <span>@(i + 1)</span> }
                        </div>
                        <span class="small fw-@(current ? "bold" : "normal") @(current ? "text-brand" : "text-muted")">@stages[i]</span>
                    </div>
                    @if (i < stages.Length - 1) { <hr class="flex-grow-1 my-0" style="border-color:var(--border)" /> }
                </div>
            }
        }
    </div>
</div>

<form asp-action="Stage2" method="post" id="wizard-stage2-form">
    <input type="hidden" asp-for="TemplateCode" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" name="Mode" id="hidden-mode" value="@((int)Model.Mode)" />
    <input type="hidden" asp-for="EditingTemplateId" />
    <input type="hidden" asp-for="ImagePath" id="hidden-image-path" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="row g-4">

        <!-- Left: Image upload -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-image me-2"></i>Component Image</div>
                <div class="card-body d-flex flex-column align-items-center gap-3 p-4">

                    <!-- Preview area -->
                    <div id="image-preview-wrap"
                         style="width:100%;min-height:160px;max-height:280px;border-radius:var(--radius);overflow:hidden;background:var(--bg-subtle);border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;">
                        @if (Model.HasImage)
                        {
                            <img id="image-preview" src="/@Model.ImagePath" alt="Component image"
                                 style="max-width:100%;max-height:280px;object-fit:contain" />
                        }
                        else
                        {
                            <div id="image-placeholder" class="text-center text-muted">
                                <i class="bi bi-card-image" style="font-size:3rem;color:var(--border)"></i>
                                <p class="mt-2 small mb-0">No image uploaded</p>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2 w-100">
                        <label class="btn btn-secondary flex-grow-1" for="file-input" id="btn-choose-image">
                            <i class="bi bi-upload me-2"></i>@(Model.HasImage ? "Replace Image" : "Choose Image")
                        </label>
                        <button type="button" class="btn btn-outline-secondary @(Model.HasImage ? "" : "d-none")"
                                id="btn-edit-image" title="Crop / edit current image">
                            <i class="bi bi-crop me-1"></i>Edit
                        </button>
                    </div>
                    <input type="file" id="file-input" accept=".jpg,.jpeg,.png,.webp" class="d-none" />

                    <small class="text-muted text-center">
                        JPG, PNG or WebP · max 5 MB.<br />
                        A crop editor opens after you choose a file.
                    </small>

                    <div id="upload-status" class="d-none w-100 text-center">
                        <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                        <span class="small text-muted">Uploading…</span>
                    </div>
                    <div id="upload-error" class="alert alert-danger d-none w-100 py-2 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span id="upload-error-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Step count -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-list-ol me-2"></i>Steps Configuration</div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">
                        Define how many measurement steps this template has.
                        Torque = number of bolts/fasteners. Vernier = number of dimensions.
                    </p>
                    <div class="mb-4">
                        <label asp-for="StepCount" class="form-label fw-semibold">
                            Number of Steps <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-secondary" id="btn-dec-steps" onclick="adjustSteps(-1)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input asp-for="StepCount" type="number"
                                   class="form-control text-center fw-bold fs-4 num"
                                   id="step-count-input" style="width:100px" min="1" max="100" />
                            <button type="button" class="btn btn-secondary" id="btn-inc-steps" onclick="adjustSteps(1)">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="StepCount" class="text-danger small"></span>
                    </div>
                    <div class="alert-inline info mb-4">
                        <i class="bi bi-info-circle"></i>
                        <span>Mode: <strong>@Model.Mode</strong> — instruments are pre-filled but can be changed individually in Step 3.</span>
                    </div>
                    <div class="d-flex justify-content-between mt-auto pt-4">
                        <a asp-action="Create" asp-route-id="@Model.EditingTemplateId" class="btn btn-secondary" id="btn-back-1">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-primary px-4" id="btn-next-2">
                            Next — Values &amp; Tolerances <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- =====================================================================
     CROP EDITOR MODAL
     ===================================================================== -->
<div class="modal fade" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">

            <!-- Header -->
            <div class="modal-header py-2 border-bottom">
                <h5 class="modal-title fw-semibold" id="cropModalLabel">
                    <i class="bi bi-crop me-2 text-primary"></i>Crop &amp; Edit Image
                </h5>
                <button type="button" class="btn-close" id="btn-close-modal" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Toolbar -->
            <div class="border-bottom px-3 py-2 d-flex flex-wrap align-items-center gap-2" style="background:#f8f9fa;">

                <!-- Aspect ratio -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted me-1">Ratio:</span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary active" id="ar-free"    onclick="setAspect(NaN)"    title="Free">Free</button>
                        <button type="button" class="btn btn-outline-secondary"        id="ar-11"      onclick="setAspect(1)"      title="Square">1:1</button>
                        <button type="button" class="btn btn-outline-secondary"        id="ar-43"      onclick="setAspect(4/3)"    title="4:3">4:3</button>
                        <button type="button" class="btn btn-outline-secondary"        id="ar-169"     onclick="setAspect(16/9)"   title="16:9">16:9</button>
                        <button type="button" class="btn btn-outline-secondary"        id="ar-32"      onclick="setAspect(3/2)"    title="3:2">3:2</button>
                    </div>
                </div>

                <!-- Rotate -->
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" onclick="doCropRotate(-90)" title="Rotate 90° left">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="doCropRotate(90)"  title="Rotate 90° right">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Flip -->
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" id="btn-fliph" onclick="doCropFlipH()" title="Flip horizontal">
                        <i class="bi bi-symmetry-vertical"></i> H
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-flipv" onclick="doCropFlipV()" title="Flip vertical">
                        <i class="bi bi-symmetry-horizontal"></i> V
                    </button>
                </div>

                <!-- Zoom -->
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="doCropZoom(-0.1)" title="Zoom out"><i class="bi bi-zoom-out"></i></button>
                    <input type="range" id="zoom-slider" min="0.1" max="3" step="0.05" value="1"
                           style="width:80px;cursor:pointer;" title="Zoom level" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="doCropZoom(0.1)"  title="Zoom in"><i class="bi bi-zoom-in"></i></button>
                    <span id="zoom-pct" class="small text-muted font-monospace ms-1" style="min-width:38px;">100%</span>
                </div>

                <!-- Reset -->
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="doCropReset()" title="Reset all edits">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </button>

                <!-- Quality (right-aligned) -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                    <label class="small text-muted mb-0" for="crop-quality">Quality:</label>
                    <select id="crop-quality" class="form-select form-select-sm" style="width:95px;">
                        <option value="0.95" selected>High</option>
                        <option value="0.80">Medium</option>
                        <option value="0.60">Low</option>
                    </select>
                </div>
            </div>

            <!-- Canvas area -->
            <div class="modal-body p-0" style="background:#1e293b; min-height:380px;">
                <div id="crop-canvas-wrap" style="width:100%; max-height:58vh; overflow:hidden;">
                    <img id="crop-img" src="" alt="Crop target"
                         style="display:block; max-width:100%; opacity:0;" />
                </div>
            </div>

            <!-- Info bar -->
            <div class="px-3 py-1 border-top d-flex align-items-center gap-4 small text-muted" style="background:#f8f9fa;">
                <span>Crop: <strong id="info-cw">–</strong> × <strong id="info-ch">–</strong> px</span>
                <span>Output: <strong id="info-ow">–</strong> × <strong id="info-oh">–</strong> px</span>
                <span class="ms-auto text-info"><i class="bi bi-info-circle me-1"></i>Drag inside box to move · drag edge/corner to resize</span>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2 border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary px-4" id="btn-apply-crop" onclick="applyAndUpload()">
                    <i class="bi bi-check2 me-1"></i>Crop &amp; Use Image
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/cropperjs/cropper.min.js"></script>
<script>
/* ============================================================
   Crop editor — WizardStage2
   ============================================================ */

var _cropper   = null;   // Cropper.js instance
var _blobUrl   = null;   // Object URL of the selected raw file
var _flipH     = false;
var _flipV     = false;
var _zoomLevel = 1.0;    // tracked manually

/* ---------- step stepper ---------- */
function adjustSteps(delta) {
    var inp = document.getElementById('step-count-input');
    inp.value = Math.max(1, Math.min(100, (parseInt(inp.value) || 1) + delta));
}

/* ---------- open modal with an image URL ---------- */
function openCropModal(src) {
    var img = document.getElementById('crop-img');

    // Reset all toolbar state
    _flipH = false;
    _flipV = false;
    _zoomLevel = 1.0;
    document.getElementById('zoom-slider').value = 1;
    document.getElementById('zoom-pct').textContent = '100%';
    document.getElementById('btn-fliph').classList.remove('active');
    document.getElementById('btn-flipv').classList.remove('active');
    setAspectActive(NaN);

    // Destroy any previous instance first
    if (_cropper) { _cropper.destroy(); _cropper = null; }

    // Set image src (hide briefly to avoid layout flash)
    img.style.opacity = '0';
    img.src = src;

    var modal = new bootstrap.Modal(document.getElementById('cropModal'));
    modal.show();
}

/* Bootstrap fires 'shown.bs.modal' after the CSS transition completes.
   Only then is the image visible and Cropper.js can measure it correctly. */
document.getElementById('cropModal').addEventListener('shown.bs.modal', function () {
    var img = document.getElementById('crop-img');
    img.style.opacity = '1';

    if (_cropper) { _cropper.destroy(); _cropper = null; }

    _cropper = new Cropper(img, {
        viewMode:        1,       // restrict crop box to image
        dragMode:        'move',  // move image by default; drag crop-box edge to resize
        autoCropArea:    0.85,
        responsive:      true,
        restore:         false,
        guides:          true,
        center:          true,
        highlight:       false,
        cropBoxMovable:  true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: true,
        ready: function () {
            _zoomLevel = 1.0;
            document.getElementById('zoom-slider').value = 1;
            document.getElementById('zoom-pct').textContent = '100%';
        },
        zoom: function (e) {
            // Keep slider in sync when user uses mouse-wheel on the canvas
            _zoomLevel = e.detail.ratio;
            var pct = Math.round(_zoomLevel * 100);
            document.getElementById('zoom-pct').textContent = pct + '%';
            // clamp slider display
            var sl = document.getElementById('zoom-slider');
            var clamped = Math.min(Math.max(_zoomLevel, parseFloat(sl.min)), parseFloat(sl.max));
            sl.value = clamped;
        },
        crop: function (e) {
            var d = e.detail;
            document.getElementById('info-cw').textContent = Math.round(d.width);
            document.getElementById('info-ch').textContent = Math.round(d.height);
            // Approximate output at natural resolution
            var imgData = _cropper.getImageData();
            var ratio   = imgData.naturalWidth / imgData.width;
            document.getElementById('info-ow').textContent = Math.round(d.width  * ratio);
            document.getElementById('info-oh').textContent = Math.round(d.height * ratio);
        }
    });
});

/* Clean up when modal is hidden without applying */
document.getElementById('cropModal').addEventListener('hidden.bs.modal', function () {
    if (_blobUrl) { URL.revokeObjectURL(_blobUrl); _blobUrl = null; }
    if (_cropper) { _cropper.destroy(); _cropper = null; }
    document.getElementById('crop-img').src = '';
});

/* ---------- toolbar actions ---------- */
function setAspect(ratio) {
    if (!_cropper) return;
    _cropper.setAspectRatio(isNaN(ratio) ? NaN : ratio);
    setAspectActive(ratio);
}
function setAspectActive(ratio) {
    var map = { 'ar-free': NaN, 'ar-11': 1, 'ar-43': 4/3, 'ar-169': 16/9, 'ar-32': 3/2 };
    Object.keys(map).forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        var match = isNaN(ratio) ? isNaN(map[id]) : Math.abs(ratio - map[id]) < 0.001;
        el.classList.toggle('active', match);
    });
}

function doCropRotate(deg) {
    if (_cropper) _cropper.rotate(deg);
}

function doCropFlipH() {
    if (!_cropper) return;
    _flipH = !_flipH;
    _cropper.scaleX(_flipH ? -1 : 1);
    document.getElementById('btn-fliph').classList.toggle('active', _flipH);
}
function doCropFlipV() {
    if (!_cropper) return;
    _flipV = !_flipV;
    _cropper.scaleY(_flipV ? -1 : 1);
    document.getElementById('btn-flipv').classList.toggle('active', _flipV);
}

function doCropZoom(delta) {
    if (!_cropper) return;
    _cropper.zoom(delta);
    /* zoom event will update _zoomLevel & label */
}

/* Slider input: compute the delta from current zoom and apply */
document.getElementById('zoom-slider').addEventListener('input', function () {
    if (!_cropper) return;
    var target  = parseFloat(this.value);
    var current = _cropper.getImageData().scaleX || _zoomLevel || 1;
    // Use zoomTo which is absolute (Cropper.js >= 1.0)
    _cropper.zoomTo(target);
});

function doCropReset() {
    if (!_cropper) return;
    _cropper.reset();
    _flipH = false; _flipV = false;
    _zoomLevel = 1.0;
    document.getElementById('zoom-slider').value = 1;
    document.getElementById('zoom-pct').textContent = '100%';
    document.getElementById('btn-fliph').classList.remove('active');
    document.getElementById('btn-flipv').classList.remove('active');
    setAspectActive(NaN);
}

/* ---------- apply crop → blob → upload ---------- */
function applyAndUpload() {
    if (!_cropper) return;

    var btn = document.getElementById('btn-apply-crop');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Processing…';

    var quality = parseFloat(document.getElementById('crop-quality').value);

    var canvas = _cropper.getCroppedCanvas({
        maxWidth: 4096, maxHeight: 4096,
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high'
    });

    if (!canvas) {
        showError('Could not generate crop. Please try again.');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Crop & Use Image';
        return;
    }

    canvas.toBlob(function (blob) {
        if (!blob) {
            showError('Blob conversion failed. Please try again.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Crop & Use Image';
            return;
        }

        // Close modal first (so user sees progress on the main page)
        bootstrap.Modal.getInstance(document.getElementById('cropModal')).hide();
        _blobUrl = null; // prevent hidden.bs.modal from revoking it (we still need it? no — blob is in memory)

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Crop & Use Image';

        uploadBlob(blob);
    }, 'image/jpeg', quality);
}

/* ---------- upload helper ---------- */
async function uploadBlob(blob) {
    var errEl  = document.getElementById('upload-error');
    var statEl = document.getElementById('upload-status');
    errEl.classList.add('d-none');
    statEl.classList.remove('d-none');

    var fd = new FormData();
    fd.append('file', blob, 'component.jpg');

    var antiforgery = document.querySelector('[name="__RequestVerificationToken"]');

    try {
        var res = await fetch('/Template/UploadImage', {
            method: 'POST',
            headers: antiforgery ? { 'RequestVerificationToken': antiforgery.value } : {},
            body: fd
        });
        var data = await res.json();
        statEl.classList.add('d-none');

        if (!res.ok) { showError(data.error || 'Upload failed.'); return; }

        // Update hidden input and preview
        document.getElementById('hidden-image-path').value = data.path;
        refreshPreview(data.url);
        document.getElementById('btn-choose-image').innerHTML = '<i class="bi bi-upload me-2"></i>Replace Image';
        document.getElementById('btn-edit-image').classList.remove('d-none');

    } catch (ex) {
        statEl.classList.add('d-none');
        showError('Network error. Please try again.');
    }
}

function refreshPreview(url) {
    var wrap    = document.getElementById('image-preview-wrap');
    var ph      = document.getElementById('image-placeholder');
    if (ph) ph.remove();

    var prev = document.getElementById('image-preview');
    if (prev) {
        prev.src = url + '?t=' + Date.now();
    } else {
        prev = document.createElement('img');
        prev.id = 'image-preview';
        prev.alt = 'Component image';
        prev.style.cssText = 'max-width:100%;max-height:280px;object-fit:contain';
        prev.src = url + '?t=' + Date.now();
        wrap.appendChild(prev);
    }
}

function showError(msg) {
    document.getElementById('upload-error-text').textContent = msg;
    document.getElementById('upload-error').classList.remove('d-none');
}

/* ---------- file input handler ---------- */
document.getElementById('file-input').addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    this.value = '';   // allow re-selecting same file

    if (_blobUrl) { URL.revokeObjectURL(_blobUrl); }
    _blobUrl = URL.createObjectURL(file);
    openCropModal(_blobUrl);
});

/* ---------- "Edit" button for already-uploaded image ---------- */
(function () {
    var btn = document.getElementById('btn-edit-image');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var preview = document.getElementById('image-preview');
        if (preview && preview.src) {
            // Load the already-saved image into the cropper
            openCropModal(preview.src);
        }
    });
})();
</script>
}
