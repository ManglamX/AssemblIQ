@model SmartTorque.Web.ViewModels.Template.Stage2ViewModel
@{
    Layout = "_AdminLayout";
    ViewData["ActiveNav"] = "Templates";
}

<!-- Wizard progress -->
<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        @{
            string[] stages = ["Basic Info", "Image & Steps", "Values & Tolerances"];
            for (int i = 0; i < stages.Length; i++)
            {
                bool current = i == 1; bool done = i == 0;
                <div class="d-flex align-items-center gap-2 @(i < stages.Length - 1 ? "flex-grow-1" : "")">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                             style="width:32px;height:32px;font-size:13px;
                             background:@(current ? "var(--brand)" : done ? "var(--pass)" : "var(--border)");
                             color:@(current || done ? "#fff" : "var(--text-muted)")">
                            @if (done) { <i class="bi bi-check"></i> } else { <span>@(i + 1)</span> }
                        </div>
                        <span class="small fw-@(current ? "bold" : "normal") @(current ? "text-brand" : "text-muted")">@stages[i]</span>
                    </div>
                    @if (i < stages.Length - 1) { <hr class="flex-grow-1 my-0" style="border-color:var(--border)" /> }
                </div>
            }
        }
    </div>
</div>

<form asp-action="Stage2" method="post" id="wizard-stage2-form">
    <!-- Pass-through hidden fields -->
    <input type="hidden" asp-for="TemplateCode" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="Mode" />
    <input type="hidden" asp-for="EditingTemplateId" />
    <input type="hidden" asp-for="ImagePath" id="hidden-image-path" />

    <div class="row g-4">

        <!-- Left: Image upload -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-image me-2"></i>Component Image</div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center gap-3 p-4">

                    <!-- Preview -->
                    <div id="image-preview-wrap"
                         style="width:100%;max-height:280px;border-radius:var(--radius);overflow:hidden;background:var(--bg-subtle);border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;min-height:160px">
                        @if (Model.HasImage)
                        {
                            <img id="image-preview" src="/@Model.ImagePath" alt="Component image"
                                 style="max-width:100%;max-height:280px;object-fit:contain" />
                        }
                        else
                        {
                            <div id="image-placeholder" class="text-center text-muted">
                                <i class="bi bi-card-image" style="font-size:3rem;color:var(--border)"></i>
                                <p class="mt-2 small mb-0">No image uploaded</p>
                            </div>
                        }
                    </div>

                    <label class="btn btn-secondary w-100" id="btn-choose-image" for="file-input">
                        <i class="bi bi-upload me-2"></i>
                        @(Model.HasImage ? "Replace Image" : "Choose Image")
                    </label>
                    <input type="file" id="file-input" accept=".jpg,.jpeg,.png" class="d-none" />

                    <small class="text-muted text-center">JPG or PNG, maximum 5 MB.<br />
                        Click on the image in Step 3 to place step markers.</small>

                    <div id="upload-error" class="alert-inline error d-none w-100" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span id="upload-error-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Step count + submit -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-list-ol me-2"></i>Steps Configuration</div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">
                        Define how many measurement steps this template has.
                        Torque = number of bolts/fasteners. Vernier = number of dimensions.
                    </p>

                    <div class="mb-4">
                        <label asp-for="StepCount" class="form-label fw-semibold">
                            Number of Steps <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-secondary" id="btn-dec-steps"
                                    onclick="adjustSteps(-1)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input asp-for="StepCount" type="number"
                                   class="form-control text-center fw-bold fs-4 num"
                                   id="step-count-input"
                                   style="width:100px" min="1" max="100" />
                            <button type="button" class="btn btn-secondary" id="btn-inc-steps"
                                    onclick="adjustSteps(1)">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="StepCount" class="text-danger small"></span>
                    </div>

                    <div class="alert-inline info mb-4">
                        <i class="bi bi-info-circle"></i>
                        <span>Mode: <strong>@Model.Mode</strong> — step instruments are pre-filled but can be changed individually in Step 3.</span>
                    </div>

                    <div class="d-flex justify-content-between mt-auto pt-4">
                        <a asp-action="Create" asp-route-id="@Model.EditingTemplateId" class="btn btn-secondary" id="btn-back-1">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-primary px-4" id="btn-next-2">
                            Next — Values &amp; Tolerances <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
function adjustSteps(delta) {
    const input = document.getElementById('step-count-input');
    const val = Math.max(1, Math.min(100, (parseInt(input.value) || 1) + delta));
    input.value = val;
}

// Image upload via fetch
document.getElementById('file-input').addEventListener('change', async function () {
    const file = this.files[0];
    if (!file) return;

    const errWrap = document.getElementById('upload-error');
    const errText = document.getElementById('upload-error-text');
    errWrap.classList.add('d-none');

    const formData = new FormData();
    formData.append('file', file);

    try {
        const res = await fetch('/Template/UploadImage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '' },
            body: formData
        });
        const data = await res.json();
        if (!res.ok) {
            errText.textContent = data.error ?? 'Upload failed.';
            errWrap.classList.remove('d-none');
            return;
        }
        document.getElementById('hidden-image-path').value = data.path;
        const preview = document.getElementById('image-preview');
        const placeholder = document.getElementById('image-placeholder');
        if (placeholder) placeholder.remove();
        if (preview) {
            preview.src = data.url;
        } else {
            const img = document.createElement('img');
            img.id = 'image-preview';
            img.src = data.url;
            img.alt = 'Component image';
            img.style.cssText = 'max-width:100%;max-height:280px;object-fit:contain';
            document.getElementById('image-preview-wrap').appendChild(img);
        }
        document.getElementById('btn-choose-image').innerHTML = '<i class="bi bi-upload me-2"></i>Replace Image';
    } catch (e) {
        errText.textContent = 'Upload failed. Please try again.';
        errWrap.classList.remove('d-none');
    }
});
</script>
<script>@Html.AntiForgeryToken()</script>
}
