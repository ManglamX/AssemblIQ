@model SmartTorque.Web.ViewModels.Template.TemplateListViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Templates";
    ViewData["ActiveNav"] = "Templates";
}

@if (TempData["Success"] != null)
{
    <div class="alert-inline success mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Templates</h1>
        <p class="text-muted small mb-0">Reusable measurement step sequences</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" id="btn-new-template">
        <i class="bi bi-plus-lg me-1"></i> New Template
    </a>
</div>

<!-- Filters -->
<form method="get" class="card mb-4 p-3" id="filter-form">
    <div class="row g-2 align-items-end">
        <div class="col-sm-5 col-md-4">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Name or code…" value="@Model.Search" id="search-input" />
        </div>
        <div class="col-sm-3 col-md-2">
            <label class="form-label small mb-1">Mode</label>
            <select name="mode" class="form-select form-select-sm" id="filter-mode">
                <option value="">All</option>
                @foreach (TemplateMode m in Enum.GetValues<TemplateMode>())
                {
                    <option value="@((int)m)" selected="@(Model.ModeFilter == m)">@m</option>
                }
            </select>
        </div>
        <div class="col-sm-3 col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select name="active" class="form-select form-select-sm" id="filter-status">
                <option value="">All</option>
                <option value="true" selected="@(Model.ActiveFilter == true)">Active</option>
                <option value="false" selected="@(Model.ActiveFilter == false)">Inactive</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm" id="btn-filter">
                <i class="bi bi-search me-1"></i>Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-sm ms-1" id="btn-clear">Clear</a>
        </div>
    </div>
</form>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-5" id="templates-empty">
                <i class="bi bi-layout-text-sidebar-reverse" style="font-size:2.5rem;color:var(--border)"></i>
                <p class="mt-2 mb-1 fw-semibold">No templates found</p>
                <p class="small mb-3">Create your first template to get started.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm" id="btn-empty-create">
                    <i class="bi bi-plus-lg me-1"></i>New Template
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0" id="templates-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Mode</th>
                        <th class="text-center">Steps</th>
                        <th class="text-center">Ver.</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <code>@t.TemplateCode</code>
                            </td>
                            <td>@t.Name</td>
                            <td>
                                <span class="badge-status @(t.Mode == TemplateMode.Mixed ? "badge-inprogress" : t.Mode == TemplateMode.Vernier ? "badge-assigned" : "badge-completed")">
                                    @t.Mode
                                </span>
                            </td>
                            <td class="text-center num">@t.StepCount</td>
                            <td class="text-center num">v@t.Version</td>
                            <td>
                                @if (t.IsActive)
                                {
                                    <span class="badge-status badge-completed"><i class="bi bi-circle-fill me-1" style="font-size:8px"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@t.TemplateId"
                                   class="btn btn-sm btn-secondary" id="btn-detail-@t.TemplateId">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Create" asp-route-id="@t.TemplateId"
                                   class="btn btn-sm btn-secondary ms-1" id="btn-edit-@t.TemplateId">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="SetActive" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="id" value="@t.TemplateId" />
                                    <input type="hidden" name="isActive" value="@(!t.IsActive)" />
                                    <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-danger" : "btn-secondary")"
                                            id="btn-toggle-@t.TemplateId"
                                            title="@(t.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(t.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Template pages">
        <small class="text-muted">
            Showing @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
            of @Model.TotalCount templates
        </small>
        <ul class="pagination pagination-sm mb-0">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-mode="@((int?)Model.ModeFilter)"
                       asp-route-active="@Model.ActiveFilter"
                       asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
