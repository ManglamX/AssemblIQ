@model IReadOnlyList<SmartTorque.Core.Entities.PriorityColourMap>

@* Colour legend panel for the BM screens (Design §7.6). *@
@if (Model.Count > 0)
{
    <div class="card mb-4" id="colour-legend">
        <div class="card-header">Colour legend</div>
        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @foreach (var shade in Model)
                {
                    var n = (int)shade.Priority;
                    var icon = n switch
                    {
                        1 => "bi-circle-fill",
                        2 => "bi-caret-up-fill",
                        3 => "bi-diamond-fill",
                        4 => "bi-square-fill",
                        5 => "bi-hexagon-fill",
                        _ => "bi-circle"
                    };

                    <span class="badge-priority badge-pri-@n">
                        <span class="d-inline-block rounded"
                              style="width:12px;height:12px;background-color:@shade.ColourHex;border:1px solid var(--border)"
                              aria-hidden="true"></span>
                        <i class="bi @icon"></i>
                        @shade.Label
                        @if (n == 1)
                        {
                            <span class="fw-normal">· Critical, first</span>
                        }
                    </span>
                }
            </div>

            <div class="text-end mt-1">
                @* The colour map screen has no sidebar entry (Design §6.1 fixes the nav at
                   eight items), so the BM screen is how an Admin reaches it (D-032). *@
                <a asp-controller="ColourMap" asp-action="Index" class="small" id="btn-edit-colour-map">
                    <i class="bi bi-palette me-1"></i>Edit colour map
                </a>
            </div>
        </div>
    </div>
}
