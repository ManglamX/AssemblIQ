@inject SmartTorque.Services.IUserContextService UserContextService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — AssemblIQ" : "AssemblIQ Worker")</title>
    <meta name="description" content="AssemblIQ Guidance & Traceability — Worker Portal" />

    <!-- Progressive Web App (PWA) & Mobile Fullscreen Support -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AssemblIQ" />
    <meta name="theme-color" content="#b0123c" />

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/worker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/combobox.css" asp-append-version="true" />

    @await RenderSectionAsync("HeadLinks", required: false)
    @await RenderSectionAsync("Styles", required: false)

    <script>
        // Suppress native blocking browser popups across the app (confirm / alert)
        window.confirm = function () { return true; };
        window.alert = function (msg) { console.warn("[Alert suppressed]:", msg); };
    </script>
</head>
<body>

<a href="#main-content" class="skip-link">Skip to main content</a>

@{
    var userCtx = await UserContextService.GetCurrentUserContextAsync(User);
    var isLineSupervisor = userCtx?.IsLineSupervisor ?? false;
}

    <!-- Worker top bar -->
    <header class="worker-topbar d-flex justify-content-between align-items-center px-3 py-2 bg-white border-bottom shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <a href="/Worker/JobBoard" class="d-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-wrench-adjustable-circle-fill text-brand fs-5"></i>
                <span class="fw-bold">AssemblIQ</span>
            </a>

            <nav class="d-flex align-items-center gap-1 ms-2">
                <a href="/Worker/JobBoard" class="btn btn-sm btn-light text-dark fw-semibold py-1 px-2">
                    <i class="bi bi-kanban me-1"></i>Job Board
                </a>
                <a href="/Worker/History" class="btn btn-sm btn-light text-muted py-1 px-2">
                    <i class="bi bi-clock-history me-1"></i>My History
                </a>
                <a href="/Worker/Profile" class="btn btn-sm btn-light text-muted py-1 px-2">
                    <i class="bi bi-person me-1"></i>Profile
                </a>
                @if (isLineSupervisor)
                {
                    <a href="/Supervisor/JobAllocation" class="btn btn-sm btn-warning text-dark fw-bold py-1 px-2">
                        <i class="bi bi-person-lines-fill me-1"></i>Job Allocation
                    </a>
                }
            </nav>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- PWA Install Button (Dynamic) -->
            <button type="button" id="btn-pwa-install" class="btn btn-sm btn-outline-danger fw-bold d-none shadow-sm" onclick="installAssemblIqPwa()">
                <i class="bi bi-download me-1"></i>Install App
            </button>

            <!-- Permanent Hostname Connect Phone Button -->
            <button type="button" class="btn btn-sm btn-outline-dark d-flex align-items-center gap-1.5 shadow-sm" data-bs-toggle="modal" data-bs-target="#connectPhoneModal" title="Connect Phone / Mobile Scanner">
                <i class="bi bi-phone text-primary"></i>
                <span class="d-none d-md-inline fw-semibold">Connect Phone</span>
            </button>

            <!-- Device status chips -->
            <div id="device-status-chips" class="d-flex gap-2"></div>

            <a href="/Worker/JobBoard" class="text-decoration-none" title="Assembly Station">
                <span class="badge bg-light text-dark border px-2 py-1 small">
                    <i class="bi bi-diagram-3 text-primary me-1"></i>Assembly Station
                </span>
            </a>

            @if (isLineSupervisor)
            {
                <span class="badge bg-warning text-dark border border-warning-subtle px-2 py-1 small">
                    <i class="bi bi-star-fill me-1 text-dark"></i>Line Lead
                </span>
            }

            <a href="/Worker/Profile" class="text-decoration-none text-muted small" title="View Profile">
                <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
            </a>

            <form action="/Account/Logout" method="post" class="d-inline" onsubmit="clearBlePairingStateOnLogout()">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary" id="btn-logout-worker" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>
    </header>

    <!-- Connect Phone Modal (Permanent Hostname / QR) -->
    <div class="modal fade" id="connectPhoneModal" tabindex="-1" aria-labelledby="connectPhoneModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-2.5">
                    <h6 class="modal-title fw-bold" id="connectPhoneModalLabel">
                        <i class="bi bi-phone-vibrate text-warning me-2"></i>Connect Mobile / Barcode Scanner
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="small text-muted mb-3">
                        Point any phone camera at this screen to open AssemblIQ directly on your Wi-Fi &mdash; no IP typing required!
                    </p>

                    <!-- QR Code Display -->
                    <div class="p-3 bg-light rounded-3 border d-inline-block shadow-sm mb-3">
                        <img src="/Job/UnitQrCode?token=http://LAPTOP-Q6HH4N8U.local:5084/Worker/JobBoard"
                             alt="Connect Phone QR"
                             style="width: 200px; height: 200px;" />
                    </div>

                    <div class="alert alert-secondary py-2 px-3 small font-monospace text-break mb-3">
                        <i class="bi bi-link-45deg me-1"></i>http://LAPTOP-Q6HH4N8U.local:5084
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('http://LAPTOP-Q6HH4N8U.local:5084'); this.innerHTML = '<i class=\'bi bi-check2\'></i> Copied!';">
                            <i class="bi bi-clipboard me-1"></i>Copy URL
                        </button>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">
                            Done
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main -->
    <main class="worker-content" id="main-content">
        @RenderBody()
    </main>

    <!-- Tool QR Code Scanner Modal -->
    @await Html.PartialAsync("_ToolQrScannerModal")

<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
<script src="~/lib/html5-qrcode/html5-qrcode.min.js" asp-append-version="true"></script>
<script src="~/js/combobox.js" asp-append-version="true"></script>
<script src="~/js/tool-qr-scanner.js" asp-append-version="true"></script>
<script src="~/js/tohnichi-ble-driver.js" asp-append-version="true"></script>

<!-- Seamless Worker SPA Shell (Keeps Web Bluetooth GATT Connected Permanently) -->
<script>
    window.assemblWorkerShell = {
        isNavigating: false,

        async loadUrl(url, pushState = true) {
            if (this.isNavigating) return;
            this.isNavigating = true;

            let loader = document.getElementById('shell-top-loader');
            if (!loader) {
                loader = document.createElement('div');
                loader.id = 'shell-top-loader';
                loader.style.cssText = 'position:fixed;top:0;left:0;width:0%;height:3px;background:#be185d;z-index:9999;transition:width 0.2s ease;';
                document.body.appendChild(loader);
            }

            try {
                loader.style.width = '35%';

                const res = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Assembl-Shell': '1'
                    }
                });

                loader.style.width = '75%';

                if (!res.ok) {
                    if (window.tohnichiBle && window.tohnichiBle.isConnected) {
                        console.warn('[Worker Shell] Fetch returned non-OK status (' + res.status + '), avoiding full reload to preserve BLE.');
                        return;
                    }
                    window.location.href = url;
                    return;
                }

                const finalUrl = res.url || url;
                const html = await res.text();

                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // 1. Update Title
                if (doc.title) {
                    document.title = doc.title;
                }

                // Clean up any lingering Bootstrap modals, backdrops, and body locks
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.querySelectorAll('.modal.show').forEach(m => {
                    try {
                        const inst = bootstrap.Modal.getInstance(m);
                        if (inst) { inst.hide(); inst.dispose(); }
                    } catch(e) {}
                    m.classList.remove('show');
                    m.style.display = 'none';
                });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');

                // 2. Replace Main Content (handle both _WorkerSpaPartialLayout and full layouts)
                const spaContainer = doc.querySelector('#spa-page-container');
                const newMain = spaContainer || doc.querySelector('#main-content') || doc.querySelector('main');
                const curMain = document.querySelector('#main-content') || document.querySelector('main');

                if (newMain && curMain) {
                    curMain.innerHTML = newMain.innerHTML;
                }

                // Ensure no backdrop persists after DOM injection
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');

                // 3. Update History
                if (pushState && window.location.href !== finalUrl) {
                    history.pushState({ url: finalUrl }, '', finalUrl);
                }

                loader.style.width = '100%';
                setTimeout(() => { if (loader) loader.style.width = '0%'; }, 250);

                window.scrollTo(0, 0);

                // 4. Safely Execute Page-Specific Scripts
                let scripts = [];
                const spaScriptsContainer = doc.querySelector('#spa-page-scripts');
                if (spaScriptsContainer) {
                    scripts = Array.from(spaScriptsContainer.querySelectorAll('script'));
                } else if (newMain) {
                    scripts = Array.from(newMain.querySelectorAll('script'));
                }

                // Also pick up any page-specific scripts rendered via section Scripts (after main)
                if (doc.body) {
                    const bodyScripts = doc.body.querySelectorAll('script');
                    bodyScripts.forEach(s => {
                        const content = s.textContent || '';
                        const src = s.getAttribute('src') || '';
                        // Ignore layout-level scripts
                        if (content.includes('assemblWorkerShell') || content.includes('serviceWorker') || content.includes('clearBlePairingStateOnLogout')) {
                            return;
                        }
                        if (src.includes('bootstrap') || src.includes('signalr') || src.includes('jquery') || src.includes('html5-qrcode') || src.includes('combobox') || src.includes('tool-qr-scanner') || src.includes('tohnichi-ble-driver') || src.includes('chart')) {
                            return;
                        }
                        if (!scripts.includes(s)) {
                            scripts.push(s);
                        }
                    });
                }

                scripts.forEach(s => {
                    const src = s.getAttribute('src') || '';
                    if (src) {
                        if (src.includes('bootstrap') || src.includes('signalr') || src.includes('jquery') || src.includes('html5-qrcode') || src.includes('combobox') || src.includes('tool-qr-scanner') || src.includes('tohnichi-ble-driver') || src.includes('chart')) {
                            return;
                        }
                        const newScript = document.createElement('script');
                        newScript.src = src;
                        document.body.appendChild(newScript);
                    } else if (s.textContent && s.textContent.trim().length > 0) {
                        try {
                            window.eval(s.textContent);
                        } catch (scriptErr) {
                            console.error('[Worker Shell] Error executing page inline script:', scriptErr);
                        }
                    }
                });

                // 5. Fire DOMContentLoaded on document so page initializers run
                document.dispatchEvent(new Event('DOMContentLoaded'));

            } catch (err) {
                console.error('[Worker Shell] Navigation error:', err);
                if (window.tohnichiBle && window.tohnichiBle.isConnected) {
                    console.warn('[Worker Shell] Preserving active Web Bluetooth connection, skipping full reload.');
                } else {
                    window.location.href = url;
                }
            } finally {
                this.isNavigating = false;
                if (loader) loader.style.width = '0%';
            }
        }
    };

    // Intercept clicks on links that lead to /Worker/...
    document.addEventListener('click', function (e) {
        const link = e.target.closest('a[href]');
        if (!link) return;

        if (link.target === '_blank' || link.hasAttribute('download')) return;

        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.includes('Logout')) return;

        try {
            const url = new URL(href, window.location.origin);
            if (url.origin === window.location.origin && url.pathname.startsWith('/Worker')) {
                e.preventDefault();
                window.assemblWorkerShell.loadUrl(url.href);
            }
        } catch(err) {}
    });

    // Intercept form submissions to /Worker/... (prevents page reload & preserves BLE GATT link!)
    document.addEventListener('submit', async function (e) {
        const form = e.target;
        if (!form || !form.tagName || form.tagName.toLowerCase() !== 'form') return;

        const action = form.getAttribute('action') || window.location.href;
        if (!action || action.includes('Logout')) return;

        try {
            const url = new URL(action, window.location.origin);
            if (url.origin === window.location.origin && url.pathname.startsWith('/Worker')) {
                e.preventDefault();
                e.stopPropagation();

                const formData = new FormData(form);
                const method = (form.method || 'POST').toUpperCase();

                const res = await fetch(url.href, {
                    method: method,
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Assembl-Shell': '1'
                    }
                });

                // Clean up modal backdrops before redirecting
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.body.classList.remove('modal-open');

                const ct = res.headers.get("content-type") || "";
                if (ct.includes("application/json")) {
                    const data = await res.json();
                    const target = data.executeUrl || data.redirectUrl || res.url;
                    if (target) {
                        await window.assemblWorkerShell.loadUrl(target);
                        return;
                    }
                }

                const targetUrl = res.url || url.href;
                await window.assemblWorkerShell.loadUrl(targetUrl);
            }
        } catch(err) {
            console.error('[Worker Shell] Form interception error:', err);
        }
    });

    // Handle browser Back/Forward navigation seamlessly
    window.addEventListener('popstate', function (e) {
        if (window.location.pathname.startsWith('/Worker')) {
            window.assemblWorkerShell.loadUrl(window.location.href, false);
        }
    });
</script>

<!-- PWA Service Worker & Install Handler -->
<script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function (err) {
                console.warn('PWA SW registration failed:', err);
            });
        });
    }

    function clearBlePairingStateOnLogout() {
        try {
            if (window.tohnichiBle) {
                window.tohnichiBle.disconnect(true);
            }
            localStorage.removeItem('assembl_ble_paired');
            localStorage.removeItem('assembl_ble_auto_connect');
            localStorage.removeItem('assembl_active_ble_tool');
            localStorage.removeItem('assembl_active_ble_serial');
            localStorage.removeItem('assembl_active_ble_id');
            localStorage.removeItem('assembl_station_torque_id');
            localStorage.removeItem('assembl_station_torque_name');
            localStorage.removeItem('assembl_station_torque_trans');
            localStorage.removeItem('assembl_station_vernier_id');
            localStorage.removeItem('assembl_station_vernier_name');
            localStorage.removeItem('assembl_station_vernier_trans');
            localStorage.removeItem('assembl_station_tool_type');
            localStorage.removeItem('assembl_sticky_torque_id');
            localStorage.removeItem('assembl_sticky_vernier_id');
            sessionStorage.removeItem('assembl_shift_pairing_prompted');
        } catch(e) {}
    }
    window.clearBlePairingStateOnLogout = clearBlePairingStateOnLogout;

    let deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        deferredPwaPrompt = e;
        const installBtn = document.getElementById('btn-pwa-install');
        if (installBtn) installBtn.classList.remove('d-none');
    });

    function installAssemblIqPwa() {
        if (!deferredPwaPrompt) return;
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(function (choice) {
            deferredPwaPrompt = null;
            const installBtn = document.getElementById('btn-pwa-install');
            if (installBtn) installBtn.classList.add('d-none');
        });
    }
</script>

<!-- Virtual Keyboard Touch-Safe Controller (Worker Side) -->
<!-- Ensures soft keyboard only pops up when the operator explicitly clicks/taps an input field -->
<script>
    (function () {
        function isTypingInput(el) {
            if (!el || !el.tagName) return false;
            var tag = el.tagName.toUpperCase();
            if (tag === 'TEXTAREA') return true;
            if (tag === 'INPUT') {
                var type = (el.type || 'text').toLowerCase();
                return ['text', 'number', 'search', 'password', 'email', 'tel', 'url'].indexOf(type) !== -1;
            }
            return false;
        }

        function protectTypingField(el) {
            if (!isTypingInput(el)) return;
            if (el.dataset.kbProtected === 'true') return;
            el.dataset.kbProtected = 'true';

            // Start in readonly mode if not actively focused by user
            if (document.activeElement !== el) {
                el.setAttribute('readonly', 'readonly');
            }

            // When user deliberately taps or clicks this specific field, make it editable
            el.addEventListener('pointerdown', function () {
                this.removeAttribute('readonly');
            });
            el.addEventListener('click', function () {
                this.removeAttribute('readonly');
                this.focus();
            });

            // If user tabs into field or barcode scanner triggers it
            el.addEventListener('focus', function () {
                this.removeAttribute('readonly');
            });

            // On blur, return to safe readonly state so modals/dropdowns don't pop keyboard
            el.addEventListener('blur', function () {
                this.setAttribute('readonly', 'readonly');
            });
        }

        function protectAllInputs(root) {
            var scope = root || document;
            var inputs = scope.querySelectorAll('input, textarea');
            inputs.forEach(protectTypingField);
        }

        document.addEventListener('DOMContentLoaded', function () {
            protectAllInputs(document);
        });

        // Handle dynamically rendered elements and SPA view swaps
        var mutObs = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                m.addedNodes.forEach(function (node) {
                    if (node.nodeType === 1) {
                        if (isTypingInput(node)) protectTypingField(node);
                        protectAllInputs(node);
                    }
                });
            });
        });
        mutObs.observe(document.body || document.documentElement, { childList: true, subtree: true });

        // Prevent Bootstrap modals from automatically focusing typing inputs on show
        document.addEventListener('show.bs.modal', function (e) {
            if (e.target) {
                var modalInputs = e.target.querySelectorAll('input, textarea');
                modalInputs.forEach(function (inp) {
                    if (isTypingInput(inp)) {
                        inp.setAttribute('readonly', 'readonly');
                        inp.blur();
                    }
                });
            }
        }, true);

        // Also prevent shown.bs.modal from auto-popping keyboard
        document.addEventListener('shown.bs.modal', function (e) {
            if (e.target && document.activeElement && isTypingInput(document.activeElement)) {
                if (document.activeElement.hasAttribute('readonly')) {
                    document.activeElement.blur();
                }
            }
        }, true);
    })();
</script>

<script src="~/js/auto-dismiss.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
