@model SmartTorque.Web.ViewModels.Account.LoginViewModel
@{
    Layout = null; // Login page has its own minimal layout
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — AssemblIQ</title>
    <meta name="description" content="Sign in to AssemblIQ Guidance & Traceability System" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            background-color: #12040d;
            padding: 1.5rem 1rem;
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .login-bg-blur {
            position: fixed;
            top: -40px;
            left: -40px;
            right: -40px;
            bottom: -40px;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(136, 0, 71, 0.65) 0%, transparent 55%),
                radial-gradient(circle at 85% 80%, rgba(76, 29, 149, 0.55) 0%, transparent 55%),
                url('/images/godrej-brand.png');
            background-size: cover;
            background-position: center;
            filter: blur(28px) brightness(0.65) saturate(1.2);
            transform: scale(1.08);
            z-index: 0;
            pointer-events: none;
        }
        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 460px;
            padding: 2rem 1.75rem;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.7);
        }
        .login-brand-logo {
            max-height: 48px;
            width: auto;
            max-width: 200px;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 3px 12px rgba(129, 0, 85, 0.2);
            transition: transform 0.2s ease;
            display: inline-block;
        }
        .login-brand-logo:hover {
            transform: scale(1.03);
        }
        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 0.2rem;
        }
        .login-logo i { font-size: 1.5rem; color: #810055; }
        .login-logo span { font-size: 1.3rem; font-weight: 700; color: #1e293b; letter-spacing: -0.02em; }
        .form-label { font-weight: 600; color: #334155; font-size: 0.875rem; }
        .btn-login {
            height: 46px;
            font-size: 15px;
            font-weight: 600;
            width: 100%;
            background-color: #810055;
            border-color: #810055;
        }
        .btn-login:hover {
            background-color: #680045;
            border-color: #680045;
        }
        .tab-btn.active {
            background-color: #810055 !important;
            color: #ffffff !important;
            box-shadow: 0 2px 8px rgba(129, 0, 85, 0.3) !important;
        }
        .scanner-frame {
            position: relative;
        }
        .scanner-frame .frame-corner {
            position: absolute;
            width: 18px;
            height: 18px;
            border-color: #810055;
            border-style: solid;
        }
        .scanner-frame .top-left { top: -2px; left: -2px; border-width: 3px 0 0 3px; border-top-left-radius: 6px; }
        .scanner-frame .top-right { top: -2px; right: -2px; border-width: 3px 3px 0 0; border-top-right-radius: 6px; }
        .scanner-frame .bottom-left { bottom: -2px; left: -2px; border-width: 0 0 3px 3px; border-bottom-left-radius: 6px; }
        .scanner-frame .bottom-right { bottom: -2px; right: -2px; border-width: 0 3px 3px 0; border-bottom-right-radius: 6px; }
        .scanner-laser {
            position: absolute;
            width: 190px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #ef4444, transparent);
            box-shadow: 0 0 8px #ef4444;
            animation: scannerScan 2s ease-in-out infinite alternate;
        }
        @@keyframes scannerScan {
            0% { transform: translateY(-80px); opacity: 0.3; }
            50% { opacity: 1; }
            100% { transform: translateY(80px); opacity: 0.3; }
        }
    </style>
</head>
<body>
<div class="login-bg-blur" aria-hidden="true"></div>
<div class="login-card">
    <div class="text-center mb-3">
        <a href="https://www.godrejenterprises.com/about-us/corporate-profile" target="_blank" rel="noopener noreferrer" title="Godrej Enterprises Group">
            <img src="~/images/godrej-brand.png" alt="Godrej Enterprises - AssemblIQ Quality Control System" class="login-brand-logo mb-2" />
        </a>
        <div class="login-logo">
            <i class="bi bi-wrench-adjustable-circle-fill"></i>
            <span>AssemblIQ</span>
        </div>
        <p class="text-muted small mb-0">Assembly Guidance &amp; Traceability System</p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="login-tab-container mb-3">
        <div class="btn-group w-100 p-1 bg-light rounded-pill border" role="group">
            <button type="button" class="btn btn-sm rounded-pill fw-bold tab-btn active" id="btn-tab-worker" onclick="switchLoginTab('worker')">
                <i class="bi bi-person-badge me-1"></i> Worker Quick Login
            </button>
            <button type="button" class="btn btn-sm rounded-pill fw-semibold tab-btn text-muted" id="btn-tab-admin" onclick="switchLoginTab('admin')">
                <i class="bi bi-shield-lock me-1"></i> Admin / Staff
            </button>
        </div>
    </div>

    <!-- Section 1: Worker Quick Sign-In (Default) -->
    <div id="section-worker-login" class="py-2">
        <!-- 1-Click QR Camera Scan Button -->
        <button type="button" class="btn btn-outline-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2 fw-bold shadow-sm mb-3 rounded-3" id="btn-open-badge-scanner">
            <i class="bi bi-qr-code-scan fs-4 text-primary"></i>
            <span class="fs-6">Scan Worker Badge QR</span>
        </button>

        <!-- Divider -->
        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1 my-0 text-muted" />
            <span class="px-2 small text-muted text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Or Enter / Scan Badge ID</span>
            <hr class="flex-grow-1 my-0 text-muted" />
        </div>

        <!-- USB Barcode Gun / Manual Input Box -->
        <div class="input-group mb-2 shadow-sm rounded-3 overflow-hidden">
            <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-person-badge fs-5"></i></span>
            <input type="text" id="barcode-gun-input" class="form-control border-start-0 py-2.5" placeholder="Scan or type Worker ID & Enter..." autocomplete="off" autofocus>
            <button class="btn btn-primary px-3 fw-bold" type="button" id="btn-submit-barcode" title="Sign In">
                <span id="barcode-btn-text"><i class="bi bi-arrow-right fs-6"></i></span>
                <span id="barcode-btn-spinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
            </button>
        </div>

        <div id="worker-scan-error" class="alert alert-danger py-2 px-3 small mt-3 d-none text-start rounded-3" role="alert"></div>

        <div class="text-muted small mt-3 text-center" style="font-size: 0.8rem;">
            <i class="bi bi-info-circle me-1 text-primary"></i> Scan badge with camera or USB scanner gun, or enter your Employee ID/Email.
        </div>

        <div class="mt-4 pt-3 border-top text-center">
            <p class="text-muted small mb-2">New assembly worker on this line?</p>
            <a asp-action="Register" asp-controller="Account" asp-route-role="Worker" class="btn btn-outline-secondary w-100 py-2 fw-semibold" id="btn-worker-request-access">
                <i class="bi bi-person-plus-fill me-1 text-primary"></i>Request New Worker Access
            </a>
        </div>
    </div>

    <!-- Section 2: Admin / Staff Standard Sign-In -->
    <div id="section-admin-login" style="display: none;">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-inline error mb-3" role="alert" aria-live="assertive">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form action="@Url.Action("Login", "Account")" method="post" id="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Email"
                       class="form-control"
                       id="input-email"
                       type="email"
                       autocomplete="username"
                       placeholder="you@company.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                <div class="position-relative">
                    <input asp-for="Password"
                           class="form-control"
                           id="input-password"
                           type="password"
                           autocomplete="current-password"
                           placeholder="••••••••"
                           style="padding-right: 2.5rem;" />
                    <button type="button"
                            class="btn btn-sm position-absolute top-50 end-0 translate-middle-y"
                            id="toggle-password"
                            onclick="togglePasswordVisibility()"
                            aria-label="Show password"
                            style="border: none; background: none; padding: 0 0.75rem; z-index: 10;">
                        <i class="bi bi-eye" id="toggle-password-icon" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-login" id="btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
            </button>
        </form>

        <div class="mt-3 pt-3 border-top text-center">
            <p class="text-muted small mb-2">New administrator or supervisor?</p>
            <a asp-action="Register" asp-controller="Account" asp-route-role="Admin" class="btn btn-outline-secondary w-100 py-2 fw-semibold" id="btn-request-access">
                <i class="bi bi-shield-lock-fill me-1"></i>Request Administrator Access
            </a>
        </div>
    </div>
</div>



<!-- Modal: Worker Badge Camera Scanner Modal (Referenced from PRD Scanner Modal) -->
<div class="modal fade" id="workerBadgeScanModal" tabindex="-1" aria-labelledby="workerBadgeScanModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header bg-dark text-white py-2.5 px-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan text-warning fs-5"></i>
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="workerBadgeScanModalLabel">Scan Worker Badge QR Code</h6>
                        <small class="text-white-50" style="font-size: 0.72rem;">Worker ID / Employee QR Badge</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="stopBadgeCamera()" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <!-- Camera Viewfinder with Html5Qrcode -->
                <div class="position-relative bg-black rounded-3 overflow-hidden shadow-sm mb-2" style="min-height: 280px;">
                    <div id="worker-scanner-viewfinder" style="width: 100%;"></div>

                    <!-- Reticle Frame Overlay -->
                    <div id="badge-scanner-overlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="pointer-events: none; z-index: 10;">
                        <div class="scanner-laser"></div>
                        <div class="scanner-frame border border-2 border-primary rounded-3 shadow" style="width: 200px; height: 200px;">
                            <div class="frame-corner top-left"></div>
                            <div class="frame-corner top-right"></div>
                            <div class="frame-corner bottom-left"></div>
                            <div class="frame-corner bottom-right"></div>
                        </div>
                        <div class="badge bg-dark bg-opacity-75 text-white mt-2 px-2 py-1 small" id="badge-scanner-hint">
                            Align QR badge inside the box
                        </div>
                    </div>

                    <!-- Success Splash -->
                    <div id="badge-scan-success-splash" class="position-absolute top-0 start-0 w-100 h-100 d-none flex-column align-items-center justify-content-center bg-success bg-opacity-95 text-white p-3 text-center" style="z-index: 20;">
                        <i class="bi bi-check-circle-fill display-3 mb-2"></i>
                        <h5 class="fw-bold mb-1">Badge Detected!</h5>
                        <div class="small fw-semibold" id="badge-scan-success-desc">Authenticating worker...</div>
                    </div>
                </div>

                <!-- Camera Switch & Photo Upload Buttons -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-dark w-50" id="btnSwitchBadgeCamera" onclick="switchBadgeCamera()" title="Switch Camera">
                        <i class="bi bi-arrow-repeat me-1"></i>Switch Camera
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary w-50" onclick="document.getElementById('badgeCameraFileInput').click()">
                        <i class="bi bi-camera me-1"></i>Photo Snap
                    </button>
                </div>
                <input type="file" id="badgeCameraFileInput" accept="image/*" capture="environment" class="d-none" onchange="handleBadgeQrFile(this)" />

                <!-- Scanner Status / Feedback Box -->
                <div id="badgeScannerFeedback" class="alert alert-secondary py-1 px-2 small mb-2 text-center text-truncate d-none"></div>

                <!-- Manual fallback link inside modal -->
                <div class="text-center mt-2 pt-2 border-top">
                    <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" data-bs-dismiss="modal" onclick="focusWorkerIdInput()">
                        <i class="bi bi-keyboard me-1"></i> Or enter Worker ID manually
                    </button>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-3 border-top d-flex justify-content-end">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal" onclick="stopBadgeCamera()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
<script>
    // State management
    let badgeIsScanning = false;
    let html5BadgeScanner = null;
    let badgeFacingMode = "environment";
    let availableCameras = [];
    let currentCameraIndex = 0;
    const returnUrl = "@ViewData["ReturnUrl"]";

    // Play pleasant beep audio on successful scan
    function playBeep(freq = 880, duration = 0.12) {
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "sine";
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {}
    }

    function setBadgeStatus(msg, type) {
        type = type || 'secondary';
        const statusBox = document.getElementById('badgeScannerFeedback');
        if (!statusBox) return;
        statusBox.className = 'alert alert-' + type + ' py-1 px-2 small mb-2 text-center text-truncate';
        statusBox.textContent = msg;
        statusBox.classList.remove('d-none');
    }

    // Switch between Worker Quick Login and Admin Login
    function switchLoginTab(mode) {
        const workerBtn = document.getElementById('btn-tab-worker');
        const adminBtn = document.getElementById('btn-tab-admin');
        const workerSec = document.getElementById('section-worker-login');
        const adminSec = document.getElementById('section-admin-login');

        if (mode === 'worker') {
            workerBtn.classList.add('active');
            workerBtn.classList.remove('text-muted');
            adminBtn.classList.remove('active');
            adminBtn.classList.add('text-muted');
            workerSec.style.display = 'block';
            adminSec.style.display = 'none';
            const input = document.getElementById('barcode-gun-input');
            if (input) setTimeout(() => input.focus(), 100);
        } else {
            adminBtn.classList.add('active');
            adminBtn.classList.remove('text-muted');
            workerBtn.classList.remove('active');
            workerBtn.classList.add('text-muted');
            adminSec.style.display = 'block';
            workerSec.style.display = 'none';
            const input = document.getElementById('input-email');
            if (input) setTimeout(() => input.focus(), 100);
        }
    }

    // Barcode scanner input (USB gun / manual)
    const barcodeInput = document.getElementById('barcode-gun-input');
    if (barcodeInput) {
        barcodeInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitBarcodeScan(this.value.trim());
            }
        });
        document.getElementById('btn-submit-barcode').addEventListener('click', function () {
            submitBarcodeScan(barcodeInput.value.trim());
        });
    }

    async function submitBarcodeScan(code) {
        if (!code) return;
        const errEl = document.getElementById('worker-scan-error');
        const btnText = document.getElementById('barcode-btn-text');
        const btnSpinner = document.getElementById('barcode-btn-spinner');
        const barcodeInput = document.getElementById('barcode-gun-input');

        if (errEl) errEl.classList.add('d-none');
        if (btnText) btnText.classList.add('d-none');
        if (btnSpinner) btnSpinner.classList.remove('d-none');

        try {
            const formData = new FormData();
            formData.append('qrCode', code);
            formData.append('returnUrl', returnUrl);

            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenEl) formData.append('__RequestVerificationToken', tokenEl.value);

            const resp = await fetch('@Url.Action("WorkerQrLogin", "Account")', {
                method: 'POST',
                body: formData
            });

            const data = await resp.json();
            if (data.success) {
                playBeep(980, 0.15);
                window.location.href = data.redirectUrl || '/Worker/JobBoard';
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Worker badge / ID not recognized.';
                    errEl.classList.remove('d-none');
                    setTimeout(() => errEl.classList.add('d-none'), 5000);
                }
                if (barcodeInput) {
                    barcodeInput.value = '';
                    barcodeInput.focus();
                }
            }
        } catch (e) {
            if (errEl) {
                errEl.textContent = 'Error connecting to server. Please try again.';
                errEl.classList.remove('d-none');
                setTimeout(() => errEl.classList.add('d-none'), 5000);
            }
        } finally {
            if (btnText) btnText.classList.remove('d-none');
            if (btnSpinner) btnSpinner.classList.add('d-none');
        }
    }

    // Camera Badge Scanner Modal (Referenced exactly from PRD unit scanner in JobBoard)
    const scannerModalEl = document.getElementById('workerBadgeScanModal');
    const btnOpenScanner = document.getElementById('btn-open-badge-scanner');

    if (btnOpenScanner && scannerModalEl) {
        btnOpenScanner.addEventListener('click', function () {
            const scanModal = bootstrap.Modal.getOrCreateInstance(scannerModalEl, { focus: false });
            scanModal.show();
        });

        scannerModalEl.addEventListener('shown.bs.modal', function () {
            startBadgeCamera();
        });

        scannerModalEl.addEventListener('hidden.bs.modal', function () {
            stopBadgeCamera();
        });
    }

    function startBadgeCamera() {
        if (badgeIsScanning) return;
        const readerEl = document.getElementById('worker-scanner-viewfinder');
        if (!readerEl) return;

        setBadgeStatus('Accessing camera...', 'info');

        if (typeof Html5Qrcode === 'undefined') {
            setBadgeStatus('Camera QR library loading...', 'warning');
            return;
        }

        if (!html5BadgeScanner) {
            html5BadgeScanner = new Html5Qrcode("worker-scanner-viewfinder");
        }

        const config = {
            fps: 15,
            qrbox: { width: 220, height: 220 },
            aspectRatio: 1.0
        };

        // Try start with facingMode first (standard on mobile)
        html5BadgeScanner.start(
            { facingMode: badgeFacingMode },
            config,
            onBadgeScanSuccess,
            onBadgeScanFailure
        ).then(() => {
            badgeIsScanning = true;
            setBadgeStatus('Align Worker Badge QR inside box', 'success');
        }).catch(err => {
            console.warn('Badge camera start error with facingMode:', err);
            // Fallback from PRD scanner: enumerate available cameras and pick direct cameraId (standard on desktop/laptop)
            Html5Qrcode.getCameras().then(devices => {
                availableCameras = devices || [];
                if (availableCameras.length > 0) {
                    const cameraId = availableCameras[currentCameraIndex % availableCameras.length].id;
                    return html5BadgeScanner.start(cameraId, config, onBadgeScanSuccess, onBadgeScanFailure);
                } else {
                    throw new Error("No cameras found on device");
                }
            }).then(() => {
                badgeIsScanning = true;
                setBadgeStatus('Camera ready. Scan Worker Badge QR.', 'success');
            }).catch(e => {
                console.warn('Full badge camera error:', e);
                setBadgeStatus('Camera access unavailable. Please use Photo Snap or enter ID below.', 'warning');
            });
        });
    }

    function stopBadgeCamera() {
        if (!html5BadgeScanner || !badgeIsScanning) return Promise.resolve();
        return html5BadgeScanner.stop().then(() => {
            badgeIsScanning = false;
        }).catch(err => {
            console.warn('Badge camera stop error:', err);
            badgeIsScanning = false;
        });
    }

    function switchBadgeCamera() {
        if (availableCameras && availableCameras.length > 1) {
            currentCameraIndex = (currentCameraIndex + 1) % availableCameras.length;
            stopBadgeCamera().then(() => {
                const config = { fps: 15, qrbox: { width: 220, height: 220 }, aspectRatio: 1.0 };
                const cameraId = availableCameras[currentCameraIndex].id;
                return html5BadgeScanner.start(cameraId, config, onBadgeScanSuccess, onBadgeScanFailure);
            }).then(() => {
                badgeIsScanning = true;
                setBadgeStatus('Switched to camera ' + (currentCameraIndex + 1), 'success');
            }).catch(() => {
                startBadgeCamera();
            });
        } else {
            badgeFacingMode = (badgeFacingMode === "environment") ? "user" : "environment";
            stopBadgeCamera().then(() => startBadgeCamera());
        }
    }

    function onBadgeScanSuccess(decodedText) {
        if (!decodedText || !decodedText.trim()) return;
        playBeep(980, 0.15);
        stopBadgeCamera();

        const splash = document.getElementById('badge-scan-success-splash');
        const desc = document.getElementById('badge-scan-success-desc');
        if (splash) {
            if (desc) desc.textContent = 'Badge: ' + decodedText.substring(0, 24) + '...';
            splash.classList.remove('d-none');
        }

        setTimeout(() => {
            const modalEl = document.getElementById('workerBadgeScanModal');
            if (modalEl) {
                const m = bootstrap.Modal.getInstance(modalEl);
                if (m) m.hide();
            }
            if (splash) splash.classList.add('d-none');
            submitBarcodeScan(decodedText.trim());
        }, 500);
    }

    function onBadgeScanFailure(error) {
        // Frame scanning pass-through
    }

    function handleBadgeQrFile(input) {
        if (!input.files || input.files.length === 0) return;
        const file = input.files[0];
        setBadgeStatus('Scanning QR code from photo...', 'info');

        if (!html5BadgeScanner) {
            html5BadgeScanner = new Html5Qrcode("worker-scanner-viewfinder");
        }

        html5BadgeScanner.scanFile(file, true)
            .then(decodedText => {
                onBadgeScanSuccess(decodedText);
            })
            .catch(err => {
                console.warn('scanFile error:', err);
                setBadgeStatus('Could not detect QR code in photo. Please try a clearer picture or enter ID manually.', 'danger');
            });
    }

    function focusWorkerIdInput() {
        stopBadgeCamera();
        const input = document.getElementById('barcode-gun-input');
        if (input) setTimeout(() => input.focus(), 200);
    }

    // Password visibility toggle
    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('input-password');
        const toggleIcon = document.getElementById('toggle-password-icon');
        const toggleBtn = document.getElementById('toggle-password');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.remove('bi-eye');
            toggleIcon.classList.add('bi-eye-slash');
            toggleBtn.setAttribute('aria-label', 'Hide password');
        } else {
            passwordInput.type = 'password';
            toggleIcon.classList.remove('bi-eye-slash');
            toggleIcon.classList.add('bi-eye');
            toggleBtn.setAttribute('aria-label', 'Show password');
        }
    }
</script>
</script>
</body>
</html>
