@model SmartTorque.Web.ViewModels.Account.LoginViewModel
@{
    Layout = null; // Login page has its own minimal layout
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — SmartTorque</title>
    <meta name="description" content="Sign in to SmartTorque Guidance & Traceability System" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            background-color: #12040d;
            padding: 1.5rem 1rem;
            margin: 0;
        }
        .login-bg-blur {
            position: fixed;
            top: -40px;
            left: -40px;
            right: -40px;
            bottom: -40px;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(136, 0, 71, 0.65) 0%, transparent 55%),
                radial-gradient(circle at 85% 80%, rgba(76, 29, 149, 0.55) 0%, transparent 55%),
                url('/images/godrej-brand.png');
            background-size: cover;
            background-position: center;
            filter: blur(28px) brightness(0.65) saturate(1.2);
            transform: scale(1.08);
            z-index: 0;
            pointer-events: none;
        }
        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 430px;
            padding: 2.25rem 2rem;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 18px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.7);
        }
        .login-brand-logo {
            max-height: 52px;
            width: auto;
            max-width: 220px;
            object-fit: contain;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(129, 0, 85, 0.25);
            transition: transform 0.2s ease;
            display: inline-block;
        }
        .login-brand-logo:hover {
            transform: scale(1.03);
        }
        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--sp-2, 8px);
            margin-bottom: 0.25rem;
        }
        .login-logo i { font-size: 1.6rem; color: #810055; }
        .login-logo span { font-size: 1.35rem; font-weight: 700; color: #1e293b; letter-spacing: -0.02em; }
        .form-label { font-weight: 600; color: #334155; font-size: 0.875rem; }
        .btn-login {
            height: 48px;
            font-size: 16px;
            font-weight: 600;
            width: 100%;
            background-color: #810055;
            border-color: #810055;
        }
        .btn-login:hover {
            background-color: #680045;
            border-color: #680045;
        }
    </style>
</head>
<body>
<div class="login-bg-blur" aria-hidden="true"></div>
<div class="login-card">
    <div class="text-center mb-3">
        <a href="https://www.godrejenterprises.com/about-us/corporate-profile" target="_blank" rel="noopener noreferrer" title="Godrej Enterprises Group">
            <img src="~/images/godrej-brand.png" alt="Godrej Enterprises" class="login-brand-logo mb-3" />
        </a>
        <div class="login-logo">
            <i class="bi bi-wrench-adjustable-circle-fill"></i>
            <span>SmartTorque</span>
        </div>
        <p class="text-muted small mb-0">Torque Guidance &amp; Traceability System</p>
    </div>

    <h1 class="h6 fw-bold text-center text-secondary mb-3 pb-2 border-bottom">Sign in to your station</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-inline error mb-4" role="alert" aria-live="assertive">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form action="@Url.Action("Login", "Account")" method="post" id="login-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
            <input asp-for="Email"
                   class="form-control"
                   id="input-email"
                   type="email"
                   autocomplete="username"
                   autofocus
                   placeholder="you@company.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
            <input asp-for="Password"
                   class="form-control"
                   id="input-password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-login" id="btn-login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
        </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center">
        <p class="text-muted small mb-2">New worker or administrator?</p>
        <a asp-action="Register" asp-controller="Account" class="btn btn-outline-secondary w-100 py-2 fw-semibold" id="btn-request-access">
            <i class="bi bi-person-plus-fill me-1"></i>Request New User Access
        </a>
    </div>
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
