@model SmartTorque.Web.ViewModels.Account.LoginViewModel
@{
    Layout = null; // Login page has its own minimal layout
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — SmartTorque</title>
    <meta name="description" content="Sign in to SmartTorque Guidance & Traceability System" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-subtle);
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            padding: var(--sp-7) var(--sp-6);
            background: var(--bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-2);
            border: 1px solid var(--border);
        }
        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--sp-2);
            margin-bottom: var(--sp-6);
        }
        .login-logo i { font-size: 2rem; color: var(--brand); }
        .login-logo span { font-size: 1.5rem; font-weight: 700; color: var(--text); }
        .form-label { font-weight: 500; color: var(--text); }
        .btn-login {
            height: 48px;
            font-size: 16px;
            font-weight: 600;
            width: 100%;
        }
    </style>
</head>
<body>
<div class="login-card">
    <div class="login-logo">
        <i class="bi bi-wrench-adjustable-circle-fill"></i>
        <span>SmartTorque</span>
    </div>

    <h1 class="h5 fw-bold text-center mb-1">Sign in</h1>
    <p class="text-center text-muted small mb-4">Torque Guidance &amp; Traceability System</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-inline error mb-4" role="alert" aria-live="assertive">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form asp-action="Login" asp-controller="Account" method="post" id="login-form">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
            <input asp-for="Email"
                   class="form-control"
                   id="input-email"
                   type="email"
                   autocomplete="username"
                   autofocus
                   placeholder="you@company.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
            <input asp-for="Password"
                   class="form-control"
                   id="input-password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-login" id="btn-login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
        </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center">
        <span class="text-muted small">Need an account?</span>
        <a asp-action="Register" asp-controller="Account" class="small fw-bold ms-1 text-decoration-none">
            Register for Access <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
