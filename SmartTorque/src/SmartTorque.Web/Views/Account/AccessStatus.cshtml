@model SmartTorque.Core.Entities.ApplicationUser
@using SmartTorque.Core.Enums
@{
    Layout = null;
    ViewData["Title"] = "Access Request Status";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Status — SmartTorque</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            background-color: #12040d;
            padding: 2rem 1rem;
            margin: 0;
        }
        .login-bg-blur {
            position: fixed;
            top: -40px;
            left: -40px;
            right: -40px;
            bottom: -40px;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(136, 0, 71, 0.65) 0%, transparent 55%),
                radial-gradient(circle at 85% 80%, rgba(76, 29, 149, 0.55) 0%, transparent 55%),
                url('/images/godrej-brand.png');
            background-size: cover;
            background-position: center;
            filter: blur(28px) brightness(0.65) saturate(1.2);
            transform: scale(1.08);
            z-index: 0;
            pointer-events: none;
        }
        .status-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 500px;
            padding: 2.5rem 2rem;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 18px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.7);
            text-align: center;
        }
        .status-brand-logo {
            max-height: 48px;
            width: auto;
            max-width: 200px;
            object-fit: contain;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(129, 0, 85, 0.25);
            margin-bottom: 0.75rem;
        }
        .status-icon {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
<div class="login-bg-blur" aria-hidden="true"></div>
<div class="status-card">
    <div class="mb-3">
        <a href="https://www.godrejenterprises.com/about-us/corporate-profile" target="_blank" rel="noopener noreferrer" title="Godrej Enterprises Group">
            <img src="~/images/godrej-brand.png" alt="Godrej Enterprises" class="status-brand-logo" />
        </a>
        <div class="d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-wrench-adjustable-circle-fill fs-4" style="color: #810055;"></i>
            <span class="fs-4 fw-bold text-dark">SmartTorque</span>
        </div>
    </div>

    @if (Model.RegistrationStatus == RegistrationStatus.Pending)
    {
        <div class="status-icon text-warning">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <h1 class="h4 fw-bold mb-2">Access Request Under Review</h1>
        <p class="text-muted mb-3">
            Hello <strong>@Model.FullName</strong>, your request for <strong>@(Model.RequestedRole ?? "Worker")</strong> access has been received.
        </p>
        <div class="alert alert-warning text-start py-2 px-3 small mb-4">
            <i class="bi bi-info-circle-fill me-1"></i>
            An active administrator must review and approve your registration before you can log in. Please check back later or notify your shop-floor supervisor.
        </div>
        <div class="bg-light p-3 rounded text-start small mb-4">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Account:</span>
                <span class="fw-semibold">@Model.Email</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.EmployeeNo))
            {
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Badge / Employee ID:</span>
                    <span class="fw-semibold">@Model.EmployeeNo</span>
                </div>
            }
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Requested Role:</span>
                <span class="badge bg-secondary">@(Model.RequestedRole ?? "Worker")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Submitted:</span>
                <span>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</span>
            </div>
        </div>
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100">
            <i class="bi bi-arrow-left me-1"></i>Back to Sign In
        </a>
    }
    else if (Model.RegistrationStatus == RegistrationStatus.Rejected)
    {
        <div class="status-icon text-danger">
            <i class="bi bi-shield-x"></i>
        </div>
        <h1 class="h4 fw-bold text-danger mb-2">Access Request Rejected</h1>
        <p class="text-muted mb-3">
            Hello <strong>@Model.FullName</strong>, your account registration was declined by an administrator.
        </p>
        <div class="alert alert-danger text-start py-3 px-3 mb-4">
            <div class="fw-bold mb-1"><i class="bi bi-x-circle me-1"></i>Rejection Reason:</div>
            <div class="small">
                @(string.IsNullOrWhiteSpace(Model.RejectionReason) ? "Access rejected by plant administrator. Please contact your supervisor." : Model.RejectionReason)
            </div>
        </div>
        <div class="bg-light p-3 rounded text-start small mb-4">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Account:</span>
                <span class="fw-semibold">@Model.Email</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Reviewed By:</span>
                <span>@(Model.ReviewedBy ?? "Administrator")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Reviewed At:</span>
                <span>@(Model.ReviewedAt?.ToString("dd MMM yyyy, HH:mm") ?? "N/A") UTC</span>
            </div>
        </div>
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100">
            <i class="bi bi-arrow-left me-1"></i>Back to Sign In
        </a>
    }
    else
    {
        <div class="status-icon text-success">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="h4 fw-bold text-success mb-2">Account Approved!</h1>
        <p class="text-muted mb-4">
            Hello <strong>@Model.FullName</strong>, your account has been approved and activated.
        </p>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg w-100" style="background-color: #810055; border-color: #810055;">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to SmartTorque
        </a>
    }
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
