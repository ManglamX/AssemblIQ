@model SmartTorque.Web.ViewModels.Bm.WorkloadByItemViewModel
@using SmartTorque.Web.ViewModels.Bm
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders by Item Code";
    ViewData["ActiveNav"] = "Workload";

    var priorityIcons = new Dictionary<int, string>
    {
        [1] = "bi-circle-fill",
        [2] = "bi-caret-up-fill",
        [3] = "bi-diamond-fill",
        [4] = "bi-square-fill",
        [5] = "bi-hexagon-fill",
        [6] = "bi-circle"
    };

    var priorityLabels = new Dictionary<int, string>
    {
        [1] = "BLACK",
        [2] = "RED",
        [3] = "YELLOW",
        [4] = "GREEN",
        [5] = "BLUE",
        [6] = "WHITE"
    };
}

@await Html.PartialAsync("_BmSubNav", "ByItem")

@* Antiforgery token for AJAX requests *@
<form id="ajax-antiforgery-form" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Summary KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Item Codes</div>
                    <div class="fs-4 fw-bold num" id="stat-total-items">@Model.TotalItemCodes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info-subtle text-info" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total to Manufacture</div>
                    <div class="fs-4 fw-bold num text-info" id="stat-total-qty">@Model.TotalQuantityAcrossAllBms <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Completed</div>
                    <div class="fs-4 fw-bold num text-success" id="stat-completed-qty">@Model.TotalQuantityCompleted <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning-subtle text-warning" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Remaining</div>
                    <div class="fs-4 fw-bold num text-warning" id="stat-remaining-qty">@Model.TotalQuantityRemaining <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search Bar -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form asp-action="ByItem" method="get" class="row g-2 align-items-center" data-live-filter>
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search"
                           class="form-control border-start-0"
                           placeholder="Filter by item code (e.g. 46171506DG05623), product name, or job no..."
                           id="input-search-items" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" id="btn-search-items">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="ByItem" class="btn btn-outline-secondary" title="Reset filter"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Item Codes Grouped View -->
@if (Model.Items.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            <h5 class="fw-semibold">No manufacturing jobs found</h5>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <p class="small mb-3">No jobs matched "@Model.Search". Try clearing the filter.</p>
                <a asp-action="ByItem" class="btn btn-outline-secondary btn-sm">Clear Filter</a>
            }
            else
            {
                <p class="small mb-3">Upload an order sheet or create a manufacturing order to track quantities to manufacture.</p>
                <a asp-action="Index" class="btn btn-primary btn-sm"><i class="bi bi-upload me-1"></i>Go to Order Creation</a>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3" id="itemsList">
        @{ var itemIndex = 0; }
        @foreach (var item in Model.Items)
        {
            itemIndex++;
            var pri = (int)item.HighestPriority;
            var pct = item.TotalQuantityRequired > 0
                ? Math.Min(100, (int)Math.Round((double)item.TotalQuantityCompleted / item.TotalQuantityRequired * 100))
                : 0;
            var collapseId = $"bifurcation-{itemIndex}";

            <div class="card border @(pri == 1 ? "border-dark shadow-sm" : "")" id="item-card-@itemIndex">
                <!-- Top-Level Item Code Header (Aggregated) -->
                <div class="card-header bg-white py-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <!-- Left: Item Code, Name, Product Link, Meta -->
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-priority badge-pri-@(pri >= 1 && pri <= 6 ? pri : 6)" title="Highest priority in batch: @WorkloadByItemViewModel.PriorityLabel(item.HighestPriority)">
                                <i class="bi @WorkloadByItemViewModel.PriorityIcon(item.HighestPriority)"></i> @(pri >= 1 && pri <= 6 ? pri : 6) @WorkloadByItemViewModel.PriorityLabel(item.HighestPriority)
                            </span>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (item.ProductConfigured)
                                    {
                                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                                           class="fs-5 fw-bold text-decoration-none text-primary"
                                           title="Click to view product info designed for @item.ItemCode">
                                            <code>@item.ItemCode</code>
                                            <i class="bi bi-box-arrow-up-right ms-1 fs-6"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <code class="fs-5 fw-bold text-dark">@item.ItemCode</code>
                                        <span class="badge bg-warning-subtle text-warning-emphasis small">Product not configured</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.ProductName))
                                    {
                                        <span class="fw-semibold text-dark fs-5">&mdash; @item.ProductName</span>
                                    }
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-2 mt-1 flex-wrap">
                                    @if (item.ProductConfigured)
                                    {
                                        <span><i class="bi bi-layers me-1"></i>@item.ComponentCount components &middot; @item.TotalSteps steps</span>
                                        <span>&middot;</span>
                                    }
                                    @if (item.EarliestDueDate.HasValue)
                                    {
                                        <span><i class="bi bi-calendar-event me-1"></i>Earliest due: <strong>@item.EarliestDueDate.Value.ToString("dd MMM yyyy")</strong></span>
                                        <span>&middot;</span>
                                    }
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        <i class="bi bi-receipt me-1"></i>@item.TotalOrders @(item.TotalOrders == 1 ? "Sales Order" : "Sales Orders")
                                    </span>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-kanban me-1"></i>@item.TotalJobs @(item.TotalJobs == 1 ? "job" : "jobs")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Actions, Overall Quantity Summary, & Bifurcation Toggle -->
                        <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                            <div class="text-end" data-item-summary="@item.ItemCode">
                                <div class="small text-muted text-uppercase fw-semibold">Total to Manufacture</div>
                                <div class="fs-5 fw-bold num text-dark">
                                    <span class="item-total-required">@item.TotalQuantityRequired</span> <span class="fs-6 text-muted fw-normal">units</span>
                                </div>
                                <div class="small text-muted">
                                    <span class="text-success fw-semibold item-total-completed">@item.TotalQuantityCompleted completed</span> &middot;
                                    <span class="text-warning fw-semibold item-total-remaining">@item.TotalQuantityRemaining remaining</span>
                                </div>
                            </div>

                            @if (item.ProductConfigured)
                            {
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                                   class="btn btn-outline-primary btn-sm px-3"
                                   title="Open Product Info for @item.ItemCode">
                                    <i class="bi bi-box-seam me-1"></i> Product Info
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Product" asp-action="Create" asp-route-productCode="@item.ItemCode"
                                   class="btn btn-warning btn-sm px-3"
                                   title="Create product definition for @item.ItemCode">
                                    <i class="bi bi-plus-circle me-1"></i> Create Product
                                </a>
                            }

                            <!-- Bifurcation Toggle Button -->
                            <button class="btn btn-sm btn-outline-secondary px-3 d-flex align-items-center gap-1"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="true"
                                    aria-controls="@collapseId"
                                    title="Toggle Sales Order and PO No bifurcation for @item.ItemCode">
                                <i class="bi bi-diagram-3 me-1"></i>
                                <span>Order Bifurcation (@item.TotalOrders)</span>
                                <i class="bi bi-chevron-down ms-1 small"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Overall Progress Bar across all BMs & Orders -->
                    <div class="progress mt-3" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                             title="@pct% total manufacturing progress (@item.TotalQuantityCompleted of @item.TotalQuantityRequired units)"></div>
                    </div>
                </div>

                <!-- Collapsible Bifurcation Section (Grouped by Sales Order & PO No) -->
                <div class="collapse show" id="@collapseId">
                    <div class="card-body p-3 bg-light-subtle">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var order in item.OrderBifurcations)
                            {
                                var orderPri = (int)order.HighestPriority;
                                var orderPct = order.CompletionPercentage;
                                var isOrderComplete = order.QuantityCompleted >= order.QuantityRequired;

                                <div class="card border shadow-none bg-white">
                                    <!-- Order Bifurcation Header -->
                                    <div class="card-header bg-white py-2 px-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <!-- Sales Order Badge -->
                                            <span class="badge bg-primary text-white px-2 py-1 fs-6 font-monospace">
                                                <i class="bi bi-receipt me-1"></i>SO: @order.DisplaySalesOrder
                                            </span>

                                            <!-- PO No Badge -->
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border px-2 py-1 fs-6 font-monospace">
                                                <i class="bi bi-hash me-1"></i>PO: @order.DisplayPONo
                                            </span>

                                            <!-- Order Status -->
                                            @if (isOrderComplete)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Fulfilled
                                                </span>
                                            }
                                            else if (order.QuantityCompleted > 0)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                    <i class="bi bi-hourglass-split me-1"></i>In Progress (@orderPct%)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                    <i class="bi bi-clock me-1"></i>Pending
                                                </span>
                                            }

                                            @if (order.EarliestDueDate.HasValue)
                                            {
                                                <span class="small text-muted ms-2">
                                                    <i class="bi bi-calendar3 me-1"></i>Due: <strong>@order.EarliestDueDate.Value.ToString("dd MMM yyyy")</strong>
                                                </span>
                                            }
                                        </div>

                                        <!-- Order Quantity Breakdown -->
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="text-end small" data-order-summary="@order.DisplaySalesOrder-@order.DisplayPONo">
                                                <span class="text-muted">Order Qty:</span>
                                                <strong class="fs-6 font-monospace order-qty-required">@order.QuantityRequired</strong> units
                                                <span class="text-muted mx-1">&middot;</span>
                                                <span class="text-success fw-semibold font-monospace order-qty-completed">@order.QuantityCompleted</span> done
                                                <span class="text-muted mx-1">&middot;</span>
                                                <span class="text-warning fw-semibold font-monospace order-qty-remaining">@order.QuantityRemaining</span> remaining
                                            </div>
                                            <div style="width: 80px;">
                                                <div class="progress" style="height: 6px;" title="@orderPct% completed">
                                                    <div class="progress-bar @(isOrderComplete ? "bg-success" : "bg-primary")" role="progressbar"
                                                         style="width: @orderPct%;" aria-valuenow="@orderPct" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Jobs Table for this specific Order Bifurcation -->
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 130px;">Job No</th>
                                                        <th>Source Order Sheet</th>
                                                        <th class="text-center" style="width: 110px;">Required</th>
                                                        <th class="text-center" style="width: 110px;">Completed</th>
                                                        <th style="width: 120px;">Priority</th>
                                                        <th style="width: 120px;">Due Date</th>
                                                        <th style="width: 110px;">Status</th>
                                                        <th>Assigned Worker</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var job in order.Jobs)
                                                    {
                                                        var jobPri = (int)job.Priority;
                                                        <tr class="@(jobPri == 1 ? "table-active" : "")">
                                                            <td>
                                                                <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.JobId"
                                                                   class="fw-semibold text-primary text-decoration-none"
                                                                   title="View details for @job.JobNo">
                                                                    <code>@job.JobNo</code>
                                                                    <i class="bi bi-box-arrow-up-right ms-1 small" style="font-size:0.75rem"></i>
                                                                </a>
                                                            </td>
                                                            <td>
                                                                @if (job.BmUploadId.HasValue && !string.IsNullOrEmpty(job.BmFileName))
                                                                {
                                                                    <a asp-action="Preview" asp-route-id="@job.BmUploadId.Value"
                                                                       class="text-decoration-none text-body"
                                                                       title="View order sheet preview">
                                                                        <i class="bi bi-file-earmark-spreadsheet text-success me-1"></i>@job.BmFileName
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted"><i class="bi bi-file-earmark me-1"></i>@(job.BmFileName ?? "Manual order")</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-qty-decrease"
                                                                            data-job-id="@job.JobId"
                                                                            title="Decrease quantity"
                                                                            style="line-height: 1.2; font-size: 1rem;">
                                                                        <i class="bi bi-dash"></i>
                                                                    </button>
                                                                    <span class="fw-semibold num mx-1" id="qty-@job.JobId" style="min-width: 35px; display: inline-block; text-align: center;">@job.Quantity</span>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-qty-increase"
                                                                            data-job-id="@job.JobId"
                                                                            title="Increase quantity"
                                                                            style="line-height: 1.2; font-size: 1rem;">
                                                                        <i class="bi bi-plus"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                            <td class="text-center num">
                                                                @if (job.QuantityCompleted >= job.Quantity)
                                                                {
                                                                    <span class="badge bg-success-subtle text-success">@job.QuantityCompleted</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">@job.QuantityCompleted</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <span class="badge-priority badge-pri-@(jobPri >= 1 && jobPri <= 6 ? jobPri : 6)">
                                                                    <i class="bi @WorkloadByItemViewModel.PriorityIcon(job.Priority)"></i> @(jobPri >= 1 && jobPri <= 6 ? jobPri : 6) @WorkloadByItemViewModel.PriorityLabel(job.Priority)
                                                                </span>
                                                            </td>
                                                            <td>
                                                                @(job.DueDate?.ToString("dd MMM yyyy") ?? "—")
                                                            </td>
                                                            <td>
                                                                <span class="badge-status @WorkloadByItemViewModel.StatusBadgeClass(job.Status)">@job.Status</span>
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(job.AssignedWorkerName))
                                                                {
                                                                    <span><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fst-italic">Open (Unassigned)</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Items.Count > 3)
    {
        <div class="card mt-3" id="itemsPagination">
            <div class="card-body py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small text-muted" id="itemsPaginationInfo"></div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="itemsPrevPage" disabled>
                        <i class="bi bi-chevron-left me-1"></i>Prev
                    </button>
                    <span class="small fw-semibold text-dark" id="itemsPageDisplay"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="itemsNextPage">
                        Next<i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Quantity adjustment handler with pending changes tracking
        const quantityButtons = document.querySelectorAll('.btn-qty-increase, .btn-qty-decrease');

        // State management
        const pendingChanges = new Map(); // jobId -> { originalQty, newQty }
        const originalQuantities = new Map(); // jobId -> originalQty
        let isSaving = false;

        // Initialize original quantities
        function initializeOriginalQuantities() {
            document.querySelectorAll('[id^="qty-"]').forEach(el => {
                const jobId = el.id.replace('qty-', '');
                const qty = parseInt(el.textContent);
                originalQuantities.set(jobId, qty);
            });
        }

        // Update quantity display (pending changes only - not saved to DB)
        function updateQuantityDisplay(jobId, delta) {
            const qtyElement = document.getElementById('qty-' + jobId);
            if (!qtyElement) return false;

            const currentQty = parseInt(qtyElement.textContent);
            const newQty = currentQty + delta;

            // Validate minimum quantity
            if (newQty < 1) {
                alert('Quantity cannot be less than 1.');
                return false;
            }

            // Update display
            qtyElement.textContent = newQty;

            // Track pending change
            const originalQty = originalQuantities.get(jobId);
            if (newQty !== originalQty) {
                pendingChanges.set(jobId, {
                    originalQty: originalQty,
                    newQty: newQty
                });
                // Add visual indicator for changed quantity
                qtyElement.classList.add('text-primary', 'fw-bold');
            } else {
                // Quantity reverted to original - remove from pending changes
                pendingChanges.delete(jobId);
                qtyElement.classList.remove('text-primary', 'fw-bold');
            }

            updateSaveButton();
            updateTotalToManufacture();
            return true;
        }

        // Update total to manufacture with pending changes
        function updateTotalToManufacture() {
            const totalElement = document.getElementById('stat-total-qty');
            if (!totalElement) return;

            let total = 0;

            // Sum all quantities including pending changes
            document.querySelectorAll('[id^="qty-"]').forEach(el => {
                const qty = parseInt(el.textContent);
                if (!isNaN(qty)) {
                    total += qty;
                }
            });

            totalElement.innerHTML = `${total} <span class="fs-6 text-muted fw-normal">units</span>`;
        }

        // Update order summaries (recalculate order-level totals from job quantities)
        function updateOrderSummaries() {
            console.log('Updating order summaries...');

            // Group jobs by their order (SO + PO) and by item code
            const orderTotals = new Map();
            const itemTotals = new Map();

            // Collect all job rows and sum by order
            document.querySelectorAll('[id^="qty-"]').forEach(qtyEl => {
                const jobId = qtyEl.id.replace('qty-', '');
                const qty = parseInt(qtyEl.textContent);

                // Find the parent order bifurcation card
                const jobRow = qtyEl.closest('tr');
                if (!jobRow) {
                    console.log('No job row found for', jobId);
                    return;
                }

                const orderCard = jobRow.closest('.card.border');
                if (!orderCard) {
                    console.log('No order card found for', jobId);
                    return;
                }

                const orderHeader = orderCard.querySelector('[data-order-summary]');
                if (!orderHeader) {
                    console.log('No order header found for', jobId);
                    return;
                }

                const orderKey = orderHeader.getAttribute('data-order-summary');
                console.log('Found order key:', orderKey, 'for job', jobId, 'qty:', qty);

                if (!orderTotals.has(orderKey)) {
                    orderTotals.set(orderKey, { required: 0, completed: 0 });
                }

                const totals = orderTotals.get(orderKey);
                totals.required += qty;

                // Also track by item code for the top-level summary
                const itemCard = jobRow.closest('[id^="item-card-"]');
                if (itemCard) {
                    const itemSummary = itemCard.querySelector('[data-item-summary]');
                    if (itemSummary) {
                        const itemCode = itemSummary.getAttribute('data-item-summary');
                        if (!itemTotals.has(itemCode)) {
                            itemTotals.set(itemCode, { required: 0, completed: 0 });
                        }
                        const itemTotal = itemTotals.get(itemCode);
                        itemTotal.required += qty;
                    }
                }

                // Get completed count from the same row
                const completedCell = jobRow.querySelector('td:nth-child(4)');
                if (completedCell) {
                    const completedBadge = completedCell.querySelector('.badge');
                    const completedSpan = completedCell.querySelector('.text-muted');
                    const completedText = completedBadge ? completedBadge.textContent : (completedSpan ? completedSpan.textContent : completedCell.textContent);
                    const completed = parseInt(completedText.trim());
                    if (!isNaN(completed)) {
                        totals.completed += completed;

                        // Also add to item totals
                        const itemCard = jobRow.closest('[id^="item-card-"]');
                        if (itemCard) {
                            const itemSummary = itemCard.querySelector('[data-item-summary]');
                            if (itemSummary) {
                                const itemCode = itemSummary.getAttribute('data-item-summary');
                                if (itemTotals.has(itemCode)) {
                                    itemTotals.get(itemCode).completed += completed;
                                }
                            }
                        }
                    }
                }
            });

            console.log('Order totals:', orderTotals);
            console.log('Item totals:', itemTotals);

            // Update the display for each order summary
            orderTotals.forEach((totals, orderKey) => {
                const summaryDiv = document.querySelector(`[data-order-summary="${orderKey}"]`);
                if (!summaryDiv) {
                    console.log('Could not find summary div for', orderKey);
                    return;
                }

                console.log('Updating summary for', orderKey, 'with totals:', totals);

                const requiredEl = summaryDiv.querySelector('.order-qty-required');
                const completedEl = summaryDiv.querySelector('.order-qty-completed');
                const remainingEl = summaryDiv.querySelector('.order-qty-remaining');

                if (requiredEl) {
                    console.log('Updating required from', requiredEl.textContent, 'to', totals.required);
                    requiredEl.textContent = totals.required;
                }
                if (completedEl) {
                    console.log('Updating completed to', totals.completed);
                    completedEl.textContent = totals.completed;
                }
                if (remainingEl) {
                    const remaining = Math.max(0, totals.required - totals.completed);
                    console.log('Updating remaining to', remaining);
                    remainingEl.textContent = remaining;
                }

                // Update progress bar
                const progressBarContainer = summaryDiv.closest('.d-flex');
                if (progressBarContainer) {
                    const progressBar = progressBarContainer.querySelector('.progress-bar');
                    if (progressBar && totals.required > 0) {
                        const percentage = Math.min(100, Math.round((totals.completed / totals.required) * 100));
                        console.log('Updating progress bar to', percentage, '%');
                        progressBar.style.width = `${percentage}%`;
                        progressBar.setAttribute('aria-valuenow', percentage);

                        // Update color based on completion
                        if (totals.completed >= totals.required) {
                            progressBar.classList.remove('bg-primary');
                            progressBar.classList.add('bg-success');
                        } else {
                            progressBar.classList.remove('bg-success');
                            progressBar.classList.add('bg-primary');
                        }
                    }
                }
            });

            // Update the item-level summaries (the "Total to Manufacture" at top right of each card)
            itemTotals.forEach((totals, itemCode) => {
                const itemSummary = document.querySelector(`[data-item-summary="${itemCode}"]`);
                if (!itemSummary) {
                    console.log('Could not find item summary for', itemCode);
                    return;
                }

                console.log('Updating item summary for', itemCode, 'with totals:', totals);

                const requiredEl = itemSummary.querySelector('.item-total-required');
                const completedEl = itemSummary.querySelector('.item-total-completed');
                const remainingEl = itemSummary.querySelector('.item-total-remaining');

                if (requiredEl) {
                    console.log('Updating item required from', requiredEl.textContent, 'to', totals.required);
                    requiredEl.textContent = totals.required;
                }
                if (completedEl) {
                    const remaining = Math.max(0, totals.required - totals.completed);
                    console.log('Updating item completed to', totals.completed, 'and remaining to', remaining);
                    completedEl.textContent = totals.completed + ' completed';
                    if (remainingEl) {
                        remainingEl.textContent = remaining + ' remaining';
                    }
                }
            });

            console.log('Order summaries updated successfully');
        }

        // Update save button visibility and state
        function updateSaveButton() {
            let saveButton = document.getElementById('btn-save-quantities');

            if (pendingChanges.size > 0) {
                // Show save button if it doesn't exist
                if (!saveButton) {
                    const container = document.querySelector('.mb-4.flex-wrap.gap-3');
                    if (container) {
                        const buttonHtml = `
                            <button type="button" class="btn btn-success position-fixed shadow-lg"
                                    id="btn-save-quantities"
                                    style="bottom: 30px; right: 30px; z-index: 1050; min-width: 200px;">
                                <i class="bi bi-check-circle me-2"></i>Save Changes (<span id="pending-count">0</span>)
                            </button>
                        `;
                        document.body.insertAdjacentHTML('beforeend', buttonHtml);
                        saveButton = document.getElementById('btn-save-quantities');
                        saveButton.addEventListener('click', showConfirmationDialog);
                    }
                }

                // Update count
                const countEl = document.getElementById('pending-count');
                if (countEl) {
                    countEl.textContent = pendingChanges.size;
                }
            } else {
                // Hide save button
                if (saveButton) {
                    saveButton.remove();
                }
            }
        }

        // Show confirmation dialog
        function showConfirmationDialog() {
            if (pendingChanges.size === 0) return;

            const changes = Array.from(pendingChanges.entries()).map(([jobId, change]) => {
                // Find job number from the page
                const jobLink = document.querySelector(`a[href*="job/${jobId}"] code`);
                const jobNo = jobLink ? jobLink.textContent : `Job #${jobId}`;
                return {
                    jobId,
                    jobNo,
                    originalQty: change.originalQty,
                    newQty: change.newQty
                };
            });

            // Build modal HTML
            const modalHtml = `
                <div class="modal fade" id="confirmQuantityChangesModal" tabindex="-1" aria-labelledby="confirmQuantityChangesModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-primary-subtle">
                                <h5 class="modal-title fw-bold" id="confirmQuantityChangesModalLabel">
                                    <i class="bi bi-exclamation-circle me-2"></i>Confirm Quantity Changes
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-3">You are about to save quantity changes for <strong>${changes.length}</strong> order(s):</p>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Order</th>
                                                <th class="text-center">Previous Quantity</th>
                                                <th class="text-center">New Quantity</th>
                                                <th class="text-center">Change</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${changes.map(ch => {
                                                const diff = ch.newQty - ch.originalQty;
                                                const diffClass = diff > 0 ? 'text-success' : 'text-danger';
                                                const diffIcon = diff > 0 ? '↑' : '↓';
                                                return `
                                                    <tr>
                                                        <td><code>${ch.jobNo}</code></td>
                                                        <td class="text-center num">${ch.originalQty}</td>
                                                        <td class="text-center num fw-bold">${ch.newQty}</td>
                                                        <td class="text-center ${diffClass} fw-bold">${diffIcon} ${Math.abs(diff)}</td>
                                                    </tr>
                                                `;
                                            }).join('')}
                                        </tbody>
                                    </table>
                                </div>
                                <div class="alert alert-info d-flex align-items-center mt-3 mb-0">
                                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                    <div class="small">
                                        These changes will be saved to the database and reflected across all order management sections.
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                                <button type="button" class="btn btn-success" id="btn-confirm-save" onclick="savePendingChanges()">
                                    <i class="bi bi-check-circle me-1"></i>Confirm & Save
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('confirmQuantityChangesModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('confirmQuantityChangesModal'));
            modal.show();
        }

        // Save all pending changes
        window.savePendingChanges = async function() {
            if (isSaving || pendingChanges.size === 0) return;

            isSaving = true;
            const confirmBtn = document.getElementById('btn-confirm-save');
            const originalBtnText = confirmBtn.innerHTML;

            // Show loading state
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

            const changesToSave = Array.from(pendingChanges.entries()).map(([jobId, change]) => ({
                jobId: parseInt(jobId),
                quantity: change.newQty
            }));

            try {
                const response = await fetch('@Url.Action("UpdateJobQuantitiesBatch", "Bm")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ changes: changesToSave })
                });

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.message || 'Failed to save changes');
                }

                // Success - update original quantities and clear pending changes
                pendingChanges.forEach((change, jobId) => {
                    originalQuantities.set(jobId, change.newQty);
                    const qtyElement = document.getElementById('qty-' + jobId);
                    if (qtyElement) {
                        qtyElement.classList.remove('text-primary', 'fw-bold');
                    }
                });
                pendingChanges.clear();

                // Force immediate update of order summaries and totals
                console.log('Save successful, updating displays...');
                setTimeout(() => {
                    updateOrderSummaries();
                    updateTotalToManufacture();
                    console.log('Displays updated after save');
                }, 100);

                // Hide modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('confirmQuantityChangesModal'));
                if (modal) modal.hide();

                // Update UI
                updateSaveButton();

                // Show success notification - use toast if available
                if (window.AppNotifications && window.AppNotifications.show) {
                    window.AppNotifications.show(`Successfully updated ${result.updatedCount} order quantities`, 'success');
                }
                // If toast system not available, show a temporary banner instead of alert
                else {
                    const banner = document.createElement('div');
                    banner.className = 'alert alert-success position-fixed shadow-lg';
                    banner.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                    banner.innerHTML = `
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Successfully updated ${result.updatedCount} order quantities
                    `;
                    document.body.appendChild(banner);
                    setTimeout(() => banner.remove(), 3000);
                }

            } catch (error) {
                console.error('Error saving quantities:', error);

                // Show error notification
                const errorMsg = error.message || 'Failed to save quantity changes. Please try again.';
                if (window.AppNotifications && window.AppNotifications.show) {
                    window.AppNotifications.show(errorMsg, 'error');
                } else {
                    alert(errorMsg);
                }

                // Re-enable button
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = originalBtnText;
            } finally {
                isSaving = false;
            }
        };

        // Warn user about unsaved changes
        window.addEventListener('beforeunload', function(e) {
            if (pendingChanges.size > 0) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });

        // Button click handlers
        quantityButtons.forEach(button => {
            button.addEventListener('click', function() {
                const jobId = this.getAttribute('data-job-id');
                const isIncrease = this.classList.contains('btn-qty-increase');
                const delta = isIncrease ? 1 : -1;

                updateQuantityDisplay(jobId, delta);
            });
        });

        // Item code pagination — 3 item cards per page
        (function initItemsPagination() {
            const pageSize = 3;
            const container = document.getElementById('itemsList');
            if (!container) return;

            const cards = Array.from(container.children).filter(el => el.classList.contains('card'));
            if (cards.length <= pageSize) return;

            let page = 1;
            const totalPages = Math.ceil(cards.length / pageSize);
            const info = document.getElementById('itemsPaginationInfo');
            const display = document.getElementById('itemsPageDisplay');
            const prev = document.getElementById('itemsPrevPage');
            const next = document.getElementById('itemsNextPage');

            function render() {
                cards.forEach((card, index) => {
                    card.style.display = Math.floor(index / pageSize) === page - 1 ? '' : 'none';
                });
                const start = (page - 1) * pageSize + 1;
                const end = Math.min(page * pageSize, cards.length);
                if (info) info.textContent = `Showing ${start}–${end} of ${cards.length} item codes`;
                if (display) display.textContent = `Page ${page} of ${totalPages}`;
                if (prev) prev.disabled = page === 1;
                if (next) next.disabled = page === totalPages;
            }

            prev?.addEventListener('click', () => { if (page > 1) { page--; render(); } });
            next?.addEventListener('click', () => { if (page < totalPages) { page++; render(); } });
            render();
        })();

        // Initialize on page load
        initializeOriginalQuantities();
    </script>
}
