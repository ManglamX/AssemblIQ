@model SmartTorque.Web.ViewModels.Bm.WorkloadByItemViewModel
@using SmartTorque.Web.ViewModels.Bm
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Jobs by Item Code";
    ViewData["ActiveNav"] = "Workload";

    var priorityIcons = new Dictionary<int, string>
    {
        [1] = "bi-circle-fill",
        [2] = "bi-caret-up-fill",
        [3] = "bi-diamond-fill",
        [4] = "bi-square-fill",
        [5] = "bi-hexagon-fill",
        [6] = "bi-circle"
    };

    var priorityLabels = new Dictionary<int, string>
    {
        [1] = "BLACK",
        [2] = "RED",
        [3] = "YELLOW",
        [4] = "GREEN",
        [5] = "BLUE",
        [6] = "WHITE"
    };
}

@await Html.PartialAsync("_BmSubNav", "ByItem")

<!-- Summary KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Item Codes</div>
                    <div class="fs-4 fw-bold num" id="stat-total-items">@Model.TotalItemCodes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info-subtle text-info" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total to Manufacture</div>
                    <div class="fs-4 fw-bold num text-info" id="stat-total-qty">@Model.TotalQuantityAcrossAllBms <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Completed</div>
                    <div class="fs-4 fw-bold num text-success" id="stat-completed-qty">@Model.TotalQuantityCompleted <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning-subtle text-warning" style="width:48px;height:48px;font-size:1.4rem">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Remaining</div>
                    <div class="fs-4 fw-bold num text-warning" id="stat-remaining-qty">@Model.TotalQuantityRemaining <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search Bar -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form asp-action="ByItem" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search"
                           class="form-control border-start-0"
                           placeholder="Filter by item code (e.g. 46171506DG05623), product name, or job no..."
                           id="input-search-items" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" id="btn-search-items">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="ByItem" class="btn btn-outline-secondary" title="Reset filter"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Item Codes Grouped View -->
@if (Model.Items.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            <h5 class="fw-semibold">No manufacturing jobs found</h5>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <p class="small mb-3">No jobs matched "@Model.Search". Try clearing the filter.</p>
                <a asp-action="ByItem" class="btn btn-outline-secondary btn-sm">Clear Filter</a>
            }
            else
            {
                <p class="small mb-3">Upload a BM workbook and confirm it to create jobs and track quantities to manufacture.</p>
                <a asp-action="Index" class="btn btn-primary btn-sm"><i class="bi bi-upload me-1"></i>Go to BM Import</a>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Items)
        {
            var pri = (int)item.HighestPriority;
            var pct = item.TotalQuantityRequired > 0
                ? Math.Min(100, (int)Math.Round((double)item.TotalQuantityCompleted / item.TotalQuantityRequired * 100))
                : 0;

            <div class="card border @(pri == 1 ? "border-dark shadow-sm" : "")" id="item-card-@item.ItemCode">
                <div class="card-header bg-white py-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <!-- Left: Item Code, Name, Product Link -->
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-priority badge-pri-@pri" title="Highest priority in batch: @priorityLabels[pri]">
                                <i class="bi @priorityIcons[pri]"></i> @pri @priorityLabels[pri]
                            </span>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (item.ProductConfigured)
                                    {
                                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                                           class="fs-5 fw-bold text-decoration-none text-primary"
                                           title="Click to view product info designed for @item.ItemCode">
                                            <code>@item.ItemCode</code>
                                            <i class="bi bi-box-arrow-up-right ms-1 fs-6"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <code class="fs-5 fw-bold text-dark">@item.ItemCode</code>
                                        <span class="badge bg-warning-subtle text-warning-emphasis small">Product not configured</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.ProductName))
                                    {
                                        <span class="fw-semibold text-dark fs-5">&mdash; @item.ProductName</span>
                                    }
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-3 mt-1 flex-wrap">
                                    @if (item.ProductConfigured)
                                    {
                                        <span><i class="bi bi-layers me-1"></i>@item.ComponentCount components &middot; @item.TotalSteps steps</span>
                                    }
                                    @if (item.EarliestDueDate.HasValue)
                                    {
                                        <span><i class="bi bi-calendar-event me-1"></i>Earliest due: <strong>@item.EarliestDueDate.Value.ToString("dd MMM yyyy")</strong></span>
                                    }
                                    <span><i class="bi bi-kanban me-1"></i>@item.TotalJobs @(item.TotalJobs == 1 ? "job" : "jobs") across all BMs</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Actions & Quantity Summary -->
                        <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                            <div class="text-end">
                                <div class="small text-muted text-uppercase fw-semibold">Quantity to Manufacture</div>
                                <div class="fs-5 fw-bold num text-dark">
                                    @item.TotalQuantityRequired <span class="fs-6 text-muted fw-normal">units</span>
                                </div>
                                <div class="small text-muted">
                                    <span class="text-success fw-semibold">@item.TotalQuantityCompleted completed</span> &middot;
                                    <span class="text-warning fw-semibold">@item.TotalQuantityRemaining remaining</span>
                                </div>
                            </div>

                            @if (item.ProductConfigured)
                            {
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                                   class="btn btn-outline-primary btn-sm px-3"
                                   title="Open Product Info for @item.ItemCode">
                                    <i class="bi bi-box-seam me-1"></i> Product Info
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Product" asp-action="Create" asp-route-productCode="@item.ItemCode"
                                   class="btn btn-warning btn-sm px-3"
                                   title="Create product definition for @item.ItemCode">
                                    <i class="bi bi-plus-circle me-1"></i> Create Product
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Progress Bar across all BMs -->
                    <div class="progress mt-3" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <!-- Jobs Table for this Item Code across all BMs -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 130px;">Job No</th>
                                    <th>Source BM Workbook</th>
                                    <th class="text-center" style="width: 120px;">Qty Required</th>
                                    <th class="text-center" style="width: 120px;">Qty Completed</th>
                                    <th style="width: 130px;">Priority</th>
                                    <th style="width: 130px;">Due Date</th>
                                    <th style="width: 120px;">Status</th>
                                    <th>Assigned Worker</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in item.Jobs)
                                {
                                    var jobPri = (int)job.Priority;
                                    <tr class="@(jobPri == 1 ? "table-active" : "")">
                                        <td>
                                            <code>@job.JobNo</code>
                                        </td>
                                        <td>
                                            @if (job.BmUploadId.HasValue && !string.IsNullOrEmpty(job.BmFileName))
                                            {
                                                <a asp-action="Preview" asp-route-id="@job.BmUploadId.Value"
                                                   class="text-decoration-none text-body"
                                                   title="View BM workbook preview">
                                                    <i class="bi bi-file-earmark-spreadsheet text-success me-1"></i>@job.BmFileName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="bi bi-file-earmark me-1"></i>@(job.BmFileName ?? "Manual job")</span>
                                            }
                                        </td>
                                        <td class="text-center fw-semibold num">@job.Quantity</td>
                                        <td class="text-center num">
                                            @if (job.QuantityCompleted >= job.Quantity)
                                            {
                                                <span class="badge bg-success-subtle text-success">@job.QuantityCompleted</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@job.QuantityCompleted</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge-priority badge-pri-@jobPri">
                                                <i class="bi @priorityIcons[jobPri]"></i> @jobPri @priorityLabels[jobPri]
                                            </span>
                                        </td>
                                        <td>
                                            @(job.DueDate?.ToString("dd MMM yyyy") ?? "—")
                                        </td>
                                        <td>
                                            <span class="badge-status @WorkloadByItemViewModel.StatusBadgeClass(job.Status)">@job.Status</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(job.AssignedWorkerName))
                                            {
                                                <span><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Open (Unassigned)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}
