@model SmartTorque.Web.ViewModels.Bm.BmIndexViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "BM import";
    ViewData["ActiveNav"] = "Workload";
}

@if (TempData["Success"] != null)
{
    <div class="alert-inline success mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-inline error mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Header -->
<div class="mb-4">
    <h1 class="h4 fw-bold mb-0">BM import</h1>
    <p class="text-muted small mb-0">
        Upload the supplier's BM workbook. Rows are parsed and checked here first —
        nothing becomes a job until the import is confirmed.
    </p>
</div>

<div class="row g-4">
    <!-- Upload -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Upload workbook</div>
            <div class="card-body">
                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="bm-upload-form">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small mb-1" for="file">
                            Workbook <span class="text-danger">*</span>
                        </label>
                        <input type="file" name="file" id="file" accept=".xlsx" class="form-control" required />
                        <div class="text-muted" style="font-size:.8rem">
                            .xlsx only, up to 10 MB. Headings are matched against the
                            configured header map; a colour legend is shown below.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" id="btn-upload-bm">
                        <i class="bi bi-upload me-1"></i> Upload and preview
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Legend + recent uploads -->
    <div class="col-lg-7">
        @await Html.PartialAsync("_ColourLegend", Model.Legend)

        <div class="card">
            <div class="card-header">Recent uploads</div>
            <div class="card-body p-0">
                @if (!Model.HasUploads)
                {
                    <div class="text-center text-muted py-5" id="bm-uploads-empty">
                        <i class="bi bi-file-earmark-spreadsheet" style="font-size:2.5rem;color:var(--border)"></i>
                        <p class="mt-2 mb-0 fw-semibold">No workbooks uploaded yet</p>
                        <p class="small mb-0">Upload a .xlsx to see it listed here.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0" id="bm-uploads-table">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Uploaded</th>
                                <th class="text-center">Rows</th>
                                <th class="text-center">Errors</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.RecentUploads)
                            {
                                var badge = u.Status switch
                                {
                                    BmUploadStatus.Previewed => "badge-onhold",
                                    BmUploadStatus.Confirmed => "badge-completed",
                                    BmUploadStatus.Failed => "badge-rework",
                                    _ => "badge-pending"
                                };
                                var label = u.Status.ToString();

                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                                        @u.FileName
                                    </td>
                                    <td class="small">
                                        @u.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                        <div class="text-muted">@u.UploadedBy</div>
                                    </td>
                                    <td class="num text-center">@u.RowCount</td>
                                    <td class="num text-center">@u.ErrorCount</td>
                                    <td><span class="badge-status @badge">@label</span></td>
                                    <td class="text-end">
                                        <a asp-action="Preview" asp-route-id="@u.UploadId"
                                           class="btn btn-sm btn-secondary" id="btn-open-@u.UploadId">
                                            <i class="bi bi-eye"></i> Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Column Mapping before rendering Excel -->
<div class="modal fade" id="columnMappingModal" tabindex="-1" aria-labelledby="columnMappingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="columnMappingModalLabel">
                    <i class="bi bi-layout-three-columns me-2 text-primary"></i>BM Column Mapping
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Found the Item Code column automatically. Please confirm the <strong>Description</strong> column before rendering the BM preview.
                </p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold" for="modalItemCode">
                        Item Code Column <span class="badge bg-success ms-1">Detected</span>
                    </label>
                    <select id="modalItemCode" class="form-select"></select>
                    <div class="text-muted" style="font-size:.8rem">Common column name for product code in all BMs.</div>
                </div>

                <div class="mb-3 p-3 rounded" style="background:var(--bg-subtle);border:1px solid var(--border)">
                    <label class="form-label small fw-bold text-primary" for="modalDescription">
                        <i class="bi bi-card-text me-1"></i> Description Column <span class="text-danger">*</span>
                    </label>
                    <select id="modalDescription" class="form-select" required></select>
                    <div class="text-muted mt-1" style="font-size:.8rem">Select the description heading (e.g. <code>Finished Good Item Desc</code>).</div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold" for="modalQuantity">Quantity Column</label>
                        <select id="modalQuantity" class="form-select"></select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold" for="modalDueDate">Due Date Column</label>
                        <select id="modalDueDate" class="form-select"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-modal-render">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Render BM Preview
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('file');
            const form = document.getElementById('bm-upload-form');
            const modalEl = document.getElementById('columnMappingModal');
            let mappingModal = null;
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                mappingModal = new bootstrap.Modal(modalEl);
            }

            const itemCodeSelect = document.getElementById('modalItemCode');
            const descSelect = document.getElementById('modalDescription');
            const qtySelect = document.getElementById('modalQuantity');
            const dueSelect = document.getElementById('modalDueDate');
            const btnRender = document.getElementById('btn-modal-render');

            let headersInspected = false;

            fileInput.addEventListener('change', function () {
                headersInspected = false;
                if (!fileInput.files || fileInput.files.length === 0) return;

                const file = fileInput.files[0];
                const formData = new FormData();
                formData.append('file', file);

                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                // Call inspection endpoint to discover columns
                fetch('@Url.Action("InspectHeaders")', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (!data.success || !data.headers || data.headers.length === 0) return;

                    headersInspected = true;

                    // Populate dropdowns
                    function populate(selectEl, selectedVal) {
                        selectEl.innerHTML = '';
                        data.headers.forEach(h => {
                            const opt = document.createElement('option');
                            opt.value = h;
                            opt.textContent = h;
                            if (h.toLowerCase() === (selectedVal || '').toLowerCase()) {
                                opt.selected = true;
                            }
                            selectEl.appendChild(opt);
                        });
                    }

                    populate(itemCodeSelect, data.itemCodeColumn);
                    populate(descSelect, data.suggestedDescription);
                    populate(qtySelect, data.suggestedQuantity);
                    populate(dueSelect, data.suggestedDueDate);

                    if (mappingModal) {
                        mappingModal.show();
                    }
                })
                .catch(err => {
                    console.error('Column inspection error:', err);
                });
            });

            form.addEventListener('submit', function (e) {
                // If modal has not confirmed column mapping yet, open modal
                if (headersInspected && !form.querySelector('input[name="descriptionColumn"]')) {
                    e.preventDefault();
                    if (mappingModal) mappingModal.show();
                }
            });

            btnRender.addEventListener('click', function () {
                // Add hidden fields with chosen columns to form and submit
                function setHidden(name, val) {
                    let hidden = form.querySelector(`input[name="${name}"]`);
                    if (!hidden) {
                        hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = name;
                        form.appendChild(hidden);
                    }
                    hidden.value = val;
                }

                setHidden('itemCodeColumn', itemCodeSelect.value);
                setHidden('descriptionColumn', descSelect.value);
                setHidden('quantityColumn', qtySelect.value);
                setHidden('dueDateColumn', dueSelect.value);

                if (mappingModal) mappingModal.hide();
                form.submit();
            });
        });
    </script>
}
