@model SmartTorque.Web.ViewModels.Bm.BmIndexViewModel

@using SmartTorque.Core.Enums

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "Order Creation";

    ViewData["ActiveNav"] = "Workload";

}



@if (TempData["Success"] != null)

{

    <div class="alert-inline success mb-4" role="alert">

        <i class="bi bi-check-circle-fill"></i>

        <span>@TempData["Success"]</span>

    </div>

}



@if (TempData["Error"] != null)

{

    <div class="alert-inline error mb-4" role="alert">

        <i class="bi bi-exclamation-octagon-fill"></i>

        <span>@TempData["Error"]</span>

    </div>

}



@await Html.PartialAsync("_BmSubNav", "Uploads")



<div class="row g-4">

    <!-- Upload & Manual Creation Column -->

    <div class="col-lg-5">

        <!-- 1. Bulk Upload Workbook Card -->

        <div class="card mb-4 shadow-sm border">

            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2.5">

                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-file-earmark-spreadsheet text-primary"></i>

                    <span class="fw-bold text-dark">Bulk Order Import</span>

                </div>

                <span class="badge bg-secondary-subtle text-secondary small">Excel / .xlsx</span>

            </div>

            <div class="card-body p-3">

                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="bm-upload-form">

                    @Html.AntiForgeryToken()



                    <div class="mb-3">

                        <label class="form-label small fw-semibold mb-1" for="file">

                            Order Sheet File <span class="text-danger">*</span>

                        </label>

                        <input type="file" name="file" id="file" accept=".xlsx" class="form-control" required />

                        <div class="text-muted mt-1" style="font-size:.8rem">

                            .xlsx only, up to 10 MB. Headings are matched against the configured header map; priority colour legend is shown on the right.

                        </div>

                    </div>



                    <button type="submit" class="btn btn-primary w-100" id="btn-upload-bm">

                        <i class="bi bi-upload me-1"></i> Upload and Preview Orders

                    </button>

                </form>

            </div>

        </div>



        <!-- 2. Create Individual Workload Card -->

        <div class="card shadow-sm border" id="create-workload-card">

            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2.5">

                <div class="d-flex align-items-center gap-2">

                    <span class="rounded p-1 bg-primary-subtle text-primary d-inline-flex">

                        <i class="bi bi-plus-circle-fill"></i>

                    </span>

                    <span class="fw-bold text-dark">Create Single Manufacturing Order</span>

                </div>

                <span class="badge bg-primary-subtle text-primary" style="font-size:0.75rem">Direct Entry</span>

            </div>

            <div class="card-body p-3">

                <p class="text-muted small mb-3">

                    Add a single manufacturing order directly. Form fields align with production order parameters to maintain full data consistency.

                </p>



                <form asp-action="CreateWorkload" method="post" id="create-workload-form">

                    @Html.AntiForgeryToken()



                    <!-- Product / Item Code Selection -->

                    <div class="mb-2">

                        <label class="form-label small fw-semibold mb-1" for="workload-product-code">

                            Product / Item Code <span class="text-danger">*</span>

                        </label>

                        <div class="position-relative" id="product-combo-wrap">
                            <input type="hidden" name="ProductCode" id="workload-product-code-val" />
                            <div class="input-group input-group-sm">
                                <input type="text" id="workload-product-code-search"
                                       class="form-control form-control-sm"
                                       placeholder="-- Select or type to search --"
                                       autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                        id="product-combo-toggle" tabindex="-1">
                                    <i class="bi bi-chevron-down" id="product-combo-chevron"></i>
                                </button>
                            </div>
                            <ul id="product-combo-list"
                                class="list-unstyled mb-0 shadow border rounded bg-white position-absolute w-100 d-none"
                                style="max-height:220px;overflow-y:auto;z-index:1055;top:100%;left:0;">
                            </ul>
                            <script id="product-combo-data" type="application/json">
                            [
                            @foreach (var prod in Model.AvailableProducts)
                            {
                                <text>{"c":"@Html.Raw(System.Text.Json.JsonEncodedText.Encode(prod.ProductCode))","n":"@Html.Raw(System.Text.Json.JsonEncodedText.Encode(prod.Name))","lid":@(prod.DefaultAssemblyLineId ?? 0)},</text>
                            }
                            {"c":"","n":"","lid":0}
                            ]
                            </script>
                        </

                        <div class="text-muted mt-0.5" id="workload-product-hint" style="font-size:0.72rem">

                            Default assembly line will be mapped automatically.

                        </div>

                    </div>



                    <!-- Quantity & Due Date -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-quantity">

                                Quantity <span class="text-danger">*</span>

                            </label>

                            <input type="number" name="Quantity" id="workload-quantity" class="form-control form-control-sm" min="1" max="100000" value="1" required />

                            <div class="text-muted" style="font-size:0.7rem">Unit tokens generated automatically.</div>

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-duedate">

                                Due Date

                            </label>

                            <input type="date" name="DueDate" id="workload-duedate" class="form-control form-control-sm" />

                        </div>

                    </div>



                    <!-- Priority Level with BM Colour styling -->

                    <div class="mb-2">

                        <label class="form-label small fw-semibold mb-1" for="workload-priority">

                            Priority / Priority Colour <span class="text-danger">*</span>

                        </label>

                        <select name="Priority" id="workload-priority" class="form-select form-select-sm" required>

                            <option value="1" style="background:#0f172a;color:#fff;font-weight:bold;">● Black — Critical (Urgent production first)</option>

                            <option value="2" style="background:#fee2e2;color:#991b1b;font-weight:bold;">▲ Red — High Priority</option>

                            <option value="3" style="background:#fef9c3;color:#854d0e;font-weight:bold;">◆ Yellow — Medium Priority</option>

                            <option value="4" style="background:#dcfce7;color:#166534;font-weight:bold;">■ Green — Normal</option>

                            <option value="5" style="background:#dbeafe;color:#1e40af;font-weight:bold;">⬢ Blue — Standard</option>

                            <option value="6" selected>○ White — Routine</option>

                        </select>

                        <div class="text-muted" style="font-size:0.7rem">

                            Matches priority colour legend and auto-prioritizes in production dispatch.

                        </div>

                    </div>



                    <!-- Sales Order & Purchase Order (PO No) -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-salesorder">

                                Sales Order

                            </label>

                            <input type="text" name="SalesOrder" id="workload-salesorder" class="form-control form-control-sm" placeholder="e.g. 1200|UOE004006|20" />

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-pono">

                                PO Number

                            </label>

                            <input type="text" name="PONo" id="workload-pono" class="form-control form-control-sm" placeholder="e.g. S7A021822" />

                        </div>

                    </div>



                    <!-- Assembly Line & Assigned Worker -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-assembly-line">

                                Assembly Line

                            </label>

                            <select name="AssemblyLineId" id="workload-assembly-line" class="form-select form-select-sm">

                                <option value="">— Unassigned Line —</option>

                                @foreach (var line in Model.AvailableAssemblyLines)

                                {

                                    <option value="@line.AssemblyLineId">@line.AssemblyName @(!string.IsNullOrEmpty(line.Department) ? $"({line.Department})" : "")</option>

                                }

                            </select>

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-semibold mb-1" for="workload-worker">

                                Assigned Worker

                            </label>

                            <select name="AssignedWorkerId" id="workload-worker" class="form-select form-select-sm">

                                <option value="">— Open / Unassigned —</option>

                                @foreach (var w in Model.AvailableWorkers)

                                {

                                    <option value="@w.Value">@w.Text</option>

                                }

                            </select>

                        </div>

                    </div>



                    <!-- Remarks & Estimated Workload -->

                    <div class="row g-2 mb-3">

                        <div class="col-8">

                            <label class="form-label small fw-semibold mb-1" for="workload-remarks">

                                Remarks / Description

                            </label>

                            <input type="text" name="Remarks" id="workload-remarks" class="form-control form-control-sm" placeholder="e.g. Finished Good Item Desc or notes" />

                        </div>

                        <div class="col-4">

                            <label class="form-label small fw-semibold mb-1" for="workload-workload-units">

                                Workload Units

                            </label>

                            <input type="number" step="0.1" min="0.1" max="100.0" name="EstimatedWorkload" id="workload-workload-units" class="form-control form-control-sm" value="1.0" />

                        </div>

                    </div>



                    <button type="submit" class="btn btn-primary w-100 fw-semibold py-2" id="btn-submit-manual-workload">

                        <i class="bi bi-plus-lg me-1"></i> Create Manufacturing Order

                    </button>

                </form>

            </div>

        </div>

    </div>



    <!-- Legend + recent uploads -->

    <div class="col-lg-7">

        @await Html.PartialAsync("_ColourLegend", Model.Legend)



        <div class="card">

            <div class="card-header">Recent Order Uploads</div>

            <div class="card-body p-0">

                @if (!Model.HasUploads)

                {

                    <div class="text-center text-muted py-5" id="bm-uploads-empty">

                        <i class="bi bi-file-earmark-spreadsheet" style="font-size:2.5rem;color:var(--border)"></i>

                        <p class="mt-2 mb-0 fw-semibold">No order sheets uploaded yet</p>

                        <p class="small mb-0">Upload a .xlsx to see it listed here.</p>

                    </div>

                }

                else

                {

                    <table class="table table-hover mb-0" id="bm-uploads-table">

                        <thead>

                            <tr>

                                <th>Order File</th>

                                <th>Uploaded</th>

                                <th class="text-center">Rows</th>

                                <th class="text-center">Errors</th>

                                <th>Status</th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var u in Model.RecentUploads)

                            {

                                var badge = u.Status switch

                                {

                                    BmUploadStatus.Previewed => "badge-onhold",

                                    BmUploadStatus.Confirmed => "badge-completed",

                                    BmUploadStatus.Failed => "badge-rework",

                                    _ => "badge-pending"

                                };

                                var label = u.Status.ToString();



                                <tr>

                                    <td>

                                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>

                                        @u.FileName

                                    </td>

                                    <td class="small">

                                        @u.UploadedAt.ToIstString("dd MMM yyyy HH:mm")

                                        <div class="text-muted">@u.UploadedBy</div>

                                    </td>

                                    <td class="num text-center">@u.RowCount</td>

                                    <td class="num text-center">@u.ErrorCount</td>

                                    <td><span class="badge-status @badge">@label</span></td>

                                    <td class="text-end">

                                        <a asp-action="Preview" asp-route-id="@u.UploadId"

                                           class="btn btn-sm btn-secondary" id="btn-open-@u.UploadId">

                                            <i class="bi bi-eye"></i> Open

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                }

            </div>

        </div>

    </div>

</div>



<!-- Modal: Column Mapping before rendering Excel -->

<div class="modal fade" id="columnMappingModal" tabindex="-1" aria-labelledby="columnMappingModalLabel" aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="columnMappingModalLabel">

                    <i class="bi bi-layout-three-columns me-2 text-primary"></i>Order Column Mapping

                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>

            <div class="modal-body">

                <p class="text-muted small mb-3">

                    Found the Item Code column automatically. Please confirm the <strong>Description</strong> column before rendering the order preview.

                </p>



                <div class="mb-3">

                    <label class="form-label small fw-semibold" for="modalItemCode">

                        Item Code Column <span class="badge bg-success ms-1">Detected</span>

                    </label>

                    <select id="modalItemCode" class="form-select"></select>

                    <div class="text-muted" style="font-size:.8rem">Common column name for product code in order sheets.</div>

                </div>



                <div class="mb-3 p-3 rounded" style="background:var(--bg-subtle);border:1px solid var(--border)">

                    <label class="form-label small fw-bold text-primary" for="modalDescription">

                        <i class="bi bi-card-text me-1"></i> Description Column <span class="text-danger">*</span>

                    </label>

                    <select id="modalDescription" class="form-select" required></select>

                    <div class="text-muted mt-1" style="font-size:.8rem">Select the description heading (e.g. <code>Finished Good Item Desc</code>).</div>

                </div>



                <div class="row g-2 mb-2">

                    <div class="col-6">

                        <label class="form-label small fw-semibold" for="modalQuantity">Quantity Column</label>

                        <select id="modalQuantity" class="form-select"></select>

                    </div>

                    <div class="col-6">

                        <label class="form-label small fw-semibold" for="modalDueDate">Due Date Column</label>

                        <select id="modalDueDate" class="form-select"></select>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

                <button type="button" class="btn btn-primary" id="btn-modal-render">

                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Render Order Preview

                </button>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            const fileInput = document.getElementById('file');

            const form = document.getElementById('bm-upload-form');

            const modalEl = document.getElementById('columnMappingModal');

            let mappingModal = null;

            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {

                mappingModal = new bootstrap.Modal(modalEl);

            }



            const itemCodeSelect = document.getElementById('modalItemCode');

            const descSelect = document.getElementById('modalDescription');

            const qtySelect = document.getElementById('modalQuantity');

            const dueSelect = document.getElementById('modalDueDate');

            const btnRender = document.getElementById('btn-modal-render');



            let headersInspected = false;



            fileInput.addEventListener('change', function () {

                headersInspected = false;

                if (!fileInput.files || fileInput.files.length === 0) return;



                const file = fileInput.files[0];

                const formData = new FormData();

                formData.append('file', file);



                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');

                if (tokenInput) {

                    formData.append('__RequestVerificationToken', tokenInput.value);

                }



                // Call inspection endpoint to discover columns

                fetch('@Url.Action("InspectHeaders")', {

                    method: 'POST',

                    body: formData

                })

                .then(r => r.json())

                .then(data => {

                    if (!data.success || !data.headers || data.headers.length === 0) return;



                    headersInspected = true;



                    // Populate dropdowns

                    function populate(selectEl, selectedVal) {

                        selectEl.innerHTML = '';

                        data.headers.forEach(h => {

                            const opt = document.createElement('option');

                            opt.value = h;

                            opt.textContent = h;

                            if (h.toLowerCase() === (selectedVal || '').toLowerCase()) {

                                opt.selected = true;

                            }

                            selectEl.appendChild(opt);

                        });

                    }



                    populate(itemCodeSelect, data.itemCodeColumn);

                    populate(descSelect, data.suggestedDescription);

                    populate(qtySelect, data.suggestedQuantity);

                    populate(dueSelect, data.suggestedDueDate);



                    if (mappingModal) {

                        mappingModal.show();

                    }

                })

                .catch(err => {

                    console.error('Column inspection error:', err);

                });

            });



            form.addEventListener('submit', function (e) {

                // If modal has not confirmed column mapping yet, open modal

                if (headersInspected && !form.querySelector('input[name="descriptionColumn"]')) {

                    e.preventDefault();

                    if (mappingModal) mappingModal.show();

                }

            });



            btnRender.addEventListener('click', function () {

                // Add hidden fields with chosen columns to form and submit

                function setHidden(name, val) {

                    let hidden = form.querySelector(`input[name="${name}"]`);

                    if (!hidden) {

                        hidden = document.createElement('input');

                        hidden.type = 'hidden';

                        hidden.name = name;

                        form.appendChild(hidden);

                    }

                    hidden.value = val;

                }



                setHidden('itemCodeColumn', itemCodeSelect.value);

                setHidden('descriptionColumn', descSelect.value);

                setHidden('quantityColumn', qtySelect.value);

                setHidden('dueDateColumn', dueSelect.value);



                if (mappingModal) mappingModal.hide();

                form.submit();

            });

            // Product selection auto-fills default assembly line and remarks

            // Searchable product combobox
            (function () {
                var dataEl   = document.getElementById('product-combo-data');
                var searchEl = document.getElementById('workload-product-code-search');
                var valEl    = document.getElementById('workload-product-code-val');
                var list     = document.getElementById('product-combo-list');
                var toggle   = document.getElementById('product-combo-toggle');
                var chevron  = document.getElementById('product-combo-chevron');
                if (!dataEl || !searchEl || !valEl || !list) return;

                var products = JSON.parse(dataEl.textContent).filter(function(p){ return p.c !== ''; });
                var selectedItem = null;

                function esc(s) { var d=document.createElement('div'); d.textContent=String(s); return d.innerHTML; }

                function applySelection(item) {
                    selectedItem = item;
                    valEl.value    = item ? item.c : '';
                    searchEl.value = item ? item.c + ' - ' + item.n : '';
                    searchEl.classList.remove('is-invalid');
                    closeList();
                    var lineSelect   = document.getElementById('workload-assembly-line');
                    var remarksInput = document.getElementById('workload-remarks');
                    if (item && item.lid > 0 && lineSelect) lineSelect.value = item.lid;
                    if (item && item.n && remarksInput && !remarksInput.value) remarksInput.value = item.n;
                }

                function renderList(q) {
                    var lower    = (q || '').toLowerCase();
                    var filtered = lower
                        ? products.filter(function(p){ return (p.c + ' ' + p.n).toLowerCase().indexOf(lower) >= 0; })
                        : products;
                    list.innerHTML = '';
                    if (!filtered.length) {
                        var li = document.createElement('li');
                        li.className = 'px-3 py-2 text-muted small';
                        li.textContent = 'No products found';
                        list.appendChild(li);
                        return;
                    }
                    filtered.slice(0, 150).forEach(function(p) {
                        var isSelected = selectedItem && selectedItem.c === p.c;
                        var li = document.createElement('li');
                        li.style.cssText = 'cursor:pointer;font-size:0.85rem;padding:6px 12px;';
                        if (isSelected) { li.style.background = '#0d6efd'; li.style.color = '#fff'; }
                        li.innerHTML = '<strong>' + esc(p.c) + '</strong> <span style="opacity:.75">' + esc(p.n) + '</span>';
                        li.addEventListener('mouseover', function(){ if (!isSelected) li.style.background='#f0f0f0'; });
                        li.addEventListener('mouseout',  function(){ if (!isSelected) li.style.background=''; });
                        li.addEventListener('mousedown', function(e){ e.preventDefault(); applySelection(p); });
                        list.appendChild(li);
                    });
                }

                function openList()  { renderList(selectedItem ? '' : searchEl.value); list.classList.remove('d-none'); if(chevron){chevron.className='bi bi-chevron-up';} }
                function closeList() { list.classList.add('d-none'); if(chevron){chevron.className='bi bi-chevron-down';} }

                searchEl.addEventListener('focus', openList);
                searchEl.addEventListener('input', function() {
                    selectedItem = null; valEl.value = '';
                    renderList(searchEl.value);
                    list.classList.remove('d-none');
                });
                searchEl.addEventListener('blur', function() {
                    setTimeout(function() {
                        closeList();
                        if (!valEl.value) searchEl.value = '';
                    }, 160);
                });
                if (toggle) toggle.addEventListener('mousedown', function(e) {
                    e.preventDefault();
                    if (list.classList.contains('d-none')) { searchEl.focus(); openList(); } else { closeList(); }
                });
                // Form submit validation
                var frm = document.getElementById('create-workload-form');
                if (frm) frm.addEventListener('submit', function(e) {
                    if (!valEl.value) { e.preventDefault(); searchEl.classList.add('is-invalid'); searchEl.focus(); }
                });
            })();

        });

    </script>

}

