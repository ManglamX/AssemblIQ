@model SmartTorque.Web.Controllers.JobAllocationViewModel
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_WorkerLayout";
    ViewData["Title"] = "Job Allocation";
    ViewData["ActiveNav"] = "JobAllocation";
}

<div class="container-fluid px-4 py-3">
    <!-- Header with Department Scoping & Action Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-person-lines-fill me-1"></i>Job Allocation &amp; Worker Dispatch
                </span>
                <span class="text-muted small">Department: <strong>@(string.IsNullOrEmpty(Model.CurrentDepartmentName) ? "All Departments" : Model.CurrentDepartmentName)</strong></span>
            </div>
            <h1 class="h4 fw-bold text-dark mb-0">Shop Floor Job Allocation &amp; Worker Dispatch</h1>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model.AvailableDepartments.Count > 1)
            {
                <form method="get" action="/Supervisor/JobAllocation" class="d-flex align-items-center gap-2">
                    <label for="deptSelect" class="form-label mb-0 small fw-semibold text-secondary">Department:</label>
                    <select name="departmentId" id="deptSelect" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 200px;">
                        @foreach (var dept in Model.AvailableDepartments)
                        {
                            <option value="@dept.DepartmentId" selected="@(dept.DepartmentId == Model.CurrentDepartmentId)">
                                @dept.Name
                            </option>
                        }
                    </select>
                </form>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SupervisorLineName))
    {
        <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm border-start border-4 border-info">
            <i class="bi bi-info-circle-fill fs-5 text-info"></i>
            <div>
                <strong>Line Supervisor View:</strong> Showing orders allocated to <strong>@Model.SupervisorLineName</strong>. Assign available workers on your line or from the free worker pool to dispatch operations.
            </div>
        </div>
    }

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Unallocated Jobs</div>
                        <div class="h3 fw-bold text-warning mb-0">@Model.UnallocatedJobs.Count</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-inbox fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Active Dispatched Jobs</div>
                        <div class="h3 fw-bold text-primary mb-0">@Model.AllocatedJobs.Count</div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-play-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Active Line Workers</div>
                        <div class="h3 fw-bold text-success mb-0">@Model.Workers.Count</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Active Workload</div>
                        <div class="h3 fw-bold text-secondary mb-0">
                            @Model.AllocatedJobs.Sum(j => j.EstimatedWorkload).ToString("0.0") <span class="fs-6 text-muted">pts</span>
                        </div>
                    </div>
                    <div class="bg-secondary-subtle text-secondary p-3 rounded-circle">
                        <i class="bi bi-speedometer2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Workspace: Unallocated Jobs (Left 50%) vs Workers & Lines (Right 50%) -->
    <div class="row g-4">
        <!-- Left: Unallocated Jobs Queue -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm bg-white rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="h6 fw-bold text-dark mb-0">
                        <i class="bi bi-inbox-fill text-warning me-2"></i>Unallocated Work Queue
                    </h5>
                    <span class="badge bg-warning text-dark">@Model.UnallocatedJobs.Count Available</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.UnallocatedJobs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-1 text-success mb-2"></i>
                            <div>All jobs have been dispatched to workers!</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Job &amp; Scope</th>
                                        <th>Target Line</th>
                                        <th>Qty</th>
                                        <th>Priority</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in Model.UnallocatedJobs)
                                    {
                                        var priorityClass = job.Priority switch
                                        {
                                            SmartTorque.Core.Enums.PriorityLevel.Black => "bg-dark text-white",
                                            SmartTorque.Core.Enums.PriorityLevel.Red => "bg-danger text-white",
                                            SmartTorque.Core.Enums.PriorityLevel.Yellow => "bg-warning text-dark",
                                            SmartTorque.Core.Enums.PriorityLevel.Green => "bg-success text-white",
                                            SmartTorque.Core.Enums.PriorityLevel.Blue => "bg-primary text-white",
                                            _ => "bg-light text-dark border"
                                        };

                                        <tr>
                                            <td>
                                                <div class="fw-bold font-monospace small">@job.JobNo</div>
                                                <div class="small text-muted text-truncate" style="max-width: 170px;" title="@job.ProductName">
                                                    @job.ProductName
                                                </div>
                                                @if (job.ScopeType != SmartTorque.Core.Enums.AllocationScopeType.FullProduct && !string.IsNullOrEmpty(job.ScopeSummary))
                                                {
                                                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle mt-1" style="font-size: 0.65rem;">
                                                        <i class="bi bi-layers me-1"></i>@job.ScopeSummary
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.65rem;">
                                                        <i class="bi bi-box me-1"></i>Full Product
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border small">@(job.AssemblyLineName ?? "Line Unassigned")</span>
                                            </td>
                                            <td>
                                                <span class="fw-semibold small">@job.Quantity</span>
                                            </td>
                                            <td>
                                                <span class="badge @priorityClass small px-2 py-1">@job.Priority</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1">
                                                    @if (!Model.IsDepartmentAdmin)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-success py-1 px-2 btn-accept-job"
                                                                data-job-id="@job.JobId"
                                                                data-job-no="@job.JobNo"
                                                                title="Accept and claim this job for myself">
                                                            <i class="bi bi-check-circle me-1"></i>Accept
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-primary py-1 px-2 btn-open-allocate"
                                                            data-job-id="@job.JobId"
                                                            data-job-no="@job.JobNo"
                                                            data-product-name="@job.ProductName"
                                                            data-line-id="@(job.AssemblyLineId ?? 0)"
                                                            title="Dispatch to Department Worker">
                                                        <i class="bi bi-person-plus-fill me-1"></i>Dispatch
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Workers Roster, Line Supervisors & Active Dispatches -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm bg-white rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <ul class="nav nav-pills card-header-pills" id="supervisorTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active py-1 px-3 small fw-semibold" id="workers-tab" data-bs-toggle="pill" data-bs-target="#tabWorkers" type="button">
                                <i class="bi bi-people-fill me-1"></i>@(Model.IsDepartmentAdmin ? "Department Workers" : "Line Workers") (@Model.Workers.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-1 px-3 small fw-semibold" id="allocated-tab" data-bs-toggle="pill" data-bs-target="#tabAllocated" type="button">
                                <i class="bi bi-kanban-fill me-1"></i>Dispatched Jobs (@Model.AllocatedJobs.Count)
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-0 tab-content">
                    <!-- Tab 1: Department Workers Roster (Shop Floor Assembly) -->
                    <div class="tab-pane fade show active" id="tabWorkers" role="tabpanel">
                        @if (Model.Workers.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 mb-2"></i>
                                <div>No approved workers registered in this department yet.</div>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var worker in Model.Workers)
                                {
                                    var loadBadgeClass = worker.CurrentWorkload >= 2.0m ? "bg-danger" : (worker.CurrentWorkload >= 1.0m ? "bg-warning text-dark" : "bg-success");
                                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-person-circle fs-5 text-secondary"></i>
                                                <span class="fw-bold text-dark">@worker.FullName</span>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle small" style="font-size: 0.68rem;">Worker</span>
                                                @if (worker.IsLineSupervisor)
                                                {
                                                    <span class="badge bg-warning text-dark border border-warning-subtle small ms-1" style="font-size: 0.68rem;">
                                                        <i class="bi bi-star-fill me-1 text-dark"></i>Line Lead
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(worker.EmployeeNo))
                                                {
                                                    <span class="badge bg-light text-muted border">@worker.EmployeeNo</span>
                                                }
                                                @if (Model.IsDepartmentAdmin)
                                                {
                                                    <button type="button" class="btn btn-xs @(worker.IsLineSupervisor ? "btn-warning text-dark fw-semibold" : "btn-outline-secondary") btn-toggle-lead py-0 px-2 ms-2"
                                                            data-worker-id="@worker.Id" style="font-size: 0.72rem;">
                                                        <i class="bi @(worker.IsLineSupervisor ? "bi-star-fill" : "bi-star") me-1"></i>@(worker.IsLineSupervisor ? "Lead Assigned" : "Make Lead")
                                                    </button>
                                                }
                                            </div>
                                            <div class="small text-muted">
                                                Line: <strong class="text-dark">@(worker.CurrentAssemblyLineName ?? "Unassigned Line")</strong>
                                                @if (!string.IsNullOrEmpty(worker.WorkStationName))
                                                {
                                                    <span> &bull; Station: <strong class="text-dark">@worker.WorkStationName</strong></span>
                                                }
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <span class="badge @loadBadgeClass px-2 py-1 mb-1">
                                                @worker.CurrentWorkload.ToString("0.0") pts (@worker.ActiveJobCount active)
                                            </span>
                                            <div class="text-muted" style="font-size: 0.75rem;">Capacity: @(worker.CurrentWorkload >= 3.0m ? "Maxed" : "Available")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>



                    <!-- Tab 3: Dispatched Jobs -->
                    <div class="tab-pane fade" id="tabAllocated" role="tabpanel">
                        @if (Model.AllocatedJobs.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-1 mb-2"></i>
                                <div>No active jobs are currently dispatched to workers.</div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Job &amp; Scope</th>
                                            <th>Assigned Worker</th>
                                            <th>Line</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var job in Model.AllocatedJobs)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold font-monospace small">@job.JobNo</div>
                                                    <div class="small text-muted text-truncate" style="max-width: 150px;">@job.ProductName</div>
                                                    @if (job.ScopeType != SmartTorque.Core.Enums.AllocationScopeType.FullProduct && !string.IsNullOrEmpty(job.ScopeSummary))
                                                    {
                                                        <span class="badge bg-purple-subtle text-purple border border-purple-subtle mt-0.5" style="font-size: 0.62rem;">
                                                            @job.ScopeSummary
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-semibold small"><i class="bi bi-person me-1"></i>@job.AssignedWorkerName</div>
                                                    <span class="badge bg-info-subtle text-info small" style="font-size: 0.65rem;">@job.Status</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border small">@(job.AssemblyLineName ?? "Shop Floor")</span>
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 btn-deallocate" data-job-id="@job.JobId" title="Revoke and return to pool">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Revoke
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Dispatch Job to Worker Modal -->
<div class="modal fade" id="dispatchModal" tabindex="-1" aria-labelledby="dispatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title h6 fw-bold" id="dispatchModalLabel">
                    <i class="bi bi-send-check text-primary me-2"></i>Allocate Job to Shop Floor Worker
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modalJobId" />

                <div class="alert alert-light border py-2 px-3 mb-3">
                    <div class="small text-muted">Selected Job:</div>
                    <div class="fw-bold text-dark fs-6" id="modalJobNo"></div>
                    <div class="small text-secondary text-truncate" id="modalProductName"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Assign to Department Worker <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" id="modalWorkerSelect" required>
                        <option value="">-- Select Worker --</option>
                        @if (!Model.IsDepartmentAdmin)
                        {
                            <option value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                                -- Assign to Myself (Line Lead) --
                            </option>
                        }
                        @foreach (var w in Model.Workers)
                        {
                            <option value="@w.Id">
                                @w.FullName (@w.CurrentWorkload.ToString("0.0") pts active)
                            </option>
                        }
                    </select>
                    <div class="form-text text-muted small">@(Model.IsDepartmentAdmin ? "Department workers can be dispatched to any child line or cell." : "Only workers on your line/subcell or free pool workers can be assigned.")</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Assembly Line / Cell</label>
                        <select class="form-select form-select-sm" id="modalLineSelect">
                            <option value="">-- Keep Current Line --</option>
                            @foreach (var l in Model.Lines)
                            {
                                <option value="@l.AssemblyLineId">@l.AssemblyName (@l.AssemblyCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Station / Subcell</label>
                        <select class="form-select form-select-sm" id="modalStationSelect">
                            <option value="">-- Default Station --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnConfirmAllocate">
                    <i class="bi bi-check2-circle me-1"></i>Confirm &amp; Dispatch
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const linesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lines));
            const modalLineSelect = document.getElementById('modalLineSelect');
            const modalStationSelect = document.getElementById('modalStationSelect');

            modalLineSelect.addEventListener('change', function() {
                const lineId = parseInt(this.value, 10);
                modalStationSelect.innerHTML = '<option value="">-- Default Station --</option>';
                if (!lineId) return;

                const selectedLine = linesData.find(l => l.AssemblyLineId === lineId);
                if (selectedLine && selectedLine.Stations) {
                    selectedLine.Stations.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.WorkStationId;
                        opt.textContent = `${s.StationName} (${s.StationCode})`;
                        modalStationSelect.appendChild(opt);
                    });
                }
            });

            // Open Dispatch Modal
            document.querySelectorAll('.btn-open-allocate').forEach(btn => {
                btn.addEventListener('click', function() {
                    const jobId = this.dataset.jobId;
                    const jobNo = this.dataset.jobNo;
                    const prodName = this.dataset.productName;
                    const lineId = parseInt(this.dataset.lineId, 10);

                    document.getElementById('modalJobId').value = jobId;
                    document.getElementById('modalJobNo').textContent = jobNo;
                    document.getElementById('modalProductName').textContent = prodName;

                    if (lineId && lineId > 0) {
                        modalLineSelect.value = lineId;
                        modalLineSelect.dispatchEvent(new Event('change'));
                    }

                    const modal = new bootstrap.Modal(document.getElementById('dispatchModal'));
                    modal.show();
                });
            });

            // Confirm Dispatch Allocation to Worker
            document.getElementById('btnConfirmAllocate').addEventListener('click', async function() {
                const jobId = parseInt(document.getElementById('modalJobId').value, 10);
                const workerId = document.getElementById('modalWorkerSelect').value;
                const lineIdVal = document.getElementById('modalLineSelect').value;
                const stationIdVal = document.getElementById('modalStationSelect').value;

                if (!workerId) {
                    alert('Please select a worker to allocate this job.');
                    return;
                }

                try {
                    const res = await fetch('/Supervisor/AllocateJob', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            jobId,
                            workerId,
                            assemblyLineId: lineIdVal ? parseInt(lineIdVal, 10) : null,
                            workStationId: stationIdVal ? parseInt(stationIdVal, 10) : null
                        })
                    });
                    const json = await res.json();
                    if (json.success) {
                        window.location.reload();
                    } else {
                        alert(json.message);
                    }
                } catch (err) {
                    alert('Error allocating job: ' + err.message);
                }
            });

            // Accept Job (Self-assign)
            document.querySelectorAll('.btn-accept-job').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const jobId = parseInt(this.dataset.jobId, 10);
                    const jobNo = this.dataset.jobNo;
                    if (!confirm('Accept and assign job "' + jobNo + '" to yourself?')) return;

                    try {
                        this.disabled = true;
                        const res = await fetch('/Supervisor/AcceptJob', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ jobId })
                        });
                        const json = await res.json();
                        if (json.success) {
                            window.location.reload();
                        } else {
                            alert(json.message);
                            this.disabled = false;
                        }
                    } catch (err) {
                        alert('Error accepting job: ' + err.message);
                        this.disabled = false;
                    }
                });
            });

            // Toggle Lead Supervisor from Workers list
            document.querySelectorAll('.btn-toggle-lead').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const workerId = this.dataset.workerId;
                    try {
                        this.disabled = true;
                        const res = await fetch('/Supervisor/ToggleSupervisorStatus', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ workerId })
                        });
                        const json = await res.json();
                        if (json.success) {
                            window.location.reload();
                        } else {
                            alert(json.message);
                            this.disabled = false;
                        }
                    } catch (err) {
                        alert('Error updating supervisor status: ' + err.message);
                        this.disabled = false;
                    }
                });
            });

            // Deallocate / Revoke Job
            document.querySelectorAll('.btn-deallocate').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const jobId = parseInt(this.dataset.jobId, 10);
                    if (!confirm('Revoke this job and return it to the unallocated pool?')) return;

                    try {
                        const res = await fetch('/Supervisor/DeallocateJob', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ jobId })
                        });
                        const json = await res.json();
                        if (json.success) {
                            window.location.reload();
                        } else {
                            alert(json.message);
                        }
                    } catch (err) {
                        alert('Error revoking job: ' + err.message);
                    }
                });
            });

        })();
    </script>
}
