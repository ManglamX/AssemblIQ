@model SmartTorque.Web.ViewModels.User.UserListViewModel

@using SmartTorque.Core.Enums

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "User & Access Approvals";

    ViewData["ActiveNav"] = "Users";

}



<div class="container-fluid px-3 py-2">

    <!-- Header -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div>

            <h1 class="h4 fw-bold mb-1">User &amp; Access Management</h1>

            <p class="text-muted small mb-0">Review worker and admin registration requests, verify plant hierarchy placement, and manage access.</p>

        </div>



        <!-- Plant Head / Admin Department Filter -->

        <div class="d-flex align-items-center gap-2">

            @if (Model.IsPlantHead)

            {

                <form method="get" action="@Url.Action("Index", "User")" class="d-flex align-items-center gap-2">

                    <input type="hidden" name="filter" value="@Model.ActiveFilter" />

                    <label for="deptSelect" class="form-label small fw-semibold text-secondary mb-0 text-nowrap">

                        <i class="bi bi-funnel-fill text-primary me-1"></i>Plant Department:

                    </label>

                    <select id="deptSelect" name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width: 200px;">

                        <option value="">All Departments (Plant Overview)</option>

                        @foreach (var d in Model.AvailableDepartments)

                        {

                            <option value="@d.Id" selected="@(Model.SelectedDepartmentId == d.Id)">@d.Name (@d.Code)</option>

                        }

                    </select>

                </form>

            }

            else if (!string.IsNullOrEmpty(Model.CurrentUserDepartmentName))

            {

                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">

                    <i class="bi bi-building me-1"></i>Dept: <strong>@Model.CurrentUserDepartmentName</strong>

                </span>

            }

        </div>

    </div>



    <!-- Alert Messages -->

    @if (TempData["Success"] != null)

    {

        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">

            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

        </div>

    }

    @if (TempData["Warning"] != null)

    {

        <div class="alert alert-warning alert-dismissible fade show py-2" role="alert">

            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Warning"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

        </div>

    }

    @if (TempData["Error"] != null)

    {

        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">

            <i class="bi bi-x-circle me-1"></i>@TempData["Error"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

        </div>

    }



    <!-- Filter Tabs -->

    <div class="d-flex flex-wrap gap-2 mb-4">

        <a href="@Url.Action("Index", "User", new { filter = "pending", departmentId = Model.SelectedDepartmentId })"

           class="btn btn-sm @(Model.ActiveFilter == "pending" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")">

            <i class="bi bi-hourglass-split me-1"></i>Pending Review

            <span class="badge @(Model.PendingCount > 0 ? "bg-danger text-white" : "bg-secondary text-white") ms-1">@Model.PendingCount</span>

        </a>

        <a href="@Url.Action("Index", "User", new { filter = "workers", departmentId = Model.SelectedDepartmentId })"

           class="btn btn-sm @(Model.ActiveFilter == "workers" ? "btn-primary" : "btn-outline-secondary")">

            <i class="bi bi-wrench me-1"></i>Workers

            <span class="badge bg-light text-dark ms-1">@Model.WorkersCount</span>

        </a>

        <a href="@Url.Action("Index", "User", new { filter = "admins", departmentId = Model.SelectedDepartmentId })"

           class="btn btn-sm @(Model.ActiveFilter == "admins" ? "btn-dark" : "btn-outline-secondary")">

            <i class="bi bi-shield-lock me-1"></i>Administrators

            <span class="badge bg-light text-dark ms-1">@Model.AdminsCount</span>

        </a>

        <a href="@Url.Action("Index", "User", new { filter = "rejected", departmentId = Model.SelectedDepartmentId })"

           class="btn btn-sm @(Model.ActiveFilter == "rejected" ? "btn-danger" : "btn-outline-danger")">

            <i class="bi bi-x-circle me-1"></i>Rejected

            <span class="badge bg-light text-dark ms-1">@Model.RejectedCount</span>

        </a>

        <a href="@Url.Action("Index", "User", new { filter = "all", departmentId = Model.SelectedDepartmentId })"

           class="btn btn-sm @(Model.ActiveFilter == "all" ? "btn-secondary" : "btn-outline-secondary")">

            All Users

            <span class="badge bg-light text-dark ms-1">@Model.TotalCount</span>

        </a>

    </div>



    @if (!Model.Users.Any())

    {

        <div class="text-center py-5 border rounded-3 bg-white text-muted">

            <i class="bi bi-people" style="font-size: 3rem; color: #adb5bd;"></i>

            <h2 class="h5 mt-3 mb-1">No users found</h2>

            <p class="mb-0">There are currently no users matching the selected filter "@Model.ActiveFilter"@(!string.IsNullOrEmpty(Model.CurrentUserDepartmentName) ? $" in department {Model.CurrentUserDepartmentName}" : "").</p>

        </div>

    }

    else if (Model.ActiveFilter == "pending")

    {

        <!-- Pending Approvals Cards Grid -->

        <div class="row g-3">

            @foreach (var user in Model.Users)

            {

                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card border-warning shadow-sm h-100">

                        <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center py-2">

                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending Review</span>

                            <span class="badge bg-dark">Requested: @user.RequestedRole</span>

                        </div>

                        <div class="card-body">

                            <h2 class="h5 fw-bold mb-1">@user.FullName</h2>

                            <div class="text-muted small mb-2">

                                <div><i class="bi bi-envelope me-1"></i>@user.Email</div>

                                @if (!string.IsNullOrEmpty(user.EmployeeNo))

                                {

                                    <div><i class="bi bi-badge-ad me-1"></i>Badge ID: <strong>@user.EmployeeNo</strong></div>

                                }

                                <div><i class="bi bi-calendar3 me-1"></i>Registered: @user.CreatedAt.ToIstString("dd MMM yyyy, HH:mm") IST</div>

                            </div>



                            <!-- Hierarchy Badges -->

                            <div class="p-2 mb-3 bg-light rounded small">

                                <div class="fw-semibold text-secondary mb-1"><i class="bi bi-diagram-3 me-1"></i>Assigned Placement:</div>

                                <div class="d-flex flex-wrap gap-1">

                                    <span class="badge bg-secondary-subtle text-secondary border">Dept: @(user.DepartmentName ?? "Unassigned")</span>

                                    @if (!string.IsNullOrEmpty(user.AssemblyLineName))

                                    {

                                        <span class="badge bg-info-subtle text-info-emphasis border">Line/Cell: @user.AssemblyLineName</span>

                                    }

                                    @if (!string.IsNullOrEmpty(user.WorkStationName))

                                    {

                                        <span class="badge bg-primary-subtle text-primary border">Station: @user.WorkStationName</span>

                                    }

                                </div>

                            </div>



                            <!-- Actions -->
                            <div class="d-flex gap-2 pt-2 border-top">
                                <!-- Approve Form -->
                                <form asp-action="Approve" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="assignedRole" id="assignedRole-@user.Id" value="@user.RequestedRole" />

                                    <div class="btn-group w-100">
                                        <button type="submit" class="btn btn-success btn-sm fw-bold">
                                            <i class="bi bi-check-lg me-1"></i>Approve as @user.RequestedRole
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="Choose Role to Approve">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                            <li>
                                                <button type="submit" class="dropdown-item py-1" onclick="document.getElementById('assignedRole-@user.Id').value='Worker'">
                                                    <i class="bi bi-wrench me-2 text-primary"></i>Approve as Worker
                                                </button>
                                            </li>
                                            <li>
                                                <button type="submit" class="dropdown-item py-1" onclick="document.getElementById('assignedRole-@user.Id').value='Admin'">
                                                    <i class="bi bi-shield-lock me-2 text-dark"></i>Approve as Dept Admin
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </form>

                                <!-- Reject Button triggers modal -->
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@user.Id">
                                    <i class="bi bi-x-lg me-1"></i>Reject
                                </button>
                            </div>

                        </div>

                    </div>

                </div>



                <!-- Reject Reason Modal -->

                <div class="modal fade" id="rejectModal-@user.Id" tabindex="-1" aria-hidden="true">

                    <div class="modal-dialog">

                        <div class="modal-content">

                            <form asp-action="Reject" method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="userId" value="@user.Id" />

                                <div class="modal-header bg-danger text-white">

                                    <h5 class="modal-title fs-6"><i class="bi bi-x-circle me-1"></i>Reject Access: @user.FullName</h5>

                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>

                                </div>

                                <div class="modal-body">

                                    <p class="small text-muted mb-2">

                                        Specify the reason for rejecting <strong>@user.Email</strong>. This reason will be displayed to the user when they check their status.

                                    </p>

                                    <div class="mb-3">

                                        <label class="form-label fw-bold small">Reason for Rejection</label>

                                        <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Employee badge number not recognized in plant records." required></textarea>

                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>

                                    <button type="submit" class="btn btn-danger btn-sm fw-bold">Confirm Rejection</button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            }

        </div>

    }

    else

    {

        <!-- Users Table -->
        <div class="card border shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="table-layout:fixed;width:100%;font-size:0.875rem;">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th style="width:20%;">User Name &amp; Email</th>
                            <th style="width:8%;">Badge / ID</th>
                            <th style="width:12%;">Role</th>
                            <th style="width:15%;">Department &amp; Unit</th>
                            <th style="width:8%;" class="text-center">Station / Subcell</th>
                            <th style="width:9%;" class="text-center">Status</th>
                            <th style="width:28%;" class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" title="@user.FullName">@user.FullName</div>
                                    <div class="text-muted small text-truncate" title="@user.Email">@user.Email</div>
                                </td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrEmpty(user.EmployeeNo))
                                    {
                                        <span class="text-secondary fw-semibold">@user.EmployeeNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        @if (user.IsMainAdmin)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-shield-fill-check me-1"></i>Main Admin</span>
                                        }
                                        else if (user.IsPlantHead)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-person-badge-fill me-1"></i>Plant Head</span>
                                        }
                                        else if (user.CurrentRole == "Admin")
                                        {
                                            <span class="badge bg-dark"><i class="bi bi-shield-lock me-1"></i>Dept Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-wrench me-1"></i>Worker</span>
                                            @if (user.IsLineSupervisor)
                                            {
                                                <span class="badge bg-warning text-dark border border-warning-subtle" title="Designated Line Supervisor">
                                                    <i class="bi bi-star-fill me-1 text-dark"></i>Line Lead
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-secondary text-truncate" title="@user.DepartmentName">@(user.DepartmentName ?? "—")</div>
                                    @if (!string.IsNullOrEmpty(user.AssemblyLineName))
                                    {
                                        <div class="small text-muted text-truncate" title="@user.AssemblyLineName"><i class="bi bi-diagram-2 me-1"></i>@user.AssemblyLineName</div>
                                    }
                                </td>
                                <td class="text-center text-muted">
                                    @(user.WorkStationName ?? "—")
                                </td>
                                <td class="text-center">
                                    @if (user.RegistrationStatus == RegistrationStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    }
                                    else if (user.RegistrationStatus == RegistrationStatus.Rejected)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Deactivated</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap pe-3">
                                    <div class="d-inline-flex gap-2 justify-content-end align-items-center">
                                        @if (user.RegistrationStatus == RegistrationStatus.Pending)
                                        {
                                            <form asp-action="Approve" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="assignedRole" value="@user.RequestedRole" />
                                                <button type="submit" class="btn btn-outline-success btn-sm py-1 px-2" title="Approve">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>
                                        }
                                        else if (user.RegistrationStatus == RegistrationStatus.Approved)
                                        {
                                            @if (user.CurrentRole == "Worker")
                                            {
                                                <form asp-action="ToggleLineSupervisor" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm @(user.IsLineSupervisor ? "btn-warning text-dark fw-semibold" : "btn-outline-secondary") py-1 px-2"
                                                            title="@(user.IsLineSupervisor ? "Revoke Line Supervisor Designation" : "Designate as Line Supervisor for Job Allocation")">
                                                        <i class="bi @(user.IsLineSupervisor ? "bi-star-fill" : "bi-star") me-1"></i>@(user.IsLineSupervisor ? "Lead Assigned" : "Make Lead")
                                                    </button>
                                                </form>
                                            }
                                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success") py-1 px-2">
                                                    @(user.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        }
                                        else if (user.RegistrationStatus == RegistrationStatus.Rejected)
                                        {
                                            <form asp-action="Approve" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="assignedRole" value="@user.RequestedRole" />
                                                <button type="submit" class="btn btn-outline-success btn-sm py-1 px-2" title="Re-approve">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Re-approve
                                                </button>
                                            </form>
                                        }
                                        @if (!user.IsMainAdmin && user.UserName != User?.Identity?.Name)
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete user \'@user.FullName\' (@user.Email)?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete User">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

    }

</div>

