@model SmartTorque.Web.ViewModels.Settings.SettingsIndexViewModel
@using SmartTorque.Services
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Settings";
    ViewData["ActiveNav"] = "Settings";
}

<style>
    .settings-section {
        background: white;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }
    .settings-section-header {
        background: #f9fafb;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }
    .settings-section-body {
        padding: 1.5rem;
    }
    .setting-item {
        padding: 1.25rem;
        border-radius: 8px;
        background: #f9fafb;
        margin-bottom: 1rem;
        border: 1px solid #e5e7eb;
    }
    .setting-item:last-child {
        margin-bottom: 0;
    }
    .setting-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .setting-description {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 0.75rem;
        line-height: 1.5;
    }
    .setting-input-wrapper {
        max-width: 400px;
    }
    .info-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
    }
    .badge-active {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }
    .badge-readonly {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }
</style>

<div class="container-fluid px-3 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-gear-fill me-2 text-primary"></i>System Settings</h1>
            <p class="text-muted small mb-0">Configure application-wide parameters for device management, templates, and data import</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <!-- Device & Connectivity Settings -->
        <div class="settings-section">
            <div class="settings-section-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-router me-2 text-primary"></i>Device & Connectivity</h5>
            </div>
            <div class="settings-section-body">
                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Device Offline Threshold</label>
                        <span class="info-badge badge-active">CONFIGURABLE</span>
                    </div>
                    <div class="setting-description">
                        Time in seconds before a device without heartbeat signals is marked as offline. This affects the online/offline status shown in the Device Management page.
                    </div>
                    <div class="setting-input-wrapper">
                        <div class="input-group">
                            <input asp-for="DeviceOfflineSeconds" type="number" class="form-control"
                                   min="@SettingsService.DeviceOfflineSecondsMin"
                                   max="@SettingsService.DeviceOfflineSecondsMax"
                                   step="1" />
                            <span class="input-group-text">seconds</span>
                        </div>
                        <span asp-validation-for="DeviceOfflineSeconds" class="text-danger small"></span>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i>Recommended: 30-60 seconds (min: @SettingsService.DeviceOfflineSecondsMin, max: @SettingsService.DeviceOfflineSecondsMax)
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Measurement Stability Hold Time</label>
                        <span class="info-badge badge-readonly">DEVICE FIRMWARE</span>
                    </div>
                    <div class="setting-description">
                        Time required for a reading to stabilize before being captured. This value is controlled by the device firmware and cannot be changed from the web interface.
                    </div>
                    <div class="setting-input-wrapper">
                        <div class="form-control-plaintext fw-semibold">@Model.StableHoldMs ms</div>
                        <div class="small text-muted">
                            <i class="bi bi-shield-lock me-1"></i>Configured in device firmware (<code>STABLE_HOLD_MS</code>) to ensure reading integrity
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Template & Product Settings -->
        <div class="settings-section">
            <div class="settings-section-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-layers-fill me-2 text-success"></i>Templates & Products</h5>
            </div>
            <div class="settings-section-body">
                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Default Maximum Retries per Step</label>
                        <span class="info-badge badge-active">CONFIGURABLE</span>
                    </div>
                    <div class="setting-description">
                        Default number of retry attempts allowed for each assembly step when creating new templates. Individual steps can override this value during template creation.
                    </div>
                    <div class="setting-input-wrapper">
                        <div class="input-group">
                            <input asp-for="MaxRetriesDefault" type="number" class="form-control"
                                   min="@SettingsService.MaxRetriesMin"
                                   max="@SettingsService.MaxRetriesMax"
                                   step="1" />
                            <span class="input-group-text">attempts</span>
                        </div>
                        <span asp-validation-for="MaxRetriesDefault" class="text-danger small"></span>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i>Recommended: 3-5 attempts (min: @SettingsService.MaxRetriesMin, max: @SettingsService.MaxRetriesMax)
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Maximum Image Upload Size</label>
                        <span class="info-badge badge-active">CONFIGURABLE</span>
                    </div>
                    <div class="setting-description">
                        Maximum file size allowed for blueprint and component image uploads. Files larger than this limit will be rejected during upload.
                    </div>
                    <div class="setting-input-wrapper">
                        <div class="input-group">
                            <input asp-for="ImageMaxMb" type="number" class="form-control"
                                   min="@SettingsService.ImageMaxMbMin"
                                   max="@SettingsService.ImageMaxMbMax"
                                   step="1" />
                            <span class="input-group-text">MB</span>
                        </div>
                        <span asp-validation-for="ImageMaxMb" class="text-danger small"></span>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i>Recommended: 5-10 MB for high-quality blueprints (min: @SettingsService.ImageMaxMbMin, max: @SettingsService.ImageMaxMbMax)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Import Settings -->
        <div class="settings-section">
            <div class="settings-section-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-spreadsheet-fill me-2 text-warning"></i>Order Data Import</h5>
            </div>
            <div class="settings-section-body">
                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Excel Column Header Mapping</label>
                        <span class="info-badge badge-active">CONFIGURABLE</span>
                    </div>
                    <div class="setting-description">
                        Define how Excel columns from supplier workbooks map to system fields. Column matching is case-insensitive and whitespace-trimmed. Leave empty to use default mappings.
                    </div>
                    <div class="setting-input-wrapper" style="max-width: 100%;">
                        <textarea asp-for="BmHeaderMap" rows="5" class="form-control font-monospace small"
                                  spellcheck="false"
                                  placeholder='{"ProductCode": "Item Code", "Quantity": "Qty", "DueDate": "Due Date"}'></textarea>
                        <span asp-validation-for="BmHeaderMap" class="text-danger small"></span>
                        <div class="small text-muted mt-2">
                            <strong>Example JSON format:</strong><br>
                            <code class="small">@("{ \"ProductCode\": \"Item Code\", \"Quantity\": \"Qty\", \"DueDate\": \"Due Date\", \"Remarks\": \"Remarks\", \"SalesOrder\": \"Sales Order\", \"PONo\": \"PO No\" }")</code>
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-label">
                        <label class="form-label fw-semibold mb-0">Product Color Matching</label>
                        <span class="info-badge badge-readonly">MANAGED SEPARATELY</span>
                    </div>
                    <div class="setting-description">
                        Color tolerance settings are managed on the Color Map page where each shade has its own configurable tolerance value.
                    </div>
                    <div>
                        <a class="btn btn-outline-primary btn-sm" href="/ColourMap">
                            <i class="bi bi-palette me-1"></i>Open Color Map Management
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded">
            <div class="text-muted small">
                <i class="bi bi-shield-check me-1"></i>All changes are logged in the audit trail for security and compliance
            </div>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-circle me-2"></i>Save All Settings
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
