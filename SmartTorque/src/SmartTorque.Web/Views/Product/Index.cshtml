@model SmartTorque.Web.ViewModels.Product.ProductListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
    ViewData["ActiveNav"] = "Products";
}

@if (TempData["Success"] != null)
{
    <div class="alert-inline success mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">
            <span class="tooltip-trigger" data-tooltip="Assemblies built from one or more template components">
                Products
                <i class="bi bi-info-circle tooltip-icon"></i>
            </span>
        </h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!Model.IsPlantHead && !string.IsNullOrEmpty(Model.CurrentUserDepartmentName))
        {
            <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">
                <i class="bi bi-building me-1"></i>Dept: <strong>@Model.CurrentUserDepartmentName</strong>
            </span>
        }
        <a asp-action="Create" class="btn btn-primary" id="btn-new-product">
            <i class="bi bi-plus-lg me-1"></i> New Product
        </a>
    </div>
</div>

<!-- Filters -->
<form method="get" class="card mb-4 p-3" id="filter-form">
    <div class="row g-2 align-items-end">
        <div class="col-sm-5 col-md-4">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Name or code…" value="@Model.Search" id="search-input" />
        </div>
        <div class="col-sm-3 col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select name="active" class="form-select form-select-sm" id="filter-status">
                <option value="">All</option>
                <option value="true" selected="@(Model.ActiveFilter == true)">Active</option>
                <option value="false" selected="@(Model.ActiveFilter == false)">Inactive</option>
            </select>
        </div>
        @if (Model.IsPlantHead)
        {
            <div class="col-sm-4 col-md-3">
                <label class="form-label small mb-1"><i class="bi bi-funnel-fill text-primary me-1"></i>Department</label>
                <select name="departmentId" class="form-select form-select-sm" id="filter-dept">
                    <option value="">All Departments (Plant Overview)</option>
                    @foreach (var d in Model.AvailableDepartments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-secondary btn-sm" id="btn-clear">Clear</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filter-form');
            if (!form) return;
            var searchTimer;
            form.querySelectorAll('select').forEach(function (sel) {
                sel.addEventListener('change', function () { form.submit(); });
            });
            form.querySelectorAll('input[type="text"],input[type="date"]').forEach(function (inp) {
                inp.addEventListener('input', function () {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () { form.submit(); }, 300);
                });
                inp.addEventListener('change', function () {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () { form.submit(); }, 300);
                });
            });
            // Restore focus to search box after page reload
            var firstText = form.querySelector('input[type="text"]');
            if (firstText) {
                firstText.focus();
                var v = firstText.value; firstText.value = ''; firstText.value = v;
            }

            // Delete product handler
            document.querySelectorAll('.btn-delete-product').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var productId = this.dataset.productId;
                    var productName = this.dataset.productName;

                    AppCRUD.confirmDelete({
                        entityType: 'Product',
                        entityName: productName,
                        onConfirm: function () {
                            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                            fetch('/Product/Delete/' + productId, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                }
                            })
                            .then(response => response.json())
                            .then(result => {
                                if (result.success) {
                                    AppCRUD.notify(result.message, 'success');
                                    setTimeout(() => window.location.reload(), 1500);
                                } else {
                                    AppCRUD.notify(result.message, 'error');
                                }
                            })
                            .catch(error => {
                                AppCRUD.notify('An error occurred while deleting the product.', 'error');
                                console.error('Error:', error);
                            });
                        }
                    });
                });
            });
        })();
    </script>
}

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-5" id="products-empty">
                <i class="bi bi-box-seam" style="font-size:2.5rem;color:var(--border)"></i>
                <p class="mt-2 mb-1 fw-semibold">No products found</p>
                <p class="small mb-3">Build your first product from templates.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm" id="btn-empty-create">
                    <i class="bi bi-plus-lg me-1"></i>New Product
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0" id="products-table">
                <thead>
                    <tr>
                        <th>Item Code</th>
                        <th>Product Name</th>
                        <th>Department</th>
                        <th class="text-center">Components</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold"><code>@p.ProductCode</code></td>
                            <td>@p.ProductName</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">@(p.DepartmentName ?? "General")</span>
                            </td>
                            <td class="text-center num">@p.ComponentCount</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge-status badge-completed"><i class="bi bi-circle-fill me-1" style="font-size:8px"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-cancelled">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @if (p.UpdatedAt.HasValue && p.UpdatedAt.Value > p.CreatedAt.AddSeconds(5))
                                {
                                    <span>@p.UpdatedAt.Value.ToIstString("dd MMM yyyy")</span>
                                    <span class="text-primary fw-semibold ms-1">(Edited)</span>
                                }
                                else
                                {
                                    @p.CreatedAt.ToIstString("dd MMM yyyy")
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@p.ProductId"
                                   class="btn btn-sm btn-secondary" id="btn-detail-@p.ProductId" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.ProductId"
                                   class="btn btn-sm btn-secondary ms-1" id="btn-edit-@p.ProductId" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="SetActive" method="post" class="d-inline ms-1" onsubmit="return @(p.IsActive ? $"confirm('Are you sure you want to deactivate product \\'{p.ProductCode}\\'? This will prevent it from being used in new orders.')" : "true");">
                                    <input type="hidden" name="id" value="@p.ProductId" />
                                    <input type="hidden" name="isActive" value="@(!p.IsActive ? "true" : "false")" />
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-secondary")"
                                            id="btn-toggle-@p.ProductId"
                                            title="@(p.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(p.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-danger ms-1 btn-delete-product"
                                        data-product-id="@p.ProductId"
                                        data-product-name="@p.ProductName"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Product pages">
        <small class="text-muted">
            Showing @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
            of @Model.TotalCount products
        </small>
        <ul class="pagination pagination-sm mb-0">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-active="@Model.ActiveFilter"
                       asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
