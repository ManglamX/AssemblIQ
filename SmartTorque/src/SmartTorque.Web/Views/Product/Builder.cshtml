@model SmartTorque.Web.ViewModels.Product.ProductBuilderViewModel
@using SmartTorque.Core.Enums
@using SmartTorque.Web.ViewModels.Product
@{
    Layout = "_AdminLayout";
    bool isEdit = Model.EditingProductId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Product" : "New Product";
    ViewData["ActiveNav"] = "Products";
}

@section HeadLinks {
    <link rel="stylesheet" href="~/lib/cropperjs/cropper.min.css" />
    <style>
        .step-marker {
            position: absolute;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            background: var(--brand, #0284c7);
            border: 2px solid #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.35);
            transition: all 0.15s ease;
            user-select: none;
            z-index: 10;
        }
        .step-marker.marker-active {
            background: #e11d48 !important;
            border-color: #ffe4e6 !important;
            transform: translate(-50%, -50%) scale(1.15);
            box-shadow: 0 0 10px rgba(225, 29, 72, 0.7);
            z-index: 20;
        }
        .step-marker:hover {
            transform: translate(-50%, -50%) scale(1.15);
        }
        .step-row-selected {
            background-color: rgba(2, 132, 199, 0.08) !important;
        }
        .nav-pills .nav-link.active {
            background-color: var(--brand, #0284c7);
        }
        /* Flow Stepper */
        .step-indicator {
            transition: all 0.2s ease;
            border-radius: 10px;
        }
        .step-indicator:hover {
            background: rgba(0,0,0,0.04) !important;
        }
        .step-indicator.active {
            background: rgba(2, 132, 199, 0.08) !important;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-0">@(isEdit ? "Edit Product" : "New Product Creation Flow")</h1>
        <p class="text-muted small mb-0">Integrated flow: New Product &rarr; New Template &rarr; Product Created</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Products
    </a>
</div>

<!-- Progressive Stepper Bar -->
<div class="product-flow-stepper card border-0 shadow-sm mb-4">
    <div class="card-body p-2 p-md-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <!-- Step 1 Indicator -->
            <button type="button" class="btn step-indicator active d-flex align-items-center gap-2 p-2 border-0 bg-transparent text-start" id="step-nav-1" data-step="1">
                <span class="step-num rounded-circle d-flex align-items-center justify-content-center fw-bold bg-primary text-white" style="width:34px;height:34px;font-size:0.95rem;">1</span>
                <div>
                    <span class="d-block fw-bold small text-dark">Step 1: New Product</span>
                    <span class="d-block text-muted" style="font-size:0.75rem">Product Code &amp; Information</span>
                </div>
            </button>
            <i class="bi bi-chevron-right text-muted d-none d-md-block"></i>

            <!-- Step 2 Indicator -->
            <button type="button" class="btn step-indicator d-flex align-items-center gap-2 p-2 border-0 bg-transparent text-start" id="step-nav-2" data-step="2">
                <span class="step-num rounded-circle d-flex align-items-center justify-content-center fw-bold bg-light text-secondary border" style="width:34px;height:34px;font-size:0.95rem;">2</span>
                <div>
                    <span class="d-block fw-bold small text-dark">Step 2: New Template</span>
                    <span class="d-block text-muted" style="font-size:0.75rem">Fastening Specs &amp; Markers</span>
                </div>
            </button>
            <i class="bi bi-chevron-right text-muted d-none d-md-block"></i>

            <!-- Step 3 Indicator -->
            <button type="button" class="btn step-indicator d-flex align-items-center gap-2 p-2 border-0 bg-transparent text-start" id="step-nav-3" data-step="3">
                <span class="step-num rounded-circle d-flex align-items-center justify-content-center fw-bold bg-light text-secondary border" style="width:34px;height:34px;font-size:0.95rem;">3</span>
                <div>
                    <span class="d-block fw-bold small text-dark">Step 3: Product Created</span>
                    <span class="d-block text-muted" style="font-size:0.75rem">Review &amp; Finalize Product</span>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Inline Dynamic Notification Banner -->
<div id="builder-alert-banner" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <span id="builder-alert-msg">Specification updated.</span>
    </div>
    <button type="button" class="btn-close" aria-label="Close" onclick="document.getElementById('builder-alert-banner').classList.add('d-none')"></button>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="product-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EditingProductId" />
    <input type="hidden" asp-for="ImagePath" id="image-path" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-inline error mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <!-- ================================================================ -->
    <!-- STEP 1: NEW PRODUCT DETAILS                                      -->
    <!-- ================================================================ -->
    <div id="flow-step-1" class="flow-step-panel">
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-seam text-primary me-2"></i>Product Details</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Step 1 of 3</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small mb-1" asp-for="ProductCode">Product Code <span class="text-danger">*</span></label>
                        <input asp-for="ProductCode" class="form-control" placeholder="e.g. LK-6P" autofocus />
                        @if (Model.CodeAlreadyExists)
                        {
                            <div class="text-danger small mt-1">
                                <i class="bi bi-exclamation-triangle me-1"></i>This code already exists.
                            </div>
                        }
                        <span asp-validation-for="ProductCode" class="text-danger small"></span>
                        <div id="product-code-feedback" class="small mt-1" style="display:none"></div>
                        <div class="form-text small text-muted">Unique identifier for this assembled product.</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-1" asp-for="ProductName">Product Name <span class="text-danger">*</span></label>
                        <input asp-for="ProductName" class="form-control" placeholder="e.g. Industrial Server Locker" />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                        <div class="form-text small text-muted">Common shop-floor or catalog designation.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Product Images (optional)</label>
                        <input type="file" id="image-file" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm" multiple />
                        <div id="image-error" class="text-danger small mt-1" style="display:none"></div>
                        <div class="form-text small text-muted">Pick one or more images — the crop editor opens for each, in order. The first image becomes the main product picture.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1" asp-for="Description">Description (optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Functional notes, assembly instructions, or engineering specifications..."></textarea>
                    </div>
                    <div class="col-12" id="image-list-wrap" style="display:@(Model.Images.Count > 0 ? "block" : "none")">
                        <div id="image-list" class="d-flex flex-wrap gap-2"></div>
                        @for (var i = 0; i < Model.Images.Count; i++)
                        {
                            <input type="hidden" name="Images.Index" value="@i" />
                            <input type="hidden" name="@($"Images[{i}]")" value="@Model.Images[i]" />
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3">
                <span class="small text-muted">Product information entered here will group the template components.</span>
                <button type="button" class="btn btn-primary px-4 py-2 fw-semibold" id="btn-goto-step-2">
                    Next: Create Template Specification <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- STEP 2: NEW TEMPLATE GENERATION (INTEGRATED INSIDE PRODUCT)      -->
    <!-- ================================================================ -->
    <div id="flow-step-2" class="flow-step-panel d-none">
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-magic text-primary me-2"></i>Generate Fastening Template</h5>
                    <span class="text-muted small">Generating component specification for product: <strong class="text-primary" id="step2-product-badge">@(Model.ProductName ?? "Current Product")</strong></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Step 2 of 3</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-toggle-catalogue-view">
                        <i class="bi bi-collection me-1"></i>Library Catalogue (<span id="catalogue-badge">@Model.AvailableTemplates.Count</span>)
                    </button>
                </div>
            </div>

            <div class="card-body p-3">
                <div class="row g-4">
                    <!-- Template Generator Core -->
                    <div class="col-lg-8" id="template-generator-col">
                        <!-- 1. Template Identity -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Template / Component Name <span class="text-danger">*</span></label>
                                <input type="text" id="gen-tpl-name" class="form-control" placeholder="e.g. Front Door Hinge Plate" />
                                <div class="invalid-feedback d-none" id="gen-tpl-name-err">Template name is required.</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold mb-1">Instrument Mode</label>
                                <select id="gen-tpl-mode" class="form-select">
                                    <option value="Torque" selected>Torque (N·m) — Wrench</option>
                                    <option value="Vernier">Vernier (mm) — Caliper</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold mb-1">Tolerance Mode</label>
                                <select id="gen-tpl-tol-mode" class="form-select">
                                    <option value="Absolute" selected>Absolute (&plusmn; N·m / mm)</option>
                                    <option value="Percent">Percentage (&plusmn; %)</option>
                                </select>
                            </div>
                        </div>

                        <!-- 2. Component Image Upload & Crop Editor with Visual Markers -->
                        <div class="card border bg-light p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-dark"><i class="bi bi-image me-1 text-primary"></i>Component Visual &amp; Marker Mapping</span>
                                <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.75rem">Visual Operator Guidance</span>
                            </div>

                            <!-- Image status & eye-button large view (no small inline preview) -->
                            <div id="gen-image-preview-wrap" class="rounded border mb-2 bg-white" style="min-height:58px;">
                                <div class="d-flex align-items-center px-3 py-2">
                                    <i class="bi bi-card-image fs-5 text-secondary me-2"></i>
                                    <div id="gen-image-placeholder" class="text-muted flex-grow-1">
                                        <span class="small fw-semibold d-block">No component image uploaded</span>
                                        <span class="text-muted" style="font-size:0.75rem">Upload to enable visual pin placement for bolts &amp; measurement points</span>
                                    </div>
                                    <div id="gen-image-view-row" class="d-flex align-items-center gap-2 flex-grow-1 d-none">
                                        <span class="small fw-semibold text-dark flex-grow-1">Component image ready for marker mapping</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" id="btn-gen-view-image" title="View the image large (zoom / pan)">
                                            <i class="bi bi-eye me-1"></i>View
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mb-2">
                                <label class="btn btn-sm btn-outline-primary flex-grow-1 mb-0 py-1.5" for="gen-file-input" id="btn-gen-choose-image">
                                    <i class="bi bi-upload me-1"></i><span id="gen-upload-btn-text">Upload Component Drawing / Photo</span>
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-1.5 d-none" id="btn-gen-edit-image" title="Crop & edit image">
                                    <i class="bi bi-crop me-1"></i>Crop &amp; Rotate
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger py-1.5 d-none" id="btn-gen-remove-image" title="Remove image">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <input type="file" id="gen-file-input" accept=".jpg,.jpeg,.png,.webp" class="d-none" />
                            <input type="hidden" id="gen-image-path" value="" />

                            <div id="gen-upload-status" class="d-none text-center small text-muted py-1">
                                <span class="spinner-border spinner-border-sm me-1 text-primary"></span>Uploading component image…
                            </div>
                            <div id="gen-upload-error" class="alert alert-danger py-1 px-2 small mb-0 d-none"></div>

                            <!-- Visual Marker Placement Area (Active when image is uploaded) -->
                            <div id="gen-marker-panel" class="d-none mt-2 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                    <span class="small fw-semibold text-secondary" style="font-size:0.8rem">
                                        <i class="bi bi-pin-map-fill text-danger me-1"></i>Click image to pin bolt position &middot; drag a pin to move it
                                    </span>
                                    <!-- Marker Size Toolbar -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted" style="font-size:0.75rem">Marker Size:</span>
                                        <input type="range" class="form-range" id="gen-marker-size-slider"
                                               min="14" max="42" step="1" value="24"
                                               style="width:120px; margin-bottom:0;" title="Drag to resize all markers (live)" />
                                        <span class="text-muted" id="gen-marker-size-value" style="font-size:0.75rem; min-width:40px;">24px</span>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-secondary py-0 px-1.5 gen-size-preset" style="font-size:0.75rem" data-size="16">S</button>
                                            <button type="button" class="btn btn-outline-secondary py-0 px-1.5 gen-size-preset active" style="font-size:0.75rem" data-size="24">M</button>
                                            <button type="button" class="btn btn-outline-secondary py-0 px-1.5 gen-size-preset" style="font-size:0.75rem" data-size="32">L</button>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-muted mb-2" style="font-size:0.75rem">
                                    Currently placing: <strong id="gen-selected-step-label" class="text-primary">Bolt 1</strong>. Click on the image below to drop pin.
                                </p>
                                <div id="gen-image-container" class="position-relative d-inline-block w-100 rounded border overflow-hidden bg-dark text-center" style="cursor: crosshair;">
                                    <img id="gen-component-image" src="" alt="Marker placement target" class="img-fluid d-block mx-auto" style="max-height:340px;" />
                                    <!-- Pin overlay: absolutely sized to exactly mirror the image box
                                         (the dark container letterboxes the centered image, so pins
                                         must be positioned against the image rect, not the container). -->
                                    <div id="gen-marker-layer" style="position:absolute; pointer-events:none;"></div>
                                    <button type="button" id="btn-gen-large-view" class="btn btn-sm btn-dark position-absolute shadow-sm"
                                            style="top:6px; right:6px; z-index:10;" title="Mark pins on a large image view">
                                        <i class="bi bi-arrows-fullscreen me-1"></i>Large View
                                    </button>
                                    <!-- Step markers rendered here dynamically -->
                                </div>
                            </div>
                        </div>

                        <!-- 3. Quick Fastener Setup -->
                        <div class="p-2.5 bg-light rounded border mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-secondary"><i class="bi bi-lightning-charge me-1"></i>Quick Bolt Preset</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btn-apply-quick-steps" title="Apply to all step rows below">
                                    <i class="bi bi-arrow-repeat me-1"></i>Apply Preset
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label text-muted mb-0" style="font-size:0.75rem">Bolt Count</label>
                                    <input type="number" id="quick-bolt-count" class="form-control form-control-sm" min="1" max="50" value="4" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label text-muted mb-0" style="font-size:0.75rem">Target (<span class="unit-label">N·m</span>)</label>
                                    <input type="number" step="0.1" id="quick-target" class="form-control form-control-sm" value="25.0" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label text-muted mb-0" style="font-size:0.75rem">Tol &plusmn;</label>
                                    <input type="number" step="0.1" id="quick-tol" class="form-control form-control-sm" value="2.0" />
                                </div>
                            </div>
                        </div>

                        <!-- 4. Detailed Fastening Steps Table -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-dark">Fastening Steps (<span id="gen-steps-count">4</span>)</span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none py-0 px-1" id="btn-add-gen-step">
                                <i class="bi bi-plus-circle me-1"></i>Add Bolt Step
                            </button>
                        </div>
                        <div class="table-responsive border rounded bg-white mb-3" style="max-height: 220px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0" id="gen-steps-table">
                                <thead class="table-light small">
                                    <tr>
                                        <th style="width:36px">#</th>
                                        <th>Label</th>
                                        <th style="width:85px">Target</th>
                                        <th style="width:75px">&plusmn; Tol</th>
                                        <th style="width:40px" class="text-center" title="Marker status">Pin</th>
                                        <th style="width:36px"></th>
                                    </tr>
                                </thead>
                                <tbody id="gen-steps-tbody">
                                    <!-- Populated dynamically via product-builder.js -->
                                </tbody>
                            </table>
                        </div>

                        <div id="gen-template-error" class="alert alert-danger py-1 px-2 small mb-2 d-none"></div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary py-2 fw-semibold flex-grow-1" id="btn-generate-template">
                                <i class="bi bi-magic me-1"></i>Generate Template &amp; Attach to Product
                            </button>
                        </div>
                    </div>

                    <!-- Right Column: Catalogue Library (Select Existing) -->
                    <div class="col-lg-4" id="template-catalogue-col">
                        <div class="card h-100 border">
                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small text-dark"><i class="bi bi-collection me-1 text-secondary"></i>Catalogue Library</span>
                                <span class="badge bg-secondary" id="catalogue-badge-secondary">@Model.AvailableTemplates.Count</span>
                            </div>
                            <div class="card-body p-2">
                                <p class="text-muted small mb-2">Want to reuse an existing template? Click to attach directly to this product.</p>
                                <input type="text" id="template-search" class="form-control form-control-sm mb-2"
                                       placeholder="Search catalogue..." />
                                <div class="list-group list-group-flush border rounded" id="template-picker" style="max-height: 480px; overflow-y: auto;">
                                    @if (Model.AvailableTemplates.Any())
                                    {
                                        @foreach (var t in Model.AvailableTemplates)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2"
                                                    data-template-id="@t.TemplateId"
                                                    data-steps="@t.StepCount"
                                                    data-label="@t.Label"
                                                    data-name="@t.Name"
                                                    data-search="@($"{t.TemplateCode} {t.Name}".ToLowerInvariant())">
                                                <span>
                                                    <span class="d-block fw-semibold text-dark small">@t.Name</span>
                                                    <span class="d-block text-muted" style="font-size:0.75rem">@t.TemplateCode &middot; v@(t.Version) &middot; @t.StepCount steps</span>
                                                </span>
                                                <span class="btn btn-sm btn-outline-primary py-0 px-2" title="Attach to product">
                                                    <i class="bi bi-plus"></i> Add
                                                </span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0 p-3 text-center" id="picker-empty-msg">No templates in library yet. Generate one above!</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3">
                <button type="button" class="btn btn-outline-secondary" id="btn-back-to-step-1">
                    <i class="bi bi-arrow-left me-1"></i>Back to Product Details
                </button>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small d-none d-sm-inline">Templates attached: <strong id="step2-attached-count">@Model.Components.Count</strong></span>
                    <button type="button" class="btn btn-success px-4 py-2 fw-semibold" id="btn-goto-step-3">
                        Next: Review &amp; Finalize Product <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- STEP 3: PRODUCT CREATED / FINAL REVIEW & ASSEMBLY                -->
    <!-- ================================================================ -->
    <div id="flow-step-3" class="flow-step-panel d-none">
        <div class="row g-4 mb-4">
            <!-- Left: Product Summary Card -->
            <div class="col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>Product Summary
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <div id="summary-img-wrap" class="rounded border p-2 bg-light mb-2 d-inline-block position-relative" style="max-height:160px;min-width:140px;">
                                <img id="summary-image-preview" src="@(Model.HasImage ? Url.Content("~/" + Model.ImagePath) : "")"
                                     alt="Product preview" class="img-fluid" style="max-height:140px; display:@(Model.HasImage ? "block" : "none"); cursor:zoom-in;" />
                                <button type="button" id="btn-summary-view-image" class="btn btn-dark btn-sm position-absolute top-0 end-0 m-1" title="View image larger" style="display:@(Model.HasImage ? "" : "none");">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <div id="summary-image-placeholder" class="text-muted p-3" style="display:@(Model.HasImage ? "none" : "block");">
                                    <i class="bi bi-box-seam fs-2"></i>
                                    <p class="small mb-0 mt-1">No product image</p>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark mb-1" id="summary-product-name">@(Model.ProductName ?? "Product Name")</h5>
                            <span class="badge bg-secondary font-monospace fs-6" id="summary-product-code">@(Model.ProductCode ?? "CODE")</span>
                        </div>
                        <p class="text-muted small mb-3" id="summary-product-desc">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" id="btn-quick-edit-step1">
                            <i class="bi bi-pencil me-1"></i>Edit Product Info
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right: Product Components & Final Creation -->
            <div class="col-lg-8">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <div>
                            <span class="fw-bold text-dark"><i class="bi bi-diagram-3 text-primary me-2"></i>Product Components &amp; Assembly Sequence</span>
                            <span class="text-muted small ms-2">(Drag or use arrows to set assembly order)</span>
                        </div>
                        <span class="badge bg-primary fs-6" id="component-count">@Model.Components.Count</span>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0 align-middle" id="components-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:44px"></th>
                                    <th>Template (Version)</th>
                                    <th>Component Name</th>
                                    <th style="width:96px">Qty</th>
                                    <th class="text-center" style="width:90px">Steps</th>
                                    <th style="width:50px"></th>
                                </tr>
                            </thead>
                            <tbody id="components-body">
                                @for (int i = 0; i < Model.Components.Count; i++)
                                {
                                    ViewData["Index"] = i;
                                    ViewData["Options"] = Model.AvailableTemplates;
                                    @await Html.PartialAsync("_ComponentRow", Model.Components[i])
                                }
                            </tbody>
                        </table>
                        <div id="components-empty" class="text-center text-muted p-5" style="display:@(Model.Components.Count == 0 ? "block" : "none")">
                            <i class="bi bi-box-seam" style="font-size:2.5rem;color:var(--border, #cbd5e1)"></i>
                            <p class="small mb-1 mt-2 fw-semibold">No fastening templates attached yet.</p>
                            <p class="text-muted" style="font-size:0.8rem">Click below to generate a template or choose from the catalogue.</p>
                            <button type="button" class="btn btn-primary btn-sm mt-2" id="btn-empty-goto-step-2">
                                <i class="bi bi-magic me-1"></i>Go to Step 2: Generate Template
                            </button>
                        </div>
                    </div>
                    <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btn-add-another-template">
                            <i class="bi bi-plus-lg me-1"></i>Generate / Attach Another Template
                        </button>
                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <button type="button" class="btn btn-outline-secondary" id="btn-back-to-step-2">
                                <i class="bi bi-arrow-left me-1"></i>Back to Templates
                            </button>
                            <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm" id="btn-save-product">
                                <i class="bi bi-check-circle-fill me-1"></i>@(isEdit ? "Save Product Changes" : "Create Product")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Prototype row used by JS to add components -->
    <table style="display:none">
        <tbody>
            <tr class="component-row" id="row-prototype">
                <td class="text-center align-middle" style="width:44px">
                    <i class="bi bi-grip-vertical drag-handle text-muted" role="img" aria-label="Drag handle"></i>
                    <div class="d-flex flex-column align-items-center">
                        <button type="button" class="btn btn-sm btn-link p-0 row-up" disabled><i class="bi bi-caret-up-fill"></i></button>
                        <button type="button" class="btn btn-sm btn-link p-0 row-down" disabled><i class="bi bi-caret-down-fill"></i></button>
                    </div>
                </td>
                <td class="align-middle">
                    <select class="form-select form-select-sm row-template-select" disabled>
                        <option value="0">&mdash; Select template &mdash;</option>
                        @foreach (var o in Model.AvailableTemplates)
                        {
                            <option value="@o.TemplateId" data-steps="@o.StepCount" data-name="@o.Name">@o.Label</option>
                        }
                    </select>
                </td>
                <td class="align-middle">
                    <input class="form-control form-control-sm row-component-name" placeholder="e.g. Left Panel" disabled />
                </td>
                <td class="align-middle" style="width:96px">
                    <input type="number" min="1" max="9999" value="1" class="form-control form-control-sm num row-quantity" disabled />
                </td>
                <td class="text-center align-middle">
                    <span class="badge-status badge-assigned row-steps">0 steps</span>
                </td>
                <td class="text-end align-middle">
                    <button type="button" class="btn btn-sm btn-danger row-remove" disabled><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
</form>

<!-- CROP EDITOR MODAL (Full Cropper.js Integration) -->
<div class="modal fade" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">
            <div class="modal-header py-2 border-bottom">
                <h5 class="modal-title fw-semibold" id="cropModalLabel">
                    <i class="bi bi-crop me-2 text-primary"></i>Crop &amp; Edit <span id="crop-modal-subject">Component</span> Image
                </h5>
                <button type="button" class="btn-close" id="btn-close-crop-modal" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Toolbar -->
            <div class="border-bottom px-3 py-2 d-flex flex-wrap align-items-center gap-2" style="background:#f8f9fa;">
                <!-- Aspect ratio -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted me-1">Ratio:</span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary active crop-ar-btn" id="ar-free" data-ratio="NaN" title="Free">Free</button>
                        <button type="button" class="btn btn-outline-secondary crop-ar-btn" id="ar-11" data-ratio="1" title="Square">1:1</button>
                        <button type="button" class="btn btn-outline-secondary crop-ar-btn" id="ar-43" data-ratio="1.3333" title="4:3">4:3</button>
                        <button type="button" class="btn btn-outline-secondary crop-ar-btn" id="ar-169" data-ratio="1.7777" title="16:9">16:9</button>
                        <button type="button" class="btn btn-outline-secondary crop-ar-btn" id="ar-32" data-ratio="1.5" title="3:2">3:2</button>
                    </div>
                </div>
                <!-- Rotate -->
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" id="btn-crop-rot-left" title="Rotate 90&deg; left">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-crop-rot-right" title="Rotate 90&deg; right">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <!-- Flip -->
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" id="btn-crop-fliph" title="Flip horizontal">
                        <i class="bi bi-symmetry-vertical"></i> H
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-crop-flipv" title="Flip vertical">
                        <i class="bi bi-symmetry-horizontal"></i> V
                    </button>
                </div>
                <!-- Zoom -->
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-crop-zoom-out" title="Zoom out"><i class="bi bi-zoom-out"></i></button>
                    <input type="range" id="crop-zoom-slider" min="0.1" max="3" step="0.05" value="1" style="width:80px;cursor:pointer;" title="Zoom level" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-crop-zoom-in" title="Zoom in"><i class="bi bi-zoom-in"></i></button>
                    <span id="crop-zoom-pct" class="small text-muted font-monospace ms-1" style="min-width:38px;">100%</span>
                </div>
                <!-- Reset -->
                <button type="button" class="btn btn-sm btn-outline-danger" id="btn-crop-reset" title="Reset all edits">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </button>
                <!-- Quality -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                    <label class="small text-muted mb-0" for="crop-quality">Quality:</label>
                    <select id="crop-quality" class="form-select form-select-sm" style="width:95px;">
                        <option value="0.95" selected>High</option>
                        <option value="0.80">Medium</option>
                        <option value="0.60">Low</option>
                    </select>
                </div>
            </div>
            <!-- Canvas area -->
            <div class="modal-body p-0" style="background:#1e293b; min-height:380px;">
                <div id="crop-canvas-wrap" style="width:100%; max-height:58vh; overflow:hidden;">
                    <img id="crop-img" src="" alt="Crop target" style="display:block; max-width:100%; opacity:0;" />
                </div>
            </div>
            <!-- Info bar -->
            <div class="px-3 py-1 border-top d-flex align-items-center gap-4 small text-muted" style="background:#f8f9fa;">
                <span>Crop: <strong id="info-cw">&ndash;</strong> &times; <strong id="info-ch">&ndash;</strong> px</span>
                <span>Output: <strong id="info-ow">&ndash;</strong> &times; <strong id="info-oh">&ndash;</strong> px</span>
                <span class="ms-auto text-info"><i class="bi bi-info-circle me-1"></i>Drag box to move &middot; drag corner to resize</span>
            </div>
            <!-- Footer -->
            <div class="modal-footer py-2 border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btn-use-original">
                    <i class="bi bi-file-earmark me-1"></i>Use Without Cropping
                </button>
                <button type="button" class="btn btn-primary px-4" id="btn-apply-crop">
                    <i class="bi bi-check2 me-1"></i>Crop &amp; Use Image
                </button>
            </div>
        </div>
    </div>
</div>

<!-- PRODUCT IMAGE LARGE VIEW MODAL -->
<div class="modal fade" id="image-view-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">
            <div class="modal-header py-2 border-bottom" style="justify-content:flex-start;">
                <h5 class="modal-title fw-semibold"><i class="bi bi-eye me-2 text-primary"></i>Image Preview</h5>
                <span class="badge bg-secondary ms-2" id="image-view-zoom">100%</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="image-view-viewport" class="position-relative"
                 style="height:80vh; overflow:hidden; background:#111827; touch-action:none; cursor:grab;">
                <img id="image-view-img" src="" alt="Product image enlarged"
                     style="position:absolute; top:0; right:0; bottom:0; left:0; margin:auto; max-width:100%; max-height:100%; width:auto; height:auto; user-select:none; -webkit-user-drag:none;" />
                <span class="position-absolute bottom-0 start-50 translate-middle-x mb-2 small text-white-50" style="pointer-events:none;">
                    <i class="bi bi-zoom-in me-1"></i>Scroll / pinch to zoom &middot; drag to pan &middot; double-click toggles zoom
                </span>
            </div>
        </div>
    </div>
</div>

<!-- LARGE-SCALE MARKER PLACEMENT MODAL -->
<div class="modal fade" id="marker-large-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:min(96vw, 1250px);">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header py-2 px-3">
                <h5 class="modal-title fw-bold mb-0" style="font-size:1rem">
                    <i class="bi bi-pin-map-fill text-danger me-1"></i>Mark Step Positions
                    <span class="badge bg-primary ms-2 align-middle" id="mm-selected-step-label">Bolt 1</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height:78vh;">
                <div id="mm-img-wrap" class="position-relative d-inline-block" style="min-width:100%; min-height:100%; line-height:0; background:#0f172a; cursor:crosshair;">
                    <img id="mm-component-image" src="" alt="Marker placement target" class="d-block mx-auto" style="max-height:calc(78vh - 4px); max-width:100%; width:auto; height:auto;" />
                    <!-- Overlay mirrors the img box exactly (see inline panel note). -->
                    <div id="mm-marker-layer" style="position:absolute; pointer-events:none;"></div>
                </div>
            </div>
            <div class="modal-footer py-2 px-3 justify-content-between">
                <span class="small text-muted">Click the image to place the pin &middot; drag a pin to fine-tune it</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted" style="font-size:0.75rem">Marker Size:</span>
                    <input type="range" class="form-range" id="mm-marker-size-slider"
                           min="14" max="42" step="1" value="24"
                           style="width:120px; margin-bottom:0;" title="Resize the selected step's marker (or the default when nothing is placed)" />
                    <span class="text-muted" id="mm-marker-size-value" style="font-size:0.75rem; min-width:40px;">24px</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary py-0 px-1.5 mm-size-preset" style="font-size:0.75rem" data-size="16">S</button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-1.5 mm-size-preset active" style="font-size:0.75rem" data-size="24">M</button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-1.5 mm-size-preset" style="font-size:0.75rem" data-size="32">L</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SIDE-BY-SIDE TEMPLATE SIMILARITY COMPARISON MODAL -->
<div class="modal fade" id="similarity-modal" tabindex="-1" aria-labelledby="similarityModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-warning-subtle border-bottom border-warning-subtle">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning p-2 text-dark d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-copy fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="similarityModalLabel">Similar Template Found in Catalogue</h5>
                        <span class="text-muted small">A matching or identical fastening specification already exists in your catalogue.</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning py-2 px-3 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Compare specifications side by side:</strong> Choose whether to reuse the approved template from the catalogue or register your new design as a distinct entry.
                </div>

                <div class="row g-4">
                    <!-- Left Side: Existing Catalogue Template -->
                    <div class="col-md-6">
                        <div class="card h-100 border-2 border-success shadow-sm">
                            <div class="card-header bg-success-subtle border-bottom border-success-subtle d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i>Existing Catalogue Specification</span>
                                <span class="badge bg-success" id="modal-existing-badge">Catalogue Entry</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="mb-3">
                                    <h6 class="fw-bold text-dark mb-1" id="modal-existing-name">Existing Template Name</h6>
                                    <div class="text-muted small font-monospace">
                                        Code: <span class="fw-bold text-dark" id="modal-existing-code">TW-4B-25NM-T2</span> &middot;
                                        Version: <span id="modal-existing-version">v1</span> &middot;
                                        <span id="modal-existing-stepcount">4</span> steps
                                    </div>
                                </div>

                                <!-- Existing Image Preview & Markers if present -->
                                <div id="modal-existing-img-wrap" class="rounded border p-1 mb-3 text-center bg-dark position-relative d-none" style="max-height: 160px; overflow: hidden;">
                                    <img id="modal-existing-img" src="" alt="Existing template image" class="img-fluid" style="max-height: 150px;" />
                                    <div id="modal-existing-markers-layer"></div>
                                </div>

                                <div class="table-responsive border rounded bg-white mb-3" style="max-height: 220px;">
                                    <table class="table table-sm table-striped mb-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:36px">#</th>
                                                <th>Bolt Label</th>
                                                <th style="width:90px">Target</th>
                                                <th style="width:90px">Tolerance</th>
                                            </tr>
                                        </thead>
                                        <tbody id="modal-existing-steps-tbody">
                                            <!-- Steps dynamically populated -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-top p-3">
                                <button type="button" class="btn btn-success w-100 fw-semibold py-2" id="btn-choose-existing">
                                    <i class="bi bi-check2-circle me-1"></i>Use Existing Catalogue Template
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side: Newly Generated Specification -->
                    <div class="col-md-6">
                        <div class="card h-100 border-2 border-primary shadow-sm">
                            <div class="card-header bg-primary-subtle border-bottom border-primary-subtle d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-bold text-primary"><i class="bi bi-stars me-1"></i>Newly Generated Specification</span>
                                <span class="badge bg-primary" id="modal-new-badge">New Specification</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="mb-3">
                                    <h6 class="fw-bold text-dark mb-1" id="modal-new-name">New Template Name</h6>
                                    <div class="text-muted small font-monospace">
                                        Code: <span class="fw-bold text-dark" id="modal-new-code">TW-4B-25NM-T2</span> &middot;
                                        Status: <span class="text-primary fw-semibold">New Entry</span> &middot;
                                        <span id="modal-new-stepcount">4</span> steps
                                    </div>
                                </div>

                                <!-- New Image Preview & Markers if present -->
                                <div id="modal-new-img-wrap" class="rounded border p-1 mb-3 text-center bg-dark position-relative d-none" style="max-height: 160px; overflow: hidden;">
                                    <img id="modal-new-img" src="" alt="New template image" class="img-fluid" style="max-height: 150px;" />
                                    <div id="modal-new-markers-layer"></div>
                                </div>

                                <div class="table-responsive border rounded bg-white mb-3" style="max-height: 220px;">
                                    <table class="table table-sm table-striped mb-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:36px">#</th>
                                                <th>Bolt Label</th>
                                                <th style="width:90px">Target</th>
                                                <th style="width:90px">Tolerance</th>
                                            </tr>
                                        </thead>
                                        <tbody id="modal-new-steps-tbody">
                                            <!-- Steps dynamically populated -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-top p-3">
                                <button type="button" class="btn btn-outline-primary w-100 fw-semibold py-2" id="btn-choose-new">
                                    <i class="bi bi-plus-circle me-1"></i>Save as New Template &amp; Use
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/cropperjs/cropper.min.js"></script>
    <script src="~/js/product-builder.js" asp-append-version="true"></script>
}
