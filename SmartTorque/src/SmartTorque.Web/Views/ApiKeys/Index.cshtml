@model SmartTorque.Web.ViewModels.ApiKeys.ApiKeysDashboardViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "API Keys Directory & Access Governance";
    ViewData["ActiveNav"] = "ApiKeys";
}

<div class="container-fluid px-3 py-2">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h4 fw-bold mb-0">API Keys Directory &amp; Access Governance</h1>
                @if (Model.IsMainAdmin)
                {
                    <span class="badge bg-danger px-2 py-1"><i class="bi bi-shield-shaded me-1"></i>Main Admin Exclusive Directory</span>
                }
                else
                {
                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-person-badge me-1"></i>Admin Access Portal</span>
                }
            </div>
            <p class="text-muted small mb-0">
                @if (Model.IsMainAdmin)
                {
                    <span>Hardware device API key repository. When devices (torque wrenches, Vernier calipers) are registered, their generated 192-bit API keys are logged exclusively here for the Main Admin to govern and grant.</span>
                }
                else
                {
                    <span>Hardware device API keys are governed by the Main Administrator. Request access below; once approved, keys are persistently stored in your table without needing reassignment.</span>
                }
            </p>
        </div>
        <div>
            @if (Model.IsMainAdmin)
            {
                <a href="/Device/Create" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-cpu me-1"></i>Register Hardware Device
                </a>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                    <i class="bi bi-send-plus me-1"></i>Request Device Key Access
                </button>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-x-circle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsMainAdmin)
    {
        <!-- Main Admin Dashboard: Tabs for Directory, Pending Requests, and Access Grants -->
        <ul class="nav nav-pills mb-3 gap-2" id="adminKeyTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active btn-sm" id="directory-tab" data-bs-toggle="pill" data-bs-target="#directory-pane" type="button" role="tab">
                    <i class="bi bi-key-fill me-1"></i>Registered Device Keys
                    <span class="badge bg-secondary ms-1">@Model.AllKeys.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-sm position-relative" id="requests-tab" data-bs-toggle="pill" data-bs-target="#requests-pane" type="button" role="tab">
                    <i class="bi bi-inbox-fill me-1"></i>Pending Access Requests
                    @if (Model.PendingRequests.Count > 0)
                    {
                        <span class="badge bg-danger ms-1">@Model.PendingRequests.Count</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">0</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-sm" id="grants-tab" data-bs-toggle="pill" data-bs-target="#grants-pane" type="button" role="tab">
                    <i class="bi bi-shield-check me-1"></i>Access Grants Table
                    <span class="badge bg-secondary ms-1">@Model.AllGrants.Count</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adminKeyTabsContent">
            <!-- Central Directory Pane -->
            <div class="tab-pane fade show active" id="directory-pane" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-database-lock me-2 text-danger"></i>Registered Hardware Device Keys (Main Admin Only)</h6>
                        <span class="text-muted small">Visible strictly to Main Admin (@Model.CurrentUserEmail)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Device Friendly Name</th>
                                    <th>Transmitter ID</th>
                                    <th>Type &amp; Workstation</th>
                                    <th>Generated Device API Key</th>
                                    <th>Status</th>
                                    <th>Grants</th>
                                    <th>Registered</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AllKeys.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            No hardware device API keys registered yet.<br />
                                            <a href="/Device/Create" class="btn btn-outline-primary btn-sm mt-2">
                                                <i class="bi bi-cpu me-1"></i>Register a Hardware Device
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @foreach (var key in Model.AllKeys)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <i class="bi bi-cpu text-primary me-1"></i>@key.KeyName
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace">@key.ApiScope</span>
                                        </td>
                                        <td class="text-muted small" style="max-width: 250px;">
                                            @key.Description
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 320px;">
                                                <input type="password" class="form-control font-monospace form-control-sm border-end-0 api-key-field"
                                                       value="@key.RawApiKey" readonly id="keyInput-@key.ApiKeyId" />
                                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('keyInput-@key.ApiKeyId', this)" title="Show/Hide Key">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@key.RawApiKey', this)" title="Copy Key">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            @if (key.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Disabled</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                @key.Grants.Count(g => g.Status == ApiKeyRequestStatus.Approved) active
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            @key.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                        </td>
                                        <td class="text-end">
                                            <form action="/Admin/ApiKeys/Toggle/@key.ApiKeyId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(key.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                    <i class="bi @(key.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                                    @(key.IsActive ? "Disable" : "Enable")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pending Requests Pane -->
            <div class="tab-pane fade" id="requests-pane" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-inbox-fill me-2 text-warning"></i>Admin Access Requests Awaiting Approval</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Requesting Admin</th>
                                    <th>API Key Requested</th>
                                    <th>Scope</th>
                                    <th>Reason / Justification</th>
                                    <th>Submitted At</th>
                                    <th class="text-end">Decision</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PendingRequests.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-check2-circle text-success fs-4 d-block mb-1"></i>
                                            All API access requests have been reviewed.
                                        </td>
                                    </tr>
                                }
                                @foreach (var req in Model.PendingRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@(req.User?.FullName ?? req.User?.UserName)</div>
                                            <div class="text-muted small">@req.User?.Email</div>
                                        </td>
                                        <td class="fw-semibold">
                                            @req.ApiKey.KeyName
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace">@req.ApiKey.ApiScope</span>
                                        </td>
                                        <td class="text-muted small" style="max-width: 300px;">
                                            @(req.RequestReason ?? "No reason specified.")
                                        </td>
                                        <td class="text-muted small">
                                            @req.RequestedAt.ToString("yyyy-MM-dd HH:mm")
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                <form action="/Admin/ApiKeys/Approve/@req.GrantId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-lg me-1"></i>Approve Access
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                        data-grant-id="@req.GrantId" data-key-name="@req.ApiKey.KeyName"
                                                        data-user-name="@(req.User?.FullName ?? req.User?.Email)">
                                                    <i class="bi bi-x-lg me-1"></i>Reject
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- All Grants Table Pane -->
            <div class="tab-pane fade" id="grants-pane" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>All Access Grants &amp; Audit Trail</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Admin User</th>
                                    <th>API Key</th>
                                    <th>Scope</th>
                                    <th>Status</th>
                                    <th>Requested At</th>
                                    <th>Decision Details</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AllGrants.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No grants on record.</td>
                                    </tr>
                                }
                                @foreach (var grant in Model.AllGrants)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@(grant.User?.FullName ?? grant.User?.UserName)</div>
                                            <div class="text-muted small">@grant.User?.Email</div>
                                        </td>
                                        <td class="fw-semibold">@grant.ApiKey.KeyName</td>
                                        <td><span class="badge bg-light text-dark border font-monospace">@grant.ApiKey.ApiScope</span></td>
                                        <td>
                                            @switch (grant.Status)
                                            {
                                                case ApiKeyRequestStatus.Approved:
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                                    break;
                                                case ApiKeyRequestStatus.Pending:
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                                    break;
                                                case ApiKeyRequestStatus.Rejected:
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                                    break;
                                                case ApiKeyRequestStatus.Revoked:
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-slash-circle me-1"></i>Revoked</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-muted small">@grant.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-muted small">
                                            @if (grant.DecidedAt.HasValue)
                                            {
                                                <div>By: @(grant.DecidedByUser?.Email ?? "Main Admin")</div>
                                                <div>At: @grant.DecidedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                                @if (!string.IsNullOrEmpty(grant.RejectionReason))
                                                {
                                                    <div class="text-danger">Note: @grant.RejectionReason</div>
                                                }
                                            }
                                            else
                                            {
                                                <span>Awaiting decision</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (grant.Status == ApiKeyRequestStatus.Approved)
                                            {
                                                <form action="/Admin/ApiKeys/Revoke/@grant.GrantId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Revoke this access grant?');">
                                                        <i class="bi bi-shield-x me-1"></i>Revoke Access
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Regular Admin View: My Approved Keys Table & My Requests -->
        <div class="row g-4">
            <!-- Approved Keys Table (Persistent Storage) -->
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2 text-success"></i>My Approved API Keys (Persistent Access)</h6>
                            <span class="text-muted small">These keys are persistently stored and accessible to your account without needing repeated reassignment.</span>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                            <i class="bi bi-send-plus me-1"></i>Request Key Access
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Key Name</th>
                                    <th>Authorized Scope</th>
                                    <th>Description</th>
                                    <th>API Key (Token)</th>
                                    <th>Granted On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ApprovedGrants.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-key text-secondary fs-3 d-block mb-2"></i>
                                            You currently do not have any approved API keys.<br />
                                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                                                Request API Key Access from Main Admin
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @foreach (var grant in Model.ApprovedGrants)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <i class="bi bi-key-fill text-success me-1"></i>@grant.ApiKey.KeyName
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace">@grant.ApiKey.ApiScope</span>
                                        </td>
                                        <td class="text-muted small" style="max-width: 300px;">
                                            @grant.ApiKey.Description
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 320px;">
                                                <input type="password" class="form-control font-monospace form-control-sm border-end-0"
                                                       value="@grant.ApiKey.RawApiKey" readonly id="userKeyInput-@grant.GrantId" />
                                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('userKeyInput-@grant.GrantId', this)" title="Show/Hide Key">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@grant.ApiKey.RawApiKey', this)" title="Copy Key">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-muted small">
                                            @(grant.DecidedAt?.ToString("yyyy-MM-dd HH:mm") ?? grant.RequestedAt.ToString("yyyy-MM-dd HH:mm"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- My Requests History -->
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>My Access Request Status</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>API Key</th>
                                    <th>Scope</th>
                                    <th>My Justification</th>
                                    <th>Submitted On</th>
                                    <th>Status</th>
                                    <th>Review Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MyRequests.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">You have not submitted any API key requests.</td>
                                    </tr>
                                }
                                @foreach (var req in Model.MyRequests)
                                {
                                    <tr>
                                        <td class="fw-semibold">@req.ApiKey.KeyName</td>
                                        <td><span class="badge bg-light text-dark border font-monospace">@req.ApiKey.ApiScope</span></td>
                                        <td class="text-muted small" style="max-width: 250px;">@(req.RequestReason ?? "—")</td>
                                        <td class="text-muted small">@req.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            @switch (req.Status)
                                            {
                                                case ApiKeyRequestStatus.Approved:
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                                                    break;
                                                case ApiKeyRequestStatus.Pending:
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending Review</span>
                                                    break;
                                                case ApiKeyRequestStatus.Rejected:
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                                                    break;
                                                case ApiKeyRequestStatus.Revoked:
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Revoked</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @if (!string.IsNullOrEmpty(req.RejectionReason))
                                            {
                                                <span class="text-danger">@req.RejectionReason</span>
                                            }
                                            else if (req.Status == ApiKeyRequestStatus.Approved)
                                            {
                                                <span class="text-success">Approved by Main Admin</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Create New API Key (Main Admin Only) -->
@if (Model.IsMainAdmin)
{
    <!-- Modal: Reject Request (Main Admin) -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/Admin/ApiKeys/Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GrantId" id="rejectGrantId" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel"><i class="bi bi-x-circle me-2"></i>Reject Access Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Are you sure you want to reject the request from <strong id="rejectUserName"></strong> for <strong id="rejectKeyName"></strong>?</p>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Reason for Rejection (Optional)</label>
                            <textarea name="RejectionReason" class="form-control form-control-sm" rows="3" placeholder="Explain why the access cannot be granted"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-lg me-1"></i>Confirm Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal: Request Access (Regular Admin) -->
<div class="modal fade" id="requestAccessModal" tabindex="-1" aria-labelledby="requestAccessModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/Admin/ApiKeys/RequestAccess" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="requestAccessModalLabel"><i class="bi bi-send-plus me-2 text-primary"></i>Request Device API Key Access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Select Hardware Device <span class="text-danger">*</span></label>
                        <select name="ApiKeyId" class="form-select form-select-sm" required>
                            <option value="">-- Choose a Registered Hardware Device --</option>
                            @foreach (var key in Model.AvailableKeys)
                            {
                                <option value="@key.ApiKeyId">@key.KeyName (Transmitter: @key.ApiScope)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Business Justification / Reason <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control form-control-sm" rows="3" placeholder="Explain why you require access to this hardware device API key (e.g. firmware flashing, calibration, bench setup)" required maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.className = 'bi bi-eye-slash';
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.className = 'bi bi-eye';
                }
            }
        }

        function copyToClipboard(text, btn) {
            navigator.clipboard.writeText(text).then(function () {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check text-success"></i>';
                btn.classList.add('btn-light');
                setTimeout(function () {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('btn-light');
                }, 1500);
            }).catch(function (err) {
                console.error('Could not copy text: ', err);
            });
        }

        const rejectModal = document.getElementById('rejectModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const grantId = button.getAttribute('data-grant-id');
                const keyName = button.getAttribute('data-key-name');
                const userName = button.getAttribute('data-user-name');

                document.getElementById('rejectGrantId').value = grantId;
                document.getElementById('rejectKeyName').textContent = keyName;
                document.getElementById('rejectUserName').textContent = userName;
            });
        }
    </script>
}
