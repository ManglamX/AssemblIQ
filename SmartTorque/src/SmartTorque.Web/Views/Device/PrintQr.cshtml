@model SmartTorque.Core.Entities.Device
@{
    Layout = null;
    var rawApiKey = ViewBag.RawApiKey as string ?? Model.TransmitterId;
    var qrSvg = ViewBag.QrSvg as string ?? "";
    var isOverdue = Model.CalibrationDue.HasValue && Model.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tool QR Label - @Model.Name (@Model.TransmitterId)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #0f172a;
            padding: 24px;
        }
        .print-btn-bar {
            position: sticky;
            top: 12px;
            z-index: 100;
            background: #ffffff;
            padding: 14px 24px;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }
        .label-container {
            max-width: 270px;
            margin: 0 auto;
            background: #ffffff;
            border: 1.5px solid #0f172a;
            border-radius: 10px;
            padding: 12px 14px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
            text-align: center;
        }
        .qr-box {
            width: 135px;
            height: 135px;
            margin: 8px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px;
        }
        .qr-box svg, .qr-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        @@media print {
            .print-btn-bar { display: none !important; }
            body { background: #ffffff; padding: 0; margin: 0; }
            .label-container {
                box-shadow: none;
                border: 1.5px solid #000000;
                border-radius: 6px;
                max-width: 240px;
                padding: 8px 10px;
                page-break-inside: avoid;
            }
            .qr-box {
                width: 115px;
                height: 115px;
                margin: 6px auto;
                padding: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="print-btn-bar">
        <div>
            <h6 class="mb-0 fw-bold"><i class="bi bi-qr-code me-2 text-primary"></i>Tool Pairing Label</h6>
            <small class="text-muted">Affix to @Model.Name</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm px-3 shadow-sm fw-bold">
                <i class="bi bi-printer me-1"></i>Print Label
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm px-3">
                Close
            </button>
        </div>
    </div>

    <div class="label-container">
        <div class="border-bottom pb-1 mb-2 text-center">
            <span class="badge @(Model.InstrumentType == SmartTorque.Core.Enums.InstrumentType.Torque ? "bg-primary" : "bg-info") text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px; padding: 3px 8px;">
                <i class="bi @(Model.InstrumentType == SmartTorque.Core.Enums.InstrumentType.Torque ? "bi-wrench" : "bi-rulers") me-1"></i>@(Model.InstrumentType == SmartTorque.Core.Enums.InstrumentType.Torque ? "Torque Wrench" : "Vernier Caliper")
            </span>
        </div>

        <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.95rem;">@Model.Name</h6>
        <div class="text-secondary font-monospace" style="font-size: 0.72rem;">Transmitter: <strong>@Model.TransmitterId</strong></div>

        <div class="qr-box shadow-sm">
            @if (!string.IsNullOrEmpty(qrSvg))
            {
                @Html.Raw(qrSvg)
            }
            else
            {
                <img src="@Url.Action("QrCode", "Device", new { id = Model.DeviceId })" alt="QR Code" />
            }
        </div>

        <div class="row g-1 text-start border-top pt-2" style="font-size: 0.68rem; line-height: 1.25; color: #64748b;">
            <div class="col-6">
                <div>Location: <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.Location) ? "Assembly Floor" : Model.Location)</strong></div>
                <div>Firmware: <span class="font-monospace text-dark">@(string.IsNullOrWhiteSpace(Model.FirmwareVersion) ? "N/A" : Model.FirmwareVersion)</span></div>
            </div>
            <div class="col-6 text-end">
                <div>Cal. Due:</div>
                <strong class="@(isOverdue ? "text-danger" : "text-dark")">
                    @(Model.CalibrationDue?.ToString("yyyy-MM-dd") ?? "Indefinite")
                    @if (isOverdue) { <span class="badge bg-danger ms-1" style="font-size: 0.6rem;">OVERDUE</span> }
                </strong>
            </div>
        </div>
    </div>
</body>
</html>
