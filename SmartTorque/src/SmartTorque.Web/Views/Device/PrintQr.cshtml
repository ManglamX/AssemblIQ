@model SmartTorque.Core.Entities.Device
@{
    Layout = null;
    var rawApiKey = ViewBag.RawApiKey as string ?? Model.TransmitterId;
    var qrSvg = ViewBag.QrSvg as string ?? "";
    var isOverdue = Model.CalibrationDue.HasValue && Model.CalibrationDue.Value < DateOnly.FromDateTime(DateTime.UtcNow);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tool QR Label - @Model.Name (@Model.TransmitterId)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #0f172a;
            padding: 24px;
        }
        .print-btn-bar {
            position: sticky;
            top: 12px;
            z-index: 100;
            background: #ffffff;
            padding: 14px 24px;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }
        .label-container {
            max-width: 480px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .qr-box {
            width: 220px;
            height: 220px;
            margin: 16px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px;
        }
        .qr-box svg, .qr-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .tool-key-display {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8rem;
            background: #f8fafc;
            border: 1px dashed #94a3b8;
            border-radius: 8px;
            padding: 8px 12px;
            word-break: break-all;
            margin-bottom: 16px;
        }
        @@media print {
            .print-btn-bar { display: none !important; }
            body { background: #ffffff; padding: 0; }
            .label-container {
                box-shadow: none;
                border: 2px solid #000000;
                border-radius: 8px;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="print-btn-bar">
        <div>
            <h6 class="mb-0 fw-bold"><i class="bi bi-qr-code me-2 text-primary"></i>Tool Pairing Label</h6>
            <small class="text-muted">Affix to @Model.Name</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm px-3 shadow-sm fw-bold">
                <i class="bi bi-printer me-1"></i>Print Label
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm px-3">
                Close
            </button>
        </div>
    </div>

    <div class="label-container">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
            <div class="fw-bold fs-6 text-uppercase tracking-wider text-muted">
                <i class="bi bi-shield-check text-success me-1"></i>AssemblIQ Hardware Tool
            </div>
            <span class="badge @(Model.InstrumentType == SmartTorque.Core.Enums.InstrumentType.Torque ? "bg-primary" : "bg-info")">
                @(Model.InstrumentType == SmartTorque.Core.Enums.InstrumentType.Torque ? "Torque Wrench" : "Vernier Caliper")
            </span>
        </div>

        <h3 class="fw-bold mb-1">@Model.Name</h3>
        <div class="text-secondary font-monospace mb-2">Transmitter: <strong>@Model.TransmitterId</strong></div>

        <div class="qr-box shadow-sm">
            @if (!string.IsNullOrEmpty(qrSvg))
            {
                @Html.Raw(qrSvg)
            }
            else
            {
                <img src="@Url.Action("QrCode", "Device", new { id = Model.DeviceId })" alt="QR Code" />
            }
        </div>

        <div class="small fw-bold text-muted text-uppercase mb-1">Tool Authentication Key (Scan to Equip)</div>
        <div class="tool-key-display">@rawApiKey</div>

        <div class="row g-2 text-start border-top pt-3 small text-muted">
            <div class="col-6">
                <div>Location: <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.Location) ? "Assembly Floor" : Model.Location)</strong></div>
                <div>Firmware: <span class="font-monospace text-dark">@(string.IsNullOrWhiteSpace(Model.FirmwareVersion) ? "N/A" : Model.FirmwareVersion)</span></div>
            </div>
            <div class="col-6 text-end">
                <div>Calibration Due:</div>
                <strong class="@(isOverdue ? "text-danger" : "text-dark")">
                    @(Model.CalibrationDue?.ToString("yyyy-MM-dd") ?? "Indefinite")
                    @if (isOverdue) { <span class="badge bg-danger ms-1">OVERDUE</span> }
                </strong>
            </div>
        </div>

        <div class="mt-3 text-center text-muted" style="font-size: 0.75rem;">
            <i class="bi bi-camera me-1"></i>Scan with AssemblIQ Worker Tablet / Terminal to auto-equip for assembly.
        </div>
    </div>
</body>
</html>
