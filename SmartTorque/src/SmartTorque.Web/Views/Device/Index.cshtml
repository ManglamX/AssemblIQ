@model SmartTorque.Web.ViewModels.DeviceManagementIndexViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hardware Devices & API Keys";
    ViewData["ActiveNav"] = "Devices";

    var selectedCategory = Model.SelectedCategory;
    var selectedInstrument = Model.SelectedInstrument;
    var activeOnly = Model.ActiveOnly;
    int totalCount = Model.TotalCount;
    int onlineCount = Model.OnlineCount;
    int nodeCount = Model.NodeCount;
    int bleTorqueCount = Model.BleTorqueCount;
    int bleVernierCount = Model.BleVernierCount;
    int torqueCount = Model.TorqueCount;
    int vernierCount = Model.VernierCount;
    int pendingRequestsCount = Model.PendingRequestsCount;
    bool isGovernanceTab = string.Equals(Model.ActiveTab, "governance", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h1 class="h3 fw-bold mb-0">
                    <i class="bi bi-router me-2 text-primary"></i>
                    <span class="tooltip-trigger" data-tooltip="Unified hardware management: wireless torque wrenches, digital calipers, credentials, and API access governance">
                        Hardware Devices &amp; API Keys
                        <i class="bi bi-info-circle tooltip-icon"></i>
                    </span>
                </h1>
                @if (Model.IsMainAdmin)
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                        <i class="bi bi-shield-shaded me-1"></i>Main Admin Directory
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                        <i class="bi bi-person-badge me-1"></i>Admin Access Portal
                    </span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (!Model.IsMainAdmin)
            {
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                    <i class="bi bi-send-plus me-1"></i>Request Key Access
                </button>
            }
            <a asp-action="Create" class="btn btn-primary btn-sm fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Register Device
            </a>
        </div>
    </div>

    <!-- One-Time API Key Display Card with Live QR Code -->
    @if (TempData["NewApiKey"] != null)
    {
        <div class="card border-warning shadow-sm mb-4 bg-warning-subtle text-dark">
            <div class="card-body p-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-auto text-center">
                        <div class="p-2 bg-white rounded border border-warning shadow-sm d-inline-block">
                            <img src="@Url.Action("RawKeyQr", "Device", new { key = TempData["NewApiKey"], pixels = 8 })"
                                 alt="Device API Key QR Code" style="width: 140px; height: 140px;" class="d-block" />
                            <small class="text-muted d-block mt-1 font-monospace fw-bold" style="font-size: 0.72rem;">PAIRING QR</small>
                        </div>
                    </div>
                    <div class="col">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark"><i class="bi bi-qr-code-scan me-1"></i>Hardware Ready</span>
                            <h5 class="mb-0 fw-bold">API Key Generated for @TempData["NewDeviceName"] (@TempData["NewDeviceTransmitter"])</h5>
                        </div>
                        <p class="mb-2 small text-muted">
                            This device API key is encoded into the tool pairing QR code. Workers can scan this QR code with their camera on the shop floor to instantly pair the tool.
                        </p>
                        <div class="input-group mb-3" style="max-width: 600px;">
                            <input type="text" class="form-control font-monospace fw-bold bg-white" id="raw-api-key-input" value="@TempData["NewApiKey"]" readonly />
                            <button class="btn btn-dark" type="button" onclick="copyTextToClipboard(document.getElementById('raw-api-key-input').value, 'API Key copied to clipboard!')">
                                <i class="bi bi-clipboard me-1"></i>Copy Key
                            </button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @if (TempData["NewDeviceId"] != null)
                            {
                                <a href="@Url.Action("PrintQr", "Device", new { id = TempData["NewDeviceId"] })" target="_blank" class="btn btn-warning btn-sm text-dark fw-bold shadow-sm">
                                    <i class="bi bi-printer me-1"></i>Print Hardware Tool Label
                                </a>
                            }
                            <a href="@Url.Action("RawKeyQr", "Device", new { key = TempData["NewApiKey"], pixels = 14 })" download="Device-@(TempData["NewDeviceTransmitter"])-ApiKey-QR.svg" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-download me-1"></i>Download QR Code (SVG)
                            </a>
                            <span class="small text-muted ms-auto">Transmitter ID: <code>@TempData["NewDeviceTransmitter"]</code></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Standard Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 shadow-sm" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Cards: Device Fleet & 3 Hardware Categories -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="text-muted small text-uppercase fw-semibold">Total Devices</div>
                <div class="fs-3 fw-bold text-dark mt-1">@totalCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="text-muted small text-uppercase fw-semibold">Online Now</div>
                <div class="fs-3 fw-bold text-success mt-1" id="kpi-online-count">@onlineCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100" style="border-left: 3px solid #a00b52 !important;">
                <div class="small text-uppercase fw-bold" style="color: #a00b52;">
                    <i class="bi bi-cpu me-1"></i>Node (ESP32)
                </div>
                <div class="fs-3 fw-bold mt-1" style="color: #a00b52;">@nodeCount</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100" style="border-left: 3px solid #0d6efd !important;">
                <div class="text-primary small text-uppercase fw-bold">
                    <i class="bi bi-wrench me-1"></i>Torque Wrench (BLE)
                </div>
                <div class="fs-3 fw-bold text-primary mt-1">@bleTorqueCount</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100" style="border-left: 3px solid #0dcaf0 !important;">
                <div class="text-info-emphasis small text-uppercase fw-bold">
                    <i class="bi bi-rulers me-1"></i>Vernier Caliper (BLE)
                </div>
                <div class="fs-3 fw-bold text-info mt-1">@bleVernierCount</div>
            </div>
        </div>
        @if (pendingRequestsCount > 0)
        {
            <div class="col-12 col-xl-auto">
                <div class="card border border-warning shadow-sm rounded-3 p-3 bg-warning-subtle cursor-pointer h-100" onclick="document.getElementById('governance-tab').click();" style="cursor: pointer;">
                    <div class="text-warning-emphasis small text-uppercase fw-bold">Pending Key Requests</div>
                    <div class="fs-3 fw-bold text-danger mt-1">@pendingRequestsCount <span class="small fs-6 fw-normal text-muted">(Action Required)</span></div>
                </div>
            </div>
        }
    </div>

    <!-- Navigation Tabs (Fleet & Keys vs Access Governance) -->
    <ul class="nav nav-pills mb-3 gap-2" id="deviceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link btn-sm @(!isGovernanceTab ? "active fw-bold" : "")" id="fleet-tab" data-bs-toggle="pill" data-bs-target="#fleet-pane" type="button" role="tab">
                <i class="bi bi-cpu me-1"></i>Hardware Fleet &amp; Device Keys
                <span class="badge @(!isGovernanceTab ? "bg-white text-primary" : "bg-secondary") ms-1">@totalCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link btn-sm @(isGovernanceTab ? "active fw-bold" : "")" id="governance-tab" data-bs-toggle="pill" data-bs-target="#governance-pane" type="button" role="tab">
                <i class="bi bi-shield-lock me-1"></i>Access Governance &amp; Grants
                @if (pendingRequestsCount > 0)
                {
                    <span class="badge bg-danger ms-1">@pendingRequestsCount Pending</span>
                }
                else
                {
                    <span class="badge @(isGovernanceTab ? "bg-white text-primary" : "bg-secondary") ms-1">
                        @(Model.IsMainAdmin ? Model.AllGrants.Count : Model.ApprovedGrants.Count)
                    </span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content" id="deviceTabsContent">
        <!-- PANE 1: HARDWARE FLEET & DEVICE KEYS -->
        <div class="tab-pane fade @(!isGovernanceTab ? "show active" : "")" id="fleet-pane" role="tabpanel">
            <!-- Filter Bar: 3 Hardware Device Categories -->
            <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                <a asp-action="Index" asp-route-tab="fleet" 
                   class="btn btn-sm @(string.IsNullOrEmpty(selectedCategory) && selectedInstrument == null ? "btn-dark fw-bold shadow-sm" : "btn-outline-secondary")">
                    All Devices (@totalCount)
                </a>
                <a asp-action="Index" asp-route-category="Node" asp-route-tab="fleet" 
                   class="btn btn-sm @(selectedCategory == "Node" ? "text-white fw-bold shadow-sm" : "btn-outline-secondary")"
                   style="@(selectedCategory == "Node" ? "background-color: #a00b52; border-color: #a00b52;" : "")">
                    <i class="bi bi-cpu me-1"></i>Node (ESP32 Gateway) (@nodeCount)
                </a>
                <a asp-action="Index" asp-route-category="TorqueWrench" asp-route-tab="fleet" 
                   class="btn btn-sm @(selectedCategory == "TorqueWrench" ? "btn-primary fw-bold shadow-sm" : "btn-outline-secondary")">
                    <i class="bi bi-wrench me-1"></i>Torque Wrench (BLE) (@bleTorqueCount)
                </a>
                <a asp-action="Index" asp-route-category="VernierCaliper" asp-route-tab="fleet" 
                   class="btn btn-sm @(selectedCategory == "VernierCaliper" ? "btn-info text-dark fw-bold shadow-sm" : "btn-outline-secondary")">
                    <i class="bi bi-rulers me-1"></i>Vernier Caliper (BLE) (@bleVernierCount)
                </a>
            </div>

            <!-- Unified Device & Keys Table -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    @if (!Model.Devices.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-router fs-1 d-block mb-2 text-secondary"></i>
                            <h5>No devices found in this category</h5>
                            <p class="small mb-3">Register your first Node gateway or Bluetooth device in this category.</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm">Register Device</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="min-height: 320px;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 110px;">Status</th>
                                        <th style="width: 130px;">Transmitter ID</th>
                                        <th>Device Name</th>
                                        <th style="width: 180px;">Category &amp; Instrument</th>
                                        <th>Workstation / Location</th>
                                        <th style="min-width: 260px;">Device API Key / BLE Link</th>
                                        <th>Firmware</th>
                                        <th>Last Seen</th>
                                        <th>Calibration</th>
                                        <th style="width: 130px;" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.Devices)
                                    {
                                        <tr id="device-row-@d.DeviceId" data-device-transmitter="@d.TransmitterId" class="@(!d.IsActive ? "opacity-75 bg-light" : "")">
                                            <!-- Status -->
                                            <td>
                                                <span id="badge-status-@d.DeviceId" data-device-status="@d.TransmitterId" class="badge @(d.IsOnline ? "bg-success" : "bg-secondary") d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-circle-fill" style="font-size: 7px;"></i>
                                                    <span class="status-text">@(d.IsOnline ? "Online" : "Offline")</span>
                                                </span>
                                                @if (!d.IsActive)
                                                {
                                                    <span class="badge bg-danger ms-1">Disabled</span>
                                                }
                                            </td>

                                            <!-- Transmitter ID -->
                                            <td>
                                                <code class="fw-bold bg-light px-2 py-1 rounded border text-dark">@d.TransmitterId</code>
                                            </td>

                                            <!-- Device Name -->
                                            <td>
                                                <div class="fw-bold text-dark">@d.Name</div>
                                                <div class="text-muted small" style="font-size: 0.72rem;">ID #@d.DeviceId</div>
                                            </td>

                                            <!-- Category & Instrument -->
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    @if (d.IsBluetoothDevice)
                                                    {
                                                        if (d.InstrumentType == InstrumentType.Torque)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle align-self-start">
                                                                <i class="bi bi-wrench me-1"></i>Torque Wrench (BLE)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info-subtle text-info border border-info-subtle align-self-start">
                                                                <i class="bi bi-rulers me-1"></i>Vernier Caliper (BLE)
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-white align-self-start shadow-none" style="background-color: #a00b52;">
                                                            <i class="bi bi-cpu me-1"></i>Node (ESP32 Gateway)
                                                        </span>
                                                        <small class="text-muted" style="font-size: 0.72rem;">@(d.InstrumentType == InstrumentType.Torque ? "Torque (N·m)" : "Vernier (mm)")</small>
                                                    }
                                                </div>
                                            </td>

                                            <!-- Workstation / Location -->
                                            <td>
                                                <span class="small text-dark">@(string.IsNullOrWhiteSpace(d.Location) ? "—" : d.Location)</span>
                                            </td>

                                            <!-- Merged Generated Device API Key or BLE Link -->
                                            <td>
                                                @if (d.IsBluetoothDevice)
                                                {
                                                    <div class="d-flex flex-column gap-1" style="max-width: 290px;">
                                                        <div class="d-flex align-items-center gap-1.5">
                                                            <span class="badge bg-light text-primary border d-inline-flex align-items-center gap-1 py-1 px-2">
                                                                <i class="bi bi-bluetooth"></i>
                                                                <span class="font-monospace" style="font-size: 0.75rem;">Direct Web BLE (GATT)</span>
                                                            </span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(d.BleUuid))
                                                        {
                                                            <small class="text-muted font-monospace" style="font-size: 0.68rem;" title="Service UUID: @d.BleUuid">UUID: @d.BleUuid</small>
                                                        }
                                                    </div>
                                                }
                                                else if (!string.IsNullOrEmpty(d.RawApiKey))
                                                {
                                                    <div class="d-flex align-items-center gap-1 bg-light border rounded px-2 py-1" style="max-width: 290px;">
                                                        <span id="key-text-@d.DeviceId" class="font-monospace small text-dark fw-semibold text-truncate flex-grow-1" style="letter-spacing: 1px;" data-raw="@d.RawApiKey" data-masked="••••••••••••••••">
                                                            ••••••••••••••••
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 px-1" onclick="toggleKeyReveal(@d.DeviceId)" title="Show / Hide Key">
                                                            <i id="key-eye-@d.DeviceId" class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-link text-primary p-0 px-1" onclick="copyTextToClipboard('@d.RawApiKey', 'Copied API key for @d.Name!')" title="Copy Raw Key">
                                                            <i class="bi bi-clipboard"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-link text-dark p-0 px-1" onclick="openDeviceQrModal(@d.DeviceId, '@Html.Raw(d.Name.Replace("'", "\\'"))', '@d.TransmitterId', '@d.InstrumentType')" title="View Pairing QR Code">
                                                            <i class="bi bi-qr-code"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else if (!string.IsNullOrEmpty(d.ApiKeyHash))
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <span class="badge bg-light text-muted border font-monospace py-1" title="Configured in hardware gateway">
                                                            <i class="bi bi-shield-check text-success me-1"></i>Flashed in HW
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-link text-dark p-0 px-1" onclick="openDeviceQrModal(@d.DeviceId, '@Html.Raw(d.Name.Replace("'", "\\'"))', '@d.TransmitterId', '@d.InstrumentType')" title="View QR Code">
                                                            <i class="bi bi-qr-code"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>

                                            <!-- Firmware -->
                                            <td>
                                                <span id="firmware-@d.DeviceId" data-device-firmware="@d.TransmitterId" class="small text-muted font-monospace">
                                                    @(string.IsNullOrWhiteSpace(d.FirmwareVersion) ? "—" : d.FirmwareVersion)
                                                </span>
                                            </td>

                                            <!-- Last Seen -->
                                            <td>
                                                <span id="lastseen-@d.DeviceId" data-device-lastseen="@d.TransmitterId" class="small text-muted" style="font-size: 0.75rem;">
                                                    @(d.LastSeenAt.HasValue ? d.LastSeenAt.Value.ToIstString("yyyy-MM-dd HH:mm:ss") : "Never")
                                                </span>
                                            </td>

                                            <!-- Calibration Due -->
                                            <td>
                                                @if (d.CalibrationDue.HasValue)
                                                {
                                                    <span class="@(d.IsCalibrationOverdue ? "text-danger fw-bold" : "text-muted small")">
                                                        @d.CalibrationDue.Value.ToString("yyyy-MM-dd")
                                                        @if (d.IsCalibrationOverdue)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Calibration Overdue!"></i>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-end">
                                                <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                                    <a href="@Url.Action("PrintQr", "Device", new { id = d.DeviceId })" target="_blank" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Print Hardware Tool Label">
                                                        <i class="bi bi-printer"></i>
                                                    </a>
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border py-1 px-2" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                            <li>
                                                                <a class="dropdown-item" href="javascript:void(0)" onclick="openDeviceQrModal(@d.DeviceId, '@Html.Raw(d.Name.Replace("'", "\\'"))', '@d.TransmitterId', '@d.InstrumentType')">
                                                                    <i class="bi bi-qr-code-scan me-2 text-primary"></i>View API Key QR
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" href="@Url.Action("PrintQr", "Device", new { id = d.DeviceId })" target="_blank">
                                                                    <i class="bi bi-printer me-2 text-dark"></i>Print Tool Label
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider" /></li>
                                                            <li>
                                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@d.DeviceId">
                                                                    <i class="bi bi-pencil me-2 text-primary"></i>Edit Details
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <form asp-action="ReissueKey" asp-route-id="@d.DeviceId" method="post" onsubmit="return confirm('Reissuing an API key will generate a new secret and disconnect the transmitter until re-flashed. Continue?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="dropdown-item">
                                                                        <i class="bi bi-key me-2 text-warning"></i>Reissue API Key
                                                                    </button>
                                                                </form>
                                                            </li>
                                                            <li><hr class="dropdown-divider" /></li>
                                                            <li>
                                                                <form asp-action="ToggleActive" asp-route-id="@d.DeviceId" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="dropdown-item @(d.IsActive ? "text-danger" : "text-success")">
                                                                        <i class="bi @(d.IsActive ? "bi-slash-circle text-danger" : "bi-check-circle text-success") me-2"></i>
                                                                        @(d.IsActive ? "Deactivate Device" : "Activate Device")
                                                                    </button>
                                                                </form>
                                                            </li>
                                                            <li>
                                                                <form asp-action="Delete" asp-route-id="@d.DeviceId" method="post" onsubmit="return confirm('Are you sure you want to delete device \'@d.Name\' (@d.TransmitterId)?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="dropdown-item text-danger">
                                                                        <i class="bi bi-trash3 me-2"></i>Delete Device
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- PANE 2: ACCESS GOVERNANCE & DELEGATION -->
        <div class="tab-pane fade @(isGovernanceTab ? "show active" : "")" id="governance-pane" role="tabpanel">
            @if (Model.IsMainAdmin)
            {
                <!-- Main Admin View: Pending Requests & Active Grants -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-inbox-fill text-danger me-2"></i>Pending Device Key Access Requests</h6>
                            <span class="text-muted small">Sub-administrators requesting credentials for hardware tools</span>
                        </div>
                        <span class="badge @(Model.PendingRequests.Count > 0 ? "bg-danger" : "bg-secondary")">
                            @Model.PendingRequests.Count Pending
                        </span>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.PendingRequests.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-check2-circle fs-3 text-success d-block mb-1"></i>
                                No pending access requests. All requested device keys are resolved.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Requester</th>
                                            <th>Requested Device Key</th>
                                            <th>Transmitter Scope</th>
                                            <th>Business Reason</th>
                                            <th>Requested At</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var req in Model.PendingRequests)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@(req.User?.FullName ?? req.User?.UserName ?? "Admin")</strong>
                                                    <div class="text-muted small">@req.User?.Email</div>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">@req.ApiKey.KeyName</span>
                                                </td>
                                                <td>
                                                    <code>@req.ApiKey.ApiScope</code>
                                                </td>
                                                <td>
                                                    <span class="small text-muted">@(string.IsNullOrEmpty(req.RequestReason) ? "No reason specified" : req.RequestReason)</span>
                                                </td>
                                                <td>
                                                    <span class="small text-muted">@req.RequestedAt.ToIstString("yyyy-MM-dd HH:mm")</span>
                                                </td>
                                                <td class="text-end">
                                                    <form action="/Admin/ApiKeys/Approve/@req.GrantId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                                            <i class="bi bi-check-lg me-1"></i>Approve
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                            data-grant-id="@req.GrantId" data-key-name="@req.ApiKey.KeyName"
                                                            data-user-name="@(req.User?.FullName ?? req.User?.Email)">
                                                        <i class="bi bi-x-lg me-1"></i>Reject
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- Active Access Grants Table -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check text-success me-2"></i>Active Device Key Grants Table</h6>
                            <span class="text-muted small">Delegated credentials authorized by Main Admin</span>
                        </div>
                        <span class="badge bg-secondary">@Model.AllGrants.Count Grants</span>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.AllGrants.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                No active access grants issued to sub-administrators.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Granted User</th>
                                            <th>Hardware Device</th>
                                            <th>Transmitter ID</th>
                                            <th>Status</th>
                                            <th>Granted Date</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grant in Model.AllGrants)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@(grant.User?.FullName ?? grant.User?.UserName ?? "Admin")</strong>
                                                    <div class="text-muted small">@grant.User?.Email</div>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">@grant.ApiKey.KeyName</span>
                                                </td>
                                                <td>
                                                    <code>@grant.ApiKey.ApiScope</code>
                                                </td>
                                                <td>
                                                    @if (grant.Status == ApiKeyRequestStatus.Approved)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Authorized</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="small text-muted">@grant.DecidedAt?.ToIstString("yyyy-MM-dd HH:mm")</span>
                                                </td>
                                                <td class="text-end">
                                                    <form action="/Admin/ApiKeys/Revoke/@grant.GrantId" method="post" class="d-inline" onsubmit="return confirm('Revoke key access for this administrator?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-shield-slash me-1"></i>Revoke
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Regular Admin View: My Approved Keys & Request Access -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-key-fill text-primary me-2"></i>My Authorized Device API Keys</h6>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                            <i class="bi bi-send-plus me-1"></i>Request Device Key Access
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.ApprovedGrants.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-key fs-1 d-block mb-2 text-secondary"></i>
                                <h6>No Authorized Keys</h6>
                                <p class="small mb-3">You do not currently have delegated access to any device keys.</p>
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#requestAccessModal">
                                    Request Key Access from Main Admin
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Device Name</th>
                                            <th>Transmitter ID</th>
                                            <th>Authorized API Key</th>
                                            <th>Granted Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grant in Model.ApprovedGrants)
                                        {
                                            <tr>
                                                <td class="fw-bold">@grant.ApiKey.KeyName</td>
                                                <td><code>@grant.ApiKey.ApiScope</code></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-1 bg-light border rounded px-2 py-1" style="max-width: 280px;">
                                                        <span id="grant-key-text-@grant.GrantId" class="font-monospace small text-dark fw-semibold text-truncate flex-grow-1" data-raw="@grant.ApiKey.RawApiKey" data-masked="••••••••••••••••">
                                                            ••••••••••••••••
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 px-1" onclick="toggleGrantKeyReveal(@grant.GrantId)">
                                                            <i id="grant-eye-@grant.GrantId" class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-link text-primary p-0 px-1" onclick="copyTextToClipboard('@grant.ApiKey.RawApiKey', 'Copied key for @grant.ApiKey.KeyName!')">
                                                            <i class="bi bi-clipboard"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="small text-muted">@grant.DecidedAt?.ToIstString("yyyy-MM-dd HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- My Pending Requests -->
                @if (Model.MyRequests.Any())
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-warning"></i>My Pending Access Requests</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Device</th>
                                            <th>Transmitter Scope</th>
                                            <th>Reason</th>
                                            <th>Requested Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var req in Model.MyRequests)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@req.ApiKey.KeyName</td>
                                                <td><code>@req.ApiKey.ApiScope</code></td>
                                                <td class="small text-muted">@(req.RequestReason ?? "—")</td>
                                                <td class="small text-muted">@req.RequestedAt.ToIstString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    @if (req.Status == ApiKeyRequestStatus.Approved)
                                                    {
                                                        <span class="badge bg-success">Approved</span>
                                                    }
                                                    else if (req.DecidedAt.HasValue)
                                                    {
                                                        <span class="badge bg-danger">Rejected</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Under Review</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal: Hardware Tool Pairing QR Code -->
