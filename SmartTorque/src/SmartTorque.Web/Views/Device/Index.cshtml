<script>
    function copyTextToClipboard(text, successMsg) {
        if (!text) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
                alert(successMsg || 'Copied to clipboard!');
            });
        } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            alert(successMsg || 'Copied to clipboard!');
        }
    }

    function toggleKeyReveal(deviceId) {
        const span = document.getElementById('key-text-' + deviceId);
        const icon = document.getElementById('key-eye-' + deviceId);
        if (!span || !icon) return;

        const raw = span.getAttribute('data-raw');
        const masked = span.getAttribute('data-masked');

        if (span.textContent.trim() === masked) {
            span.textContent = raw;
            icon.className = 'bi bi-eye-slash text-danger';
        } else {
            span.textContent = masked;
            icon.className = 'bi bi-eye';
        }
    }

    function toggleGrantKeyReveal(grantId) {
        const span = document.getElementById('grant-key-text-' + grantId);
        const icon = document.getElementById('grant-eye-' + grantId);
        if (!span || !icon) return;

        const raw = span.getAttribute('data-raw');
        const masked = span.getAttribute('data-masked');

        if (span.textContent.trim() === masked) {
            span.textContent = raw;
            icon.className = 'bi bi-eye-slash text-danger';
        } else {
            span.textContent = masked;
            icon.className = 'bi bi-eye';
        }
    }

    function openDeviceQrModal(deviceId, name, transmitterId, instrumentType) {
        document.getElementById('modalQrDevName').textContent = name;
        document.getElementById('modalQrDevTransmitter').textContent = transmitterId + ' (' + instrumentType + ')';
        var qrUrl = '/Device/QrCode/' + deviceId;
        document.getElementById('modalQrDevImg').src = qrUrl;
        document.getElementById('modalQrPrintLink').href = '/Device/PrintQr/' + deviceId;
        document.getElementById('modalQrDownloadLink').href = qrUrl;
        document.getElementById('modalQrDownloadLink').setAttribute('download', 'Device-' + transmitterId + '-QR.svg');
        var modal = new bootstrap.Modal(document.getElementById('deviceQrModal'));
        modal.show();
    }

    // Modal data binding for Reject Modal
    const rejectModal = document.getElementById('rejectModal');
    if (rejectModal) {
        rejectModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) return;
            const grantId = button.getAttribute('data-grant-id');
            const keyName = button.getAttribute('data-key-name');
            const userName = button.getAttribute('data-user-name');

            document.getElementById('rejectGrantId').value = grantId || '';
            document.getElementById('rejectKeyName').textContent = keyName || '';
            document.getElementById('rejectUserName').textContent = userName || '';
        });
    }
</script>

@section Scripts {
<script src="~/lib/microsoft-signalr/signalr.min.js"></script>
<script>
    // Real-Time SignalR updates for device heartbeat and online status
    if (typeof signalR !== 'undefined') {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/live")
            .withAutomaticReconnect()
            .build();

        connection.on("deviceStatus", function (data) {
            if (!data || !data.transmitterId) return;

            const escapedId = typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(data.transmitterId) : data.transmitterId;
            const badge = document.querySelector('[data-device-status="' + escapedId + '"]') || document.getElementById("badge-status-" + data.transmitterId);
            const lastSeen = document.querySelector('[data-device-lastseen="' + escapedId + '"]') || document.getElementById("lastseen-" + data.transmitterId);
            const firmware = document.querySelector('[data-device-firmware="' + escapedId + '"]') || document.getElementById("firmware-" + data.transmitterId);

            if (badge) {
                if (data.online) {
                    badge.className = "badge bg-success d-inline-flex align-items-center gap-1";
                    badge.querySelector(".status-text").textContent = "Online";
                } else {
                    badge.className = "badge bg-secondary d-inline-flex align-items-center gap-1";
                    badge.querySelector(".status-text").textContent = "Offline";
                }
            }

            if (lastSeen) {
                lastSeen.textContent = new Date().toLocaleTimeString();
            }

            if (firmware && data.firmwareVersion) {
                firmware.textContent = data.firmwareVersion;
            }

            // Update live KPI of online devices
            const onlineBadges = document.querySelectorAll('[data-device-status].bg-success');
            const kpi = document.getElementById("kpi-online-count");
            if (kpi) kpi.textContent = onlineBadges.length;
        });

        connection.start().then(function () {
            connection.invoke("JoinAdmins");
        }).catch(function (err) {
            console.warn("SignalR connection error:", err);
        });
    }

    function toggleFormatFields() {
        const fmt = document.getElementById('protoFormat')?.value || 'Delimited';
        document.getElementById('wrapDelim')?.classList.toggle('d-none', fmt !== 'Delimited');
        document.getElementById('wrapRegex')?.classList.toggle('d-none', fmt !== 'Regex');
    }

    function openBleProtocolModal(proto) {
        document.getElementById('protoId').value = proto?.BleProtocolId || 0;
        document.getElementById('protoName').value = proto?.Name || '';
        document.getElementById('protoDescription').value = proto?.Description || '';
        document.getElementById('protoInstType').value = proto?.SupportedInstrumentType != null ? String(proto.SupportedInstrumentType) : '';
        document.getElementById('protoPrefixes').value = proto?.DeviceNamePrefixes || '';
        document.getElementById('protoServiceUuid').value = proto?.ServiceUuid || '';
        document.getElementById('protoTxUuid').value = proto?.TxCharUuid || '';
        document.getElementById('protoRxUuid').value = proto?.RxCharUuid || '';
        document.getElementById('protoFormat').value = proto?.FrameFormat || 'Delimited';
        document.getElementById('protoDelim').value = proto?.Delimiter || ',';
        document.getElementById('protoRegex').value = proto?.RegexPattern || '';
        document.getElementById('protoStartFilter').value = proto?.FrameStartFilter || '';
        document.getElementById('protoIgnorePrefix').value = proto?.IgnorePrefix || '';
        document.getElementById('protoValueField').value = proto?.ValueField || '0';
        document.getElementById('protoMultiplier').value = proto?.ValueMultiplier ?? 1;
        document.getElementById('protoCounterField').value = proto?.CounterField || '';
        document.getElementById('protoSerialField').value = proto?.ToolSerialField || '';
        document.getElementById('protoUnitField').value = proto?.UnitField || '';
        document.getElementById('protoAngleField').value = proto?.AngleField || '';
        document.getElementById('protoJudgmentField').value = proto?.JudgmentField || '';
        document.getElementById('protoPassValue').value = proto?.PassValue || '';
        document.getElementById('protoDoubleValue').value = proto?.DoubleTighteningValue || '';
        document.getElementById('protoSyncCmd').value = proto?.SyncLimitsCommandTemplate || '';
        document.getElementById('bleProtocolModalLabel').innerHTML = proto
            ? '<i class="bi bi-sliders me-2"></i>Edit BLE Protocol: ' + proto.Name
            : '<i class="bi bi-plus-circle me-2"></i>New BLE Protocol Mapping';
        toggleFormatFields();
        new bootstrap.Modal(document.getElementById('bleProtocolModal')).show();
    }

    function testBleFrameMapping() {
        const raw = (document.getElementById('testRawFrameInput')?.value || '').trim();
        const outEl = document.getElementById('testFrameOutput');
        const fmt = document.getElementById('protoFormat').value;
        const startFilter = document.getElementById('protoStartFilter').value;
        const ignorePrefix = document.getElementById('protoIgnorePrefix').value;
        const delim = document.getElementById('protoDelim').value || ',';
        const regexPat = document.getElementById('protoRegex').value;
        const mult = parseFloat(document.getElementById('protoMultiplier').value) || 1;

        if (ignorePrefix && raw.startsWith(ignorePrefix)) {
            outEl.className = 'mb-0 p-2 bg-white border rounded small font-monospace text-warning';
            outEl.textContent = 'Ignored (matches IgnorePrefix: ' + ignorePrefix + ')';
            return;
        }
        if (startFilter && !raw.startsWith(startFilter)) {
            outEl.className = 'mb-0 p-2 bg-white border rounded small font-monospace text-warning';
            outEl.textContent = 'Skipped (does not start with: ' + startFilter + ')';
            return;
        }

        let extract = () => undefined;
        try {
            if (fmt === 'Delimited') {
                const parts = raw.split(delim);
                extract = (spec) => (spec !== '' && spec != null) ? parts[parseInt(spec, 10)] : undefined;
            } else if (fmt === 'FixedPosition') {
                extract = (spec) => {
                    if (!spec) return undefined;
                    const s = String(spec).trim();
                    const dash = s.indexOf('-');
                    if (dash > 0) {
                        const start = parseInt(s.slice(0, dash), 10);
                        const end = parseInt(s.slice(dash + 1), 10);
                        return (!isNaN(start) && !isNaN(end)) ? raw.slice(start - 1, end).trim() : undefined;
                    }
                    const pos = parseInt(s, 10);
                    return !isNaN(pos) ? raw.slice(pos - 1, pos).trim() : undefined;
                };
            } else if (fmt === 'Regex') {
                const m = raw.match(new RegExp(regexPat));
                if (!m) throw new Error('Regex did not match frame');
                extract = (spec) => (spec !== '' && spec != null) ? m[parseInt(spec, 10)] : undefined;
            } else if (fmt === 'Json') {
                const obj = JSON.parse(raw);
                extract = (spec) => (spec !== '' && spec != null) ? spec.split('.').reduce((a, k) => a?.[k], obj) : undefined;
            }
            const rawVal = extract(document.getElementById('protoValueField').value);
            const val = parseFloat(rawVal) * mult;
            if (isNaN(val)) throw new Error('Parsed torque/value is NaN (raw: ' + rawVal + ')');
            const judgment = extract(document.getElementById('protoJudgmentField').value) || '';
            const dblToken = document.getElementById('protoDoubleValue').value;
            const passToken = document.getElementById('protoPassValue').value;
            const reading = {
                torque: Number(val.toFixed(4)),
                counter: parseInt(extract(document.getElementById('protoCounterField').value), 10) || 1,
                toolSerial: extract(document.getElementById('protoSerialField').value) || undefined,
                unit: extract(document.getElementById('protoUnitField').value) || undefined,
                angle: parseFloat(extract(document.getElementById('protoAngleField').value)) || undefined,
                judgment: judgment || undefined,
                isDoubleTightening: !!(dblToken && judgment && String(judgment).includes(dblToken)),
                isPass: !!(passToken && judgment === passToken)
            };
            outEl.className = 'mb-0 p-2 bg-white border rounded small font-monospace text-success';
            outEl.textContent = JSON.stringify(reading, null, 2);
        } catch (err) {
            outEl.className = 'mb-0 p-2 bg-white border rounded small font-monospace text-danger';
            outEl.textContent = 'Error: ' + err.message;
        }
    }
</script>
}
