@model SmartTorque.Web.ViewModels.EditDeviceViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit Device — {Model.Name}";
}

<div class="container-fluid px-4 py-3" style="max-width: 800px;">
    <!-- Breadcrumb & Title -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Devices
        </a>
        <h1 class="h3 fw-bold mb-1">Edit Device Details</h1>
        <p class="text-muted small mb-0">Update metadata, workstation location, and calibration schedule for transmitter <code>@Model.TransmitterId</code>.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.DeviceId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DeviceId" />
                <input type="hidden" asp-for="TransmitterId" />
                <input type="hidden" asp-for="InstrumentType" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Transmitter ID</label>
                        <input class="form-control bg-light font-monospace" value="@Model.TransmitterId" readonly />
                        <div class="form-text">Hardware transmitter ID is immutable once bound.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Instrument Type</label>
                        <input class="form-control bg-light" value="@(Model.InstrumentType == InstrumentType.Torque ? "Torque Wrench (N·m)" : "Vernier Caliper (mm)")" readonly />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Line A, Station 3" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CalibrationDue" class="form-label fw-semibold"></label>
                        <input asp-for="CalibrationDue" type="date" class="form-control" />
                        <span asp-validation-for="CalibrationDue" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
