@model SmartTorque.Web.ViewModels.CreateDeviceViewModel
@using SmartTorque.Core.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Register Device";
}

<div class="container-fluid px-4 py-3" style="max-width: 800px;">
    <!-- Breadcrumb & Title -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Devices
        </a>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>Register Hardware Device</span>
            <span class="tooltip-trigger border-0" data-tooltip="Register a new hardware device: ESP32 Node gateway, Bluetooth Torque Wrench, or Bluetooth Vernier Caliper.">
                <i class="bi bi-info-circle tooltip-icon"></i>
            </span>
        </h1>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <!-- Device Category Selector -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Device Category</label>
                    <div class="d-flex gap-2 flex-wrap" id="categoryBtnGroup">
                        <input type="hidden" asp-for="DeviceCategory" id="deviceCategoryInput" />
                        <button type="button" class="btn btn-outline-primary category-btn active" data-category="Node">
                            <i class="bi bi-cpu me-1"></i>Node (ESP32 Gateway)
                        </button>
                        <button type="button" class="btn btn-outline-primary category-btn" data-category="TorqueWrench">
                            <i class="bi bi-wrench me-1"></i>Torque Wrench (BLE)
                        </button>
                        <button type="button" class="btn btn-outline-primary category-btn" data-category="VernierCaliper">
                            <i class="bi bi-rulers me-1"></i>Vernier Caliper (BLE)
                        </button>
                    </div>
                    <span asp-validation-for="DeviceCategory" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <!-- Node: Transmitter ID -->
                    <div class="col-md-6" id="fieldTransmitterId">
                        <label asp-for="TransmitterId" class="form-label fw-semibold">
                            Transmitter ID (Hardware Identifier)
                            <span class="tooltip-trigger border-0" data-tooltip="Must be unique across all physical devices.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <input asp-for="TransmitterId" class="form-control" data-no-spaces="true" placeholder="e.g. ESP32-TW-001 or MAC address" />
                        <span asp-validation-for="TransmitterId" class="text-danger small"></span>
                    </div>

                    <!-- Device Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold" id="labelName">Device Friendly Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Station 1 Torque Wrench" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Node: Instrument Type (hidden for BLE since set automatically) -->
                    <div class="col-md-6" id="fieldInstrumentType">
                        <label asp-for="InstrumentType" class="form-label fw-semibold"></label>
                        <select asp-for="InstrumentType" class="form-select" asp-items="Html.GetEnumSelectList<InstrumentType>()"></select>
                        <span asp-validation-for="InstrumentType" class="text-danger small"></span>
                    </div>

                    <!-- Location -->
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Assembly Line A, Station 3" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <!-- Node: Firmware Version -->
                    <div class="col-md-6" id="fieldFirmware">
                        <label asp-for="FirmwareVersion" class="form-label fw-semibold"></label>
                        <input asp-for="FirmwareVersion" class="form-control" placeholder="e.g. v1.0.0" />
                        <span asp-validation-for="FirmwareVersion" class="text-danger small"></span>
                    </div>

                    <!-- BLE: Protocol Mapping selector -->
                    <div class="col-md-6 d-none" id="fieldBleProtocol">
                        <label asp-for="BleProtocolId" class="form-label fw-semibold">
                            BLE Protocol Mapping
                            <span class="tooltip-trigger border-0" data-tooltip="Select how incoming BLE frames from this tool are parsed for the worker cockpit.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select asp-for="BleProtocolId" id="bleProtocolSelect" class="form-select">
                            <option value="">-- Auto / Default Tohnichi DF-3 --</option>
                            @foreach (var p in Model.AvailableProtocols)
                            {
                                var instVal = p.SupportedInstrumentType.HasValue ? ((int)p.SupportedInstrumentType.Value).ToString() : "";
                                var scopeLabel = !p.SupportedInstrumentType.HasValue ? "Universal" : (p.SupportedInstrumentType == InstrumentType.Torque ? "Torque" : "Vernier");
                                <option value="@p.BleProtocolId" data-uuid="@p.ServiceUuid" data-inst="@instVal">@p.Name (@scopeLabel)</option>
                            }
                        </select>
                        <span asp-validation-for="BleProtocolId" class="text-danger small"></span>
                    </div>

                    <!-- BLE: UUID field -->
                    <div class="col-md-6 d-none" id="fieldBleUuid">
                        <label asp-for="BleUuid" class="form-label fw-semibold">
                            BLE UUID
                            <span class="tooltip-trigger border-0" data-tooltip="Bluetooth service UUID (auto-filled from protocol mapping or custom).">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <input asp-for="BleUuid" id="bleUuidInput" class="form-control font-monospace" placeholder="e.g. 55df0001-a9b0-11e3-a5e2-000190f08f1e" />
                        <span asp-validation-for="BleUuid" class="text-danger small"></span>
                    </div>

                    <!-- Calibration Due -->
                    <div class="col-md-6">
                        <label asp-for="CalibrationDue" class="form-label fw-semibold"></label>
                        <input asp-for="CalibrationDue" type="date" class="form-control" />
                        <span asp-validation-for="CalibrationDue" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Node: API Key notice -->
                <div class="alert alert-info d-flex align-items-center gap-2 mt-4 mb-3 py-2" id="nodeKeyNotice">
                    <i class="bi bi-shield-lock-fill fs-5 text-primary"></i>
                    <div class="small">
                        <strong>Secure Key Generation:</strong> A cryptographically secure 192-bit API key will be generated upon save and displayed to you once for flashing to the transmitter.
                    </div>
                </div>

                <!-- BLE: UUID notice -->
                <div class="alert alert-primary d-flex align-items-center gap-2 mt-4 mb-3 py-2 d-none" id="bleNotice">
                    <i class="bi bi-bluetooth fs-5"></i>
                    <div class="small">
                        <strong>Bluetooth Device:</strong> This device will be identified by its BLE UUID. No API key is generated — the worker will pair via Bluetooth or QR scan.
                    </div>
                </div>

                <input type="hidden" asp-for="IsBluetoothDevice" id="isBluetoothDeviceInput" value="false" />

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4" id="submitBtn">
                        <i class="bi bi-check-circle me-1"></i><span id="submitBtnText">Register &amp; Generate Key</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const catInput = document.getElementById('deviceCategoryInput');
            const isBleInput = document.getElementById('isBluetoothDeviceInput');
            const submitBtnText = document.getElementById('submitBtnText');
            const fieldTransmitterId = document.getElementById('fieldTransmitterId');
            const fieldInstrumentType = document.getElementById('fieldInstrumentType');
            const fieldFirmware = document.getElementById('fieldFirmware');
            const fieldBleProtocol = document.getElementById('fieldBleProtocol');
            const bleProtocolSelect = document.getElementById('bleProtocolSelect');
            const fieldBleUuid = document.getElementById('fieldBleUuid');
            const bleUuidInput = document.getElementById('bleUuidInput');
            const nodeKeyNotice = document.getElementById('nodeKeyNotice');
            const bleNotice = document.getElementById('bleNotice');

            function syncUuidFromProtocol() {
                if (!bleProtocolSelect || !bleUuidInput) return;
                const opt = bleProtocolSelect.options[bleProtocolSelect.selectedIndex];
                const uuid = opt?.dataset?.uuid;
                if (uuid) bleUuidInput.value = uuid;
            }

            if (bleProtocolSelect) {
                bleProtocolSelect.addEventListener('change', syncUuidFromProtocol);
            }

            function setCategory(cat) {
                catInput.value = cat;
                const isBle = cat === 'TorqueWrench' || cat === 'VernierCaliper';
                isBleInput.value = isBle ? 'true' : 'false';

                // Toggle Node fields
                fieldTransmitterId.classList.toggle('d-none', isBle);
                fieldInstrumentType.classList.toggle('d-none', isBle);
                fieldFirmware.classList.toggle('d-none', isBle);
                nodeKeyNotice.classList.toggle('d-none', isBle);

                // Toggle BLE fields
                fieldBleProtocol.classList.toggle('d-none', !isBle);
                fieldBleUuid.classList.toggle('d-none', !isBle);
                bleNotice.classList.toggle('d-none', !isBle);

                if (isBle && bleProtocolSelect) {
                    const targetInst = cat === 'VernierCaliper' ? '2' : '1';
                    let firstMatchingVal = '';
                    Array.from(bleProtocolSelect.options).forEach(opt => {
                        if (!opt.value) return;
                        const inst = opt.dataset.inst || '';
                        const ok = inst === '' || inst === targetInst;
                        opt.hidden = !ok;
                        if (ok && !firstMatchingVal && inst === targetInst) firstMatchingVal = opt.value;
                    });
                    const curOpt = bleProtocolSelect.options[bleProtocolSelect.selectedIndex];
                    if (!curOpt || curOpt.hidden || !curOpt.value) {
                        if (firstMatchingVal) bleProtocolSelect.value = firstMatchingVal;
                    }
                    syncUuidFromProtocol();
                }

                submitBtnText.textContent = isBle ? 'Register BLE Device' : 'Register & Generate Key';

                // Update active button
                document.querySelectorAll('.category-btn').forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.category === cat);
                    btn.classList.toggle('btn-primary', btn.dataset.category === cat);
                    btn.classList.toggle('btn-outline-primary', btn.dataset.category !== cat);
                });
            }

            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.addEventListener('click', () => setCategory(btn.dataset.category));
            });

            // Initialize
            setCategory(catInput.value || 'Node');
        })();
    </script>
}
