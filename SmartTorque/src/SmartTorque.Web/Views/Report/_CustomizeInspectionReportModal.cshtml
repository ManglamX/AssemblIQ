@* Modal: Customize QA Inspection Report (FL/QAD/F/42) *@
<div class="modal fade" id="modalCustomizeInspectionReport" tabindex="-1" aria-labelledby="modalCustomizeReportLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="modalCustomizeReportLabel">
                        <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Customize Inspection Report
                    </h5>
                    <div class="small text-white-50 mt-1">
                        Format: <span class="badge bg-secondary">FL/QAD/F/42</span> | Tailor header metadata, division, drawing number, and QA attestation
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="formCustomizeInspectionReport" method="get" target="_blank" action="@Url.Action("ExportProductUnitPdf", "Report")">
                <input type="hidden" id="reportJobId" name="jobId" value="" />
                <input type="hidden" id="reportUnitNo" name="unitNo" value="" />
                <input type="hidden" id="reportToken" name="token" value="" />
                <input type="hidden" id="hiddenFieldsInput" name="HiddenFields" value="" />

                <div class="modal-body p-4">
                    <!-- Target Unit Banner -->
                    <div class="alert alert-light border border-secondary-subtle d-flex justify-content-between align-items-center mb-4 py-2 px-3">
                        <div>
                            <span class="small text-muted d-block">Target Product Unit:</span>
                            <strong id="modalProductLabel" class="text-dark">Loading...</strong>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary font-monospace" id="modalTokenBadge">PRD-UNIT</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Section 1: Company Header -->
                        <div class="col-12 pdf-field" data-field="Section1Heading">
                            <div class="d-flex align-items-center pb-2 border-bottom">
                                <i class="bi bi-building text-primary me-2"></i>
                                <input type="text" class="form-control form-control-sm section-heading" id="hdrSection1Heading" name="Section1Heading"
                                       value="1. Company & Division Header" placeholder="Section heading" title="Heading printed in the PDF. Edit the text or hide it." />
                            </div>
                        </div>

                        <div class="col-md-6 pdf-field" data-field="CompanyName">
                            <input type="text" class="field-label-input" id="lblCompanyName" name="CompanyNameLabel" value="Company Name" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrCompanyName" name="CompanyName" 
                                   value="Godrej & Boyce Mfg. Co. Ltd." placeholder="e.g. Godrej & Boyce Mfg. Co. Ltd." required />
                        </div>
                        <div class="col-md-6 pdf-field" data-field="DivisionName">
                            <input type="text" class="field-label-input" id="lblDivisionName" name="DivisionNameLabel" value="Division / Manufacturing Unit" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrDivisionName" name="DivisionName" 
                                   value="Security Solutions Division" placeholder="e.g. Security Solutions Division" required />
                        </div>
                        <div class="col-12 pdf-field" data-field="RecordTitle">
                            <input type="text" class="field-label-input" id="lblRecordTitle" name="RecordTitleLabel" value="Record Subtitle" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrRecordTitle" name="RecordTitle" 
                                   value="Plant Quality Assurance Record" placeholder="e.g. Plant Quality Assurance Record" />
                        </div>

                        <!-- Section 2: Document Numbering & Quality Standards -->
                        <div class="col-12 mt-4 pdf-field" data-field="Section2Heading">
                            <div class="d-flex align-items-center pb-2 border-bottom">
                                <i class="bi bi-shield-check text-success me-2"></i>
                                <input type="text" class="form-control form-control-sm section-heading" id="hdrSection2Heading" name="Section2Heading"
                                       value="2. Document Identification & Quality Standards" placeholder="Section heading" title="Heading printed in the PDF. Edit the text or hide it." />
                            </div>
                        </div>

                        <div class="col-md-6 pdf-field" data-field="DocTitle">
                            <input type="text" class="field-label-input" id="lblDocTitle" name="DocTitleLabel" value="Document Title" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrDocTitle" name="DocTitle" 
                                   value="INSPECTION REPORT" required />
                        </div>
                        <div class="col-md-6 pdf-field" data-field="CheckSubtitle">
                            <input type="text" class="field-label-input" id="lblCheckSubtitle" name="CheckSubtitleLabel" value="Process / Check Subtitle" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrCheckSubtitle" name="CheckSubtitle" 
                                   value="CHECK FOR FASTENER & BOLT TORQUE" required />
                        </div>

                        <div class="col-md-4 pdf-field" data-field="DocumentNo">
                            <input type="text" class="field-label-input" id="lblDocumentNo" name="DocumentNoLabel" value="Document No." title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrDocumentNo" name="DocumentNo" 
                                   value="FL/QAD/F/42" required />
                        </div>
                        <div class="col-md-4 pdf-field" data-field="RevisionInfo">
                            <input type="text" class="field-label-input" id="lblRevisionInfo" name="RevisionInfoLabel" value="Revision & Date" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrRevisionInfo" name="RevisionInfo" 
                                   value="Revision No: 00 | Date: 09.08.17" />
                        </div>
                        <div class="col-md-4 pdf-field" data-field="QualityStandard">
                            <input type="text" class="field-label-input" id="lblQualityStandard" name="QualityStandardLabel" value="Quality Standard Reference" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrQualityStandard" name="QualityStandard" 
                                   value="Standard: ISO 9001 / IATF 16949" />
                        </div>

                        <div class="col-md-6 pdf-field" data-field="DrawingPoNo">
                            <input type="text" class="field-label-input" id="lblDrawingPoNo" name="DrawingPoNoLabel" value="Drawing / PO Number" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrDrawingPoNo" name="DrawingPoNo" 
                                   value="" placeholder="e.g. 558-3680 or PO Number" />
                        </div>
                        <div class="col-md-6 pdf-field" data-field="CertificateSubtitle">
                            <input type="text" class="field-label-input" id="lblCertificateSubtitle" name="CertificateSubtitleLabel" value="Certificate Subtitle" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrCertificateSubtitle" name="CertificateSubtitle" 
                                   value="Single Product Quality Certificate" />
                        </div>

                        <!-- Section 3: QA Attestation & Workforce -->
                        <div class="col-12 mt-4 pdf-field" data-field="Section3Heading">
                            <div class="d-flex align-items-center pb-2 border-bottom">
                                <i class="bi bi-person-badge text-warning me-2"></i>
                                <input type="text" class="form-control form-control-sm section-heading" id="hdrSection3Heading" name="Section3Heading"
                                       value="3. QA Attestation & Engineer Sign-Off" placeholder="Section heading" title="Heading printed in the PDF. Edit the text or hide it." />
                            </div>
                        </div>

                        <div class="col-12 pdf-field" data-field="Remarks">
                            <input type="text" class="field-label-input" id="lblRemarks" name="RemarksLabel" value="Quality Attestation / Remarks" title="Label printed in the PDF. Edit the text." />
                            <textarea class="form-control form-control-sm" id="hdrRemarks" name="Remarks" rows="2">All critical fastener torques digitally acquired via IoT calibrated instruments and verified against engineering drawing tolerances.</textarea>
                        </div>
                        <div class="col-md-6 pdf-field" data-field="InspectorTitle">
                            <input type="text" class="field-label-input" id="lblInspectorTitle" name="InspectorTitleLabel" value="Inspection Engineer / QA Title" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrInspectorTitle" name="InspectorTitle" 
                                   value="Inspection Engineer / QA" />
                        </div>
                        <div class="col-md-6 pdf-field" data-field="QaSignatory">
                            <input type="text" class="field-label-input" id="lblQaSignatory" name="QaSignatoryLabel" value="Digital Seal / Approval Attestation" title="Label printed in the PDF. Edit the text." />
                            <input type="text" class="form-control form-control-sm" id="hdrQaSignatory" name="QaSignatory" 
                                   value="DIGITALLY AUDITED & APPROVED" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light d-flex justify-content-between py-2 px-4">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="chkRememberHeader" checked />
                        <label class="form-check-label small text-muted" for="chkRememberHeader">
                            Remember custom header on this device
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetReportHeaderDefaults()">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Standard
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
                            <i class="bi bi-file-earmark-pdf me-1"></i>Generate & Download PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    #modalCustomizeInspectionReport .pdf-field { position: relative; }
    #modalCustomizeInspectionReport .pdf-field .form-label { padding-right: 26px; }
    #modalCustomizeInspectionReport .field-label-input {
        display: block; width: 100%; border: 0; background: transparent;
        padding: 0 26px 2px 0; margin: 0 0 2px 0;
        font-size: .8rem; font-weight: 600; color: #475569; line-height: 1.2;
    }
    #modalCustomizeInspectionReport .field-label-input:hover { border-bottom: 1px dashed #cbd5e1; }
    #modalCustomizeInspectionReport .field-label-input:focus { outline: none; box-shadow: none; border-bottom: 1px dashed #b0105a; }
    #modalCustomizeInspectionReport .pdf-toggle {
        position: absolute; top: 0; right: 12px; z-index: 3;
        width: 22px; height: 22px; padding: 0; line-height: 20px; text-align: center;
        border: 0; border-radius: 4px; background: transparent; color: #94a3b8;
    }
    #modalCustomizeInspectionReport .pdf-toggle:hover { color: #b0105a; background: #f1f5f9; }
    #modalCustomizeInspectionReport .pdf-field.pdf-hidden .pdf-toggle { color: #b0105a; }
    #modalCustomizeInspectionReport .pdf-field.pdf-hidden > *:not(.pdf-toggle) { opacity: .45; }
    #modalCustomizeInspectionReport .section-heading {
        border: 0; background: transparent; font-weight: 700; color: #0f172a;
        padding-left: 0; padding-right: 32px;
    }
    #modalCustomizeInspectionReport .section-heading:focus { box-shadow: none; border-bottom: 1px dashed #b0105a; }
</style>

<script>
    const DEFAULT_HEADER_SETTINGS = {
        CompanyName: "Godrej & Boyce Mfg. Co. Ltd.",
        DivisionName: "Security Solutions Division",
        RecordTitle: "Plant Quality Assurance Record",
        DocTitle: "INSPECTION REPORT",
        CheckSubtitle: "CHECK FOR FASTENER & BOLT TORQUE",
        CertificateSubtitle: "Single Product Quality Certificate",
        DocumentNo: "FL/QAD/F/42",
        RevisionInfo: "Revision No: 00 | Date: 09.08.17",
        QualityStandard: "Standard: ISO 9001 / IATF 16949",
        Remarks: "All critical fastener torques digitally acquired via IoT calibrated instruments and verified against engineering drawing tolerances.",
        InspectorTitle: "Inspection Engineer / QA",
        QaSignatory: "DIGITALLY AUDITED & APPROVED",
        Section1Heading: "1. Company & Division Header",
        Section2Heading: "2. Document Identification & Quality Standards",
        Section3Heading: "3. QA Attestation & Engineer Sign-Off",
        HiddenFields: [],
        CompanyNameLabel: "Company Name",
        DivisionNameLabel: "Division / Manufacturing Unit",
        RecordTitleLabel: "Record Subtitle",
        DocTitleLabel: "Document Title",
        CheckSubtitleLabel: "Process / Check Subtitle",
        CertificateSubtitleLabel: "Certificate Subtitle",
        DocumentNoLabel: "Document No.",
        RevisionInfoLabel: "Revision & Date",
        QualityStandardLabel: "Quality Standard Reference",
        DrawingPoNoLabel: "Drawing / PO Number",
        RemarksLabel: "Quality Attestation / Remarks",
        InspectorTitleLabel: "Inspection Engineer / QA Title",
        QaSignatoryLabel: "Digital Seal / Approval Attestation"
    };

    function initPdfFieldToggles() {
        document.querySelectorAll('#modalCustomizeInspectionReport .pdf-field').forEach(function (wrap) {
            if (wrap.dataset.toggleBound === '1') return;
            wrap.dataset.toggleBound = '1';
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'pdf-toggle';
            btn.title = 'Show / hide in the PDF';
            btn.innerHTML = '<i class="bi bi-eye"></i>';
            btn.addEventListener('click', function () {
                wrap.classList.toggle('pdf-hidden');
                syncHiddenFieldsInput();
            });
            wrap.appendChild(btn);
        });
    }

    function getHiddenFields() {
        const hidden = [];
        document.querySelectorAll('#modalCustomizeInspectionReport .pdf-field.pdf-hidden').forEach(function (wrap) {
            if (wrap.dataset.field) hidden.push(wrap.dataset.field);
        });
        return hidden;
    }

    function setHiddenFieldsState(hiddenList) {
        const set = new Set((hiddenList || []).map(function (f) { return String(f).trim(); }));
        document.querySelectorAll('#modalCustomizeInspectionReport .pdf-field').forEach(function (wrap) {
            wrap.classList.toggle('pdf-hidden', set.has(wrap.dataset.field));
        });
        syncHiddenFieldsInput();
    }

    function syncHiddenFieldsInput() {
        const input = document.getElementById('hiddenFieldsInput');
        if (input) input.value = getHiddenFields().join(',');
    }

    function loadSavedHeaderSettings() {
        try {
            const raw = localStorage.getItem('smarttorque_custom_inspection_header');
            if (raw) {
                const s = JSON.parse(raw);
                if (s.CompanyName) document.getElementById('hdrCompanyName').value = s.CompanyName;
                if (s.DivisionName) document.getElementById('hdrDivisionName').value = s.DivisionName;
                if (s.RecordTitle) document.getElementById('hdrRecordTitle').value = s.RecordTitle;
                if (s.DocTitle) document.getElementById('hdrDocTitle').value = s.DocTitle;
                if (s.CheckSubtitle) document.getElementById('hdrCheckSubtitle').value = s.CheckSubtitle;
                if (s.CertificateSubtitle) document.getElementById('hdrCertificateSubtitle').value = s.CertificateSubtitle;
                if (s.DocumentNo) document.getElementById('hdrDocumentNo').value = s.DocumentNo;
                if (s.RevisionInfo) document.getElementById('hdrRevisionInfo').value = s.RevisionInfo;
                if (s.QualityStandard) document.getElementById('hdrQualityStandard').value = s.QualityStandard;
                if (s.Remarks) document.getElementById('hdrRemarks').value = s.Remarks;
                if (s.InspectorTitle) document.getElementById('hdrInspectorTitle').value = s.InspectorTitle;
                if (s.QaSignatory) document.getElementById('hdrQaSignatory').value = s.QaSignatory;
                if (s.Section1Heading) document.getElementById('hdrSection1Heading').value = s.Section1Heading;
                if (s.Section2Heading) document.getElementById('hdrSection2Heading').value = s.Section2Heading;
                if (s.Section3Heading) document.getElementById('hdrSection3Heading').value = s.Section3Heading;
                if (s.CompanyNameLabel) document.getElementById('lblCompanyName').value = s.CompanyNameLabel;
                if (s.DivisionNameLabel) document.getElementById('lblDivisionName').value = s.DivisionNameLabel;
                if (s.RecordTitleLabel) document.getElementById('lblRecordTitle').value = s.RecordTitleLabel;
                if (s.DocTitleLabel) document.getElementById('lblDocTitle').value = s.DocTitleLabel;
                if (s.CheckSubtitleLabel) document.getElementById('lblCheckSubtitle').value = s.CheckSubtitleLabel;
                if (s.CertificateSubtitleLabel) document.getElementById('lblCertificateSubtitle').value = s.CertificateSubtitleLabel;
                if (s.DocumentNoLabel) document.getElementById('lblDocumentNo').value = s.DocumentNoLabel;
                if (s.RevisionInfoLabel) document.getElementById('lblRevisionInfo').value = s.RevisionInfoLabel;
                if (s.QualityStandardLabel) document.getElementById('lblQualityStandard').value = s.QualityStandardLabel;
                if (s.DrawingPoNoLabel) document.getElementById('lblDrawingPoNo').value = s.DrawingPoNoLabel;
                if (s.RemarksLabel) document.getElementById('lblRemarks').value = s.RemarksLabel;
                if (s.InspectorTitleLabel) document.getElementById('lblInspectorTitle').value = s.InspectorTitleLabel;
                if (s.QaSignatoryLabel) document.getElementById('lblQaSignatory').value = s.QaSignatoryLabel;
                if (Array.isArray(s.HiddenFields)) setHiddenFieldsState(s.HiddenFields);
            }
        } catch (e) {
            console.warn("Could not load header settings from localStorage", e);
        }
    }

    function resetReportHeaderDefaults() {
        document.getElementById('hdrCompanyName').value = DEFAULT_HEADER_SETTINGS.CompanyName;
        document.getElementById('hdrDivisionName').value = DEFAULT_HEADER_SETTINGS.DivisionName;
        document.getElementById('hdrRecordTitle').value = DEFAULT_HEADER_SETTINGS.RecordTitle;
        document.getElementById('hdrDocTitle').value = DEFAULT_HEADER_SETTINGS.DocTitle;
        document.getElementById('hdrCheckSubtitle').value = DEFAULT_HEADER_SETTINGS.CheckSubtitle;
        document.getElementById('hdrCertificateSubtitle').value = DEFAULT_HEADER_SETTINGS.CertificateSubtitle;
        document.getElementById('hdrDocumentNo').value = DEFAULT_HEADER_SETTINGS.DocumentNo;
        document.getElementById('hdrRevisionInfo').value = DEFAULT_HEADER_SETTINGS.RevisionInfo;
        document.getElementById('hdrQualityStandard').value = DEFAULT_HEADER_SETTINGS.QualityStandard;
        document.getElementById('hdrRemarks').value = DEFAULT_HEADER_SETTINGS.Remarks;
        document.getElementById('hdrInspectorTitle').value = DEFAULT_HEADER_SETTINGS.InspectorTitle;
        document.getElementById('hdrQaSignatory').value = DEFAULT_HEADER_SETTINGS.QaSignatory;
        document.getElementById('hdrSection1Heading').value = DEFAULT_HEADER_SETTINGS.Section1Heading;
        document.getElementById('hdrSection2Heading').value = DEFAULT_HEADER_SETTINGS.Section2Heading;
        document.getElementById('hdrSection3Heading').value = DEFAULT_HEADER_SETTINGS.Section3Heading;
        document.getElementById('lblCompanyName').value = DEFAULT_HEADER_SETTINGS.CompanyNameLabel;
        document.getElementById('lblDivisionName').value = DEFAULT_HEADER_SETTINGS.DivisionNameLabel;
        document.getElementById('lblRecordTitle').value = DEFAULT_HEADER_SETTINGS.RecordTitleLabel;
        document.getElementById('lblDocTitle').value = DEFAULT_HEADER_SETTINGS.DocTitleLabel;
        document.getElementById('lblCheckSubtitle').value = DEFAULT_HEADER_SETTINGS.CheckSubtitleLabel;
        document.getElementById('lblCertificateSubtitle').value = DEFAULT_HEADER_SETTINGS.CertificateSubtitleLabel;
        document.getElementById('lblDocumentNo').value = DEFAULT_HEADER_SETTINGS.DocumentNoLabel;
        document.getElementById('lblRevisionInfo').value = DEFAULT_HEADER_SETTINGS.RevisionInfoLabel;
        document.getElementById('lblQualityStandard').value = DEFAULT_HEADER_SETTINGS.QualityStandardLabel;
        document.getElementById('lblDrawingPoNo').value = DEFAULT_HEADER_SETTINGS.DrawingPoNoLabel;
        document.getElementById('lblRemarks').value = DEFAULT_HEADER_SETTINGS.RemarksLabel;
        document.getElementById('lblInspectorTitle').value = DEFAULT_HEADER_SETTINGS.InspectorTitleLabel;
        document.getElementById('lblQaSignatory').value = DEFAULT_HEADER_SETTINGS.QaSignatoryLabel;
        setHiddenFieldsState([]);
        try {
            localStorage.removeItem('smarttorque_custom_inspection_header');
        } catch (e) {}
    }

    function openReportModal(jobId, unitNo, token, productTitle, drawingNo) {
        document.getElementById('reportJobId').value = jobId || '';
        document.getElementById('reportUnitNo').value = unitNo || '';
        document.getElementById('reportToken').value = token || '';
        document.getElementById('modalProductLabel').innerText = (productTitle || ('Job #' + jobId + ' Unit #' + unitNo));
        document.getElementById('modalTokenBadge').innerText = token || ('Unit #' + unitNo);
        if (drawingNo) {
            document.getElementById('hdrDrawingPoNo').value = drawingNo;
        }

        const form = document.getElementById('formCustomizeInspectionReport');
        if (jobId && unitNo) {
            form.action = '@Url.Action("ExportProductUnitPdf", "Report")';
            document.getElementById('reportJobId').disabled = false;
            document.getElementById('reportUnitNo').disabled = false;
            document.getElementById('reportToken').disabled = true;
        } else if (token) {
            form.action = '@Url.Action("ExportProductUnitPdfByToken", "Report")';
            document.getElementById('reportJobId').disabled = true;
            document.getElementById('reportUnitNo').disabled = true;
            document.getElementById('reportToken').disabled = false;
        }

        loadSavedHeaderSettings();
        const modal = new bootstrap.Modal(document.getElementById('modalCustomizeInspectionReport'));
        modal.show();
    }

    function openReportModalByToken(token) {
        openReportModal(null, null, token, 'PRD Unit Traceability', token);
    }

    document.addEventListener('DOMContentLoaded', function () {
        initPdfFieldToggles();
        loadSavedHeaderSettings();

        const form = document.getElementById('formCustomizeInspectionReport');
        if (form) {
            form.addEventListener('submit', function () {
                syncHiddenFieldsInput();

                const remember = document.getElementById('chkRememberHeader').checked;
                if (remember) {
                    const settings = {
                        CompanyName: document.getElementById('hdrCompanyName').value,
                        DivisionName: document.getElementById('hdrDivisionName').value,
                        RecordTitle: document.getElementById('hdrRecordTitle').value,
                        DocTitle: document.getElementById('hdrDocTitle').value,
                        CheckSubtitle: document.getElementById('hdrCheckSubtitle').value,
                        CertificateSubtitle: document.getElementById('hdrCertificateSubtitle').value,
                        DocumentNo: document.getElementById('hdrDocumentNo').value,
                        RevisionInfo: document.getElementById('hdrRevisionInfo').value,
                        QualityStandard: document.getElementById('hdrQualityStandard').value,
                        Remarks: document.getElementById('hdrRemarks').value,
                        InspectorTitle: document.getElementById('hdrInspectorTitle').value,
                        QaSignatory: document.getElementById('hdrQaSignatory').value,
                        Section1Heading: document.getElementById('hdrSection1Heading').value,
                        Section2Heading: document.getElementById('hdrSection2Heading').value,
                        Section3Heading: document.getElementById('hdrSection3Heading').value,
                        HiddenFields: getHiddenFields(),
                        CompanyNameLabel: document.getElementById('lblCompanyName').value,
                        DivisionNameLabel: document.getElementById('lblDivisionName').value,
                        RecordTitleLabel: document.getElementById('lblRecordTitle').value,
                        DocTitleLabel: document.getElementById('lblDocTitle').value,
                        CheckSubtitleLabel: document.getElementById('lblCheckSubtitle').value,
                        CertificateSubtitleLabel: document.getElementById('lblCertificateSubtitle').value,
                        DocumentNoLabel: document.getElementById('lblDocumentNo').value,
                        RevisionInfoLabel: document.getElementById('lblRevisionInfo').value,
                        QualityStandardLabel: document.getElementById('lblQualityStandard').value,
                        DrawingPoNoLabel: document.getElementById('lblDrawingPoNo').value,
                        RemarksLabel: document.getElementById('lblRemarks').value,
                        InspectorTitleLabel: document.getElementById('lblInspectorTitle').value,
                        QaSignatoryLabel: document.getElementById('lblQaSignatory').value
                    };
                    try {
                        localStorage.setItem('smarttorque_custom_inspection_header', JSON.stringify(settings));
                    } catch (e) {}
                }

                // Auto dismiss modal after 1 second so UI stays responsive
                setTimeout(function () {
                    const modalEl = document.getElementById('modalCustomizeInspectionReport');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }, 1000);
            });
        }
    });
</script>
