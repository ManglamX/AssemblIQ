@using SmartTorque.Core.Enums
@model SmartTorque.Services.SessionDetailDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Session #{Model.SessionId} Audit Details";
    ViewData["ActiveNav"] = "Reports";
}

@{
    var finalSteps = Model.Steps
        .GroupBy(s => s.StepSequence)
        .Select(g => g.OrderBy(r => r.AttemptNo).Last())
        .OrderBy(s => s.StepSequence)
        .ToList();

    var totalFinalSteps = finalSteps.Count;
    var passCount = finalSteps.Count(s => s.Result == StepResult.Pass);
    var firstAttemptPassCount = finalSteps.Count(s => s.AttemptNo == 1 && s.Result == StepResult.Pass);
    var firstAttemptRate = totalFinalSteps > 0 ? Math.Round((double)firstAttemptPassCount / totalFinalSteps * 100, 1) : 0;
    var avgBias = finalSteps.Count > 0 ? Math.Round((double)finalSteps.Average(s => s.ActualValue - s.TargetValue), 3) : 0;
    var maxAbsDev = finalSteps.Count > 0 ? Math.Round((double)finalSteps.Max(s => Math.Abs(s.ActualValue - s.TargetValue)), 2) : 0;

    double sessionCpk = 0;
    if (finalSteps.Count >= 2)
    {
        var vals = finalSteps.Select(s => (double)s.ActualValue).ToList();
        double mean = vals.Average();
        double sumSq = vals.Sum(v => (v - mean) * (v - mean));
        double sigma = Math.Sqrt(sumSq / (vals.Count - 1));
        double avgLsl = finalSteps.Average(s => (double)s.LowerLimit);
        double avgUsl = finalSteps.Average(s => (double)s.UpperLimit);
        if (sigma > 1e-6 && avgUsl > avgLsl)
        {
            sessionCpk = Math.Round(Math.Min((avgUsl - mean) / (3 * sigma), (mean - avgLsl) / (3 * sigma)), 2);
        }
    }

    var failedBolts = Model.Steps.GroupBy(s => s.StepSequence)
        .Where(g => g.OrderBy(r => r.AttemptNo).Last().Result == StepResult.Fail)
        .ToList();

    var overallPass = Model.FinalResult == SessionResult.Pass;
    var cpkLabel = sessionCpk >= 1.67 ? "Excellent (5σ)" : sessionCpk >= 1.33 ? "Capable (4σ)" : sessionCpk >= 1.00 ? "Marginal" : (sessionCpk > 0 ? "Not Capable" : "N/A");
    var cpkColor = sessionCpk >= 1.67 ? "#198754" : sessionCpk >= 1.33 ? "#0d6efd" : sessionCpk >= 1.00 ? "#fd7e14" : "#dc3545";
    var biasLabel = Math.Abs(avgBias) < 0.05 ? "Centred on target" : avgBias > 0 ? "Pulling high" : "Pulling low";
    var totalSteps = Model.Steps.Count;
    var istDuration = Model.Duration.HasValue ? $"{Model.Duration.Value.TotalMinutes:0.0} min" : "In Progress";
}

<style>
    /* ── Professional Inspection Report Styles ── */
    .rpt-page {
        max-width: 1100px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
        font-size: 0.875rem;
        color: #1a1a2e;
    }

    /* Section containers */
    .rpt-section {
        border: 1px solid #c8cdd5;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .rpt-section-header {
        background: #f1f3f7;
        border-bottom: 1px solid #c8cdd5;
        padding: 7px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4a5568;
    }

    .rpt-section-body {
        padding: 14px 16px;
        background: #fff;
    }

    /* Header banner */
    .rpt-doc-header {
        background: #fff;
        border: 2px solid #1a1a2e;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .rpt-doc-header-inner {
        display: grid;
        grid-template-columns: 1fr 2fr 1.4fr;
        border-bottom: 1px solid #c8cdd5;
    }

    .rpt-doc-header-cell {
        padding: 12px 16px;
        border-right: 1px solid #c8cdd5;
    }

    .rpt-doc-header-cell:last-child {
        border-right: none;
    }

    .rpt-doc-title {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        color: #1a1a2e;
        line-height: 1.2;
    }

    .rpt-doc-subtitle {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #374151;
        margin-top: 2px;
    }

    .rpt-doc-label {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
    }

    .rpt-doc-value {
        font-size: 0.8rem;
        font-weight: 600;
        color: #111827;
    }

    /* Status badge */
    .rpt-status-badge {
        display: inline-block;
        padding: 5px 16px;
        border-radius: 4px;
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        border: 2px solid;
    }

    .rpt-status-pass {
        color: #166534;
        background: #dcfce7;
        border-color: #166534;
    }

    .rpt-status-fail {
        color: #991b1b;
        background: #fee2e2;
        border-color: #991b1b;
    }

    /* Metadata grid */
    .rpt-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
    }

    .rpt-meta-cell {
        padding: 10px 14px;
        border-right: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
    }

    .rpt-meta-cell:nth-child(even) { border-right: none; }
    .rpt-meta-cell:nth-last-child(-n+2) { border-bottom: none; }

    .rpt-meta-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6b7280;
        margin-bottom: 2px;
    }

    .rpt-meta-value {
        font-size: 0.82rem;
        font-weight: 600;
        color: #111827;
        line-height: 1.4;
    }

    .rpt-meta-value.mono {
        font-family: 'Cascadia Code', 'Consolas', monospace;
        font-size: 0.78rem;
    }

    /* KPI strip */
    .rpt-kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: #c8cdd5;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .rpt-kpi-cell {
        background: #fff;
        padding: 14px 16px;
        text-align: center;
    }

    .rpt-kpi-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .rpt-kpi-value {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .rpt-kpi-sub {
        font-size: 0.7rem;
        color: #6b7280;
        font-weight: 500;
    }

    /* Session block */
    .rpt-session-block {
        border: 1px solid #c8cdd5;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .rpt-session-header {
        background: #374151;
        color: #fff;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 0.82rem;
    }

    .rpt-session-id {
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.03em;
    }

    .rpt-session-meta {
        font-size: 0.74rem;
        color: #d1d5db;
        font-weight: 500;
    }

    /* Step table */
    .rpt-step-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
    }

    .rpt-step-table thead tr {
        background: #f8f9fb;
    }

    .rpt-step-table thead th {
        padding: 8px 10px;
        text-align: left;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #374151;
        border-bottom: 2px solid #c8cdd5;
        border-right: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .rpt-step-table thead th:last-child { border-right: none; }

    .rpt-step-table tbody td {
        padding: 8px 10px;
        border-bottom: 1px solid #f0f1f4;
        border-right: 1px solid #f0f1f4;
        vertical-align: middle;
    }

    .rpt-step-table tbody td:last-child { border-right: none; }

    .rpt-step-table tbody tr:last-child td { border-bottom: none; }

    .rpt-step-table tbody tr:hover { background: #f8f9fb; }

    .rpt-step-table .rpt-row-rework { background: #fff9f0; }

    .rpt-step-num {
        font-weight: 700;
        color: #374151;
        font-size: 0.82rem;
    }

    .rpt-step-label {
        font-weight: 600;
        color: #111827;
    }

    .rpt-limits-cell {
        font-family: 'Cascadia Code', 'Consolas', monospace;
        font-size: 0.75rem;
        color: #374151;
        white-space: nowrap;
    }

    .rpt-measured-pass {
        font-weight: 800;
        color: #166534;
        font-size: 0.88rem;
    }

    .rpt-measured-fail {
        font-weight: 800;
        color: #991b1b;
        font-size: 0.88rem;
    }

    .rpt-badge-pass {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .rpt-badge-fail {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .rpt-badge-rework {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
        border-radius: 4px;
        padding: 1px 6px;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    /* Chart section */
    .rpt-chart-section {
        border: 1px solid #c8cdd5;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        overflow: hidden;
        background: #fff;
    }

    .rpt-chart-header {
        background: #f1f3f7;
        border-bottom: 1px solid #c8cdd5;
        padding: 10px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .rpt-chart-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #111827;
        letter-spacing: 0.01em;
    }

    .rpt-chart-subtitle {
        font-size: 0.7rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .rpt-legend-dot {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 2px;
        vertical-align: middle;
    }

    .rpt-legend-item {
        font-size: 0.72rem;
        color: #374151;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Attestation footer */
    .rpt-attestation-grid {
        display: grid;
        grid-template-columns: 1fr 1.6fr 1fr;
        gap: 0;
    }

    .rpt-attest-cell {
        padding: 12px 14px;
        border-right: 1px solid #c8cdd5;
    }

    .rpt-attest-cell:last-child { border-right: none; }

    .rpt-attest-title {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #374151;
        margin-bottom: 6px;
    }

    .rpt-attest-body {
        font-size: 0.74rem;
        color: #4b5563;
        line-height: 1.6;
    }

    .rpt-attest-sig-line {
        border-bottom: 1px solid #9ca3af;
        margin-top: 16px;
        margin-bottom: 2px;
    }

    .rpt-attest-sig-label {
        font-size: 0.65rem;
        color: #9ca3af;
    }

    .rpt-dig-approved {
        display: inline-block;
        border: 2px solid #166534;
        color: #166534;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        padding: 5px 12px;
        border-radius: 4px;
        background: #f0fdf4;
        margin-top: 8px;
    }

    /* SHA hash */
    .rpt-sha {
        font-family: 'Cascadia Code', 'Consolas', monospace;
        font-size: 0.65rem;
        color: #6b7280;
        word-break: break-all;
        line-height: 1.4;
    }

    /* Defect alert box */
    .rpt-defect-alert {
        border: 1.5px solid #dc2626;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .rpt-defect-header {
        background: #fee2e2;
        border-bottom: 1px solid #fecaca;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #991b1b;
    }

    /* Print adjustments */
    @@media print {
        .rpt-no-print { display: none !important; }
        .rpt-page { max-width: 100%; }
        .rpt-doc-header { border: 2px solid #000; }
        .rpt-section, .rpt-session-block, .rpt-chart-section { border: 1px solid #aaa; }
        .rpt-session-header { background: #374151 !important; -webkit-print-color-adjust: exact; }
    }
</style>

<div class="rpt-page">

    <!-- Breadcrumb + Actions -->
    <div class="d-flex justify-content-between align-items-center mb-3 rpt-no-print">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Sessions">Reports</a></li>
                <li class="breadcrumb-item active" aria-current="page">Session #@Model.SessionId</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print / Export PDF
            </button>
        </div>
    </div>

    <!-- ══ DOCUMENT HEADER ══ -->
    <div class="rpt-doc-header">
        <!-- Top band: Company | Document Title | Doc No -->
        <div class="rpt-doc-header-inner">
            <div class="rpt-doc-header-cell">
                <div class="rpt-doc-label">Company / Division</div>
                <div style="font-size:1rem; font-weight:800; color:#1a1a2e; margin-top:3px;">AssemblIQ</div>
                <div class="rpt-doc-value" style="margin-top:2px;">SmartTorque Quality Module</div>
                <div class="rpt-doc-label" style="margin-top:4px;">Record Type</div>
                <div style="font-size:0.72rem; color:#4a5568; margin-top:1px;">Plant Quality Assurance Record</div>
            </div>
            <div class="rpt-doc-header-cell" style="display:flex; flex-direction:column; justify-content:center;">
                <div class="rpt-doc-title">INSPECTION REPORT</div>
                <div class="rpt-doc-subtitle">CHECK FOR FASTENER &amp; BOLT TORQUE</div>
                <div style="font-size:0.68rem; color:#6b7280; margin-top:4px;">Certificate Subtitle: Single Product Quality Certificate — ISO 9001 / IATF 16949</div>
            </div>
            <div class="rpt-doc-header-cell" style="display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div class="rpt-doc-label">Document No.</div>
                    <div class="rpt-doc-value mono">ST/QA/S-@Model.SessionId</div>
                    <div class="rpt-doc-label" style="margin-top:5px;">Revision / Date</div>
                    <div class="rpt-doc-value">Rev 00 &nbsp;·&nbsp; @Model.StartTime.ToIstString("dd.MM.yyyy")</div>
                    <div class="rpt-doc-label" style="margin-top:5px;">Quality Standard</div>
                    <div style="font-size:0.72rem; color:#374151;">ISO 9001 / IATF 16949</div>
                </div>
            </div>
        </div>
        <!-- Bottom band: Identity + Status -->
        <div style="display:grid; grid-template-columns: 1fr auto; align-items:center; padding:10px 16px; background:#fafbfc; border-top:1px solid #c8cdd5; gap:16px;">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px;">
                <div>
                    <div class="rpt-doc-label">Part / Product</div>
                    <div class="rpt-doc-value">@Model.ProductCode — @Model.ProductName</div>
                    <div class="rpt-doc-label" style="margin-top:4px;">Job Order No.</div>
                    <div class="rpt-doc-value mono">@Model.JobNo</div>
                </div>
                <div>
                    <div class="rpt-doc-label">PRD Serial / Token</div>
                    <div class="rpt-doc-value mono" style="font-size:0.72rem; word-break:break-all;">@(Model.UnitTokenNo ?? $"Unit #{Model.UnitNo}")</div>
                    <div class="rpt-doc-label" style="margin-top:4px;">Assembly Line</div>
                    <div class="rpt-doc-value">@(Model.ComponentName ?? "Assembly 1")</div>
                </div>
                <div>
                    <div class="rpt-doc-label">Inspection Time</div>
                    <div class="rpt-doc-value">@Model.StartTime.ToIstString("HH:mm") — @(Model.EndTime.HasValue ? Model.EndTime.Value.ToIstString("HH:mm") : "In Progress") IST (@istDuration)</div>
                    <div class="rpt-doc-label" style="margin-top:4px;">Drawing / PO Number</div>
                    <div class="rpt-doc-value mono">@Model.JobNo</div>
                </div>
            </div>
            <div style="text-align:center; min-width:130px;">
                <div class="rpt-doc-label" style="margin-bottom:5px;">Overall Status</div>
                @if (overallPass)
                {
                    <div class="rpt-status-badge rpt-status-pass">PASS (@passCount/@totalFinalSteps)</div>
                }
                else if (Model.FinalResult == SessionResult.Fail)
                {
                    <div class="rpt-status-badge rpt-status-fail">FAIL (@passCount/@totalFinalSteps)</div>
                }
                else
                {
                    <div class="rpt-status-badge" style="color:#92400e;background:#fffbeb;border-color:#92400e;">@Model.FinalResult.ToString().ToUpper()</div>
                }
            </div>
        </div>
    </div>

    <!-- ══ DEFECT ALERT (conditional) ══ -->
    @if (failedBolts.Count > 0)
    {
        <div class="rpt-defect-alert">
            <div class="rpt-defect-header">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                DEFECT ALERT — Failed Bolt Step(s) Detected &nbsp;·&nbsp; Job @Model.JobNo
            </div>
            <div style="padding:0; overflow-x:auto;">
                <table class="rpt-step-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Step / Bolt Label</th>
                            <th class="text-end">Target (Nm)</th>
                            <th class="text-center">Acceptance Limits</th>
                            <th class="text-end">Measured</th>
                            <th class="text-end">Deviation</th>
                            <th class="text-center">Tries</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in failedBolts)
                        {
                            var last = g.OrderBy(r => r.AttemptNo).Last();
                            var diff = last.ActualValue - last.TargetValue;
                            <tr>
                                <td class="rpt-step-num">#@g.Key</td>
                                <td class="rpt-step-label">@last.StepLabel</td>
                                <td class="text-end rpt-limits-cell">@last.TargetValue.ToString("0.00")</td>
                                <td class="text-center rpt-limits-cell">[@last.LowerLimit.ToString("0.00") .. @last.UpperLimit.ToString("0.00")]</td>
                                <td class="text-end rpt-measured-fail">@last.ActualValue.ToString("0.00")</td>
                                <td class="text-end rpt-measured-fail">@((diff >= 0 ? "+" : "") + diff.ToString("0.00"))</td>
                                <td class="text-center fw-bold">@g.Count()</td>
                                <td class="rpt-sha" style="font-size:0.74rem; font-family:inherit; color:#6b7280;">@(last.ReasonCode ?? "Operator logged bolt defect")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ══ QUALITY CAPABILITY METRICS ══ -->
    @if (finalSteps.Count > 0)
    {
        <div class="rpt-section-header" style="border-radius:6px 6px 0 0; border:1px solid #c8cdd5; border-bottom:none; margin-bottom:0;">
            2. &nbsp;Fastening Quality &amp; Capability Summary
        </div>
        <div class="rpt-kpi-strip" style="border-radius:0 0 6px 6px; margin-bottom:1.25rem; border:1px solid #c8cdd5; border-top:none;">
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">First-Pass Fastening Yield</div>
                <div class="rpt-kpi-value" style="color:@(firstAttemptRate >= 95 ? "#166534" : firstAttemptRate >= 80 ? "#92400e" : "#991b1b");">
                    @firstAttemptRate%
                </div>
                <div class="rpt-kpi-sub">@firstAttemptPassCount / @totalFinalSteps steps on 1st try</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Average Fastening Bias</div>
                <div class="rpt-kpi-value" style="color:@(Math.Abs(avgBias) < 0.1 ? "#166534" : Math.Abs(avgBias) < 0.3 ? "#92400e" : "#991b1b");">
                    @(avgBias >= 0 ? "+" : "")@avgBias.ToString("0.000")
                </div>
                <div class="rpt-kpi-sub">@biasLabel</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Max Deviation from Target</div>
                <div class="rpt-kpi-value" style="color:#1a1a2e;">
                    ±@maxAbsDev.ToString("0.00")
                </div>
                <div class="rpt-kpi-sub">Worst-case single step</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Fastening Capability (Cpk)</div>
                <div class="rpt-kpi-value" style="color:@cpkColor;">
                    @(sessionCpk > 0 ? sessionCpk.ToString("0.00") : "—")
                </div>
                <div class="rpt-kpi-sub">@cpkLabel</div>
            </div>
        </div>

        <!-- ══ TOLERANCE PROFILE CHART ══ -->
        <div class="rpt-chart-section">
            <div class="rpt-chart-header">
                <div>
                    <div class="rpt-chart-title">
                        <i class="bi bi-graph-up text-primary me-1"></i>
                        Fastening Quality &amp; Tolerance Profile
                    </div>
                    <div class="rpt-chart-subtitle">
                        Actual measured values plotted against engineering nominal targets and acceptance limits [LSL .. USL].
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <span class="rpt-legend-item">
                        <span class="rpt-legend-dot" style="background:#198754;"></span> Target
                    </span>
                    <span class="rpt-legend-item">
                        <span class="rpt-legend-dot" style="background:#dc3545; opacity:0.75;"></span> Limits (LSL / USL)
                    </span>
                    <span class="rpt-legend-item">
                        <span class="rpt-legend-dot" style="background:#0d6efd; border-radius:50%;"></span> Measured Value
                    </span>
                </div>
            </div>
            <div style="padding: 16px; height: 280px; position: relative;">
                <canvas id="fasteningEnvelopeChart"></canvas>
            </div>
        </div>
    }

    <!-- ══ SESSION MEASUREMENT RECORDS ══ -->
    @{
        var allSteps = Model.Steps.OrderBy(s => s.StepSequence).ThenBy(s => s.AttemptNo).ToList();
        var sessionStart = allSteps.Count > 0 ? allSteps.Min(s => s.CapturedAt) : Model.StartTime;
        var sessionEnd   = allSteps.Count > 0 ? allSteps.Max(s => s.CapturedAt) : (Model.EndTime ?? Model.StartTime);
        var sessionPassAll = finalSteps.All(s => s.Result == StepResult.Pass);
    }

    <div class="rpt-session-block">
        <div class="rpt-session-header">
            <span class="rpt-session-id">▼ SESSION #@Model.SessionId &nbsp;·&nbsp; @Model.ComponentName (v@Model.TemplateVersion)</span>
            <span style="opacity:0.4;">|</span>
            <span class="rpt-session-meta">
                <i class="bi bi-person-fill me-1"></i>Operator: @Model.WorkerName (@(Model.EmployeeNo ?? "N/A"))
            </span>
            <span style="opacity:0.4;">|</span>
            <span class="rpt-session-meta">
                <i class="bi bi-wrench me-1"></i>Tool: @(Model.TorqueTransmitterId ?? "N/A")
            </span>
            <span style="opacity:0.4;">|</span>
            <span class="rpt-session-meta">
                <i class="bi bi-clock me-1"></i>@sessionStart.ToIstString("HH:mm:ss") — @sessionEnd.ToIstString("HH:mm:ss") IST
            </span>
            <span class="ms-auto">
                @if (sessionPassAll)
                {
                    <span class="rpt-badge-pass"><i class="bi bi-check-circle-fill"></i> ALL PASS</span>
                }
                else
                {
                    <span class="rpt-badge-fail"><i class="bi bi-x-circle-fill"></i> HAS FAIL</span>
                }
            </span>
        </div>
        <div style="overflow-x:auto;">
            <table class="rpt-step-table">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>Fastener / Step</th>
                        <th style="width:70px;" class="text-center">Attempt</th>
                        <th class="text-end" style="width:150px;">Specified Limits</th>
                        <th class="text-end" style="width:120px;">Observed Value</th>
                        <th style="width:90px;" class="text-center">Time (IST)</th>
                        <th style="width:70px;" class="text-center">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!allSteps.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4" style="color:#9ca3af; font-size:0.82rem;">No step readings recorded for this session yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var step in allSteps)
                        {
                            var isPass = step.Result == StepResult.Pass;
                            var isRework = step.AttemptNo > 1;
                            <tr class="@(isRework ? "rpt-row-rework" : "")">
                                <td class="rpt-step-num">@step.StepSequence</td>
                                <td>
                                    <span class="rpt-step-label">@step.StepLabel</span>
                                    @if (isRework)
                                    {
                                        <br /><span class="rpt-badge-rework mt-1">↩ Reworked (Attempt @step.AttemptNo)</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span style="font-size:0.72rem; color:@(step.AttemptNo > 1 ? "#c2410c" : "#6b7280"); font-weight:@(step.AttemptNo > 1 ? "700" : "400");">@step.AttemptNo</span>
                                </td>
                                <td class="text-end rpt-limits-cell">
                                    @step.TargetValue.ToString("0.0") N·m&nbsp;[@step.LowerLimit.ToString("0.0") – @step.UpperLimit.ToString("0.0")]
                                </td>
                                <td class="text-end @(isPass ? "rpt-measured-pass" : "rpt-measured-fail")">
                                    @step.ActualValue.ToString("0.00") N·m
                                </td>
                                <td class="text-center" style="font-family:'Cascadia Code','Consolas',monospace; font-size:0.74rem; color:#374151;">
                                    @step.CapturedAt.ToIstString("HH:mm:ss")
                                </td>
                                <td class="text-center">
                                    @if (isPass)
                                    {
                                        <span class="rpt-badge-pass"><i class="bi bi-check2"></i> PASS</span>
                                    }
                                    else
                                    {
                                        <span class="rpt-badge-fail"><i class="bi bi-x"></i> FAIL</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>



    <!-- ══ QA ATTESTATION ══ -->
    @{
        var sha256 = System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes($"{Model.SessionId}|{Model.JobNo}|{Model.UnitTokenNo}|{passCount}/{totalFinalSteps}"));
        var shaHex = Convert.ToHexString(sha256).ToLower()[..40];
        var barcodeToken = $"PRD-{(Model.UnitTokenNo ?? $"UNIT-{Model.UnitNo}").Replace("-","").Substring(0, Math.Min(20, (Model.UnitTokenNo ?? $"UNIT-{Model.UnitNo}").Replace("-","").Length))}";
    }
    <div class="rpt-section">
        <div class="rpt-section-header">3. &nbsp;QA Attestation &amp; Engineer Sign-Off</div>
        <div class="rpt-attestation-grid" style="border-top:none;">
            <div class="rpt-attest-cell">
                <div class="rpt-attest-title">Operator Attestation</div>
                <div class="rpt-attest-body">
                    All assembly fastening operations verified per engineering specifications, calibration limits, and approved line instructions.
                </div>
                <div class="rpt-attest-sig-line"></div>
                <div class="rpt-attest-sig-label">Operator Signature</div>
                <div class="rpt-attest-sig-line" style="margin-top:14px;"></div>
                <div class="rpt-attest-sig-label">Date: @DateTime.Now.ToString("dd.MM.yyyy")</div>
            </div>
            <div class="rpt-attest-cell">
                <div class="rpt-attest-title">Quality Attestation / Remarks</div>
                <div class="rpt-attest-body">
                    All critical fastener torques digitally acquired via IoT calibrated instruments and verified against engineering drawing tolerances.<br /><br />
                    <strong>Total Fasteners Verified: @totalSteps / @totalSteps Passed (@(firstAttemptRate)% In-Spec)</strong>
                    <br /><br />
                    <span class="rpt-sha">
                        Anti-Tamper SHA-256: @shaHex<br />
                        Verification Barcode / Token: @barcodeToken<br />
                        Quality Standard Reference: ISO 9001 / IATF 16949
                    </span>
                </div>
            </div>
            <div class="rpt-attest-cell">
                <div class="rpt-attest-title">Inspection Engineer / QA</div>
                <div class="rpt-attest-body" style="font-size:0.72rem; color:#374151; font-weight:600;">
                    Inspection Engineer / QA<br />
                    <span style="color:#6b7280; font-weight:400;">Digital Seal / Approval Attestation:</span>
                </div>
                <div class="rpt-dig-approved">
                    <i class="bi bi-patch-check-fill me-1 text-success"></i>
                    DIGITALLY AUDITED &amp; APPROVED
                </div>
                <div class="rpt-attest-sig-line" style="margin-top:16px;"></div>
                <div class="rpt-attest-sig-label">Authorized Sign.</div>
                <div class="rpt-attest-sig-line" style="margin-top:14px;"></div>
                <div class="rpt-attest-sig-label">Date: @DateTime.Now.ToString("dd.MM.yyyy")</div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.getElementById("fasteningEnvelopeChart");
    if (!canvas || typeof Chart === "undefined") return;

    const labels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => $"#{s.StepSequence} {s.StepLabel}")));
    const targets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.TargetValue)));
    const lowers  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.LowerLimit)));
    const uppers  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.UpperLimit)));
    const actuals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.ActualValue)));
    const passFlags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.Result == StepResult.Pass)));
    const attempts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.AttemptNo)));

    const pointBg     = passFlags.map(p => p ? "#166534" : "#991b1b");
    const pointBorder = passFlags.map(p => p ? "#14532d" : "#7f1d1d");

    // Destroy existing if present
    const existing = Chart.getChart(canvas);
    if (existing) existing.destroy();

    new Chart(canvas, {
        type: "line",
        data: {
            labels,
            datasets: [
                {
                    label: "Upper Spec Limit (USL)",
                    data: uppers,
                    borderColor: "rgba(220,53,69,0.65)",
                    borderWidth: 1.5,
                    borderDash: [6, 4],
                    pointRadius: 0,
                    fill: false,
                    tension: 0,
                    order: 3
                },
                {
                    label: "Target",
                    data: targets,
                    borderColor: "rgba(22,101,52,0.85)",
                    borderWidth: 1.5,
                    pointRadius: 3,
                    pointBackgroundColor: "#166534",
                    fill: false,
                    tension: 0,
                    order: 2
                },
                {
                    label: "Lower Spec Limit (LSL)",
                    data: lowers,
                    borderColor: "rgba(220,53,69,0.65)",
                    borderWidth: 1.5,
                    borderDash: [6, 4],
                    pointRadius: 0,
                    fill: "-2",
                    backgroundColor: "rgba(22,101,52,0.06)",
                    tension: 0,
                    order: 3
                },
                {
                    label: "Measured Fastening Value",
                    data: actuals,
                    borderColor: "#1d4ed8",
                    borderWidth: 2.5,
                    pointRadius: 7,
                    pointHoverRadius: 9,
                    pointBackgroundColor: pointBg,
                    pointBorderColor: pointBorder,
                    pointBorderWidth: 1.5,
                    fill: false,
                    tension: 0.1,
                    order: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: "index", intersect: false },
            plugins: {
                legend: {
                    position: "top",
                    align: "end",
                    labels: {
                        boxWidth: 12,
                        boxHeight: 12,
                        padding: 16,
                        font: { size: 11, weight: "600", family: "'Segoe UI', system-ui, sans-serif" },
                        color: "#374151"
                    }
                },
                tooltip: {
                    backgroundColor: "#fff",
                    borderColor: "#e5e7eb",
                    borderWidth: 1,
                    titleColor: "#111827",
                    bodyColor: "#374151",
                    titleFont: { size: 12, weight: "700" },
                    bodyFont: { size: 11 },
                    padding: 10,
                    callbacks: {
                        afterBody: function(ctx) {
                            const i = ctx[0].dataIndex;
                            const diff = (actuals[i] - targets[i]).toFixed(2);
                            const sign = diff >= 0 ? "+" : "";
                            const pass = passFlags[i] ? "PASS ✓" : "FAIL ✗";
                            return [`Status: ${pass}  (Attempt ${attempts[i]})`, `Deviation from Target: ${sign}${diff} N·m`];
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { color: "#e5e7eb" },
                    ticks: {
                        font: { size: 11, weight: "600", family: "'Segoe UI', system-ui, sans-serif" },
                        color: "#374151"
                    }
                },
                y: {
                    grid: { color: "#f3f4f6", lineWidth: 1 },
                    border: { color: "#e5e7eb", dash: [3, 3] },
                    ticks: {
                        font: { size: 11, family: "'Segoe UI', system-ui, sans-serif" },
                        color: "#6b7280",
                        callback: v => v.toFixed(1) + " N·m"
                    },
                    title: {
                        display: true,
                        text: "Measured Value (N·m)",
                        font: { size: 11, weight: "600" },
                        color: "#6b7280"
                    }
                }
            }
        }
    });
});
</script>
}
