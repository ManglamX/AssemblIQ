@using SmartTorque.Core.Enums
@model SmartTorque.Services.SessionDetailDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Session #{Model.SessionId} Audit Details";
    ViewData["ActiveNav"] = "Reports";
}

@{
    // ── Computed metrics ──────────────────────────────────────────────────────
    var finalSteps = Model.Steps
        .GroupBy(s => s.StepSequence)
        .Select(g => g.OrderBy(r => r.AttemptNo).Last())
        .OrderBy(s => s.StepSequence)
        .ToList();

    var totalFinalSteps    = finalSteps.Count;
    var passCount          = finalSteps.Count(s => s.Result == StepResult.Pass);
    var firstAttemptPassCount = finalSteps.Count(s => s.AttemptNo == 1 && s.Result == StepResult.Pass);
    var firstAttemptRate   = totalFinalSteps > 0 ? Math.Round((double)firstAttemptPassCount / totalFinalSteps * 100, 1) : 0;
    var avgBias            = finalSteps.Count > 0 ? Math.Round((double)finalSteps.Average(s => s.ActualValue - s.TargetValue), 3) : 0;
    var maxAbsDev          = finalSteps.Count > 0 ? Math.Round((double)finalSteps.Max(s => Math.Abs(s.ActualValue - s.TargetValue)), 2) : 0;

    double sessionCpk = 0;
    if (finalSteps.Count >= 2)
    {
        var vals   = finalSteps.Select(s => (double)s.ActualValue).ToList();
        double mean  = vals.Average();
        double sumSq = vals.Sum(v => (v - mean) * (v - mean));
        double sigma = Math.Sqrt(sumSq / (vals.Count - 1));
        double avgLsl = finalSteps.Average(s => (double)s.LowerLimit);
        double avgUsl = finalSteps.Average(s => (double)s.UpperLimit);
        if (sigma > 1e-6 && avgUsl > avgLsl)
            sessionCpk = Math.Round(Math.Min((avgUsl - mean) / (3 * sigma), (mean - avgLsl) / (3 * sigma)), 2);
    }

    var failedBolts = Model.Steps.GroupBy(s => s.StepSequence)
        .Where(g => g.OrderBy(r => r.AttemptNo).Last().Result == StepResult.Fail)
        .ToList();

    var overallPass  = Model.FinalResult == SessionResult.Pass;
    var cpkLabel     = sessionCpk >= 1.67 ? "Excellent (5σ)" : sessionCpk >= 1.33 ? "Capable (4σ)" : sessionCpk >= 1.00 ? "Marginal" : (sessionCpk > 0 ? "Not Capable" : "N/A");
    var cpkColor     = sessionCpk >= 1.67 ? "#166534" : sessionCpk >= 1.33 ? "#1e3a8a" : sessionCpk >= 1.00 ? "#92400e" : "#991b1b";
    var biasLabel    = Math.Abs(avgBias) < 0.05 ? "Centred on target" : avgBias > 0 ? "Pulling high" : "Pulling low";
    var istDuration  = Model.Duration.HasValue ? $"{Model.Duration.Value.TotalMinutes:0.0} min" : "In Progress";

    // ── Step list ─────────────────────────────────────────────────────────────
    var allSteps      = Model.Steps.OrderBy(s => s.StepSequence).ThenBy(s => s.AttemptNo).ToList();
    var sessionStart  = allSteps.Count > 0 ? allSteps.Min(s => s.CapturedAt) : Model.StartTime;
    var sessionEnd    = allSteps.Count > 0 ? allSteps.Max(s => s.CapturedAt) : (Model.EndTime ?? Model.StartTime);
    var sessionPassAll = finalSteps.All(s => s.Result == StepResult.Pass);

    // ── Tool category labels ───────────────────────────────────────────────────
    static string ToolCategory(InstrumentType t, string? name) =>
        t == InstrumentType.Torque  ? "Torque Wrench" :
        t == InstrumentType.Vernier ? "Vernier Caliper" : (name ?? "Node");

    // ── Identity helpers ──────────────────────────────────────────────────────
    // ProductCode = item code (e.g. 46171506DG04710)
    // ProductName = description (e.g. FR SAFE 2DR (805D) +EL)
    // UnitNo  = physical unit number (1, 2 …)
    // UnitTokenNo = serial hash (e.g. PRDFEE…)

    var sha256Bytes = System.Security.Cryptography.SHA256.HashData(
        System.Text.Encoding.UTF8.GetBytes($"{Model.SessionId}|{Model.JobNo}|{Model.UnitTokenNo}|{passCount}/{totalFinalSteps}"));
    var shaHex = Convert.ToHexString(sha256Bytes).ToLower()[..40];
}

