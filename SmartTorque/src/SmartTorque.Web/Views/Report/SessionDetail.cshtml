<div class="rpt-page">

    <!-- Breadcrumb + Print -->
    <div class="d-flex justify-content-between align-items-center mb-3 rpt-no-print">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Sessions">Reports</a></li>
                <li class="breadcrumb-item active" aria-current="page">Session #@Model.SessionId</li>
            </ol>
        </nav>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print / Export PDF
        </button>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 1 — DOCUMENT HEADER (Standard QAD Template)
    ══════════════════════════════════════════════════════════════════ -->
    <div class="rpt-frame" style="border:1px solid #000;">

        <!-- Row 1: Company & Division Header -->
        <div style="background:#fff; border-bottom:1px solid #000; padding:6px 12px; text-align:center; font-weight:800; font-size:1.05rem; letter-spacing:0.02em; color:#000;">
            Godrej &amp; Boyce Mfg. Co. Ltd. - Security Solutions Division
        </div>

        <!-- Row 2: INSPECTION REPORT | Document No / Revision No / Rev Date -->
        <div style="display:flex; border-bottom:1px solid #000;">
            <div style="flex:1.8; display:flex; align-items:center; justify-content:center; border-right:1px solid #000; padding:8px 12px;">
                <span style="font-size:1.15rem; font-weight:900; letter-spacing:0.08em; text-transform:uppercase; color:#000;">Inspection Report</span>
            </div>
            <div style="flex:1.2; display:flex; flex-direction:column;">
                <div style="border-bottom:1px solid #000; padding:4px 8px; text-align:center; font-size:0.75rem;">
                    <strong>Document No.:-</strong> FL/QAD/F/42
                </div>
                <div style="display:flex; font-size:0.72rem;">
                    <div style="flex:1; border-right:1px solid #000; padding:3px 6px; text-align:center;">
                        <strong>Revision No.:-</strong> 00
                    </div>
                    <div style="flex:1; padding:3px 6px; text-align:center;">
                        <strong>Rev. Date.:-</strong> 09.08.17
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Part/Sub-Assly Name -->
        <div style="border-bottom:1px solid #000; padding:5px 12px; font-size:0.78rem;">
            <strong>Part/Sub-Assly Name:</strong> CHECK FOR FASTNER &amp; BOLT TORQUE
        </div>

        <!-- Row 4: Drawing No | Insp. Date | SR NO -->
        <div style="display:flex; border-bottom:1px solid #000; font-size:0.75rem;">
            <div style="flex:1.2; border-right:1px solid #000; padding:4px 12px;">
                <strong>Drawing No:</strong> @(Model.JobNo ?? "558-3680")
            </div>
            <div style="flex:1; border-right:1px solid #000; padding:4px 12px;">
                <strong>Insp. Date :</strong> @Model.StartTime.ToIstString("dd.MM.yyyy")
            </div>
            <div style="flex:1.5; padding:4px 12px;">
                <strong>SR NO -</strong> @(string.IsNullOrWhiteSpace(Model.UnitTokenNo) ? $"Unit #{Model.UnitNo}" : $"Unit #{Model.UnitNo}: {Model.UnitTokenNo}")
            </div>
        </div>

        <!-- Row 5: Detailed Product, Assembly Line & Overall Status Verification -->
        <div class="rpt-row" style="margin-bottom:0; border-bottom:none;">
            <div class="rpt-cell" style="flex:1.3; border-right:1px solid #000;">
                <span class="lbl">Item Code</span>
                <span class="val mono">@Model.ProductCode</span>
                <span class="lbl" style="margin-top:4px;">Product Description</span>
                <span class="val">@Model.ProductName</span>
                <span class="lbl" style="margin-top:4px;">Job Order No.</span>
                <span class="val mono">@Model.JobNo</span>
            </div>
            <div class="rpt-cell" style="flex:1.7; border-right:1px solid #000;">
                <span class="lbl">Assembly Line</span>
                <span class="val">@(Model.ComponentName ?? "Assembly 1")</span>
                <span class="lbl" style="margin-top:4px;">Station</span>
                <span class="val">
                    @if (!string.IsNullOrEmpty(Model.TorqueDeviceName))
                    {
                        @Model.TorqueDeviceName
                    }
                    else if (!string.IsNullOrEmpty(Model.VernierDeviceName))
                    {
                        @Model.VernierDeviceName
                    }
                    else
                    {
                        <span style="color:#6b7280;">All Stations</span>
                    }
                </span>
                <span class="lbl" style="margin-top:4px;">Quality Standard</span>
                <span class="val">ISO 9001 / IATF 16949</span>
            </div>
            <div class="rpt-cell fixed-auto" style="display:flex; flex-direction:column; justify-content:center; align-items:center; padding:10px 16px; min-width:140px;">
                <span class="lbl" style="margin-bottom:6px;">Overall Status</span>
                @if (overallPass)
                {
                    <span class="rpt-status rpt-status-pass">PASS (@passCount/@totalFinalSteps)</span>
                }
                else if (Model.FinalResult == SessionResult.Fail)
                {
                    <span class="rpt-status rpt-status-fail">FAIL (@passCount/@totalFinalSteps)</span>
                }
                else
                {
                    <span class="rpt-status rpt-status-other">@Model.FinalResult.ToString().ToUpper()</span>
                }
            </div>
        </div>
    </div>

        <!-- Row 3: Operator | Tool details | Inspection time -->
        <div class="rpt-row">
            <div class="rpt-cell" style="flex:1.2;">
                <span class="lbl">Operator (Worker)</span>
                <span class="val">@Model.WorkerName</span>
                <span class="lbl" style="margin-top:5px;">Employee No.</span>
                <span class="val mono">@(Model.EmployeeNo ?? "N/A")</span>
            </div>
            <div class="rpt-cell" style="flex:1.2;">
                <span class="lbl">Torque Instrument</span>
                <span class="val">
                    @if (!string.IsNullOrEmpty(Model.TorqueTransmitterId))
                    {
                        <span>Torque Wrench &nbsp;·&nbsp; <span class="mono" style="font-family:'Cascadia Code',monospace;">@Model.TorqueTransmitterId</span></span>
                        @if (!string.IsNullOrEmpty(Model.TorqueDeviceName))
                        {
                            <span style="color:#6b7280;"> (@Model.TorqueDeviceName)</span>
                        }
                    }
                    else
                    {
                        <span style="color:#6b7280;">None assigned</span>
                    }
                </span>
                @if (!string.IsNullOrEmpty(Model.VernierTransmitterId))
                {
                    <span class="lbl" style="margin-top:5px;">Measurement Instrument</span>
                    <span class="val">
                        Vernier Caliper &nbsp;·&nbsp; <span style="font-family:'Cascadia Code',monospace; font-size:0.72rem;">@Model.VernierTransmitterId</span>
                        @if (!string.IsNullOrEmpty(Model.VernierDeviceName))
                        {
                            <span style="color:#6b7280;"> (@Model.VernierDeviceName)</span>
                        }
                    </span>
                }
            </div>
            <div class="rpt-cell" style="flex:1;">
                <span class="lbl">Inspection Date</span>
                <span class="val">@Model.StartTime.ToIstString("dd MMM yyyy")</span>
                <span class="lbl" style="margin-top:5px;">Start Time (IST)</span>
                <span class="val mono">@Model.StartTime.ToIstString("HH:mm:ss")</span>
            </div>
            <div class="rpt-cell" style="flex:1;">
                <span class="lbl">End Time (IST)</span>
                <span class="val mono">
                    @(Model.EndTime.HasValue ? Model.EndTime.Value.ToIstString("HH:mm:ss") : "In Progress")
                </span>
                <span class="lbl" style="margin-top:5px;">Duration</span>
                <span class="val">@istDuration</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="rpt-cell" style="flex:1.2;">
                    <span class="lbl">Remarks</span>
                    <span class="val sub" style="white-space:normal;">@Model.Remarks</span>
                </div>
            }
        </div>

    </div><!-- /rpt-frame -->

    <!-- ══════════════════════════════════════════════════════════════
         DEFECT ALERT (conditional)
    ══════════════════════════════════════════════════════════════════ -->
    @if (failedBolts.Count > 0)
    {
        <div class="rpt-defect">
            <div class="rpt-defect-hdr">
                DEFECT ALERT — Failed Bolt Step(s) Detected &nbsp;·&nbsp; Job @Model.JobNo
            </div>
            <div style="overflow-x:auto;">
                <table class="rpt-tbl">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Step / Bolt Label</th>
                            <th class="text-end">Target</th>
                            <th class="text-center">Acceptance Limits [LSL – USL]</th>
                            <th class="text-end">Measured</th>
                            <th class="text-end">Deviation</th>
                            <th class="text-center">Tries</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in failedBolts)
                        {
                            var last = g.OrderBy(r => r.AttemptNo).Last();
                            var diff = last.ActualValue - last.TargetValue;
                            <tr>
                                <td class="c-bold">#@g.Key</td>
                                <td class="c-bold">@last.StepLabel</td>
                                <td class="text-end c-mono">@last.TargetValue.ToString("0.00") N·m</td>
                                <td class="text-center c-mono">[@last.LowerLimit.ToString("0.00") – @last.UpperLimit.ToString("0.00")]</td>
                                <td class="text-end c-fail">@last.ActualValue.ToString("0.00") N·m</td>
                                <td class="text-end c-fail">@((diff >= 0 ? "+" : "") + diff.ToString("0.00"))</td>
                                <td class="text-center c-bold">@g.Count()</td>
                                <td class="c-dim">@(last.ReasonCode ?? "Operator logged bolt defect")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 2 — FASTENING QUALITY SUMMARY
    ══════════════════════════════════════════════════════════════════ -->
    @if (finalSteps.Count > 0)
    {
        <div class="rpt-kpi-strip" style="border-radius:5px; margin-bottom:1rem;">
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">First-Pass Fastening Yield</div>
                <div class="rpt-kpi-value" style="color:@(firstAttemptRate >= 95 ? "#166534" : firstAttemptRate >= 80 ? "#92400e" : "#991b1b");">
                    @firstAttemptRate%
                </div>
                <div class="rpt-kpi-sub">@firstAttemptPassCount / @totalFinalSteps steps on first try</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Average Fastening Bias</div>
                <div class="rpt-kpi-value" style="color:@(Math.Abs(avgBias) < 0.1 ? "#166534" : Math.Abs(avgBias) < 0.3 ? "#92400e" : "#991b1b");">
                    @(avgBias >= 0 ? "+" : "")@avgBias.ToString("0.000")
                </div>
                <div class="rpt-kpi-sub">@biasLabel</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Max Deviation from Target</div>
                <div class="rpt-kpi-value" style="color:#111827;">
                    &plusmn;@maxAbsDev.ToString("0.00")
                </div>
                <div class="rpt-kpi-sub">Worst-case single step</div>
            </div>
            <div class="rpt-kpi-cell">
                <div class="rpt-kpi-label">Fastening Capability (Cpk)</div>
                <div class="rpt-kpi-value" style="color:@cpkColor;">
                    @(sessionCpk > 0 ? sessionCpk.ToString("0.00") : "—")
                </div>
                <div class="rpt-kpi-sub">@cpkLabel</div>
            </div>
        </div>

        <!-- Tolerance Profile Chart -->
        <div class="rpt-chart-wrap">
            <div class="rpt-chart-hdr">
                <div>
                    <div class="rpt-chart-title">Fastening Quality &amp; Tolerance Profile</div>
                    <div class="rpt-chart-sub">Actual measured values vs. engineering nominal targets and acceptance limits [LSL .. USL].</div>
                </div>
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <span class="rpt-legend-item"><span class="rpt-legend-dot" style="background:#166534;"></span>Target</span>
                    <span class="rpt-legend-item"><span class="rpt-legend-dot" style="background:#991b1b; opacity:0.7;"></span>LSL / USL</span>
                    <span class="rpt-legend-item"><span class="rpt-legend-dot" style="background:#1d4ed8; border-radius:50%;"></span>Measured</span>
                </div>
            </div>
            <div style="padding:14px; height:270px; position:relative;">
                <canvas id="fasteningEnvelopeChart"></canvas>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════
         SESSION MEASUREMENT RECORDS
    ══════════════════════════════════════════════════════════════════ -->
    <div class="rpt-session-block">
        <div class="rpt-session-hdr">
            <span class="sid">SESSION #@Model.SessionId</span>
            <span class="sdiv">|</span>
            <span class="smeta">@Model.ComponentName (v@Model.TemplateVersion)</span>
            <span class="sdiv">|</span>
            <span class="smeta">Operator: @Model.WorkerName (@(Model.EmployeeNo ?? "N/A"))</span>
            <span class="sdiv">|</span>
            <span class="smeta">@sessionStart.ToIstString("dd MMM yyyy, HH:mm:ss") — @sessionEnd.ToIstString("HH:mm:ss") IST</span>
            @if (sessionPassAll)
            {
                <span class="sbadge-pass">ALL PASS</span>
            }
            else
            {
                <span class="sbadge-fail">HAS FAIL</span>
            }
        </div>
        <div style="overflow-x:auto;">
            <table class="rpt-tbl">
                <thead>
                    <tr>
                        <th style="width:36px;">#</th>
                        <th>Fastener / Step</th>
                        <th style="width:62px;" class="text-center">Attempt</th>
                        <th class="text-center" style="width:80px;">Tool Category</th>
                        <th class="text-end" style="width:170px;">Specified Limits [Target, LSL – USL]</th>
                        <th class="text-end" style="width:110px;">Observed Value</th>
                        <th style="width:85px;" class="text-center">Time (IST)</th>
                        <th style="width:66px;" class="text-center">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!allSteps.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 c-dim">No step readings recorded for this session yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var step in allSteps)
                        {
                            var isPass   = step.Result == StepResult.Pass;
                            var isRework = step.AttemptNo > 1;
                            var toolCat  = ToolCategory(step.Instrument, step.DeviceName);
                            <tr class="@(isRework ? "row-rework" : "")">
                                <td class="c-bold">@step.StepSequence</td>
                                <td>
                                    <span style="font-weight:600; color:#111827;">@step.StepLabel</span>
                                    @if (isRework)
                                    {
                                        <br /><span class="bdg-rework">Reworked — Attempt @step.AttemptNo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span style="font-size:0.72rem; color:@(step.AttemptNo > 1 ? "#92400e" : "#6b7280"); font-weight:@(step.AttemptNo > 1 ? "700" : "400");">@step.AttemptNo</span>
                                </td>
                                <td class="text-center c-dim" style="font-size:0.7rem; white-space:normal;">
                                    @toolCat
                                    @if (!string.IsNullOrEmpty(step.TransmitterId))
                                    {
                                        <br /><span class="c-mono" style="font-size:0.65rem;">@step.TransmitterId</span>
                                    }
                                </td>
                                <td class="text-end c-mono">
                                    @step.TargetValue.ToString("0.0") N·m&nbsp;&nbsp;[@step.LowerLimit.ToString("0.0")&nbsp;–&nbsp;@step.UpperLimit.ToString("0.0")]
                                </td>
                                <td class="text-end @(isPass ? "c-pass" : "c-fail")" style="font-size:0.85rem;">
                                    @step.ActualValue.ToString("0.00") N·m
                                </td>
                                <td class="text-center c-mono c-dim">
                                    @step.CapturedAt.ToIstString("HH:mm:ss")
                                </td>
                                <td class="text-center">
                                    @if (isPass)
                                    {
                                        <span class="bdg-pass">PASS</span>
                                    }
                                    else
                                    {
                                        <span class="bdg-fail">FAIL</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         QA ATTESTATION
    ══════════════════════════════════════════════════════════════════ -->
    <div class="rpt-attest">
        <div class="rpt-attest-row">
            <!-- Quality Remarks -->
            <div class="rpt-attest-cell" style="grid-column: span 2 / auto;">
                <div class="rpt-attest-title">Quality Attestation / Remarks</div>
                <div class="rpt-attest-body">
                    All critical fastener torques digitally acquired via IoT calibrated instruments and verified against engineering drawing tolerances.<br /><br />
                    <strong>Total Fasteners Verified: @passCount / @totalFinalSteps &nbsp;·&nbsp; @firstAttemptRate% In-Spec on First Pass</strong><br /><br />
                    <span class="rpt-sha">
                        Anti-Tamper SHA-256:&nbsp;@shaHex<br />
                        Verification Token:&nbsp;@(Model.UnitTokenNo ?? $"UNIT-{Model.UnitNo}")<br />
                        Quality Standard Reference: ISO 9001 / IATF 16949
                    </span>
                </div>
            </div>
            <!-- Digital approval -->
            <div class="rpt-attest-cell" style="display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div class="rpt-attest-title">Digital Seal / Approval</div>
                    <div class="rpt-attest-body" style="font-size:0.72rem;">
                        Inspection Engineer / QA<br />
                        <span style="color:#6b7280;">Approval Attestation:</span>
                    </div>
                    <div class="rpt-dig-stamp">DIGITALLY AUDITED &amp; APPROVED</div>
                </div>
                <div style="margin-top:16px;">
                    <div style="border-bottom:1px solid #9ca3af; margin-bottom:2px;"></div>
                    <div style="font-size:0.63rem; color:#9ca3af;">Date: @Model.StartTime.ToIstString("dd.MM.yyyy")</div>
                </div>
            </div>
        </div>
    </div>

</div><!-- /rpt-page -->

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.getElementById("fasteningEnvelopeChart");
    if (!canvas || typeof Chart === "undefined") return;

    const labels    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => $"#{s.StepSequence} {s.StepLabel}")));
    const targets   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.TargetValue)));
    const lowers    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.LowerLimit)));
    const uppers    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.UpperLimit)));
    const actuals   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.ActualValue)));
    const passFlags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.Result == StepResult.Pass)));
    const attempts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalSteps.Select(s => s.AttemptNo)));

    const ptBg     = passFlags.map(p => p ? "#166534" : "#991b1b");
    const ptBorder = passFlags.map(p => p ? "#14532d" : "#7f1d1d");

    const ex = Chart.getChart(canvas);
    if (ex) ex.destroy();

    new Chart(canvas, {
        type: "line",
        data: {
            labels,
            datasets: [
                { label: "USL", data: uppers, borderColor: "rgba(153,27,27,0.55)", borderWidth: 1.5, borderDash: [5, 4], pointRadius: 0, fill: false, tension: 0, order: 3 },
                { label: "Target", data: targets, borderColor: "rgba(22,101,52,0.9)", borderWidth: 1.5, pointRadius: 3, pointBackgroundColor: "#166534", fill: false, tension: 0, order: 2 },
                { label: "LSL", data: lowers, borderColor: "rgba(153,27,27,0.55)", borderWidth: 1.5, borderDash: [5, 4], pointRadius: 0, fill: "-2", backgroundColor: "rgba(22,101,52,0.05)", tension: 0, order: 3 },
                {
                    label: "Measured Value", data: actuals, borderColor: "#1d4ed8", borderWidth: 2.5,
                    pointRadius: 7, pointHoverRadius: 9,
                    pointBackgroundColor: ptBg, pointBorderColor: ptBorder, pointBorderWidth: 1.5,
                    fill: false, tension: 0.1, order: 1
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: "index", intersect: false },
            plugins: {
                legend: { position: "top", align: "end", labels: { boxWidth: 11, boxHeight: 11, padding: 14, font: { size: 11, weight: "600" }, color: "#374151" } },
                tooltip: {
                    backgroundColor: "#fff", borderColor: "#e5e7eb", borderWidth: 1,
                    titleColor: "#111827", bodyColor: "#374151",
                    titleFont: { size: 12, weight: "700" }, bodyFont: { size: 11 }, padding: 10,
                    callbacks: {
                        afterBody: function (ctx) {
                            const i = ctx[0].dataIndex;
                            const diff = (actuals[i] - targets[i]).toFixed(2);
                            const sign = diff >= 0 ? "+" : "";
                            const pass = passFlags[i] ? "PASS" : "FAIL";
                            return [`Status: ${pass}  (Attempt ${attempts[i]})`, `Deviation: ${sign}${diff} N·m`];
                        }
                    }
                }
            },
            scales: {
                x: { grid: { display: false }, border: { color: "#e5e7eb" }, ticks: { font: { size: 11, weight: "600" }, color: "#374151" } },
                y: {
                    grid: { color: "#f3f4f6" }, border: { color: "#e5e7eb", dash: [3, 3] },
                    ticks: { font: { size: 11 }, color: "#6b7280", callback: v => v.toFixed(1) + " N·m" },
                    title: { display: true, text: "Measured Value (N·m)", font: { size: 11, weight: "600" }, color: "#6b7280" }
                }
            }
        }
    });
});
</script>
}
