@using SmartTorque.Core.Enums
@model SmartTorque.Web.ViewModels.DeviceUsageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Device Usage & Calibration";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ReportTab"] = "Devices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1">Hardware Device Usage & Calibration</h1>
        <p class="text-muted small mb-0">Monitor wireless torque wrenches and digital calipers, reading throughput, and calibration compliance</p>
    </div>
    <div>
        <a asp-controller="Device" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-gear me-1"></i> Device Management
        </a>
    </div>
</div>

<partial name="_ReportNav" />

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card p-3 border-0 shadow-sm">
            <div class="text-muted small fw-semibold text-uppercase">Total Fleet Devices</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalDevices</div>
            <div class="text-muted small">Registered in plant network</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card p-3 border-0 shadow-sm border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Online Right Now</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.OnlineDevices</div>
            <div class="text-muted small">Pinging within 30 seconds</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card p-3 border-0 shadow-sm border-start border-danger border-4">
            <div class="text-muted small fw-semibold text-uppercase">Overdue Calibration</div>
            <div class="fs-4 fw-bold @(Model.OverdueCalibration > 0 ? "text-danger" : "text-dark") mt-1">
                @Model.OverdueCalibration
            </div>
            <div class="text-muted small">Immediate ISO calibration required</div>
        </div>
    </div>
</div>

<!-- Devices Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Device & Transmitter ID</th>
                    <th>Instrument</th>
                    <th>Location</th>
                    <th class="text-center">Status</th>
                    <th>Last Seen</th>
                    <th class="text-center">Sessions Logged</th>
                    <th class="text-center">Readings Logged</th>
                    <th>Calibration Due</th>
                    <th class="text-center">Calibration Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Devices.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-router fs-2 d-block mb-2 text-secondary"></i>
                            No hardware devices registered yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model.Devices)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@d.Name</div>
                                <div class="font-monospace text-muted small">@d.TransmitterId</div>
                            </td>
                            <td>
                                @if (d.InstrumentType == InstrumentType.Torque)
                                {
                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-wrench me-1"></i>Torque Wrench</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-rulers me-1"></i>Digital Caliper</span>
                                }
                            </td>
                            <td>
                                @(d.Location ?? "Unassigned")
                            </td>
                            <td class="text-center">
                                @if (d.IsOnline)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1">
                                        <i class="bi bi-wifi me-1"></i> Online
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                        <i class="bi bi-wifi-off me-1"></i> Offline
                                    </span>
                                }
                            </td>
                            <td class="small font-monospace text-muted">
                                @(d.LastSeenAt.HasValue ? d.LastSeenAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "Never")
                            </td>
                            <td class="text-center fw-semibold">
                                @d.TotalSessions
                            </td>
                            <td class="text-center font-monospace">
                                @d.TotalReadings
                            </td>
                            <td class="small">
                                @(d.CalibrationDue.HasValue ? d.CalibrationDue.Value.ToString("yyyy-MM-dd") : "Not Set")
                            </td>
                            <td class="text-center">
                                @if (d.CalibrationStatus == "Current")
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Current
                                    </span>
                                }
                                else if (d.CalibrationStatus == "Due Soon")
                                {
                                    <span class="badge bg-warning-subtle text-warning px-2 py-1">
                                        <i class="bi bi-clock me-1"></i> Due Soon
                                    </span>
                                }
                                else if (d.CalibrationStatus == "Overdue")
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">
                                        @d.CalibrationStatus
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
