@using SmartTorque.Core.Enums
@using SmartTorque.Core.Extensions
@using SmartTorque.Services
@model SmartTorque.Web.ViewModels.SessionReportViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Session Report";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ReportTab"] = "Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1">Assembly Reports & Traceability</h1>
        <p class="text-muted small mb-0">Browse and export execution sessions, torque measurements, and quality audit trails</p>
        @if (ViewBag.IsPlantHead != true && !string.IsNullOrEmpty(ViewBag.CurrentUserDepartmentName))
        {
            <div class="mt-1">
                <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 small">
                    <i class="bi bi-building me-1"></i>Dept: @ViewBag.CurrentUserDepartmentName
                </span>
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btnScanPrdHeader" title="Scan PRD Unit QR Code">
            <i class="bi bi-qr-code-scan me-1"></i> Scan PRD QR
        </button>
        <a asp-action="ExportSessionsExcel"
           asp-route-FromDate="@(Model.Filter.FromDate?.ToString("o"))"
           asp-route-ToDate="@(Model.Filter.ToDate?.ToString("o"))"
           asp-route-WorkerId="@Model.Filter.WorkerId"
           asp-route-ProductId="@Model.Filter.ProductId"
           asp-route-DeviceId="@Model.Filter.DeviceId"
           asp-route-Result="@Model.Filter.Result"
           asp-route-Status="@Model.Filter.Status"
           asp-route-Search="@Model.Filter.Search"
           class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
        </a>
        <a asp-action="ExportSessionsPdf"
           asp-route-FromDate="@(Model.Filter.FromDate?.ToString("o"))"
           asp-route-ToDate="@(Model.Filter.ToDate?.ToString("o"))"
           asp-route-WorkerId="@Model.Filter.WorkerId"
           asp-route-ProductId="@Model.Filter.ProductId"
           asp-route-DeviceId="@Model.Filter.DeviceId"
           asp-route-Result="@Model.Filter.Result"
           asp-route-Status="@Model.Filter.Status"
           asp-route-Search="@Model.Filter.Search"
           class="btn btn-outline-danger btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
        </a>
    </div>
</div>

<partial name="_ReportNav" />

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm">
            <div class="text-muted small fw-semibold text-uppercase">Total Sessions</div>
            <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalSessions</div>
            <div class="text-muted small">Active records</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Passed Sessions</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.PassedSessions</div>
            <div class="text-muted small">Quality compliant</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm border-start border-danger border-4">
            <div class="text-muted small fw-semibold text-uppercase">Failed Sessions</div>
            <div class="fs-4 fw-bold text-danger mt-1">@Model.FailedSessions</div>
            <div class="text-muted small">Rework or failed</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Pass Rate</div>
            <div class="fs-4 fw-bold text-primary mt-1">@Model.PassRate%</div>
            <div class="text-muted small">Based on active items</div>
        </div>
    </div>
</div>

<!-- Filter Box -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <span class="fw-bold"><i class="bi bi-funnel me-1"></i> Filter Sessions</span>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Sessions" class="row g-3 align-items-end">
            <input type="hidden" name="view" value="@Model.ViewMode" />
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="Search" id="sessionSearchInput" value="@Model.Filter.Search" class="form-control" placeholder="Job No, Serial, Worker, PRD..." />
                    <button type="button" class="btn btn-outline-primary" id="btnScanPrdInput" title="Scan PRD QR Code with Camera">
                        <i class="bi bi-qr-code-scan"></i>
                    </button>
                </div>
            </div>
            @if (ViewBag.IsPlantHead == true)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-funnel-fill text-primary me-1"></i>Department</label>
                    <select name="DepartmentId" class="form-select form-select-sm">
                        <option value="">All Departments (Plant Overview)</option>
                        @foreach (var d in (List<SmartTorque.Services.HierarchyItemDto>)(ViewBag.AvailableDepartments ?? new List<SmartTorque.Services.HierarchyItemDto>()))
                        {
                            <option value="@d.Id" selected="@(ViewBag.SelectedDepartmentId == d.Id)">@d.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Worker</label>
                <select name="WorkerId" asp-items="Model.Workers" class="form-select form-select-sm">
                    <option value="">All Workers</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Product</label>
                <select name="ProductId" asp-items="Model.Products" class="form-select form-select-sm">
                    <option value="">All Products</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Device</label>
                <select name="DeviceId" asp-items="Model.Devices" class="form-select form-select-sm">
                    <option value="">All Devices</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Result</label>
                <select name="Result" class="form-select form-select-sm">
                    <option value="">All Results</option>
                    <option value="Pass" selected="@(Model.Filter.Result == SessionResult.Pass)">Pass</option>
                    <option value="Fail" selected="@(Model.Filter.Result == SessionResult.Fail)">Fail</option>
                    <option value="Incomplete" selected="@(Model.Filter.Result == SessionResult.Incomplete)">Incomplete</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-6 d-flex gap-2">
                <a asp-action="Sessions" class="btn btn-outline-secondary btn-sm">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- View Mode Toggle -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group shadow-sm" role="group">
        <a href="@Url.Action("Sessions", "Report", new { view = "product", Search = Model.Filter.Search, DepartmentId = Model.Filter.DepartmentId, ProductId = Model.Filter.ProductId, WorkerId = Model.Filter.WorkerId })" 
           class="btn btn-sm @(Model.ViewMode == "product" ? "btn-primary fw-bold" : "btn-outline-secondary")">
            <i class="bi bi-box-seam me-1"></i> Product Units (Consolidated PRD) (@Model.ProductUnits.Count)
        </a>
        <a href="@Url.Action("Sessions", "Report", new { view = "sessions", Search = Model.Filter.Search, DepartmentId = Model.Filter.DepartmentId, ProductId = Model.Filter.ProductId, WorkerId = Model.Filter.WorkerId })" 
           class="btn btn-sm @(Model.ViewMode == "sessions" ? "btn-primary fw-bold" : "btn-outline-secondary")">
            <i class="bi bi-list-check me-1"></i> Component Sessions (@Model.Sessions.Count)
        </a>
    </div>
    <div class="text-muted small">
        @(Model.ViewMode == "product" ? "All component templates and bolt results consolidated per product unit" : "Granular component execution sessions (empty abandoned attempts excluded)")
    </div>
</div>

@if (Model.ViewMode == "product")
{
    <!-- Consolidated Product Units Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Job &amp; Serial / PRD Token</th>
                        <th scope="col">Product</th>
                        <th scope="col">Appended Component Templates</th>
                        <th scope="col">Worker &amp; Devices</th>
                        <th scope="col">Working Time</th>
                        <th scope="col" class="text-center">Bolts (Pass/Fail/Total)</th>
                        <th scope="col" class="text-center">Product Result</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductUnits.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No product units found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.ProductUnits)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@u.JobNo</div>
                                    @if (!string.IsNullOrEmpty(u.UnitTokenNo))
                                    {
                                        <div class="small font-monospace text-truncate text-primary fw-semibold" style="max-width: 230px;" title="Unit #@u.UnitNo Token: @u.UnitTokenNo">
                                            <i class="bi bi-upc-scan me-1"></i>#@u.UnitNo: @u.UnitTokenNo
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(u.ProductSerial))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@u.ProductSerial</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unit #@u.UnitNo</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@u.ProductName</div>
                                    <div class="small text-muted font-monospace">@u.ProductCode</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="small fw-semibold text-secondary">
                                            @u.BuiltComponentsCount / @u.TotalComponentsCount Templates Built
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var comp in u.ComponentStatuses)
                                            {
                                                var badgeColor = comp.Result == SessionResult.Pass ? "bg-success-subtle text-success border border-success-subtle" :
                                                                 comp.Result == SessionResult.Fail ? "bg-danger-subtle text-danger border border-danger-subtle" :
                                                                 "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
                                                <span class="badge @badgeColor py-1" title="@comp.ComponentName: @comp.PassedSteps/@comp.TotalSteps pass">
                                                    @comp.ComponentName
                                                    <span class="ms-1 fw-bold">(@comp.PassedSteps/@comp.TotalSteps)</span>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-medium">@(string.Join(", ", u.WorkerNames.DefaultIfEmpty("—")))</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-wrench me-1"></i>@(string.Join(", ", u.DeviceTransmitters.DefaultIfEmpty("—")))
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark">
                                        @($"{u.WorkingDuration.TotalMinutes:0.0} min")
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                        @if (u.EarliestCapturedAt.HasValue && u.LatestCapturedAt.HasValue)
                                        {
                                            <span>@u.EarliestCapturedAt.Value.ToIstString("HH:mm:ss") - @u.LatestCapturedAt.Value.ToIstString("HH:mm:ss")</span>
                                        }
                                        else
                                        {
                                            <span>First to last bolt</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <span class="text-success fw-bold">@u.PassedSteps</span> /
                                        <span class="text-danger fw-bold">@u.FailedSteps</span> /
                                        @u.TotalSteps
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @u.StatusBadgeCss px-2 py-1">
                                        @if (u.OverallStatus == ProductUnitOverallStatus.Pass)
                                        {
                                            <i class="bi bi-check-circle me-1"></i>
                                        }
                                        else if (u.OverallStatus == ProductUnitOverallStatus.Fail || u.OverallStatus == ProductUnitOverallStatus.IncompleteFailed)
                                        {
                                            <i class="bi bi-x-circle me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-hourglass me-1"></i>
                                        }
                                        @u.StatusBadgeText
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="openReportModal(@u.JobId, @u.UnitNo, '@(u.UnitTokenNo ?? "")', '@u.ProductCode - @u.ProductName', '@(u.ProductSerial ?? u.JobNo)');"
                                                    title="Customize Header & Download QA Inspection Report (FL/QAD/F/42)">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                            </button>
                                            <button type="button" class="btn btn-outline-danger dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="Quick Options">
                                                <span class="visually-hidden">Toggle Dropdown</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item py-1" href="#" onclick="openReportModal(@u.JobId, @u.UnitNo, '@(u.UnitTokenNo ?? "")', '@u.ProductCode - @u.ProductName', '@(u.ProductSerial ?? u.JobNo)'); return false;">
                                                        <i class="bi bi-sliders me-2 text-primary"></i> Edit Header & Download...
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-1 text-danger" asp-action="ExportProductUnitPdf" asp-route-jobId="@u.JobId" asp-route-unitNo="@u.UnitNo" target="_blank">
                                                        <i class="bi bi-download me-2"></i> Quick Download (Standard)
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        <a asp-action="Traceability" asp-route-q="@(u.UnitTokenNo ?? u.ProductSerial ?? u.JobNo)" class="btn btn-sm btn-outline-primary" title="View Full PRD Unit Traceability">
                                            <i class="bi bi-search me-1"></i> Trace PRD
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- Component Sessions Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;">Session</th>
                        <th scope="col">Job &amp; Serial</th>
                        <th scope="col">Product / Component</th>
                        <th scope="col">Worker</th>
                        <th scope="col">Devices</th>
                        <th scope="col">Start &amp; Duration</th>
                        <th scope="col" class="text-center">Steps</th>
                        <th scope="col" class="text-center">Result</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Sessions.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No sessions found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-secondary">#@s.SessionId</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@s.JobNo</div>
                                    @if (!string.IsNullOrEmpty(s.UnitTokenNo))
                                    {
                                        <div class="small font-monospace text-truncate text-primary fw-semibold" style="max-width: 200px;" title="Unit #@s.UnitNo PRD Token: @s.UnitTokenNo">
                                            <i class="bi bi-upc-scan me-1"></i>#@s.UnitNo: @s.UnitTokenNo
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(s.ProductSerial))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@s.ProductSerial</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unit #@s.UnitNo</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@s.ProductName</div>
                                    <div class="small text-muted">@s.ComponentName <span class="badge bg-secondary-subtle text-secondary">v@(s.TemplateVersion)</span></div>
                                </td>
                                <td>
                                    <div class="fw-medium">@s.WorkerName</div>
                                    @if (!string.IsNullOrEmpty(s.EmployeeNo))
                                    {
                                        <div class="small text-muted font-monospace">@s.EmployeeNo</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.TorqueTransmitterId))
                                    {
                                        <div class="small"><i class="bi bi-wrench me-1 text-primary"></i>@s.TorqueTransmitterId</div>
                                    }
                                    @if (!string.IsNullOrEmpty(s.VernierTransmitterId))
                                    {
                                        <div class="small"><i class="bi bi-rulers me-1 text-info"></i>@s.VernierTransmitterId</div>
                                    }
                                    @if (string.IsNullOrEmpty(s.TorqueTransmitterId) && string.IsNullOrEmpty(s.VernierTransmitterId))
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="small">@s.StartTime.ToIstString("yyyy-MM-dd HH:mm")</div>
                                    <div class="small text-muted">
                                        @(s.Duration.HasValue ? $"{s.Duration.Value.TotalMinutes:0.0} min" : "In Progress")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <span class="text-success fw-bold">@s.PassedSteps</span> /
                                        <span class="text-danger fw-bold">@s.FailedSteps</span> /
                                        @s.TotalSteps
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (s.FinalResult == SessionResult.Pass)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> PASS
                                        </span>
                                    }
                                    else if (s.FinalResult == SessionResult.Fail)
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i> FAIL
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2 py-1">
                                            <i class="bi bi-hourglass me-1"></i> @s.FinalResult
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="SessionDetail" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<partial name="_CustomizeInspectionReportModal" />

<!-- Modal: Camera QR Scanner -->
<div class="modal fade" id="reportScannerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white" style="border-radius: 16px 16px 0 0;">
                <div>
                    <h5 class="modal-title h6 fw-bold mb-0">
                        <i class="bi bi-camera text-primary me-2"></i>Scan PRD QR Code
                    </h5>
                    <small class="text-white-50">Point camera at physical PRD label or enter token manually</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseReportScanner"></button>
            </div>
            <div class="modal-body p-3 text-center">
                <div class="position-relative mx-auto bg-black rounded-3 overflow-hidden shadow" style="max-width: 380px; height: 280px;">
                    <video id="reportScannerVideo" playsinline autoplay muted style="width: 100%; height: 100%; object-fit: cover;"></video>
                    <div id="reportScannerReticle" style="position: absolute; top: 15%; left: 15%; width: 70%; height: 70%; border: 2px dashed rgba(255,255,255,0.7); border-radius: 12px; pointer-events: none; box-shadow: 0 0 0 1000px rgba(0,0,0,0.45);">
                        <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background: #dc2626; animation: scanLine 2s infinite ease-in-out;"></div>
                    </div>
                    <div id="reportScannerCameraError" class="position-absolute top-50 start-50 translate-middle text-white p-3 d-none w-100">
                        <i class="bi bi-camera-video-off fs-1 text-danger mb-2 d-block"></i>
                        <span class="small">Camera access not available. Use manual token input below.</span>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label small fw-semibold text-muted">Or enter 40-character PRD Token manually:</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control font-monospace" id="reportManualTokenInput" placeholder="PRD-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" />
                        <button type="button" class="btn btn-primary" id="btnSubmitReportManualToken">
                            <i class="bi bi-search me-1"></i> Check Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Scan Result / Not Present Modal -->
<div class="modal fade" id="reportScanResultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom py-3 px-4" id="scanResultHeader">
                <h5 class="modal-title h6 fw-bold mb-0 text-dark" id="scanResultTitle">
                    <i class="bi bi-clipboard-check text-primary me-2"></i>PRD Quality Report
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="scanResultBody">
                <!-- Dynamically populated by JS -->
            </div>
            <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between" style="border-radius: 0 0 16px 16px;" id="scanResultFooter">
                <!-- Dynamically populated by JS -->
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scanLine {
        0% { top: 5%; opacity: 0.8; }
        50% { top: 90%; opacity: 1; }
        100% { top: 5%; opacity: 0.8; }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('form[method="get"]');
            if (form) {
                var searchTimer;
                form.querySelectorAll('select').forEach(function (sel) {
                    sel.addEventListener('change', function () { form.submit(); });
                });
                form.querySelectorAll('input[type="text"]').forEach(function (inp) {
                    inp.addEventListener('input', function () {
                        clearTimeout(searchTimer);
                        searchTimer = setTimeout(function () { form.submit(); }, 400);
                    });
                });
                form.querySelectorAll('input[type="date"]').forEach(function (inp) {
                    inp.addEventListener('change', function () { form.submit(); });
                });
            }

            // QR Camera Scanner Logic for Reports
            let videoStream = null;
            let scanInterval = null;
            const scannerModalEl = document.getElementById('reportScannerModal');
            const scannerModal = scannerModalEl ? new bootstrap.Modal(scannerModalEl) : null;
            const resultModalEl = document.getElementById('reportScanResultModal');
            const resultModal = resultModalEl ? new bootstrap.Modal(resultModalEl) : null;

            const videoEl = document.getElementById('reportScannerVideo');
            const cameraErrorEl = document.getElementById('reportScannerCameraError');

            function openScanner() {
                scannerModal?.show();
                startCamera();
            }

            document.getElementById('btnScanPrdHeader')?.addEventListener('click', openScanner);
            document.getElementById('btnScanPrdInput')?.addEventListener('click', openScanner);

            document.getElementById('btnCloseReportScanner')?.addEventListener('click', stopCamera);
            scannerModalEl?.addEventListener('hidden.bs.modal', stopCamera);

            async function startCamera() {
                if (cameraErrorEl) cameraErrorEl.classList.add('d-none');
                try {
                    videoStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
                    });
                    if (videoEl) {
                        videoEl.srcObject = videoStream;
                        videoEl.play();
                    }
                    startDecoding();
                } catch (err) {
                    console.warn('Camera stream error:', err);
                    if (cameraErrorEl) cameraErrorEl.classList.remove('d-none');
                }
            }

            function stopCamera() {
                if (scanInterval) { clearInterval(scanInterval); scanInterval = null; }
                if (videoStream) {
                    videoStream.getTracks().forEach(t => t.stop());
                    videoStream = null;
                }
            }

            function startDecoding() {
                if ('BarcodeDetector' in window) {
                    const detector = new BarcodeDetector({ formats: ['qr_code'] });
                    scanInterval = setInterval(async () => {
                        if (!videoEl || videoEl.readyState !== videoEl.HAVE_ENOUGH_DATA) return;
                        try {
                            const barcodes = await detector.detect(videoEl);
                            if (barcodes.length > 0) {
                                const raw = barcodes[0].rawValue || '';
                                if (raw.trim()) {
                                    handleScannedToken(raw.trim());
                                }
                            }
                        } catch (e) {}
                    }, 250);
                }
            }

            document.getElementById('btnSubmitReportManualToken')?.addEventListener('click', () => {
                const tok = document.getElementById('reportManualTokenInput')?.value.trim();
                if (tok) {
                    handleScannedToken(tok);
                } else {
                    alert('Please enter a PRD token.');
                }
            });

            async function handleScannedToken(token) {
                stopCamera();
                scannerModal?.hide();

                try {
                    const res = await fetch('/Report/ScanPrd?token=' + encodeURIComponent(token));
                    const data = await res.json();
                    showScanResult(data, token);
                } catch (err) {
                    alert('Error checking report: ' + err.message);
                }
            }

            function showScanResult(data, token) {
                const body = document.getElementById('scanResultBody');
                const footer = document.getElementById('scanResultFooter');
                const header = document.getElementById('scanResultHeader');
                const title = document.getElementById('scanResultTitle');

                if (!data.found || !data.hasSessions) {
                    // Report Not Present
                    header.className = 'modal-header bg-warning-subtle text-dark border-bottom py-3 px-4';
                    title.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Unit Report Not Present';

                    let msgDetail = data.message || 'No assembly report or session records found for this unit.';
                    let tokenDisplay = data.token || token;

                    body.innerHTML = `
                        <div class="text-center py-2">
                            <div class="p-3 bg-light rounded-circle d-inline-flex mb-3">
                                <i class="bi bi-file-earmark-x fs-1 text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Report Not Present</h5>
                            <p class="text-muted small mb-3">${msgDetail}</p>
                            
                            <div class="card bg-light border p-3 text-start small mb-2">
                                <div class="text-muted small mb-1">Scanned Token:</div>
                                <div class="font-monospace text-dark text-break fw-semibold mb-2">${tokenDisplay}</div>
                                ${data.found ? `
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Work Order:</span>
                                        <span class="fw-bold font-monospace">${data.jobNo}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Product:</span>
                                        <span class="fw-bold">${data.productCode}</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Status:</span>
                                        <span class="badge bg-secondary text-white">${data.unitStatus || 'Pending'}</span>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    `;

                    footer.innerHTML = `
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="bootstrap.Modal.getInstance(document.getElementById('reportScanResultModal')).hide(); openScanner();">
                            <i class="bi bi-camera me-1"></i> Scan Another QR
                        </button>
                    `;
                } else {
                    // Report Present with Quality Sessions
                    const isPass = data.isPassed;
                    const isInRework = data.isInRework;

                    if (isInRework) {
                        header.className = 'modal-header bg-warning-subtle text-dark border-bottom py-3 px-4';
                        title.innerHTML = '<i class="bi bi-arrow-repeat text-warning me-2"></i>Quality Report: UNIT UNDER REWORK';
                    } else if (isPass) {
                        header.className = 'modal-header bg-success-subtle text-dark border-bottom py-3 px-4';
                        title.innerHTML = '<i class="bi bi-check-circle-fill text-success me-2"></i>Quality Report Present: PASS';
                    } else {
                        header.className = 'modal-header bg-danger-subtle text-dark border-bottom py-3 px-4';
                        title.innerHTML = '<i class="bi bi-x-circle-fill text-danger me-2"></i>Quality Report Present: FAIL / REWORK';
                    }

                    let reworkLogHtml = '';
                    if (data.reworkHistory && data.reworkHistory.length > 0) {
                        reworkLogHtml = `
                            <div class="card border-warning bg-warning-subtle p-2 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark small"><i class="bi bi-clock-history me-1 text-warning"></i>Rework Audit Trail (${data.reworkHistory.length} cycle${data.reworkHistory.length > 1 ? 's' : ''})</strong>
                                    <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.68rem;">LATEST: REV #${data.reworkCount}</span>
                                </div>
                                <div class="table-responsive bg-white rounded border">
                                    <table class="table table-sm table-bordered mb-0" style="font-size: 0.73rem;">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center" style="width: 35px;">Rev</th>
                                                <th>Reason / Defect</th>
                                                <th>Initiated</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${data.reworkHistory.map(r => `
                                                <tr>
                                                    <td class="text-center fw-bold text-primary">#${r.reworkIteration}</td>
                                                    <td>
                                                        <div class="fw-semibold text-dark">${r.defectCategory || 'Defect'}: ${r.reason}</div>
                                                        ${r.resolutionNotes ? `<div class="text-muted small">${r.resolutionNotes}</div>` : ''}
                                                    </td>
                                                    <td class="text-muted">${r.initiatedAt} <br/><small class="text-dark">by ${r.initiatedByUserName}</small></td>
                                                    <td class="text-center">
                                                        <span class="badge ${r.status === 'Completed' ? 'bg-success' : 'bg-warning text-dark'}">${r.status}</span>
                                                    </td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        `;
                    }

                    body.innerHTML = `
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge ${isInRework ? 'bg-warning text-dark border border-warning' : (isPass ? 'bg-success' : 'bg-danger')} px-2 py-1 fs-6 text-uppercase">
                                        ${data.overallStatus}
                                    </span>
                                    <span class="fw-bold text-dark fs-5 ms-2">PRD-${data.unitIndex}</span>
                                    <span class="text-muted small">of ${data.totalQuantity}</span>
                                </div>
                                <span class="badge bg-light text-secondary border font-monospace">${data.jobNo}</span>
                            </div>

                            ${reworkLogHtml}

                            <div class="card bg-light border p-3 small mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Product:</span>
                                    <strong class="text-dark">${data.productCode} — ${data.productName}</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Line:</span>
                                    <span>${data.assemblyLine}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Worker:</span>
                                    <span>${data.workerName}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Fastener / Bolt Torque:</span>
                                    <strong class="${isPass ? 'text-success' : 'text-danger'}">${data.passedBolts} / ${data.totalBolts} Passed</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Working Time:</span>
                                    <span>${data.duration} (${data.startTime})</span>
                                </div>
                                <div class="border-top pt-2 mt-2">
                                    <div class="text-muted small">PRD Token:</div>
                                    <div class="font-monospace text-dark text-break fw-semibold" style="font-size: 0.72rem;">${data.token}</div>
                                </div>
                            </div>
                        </div>
                    `;

                    footer.innerHTML = `
                        <div class="d-flex gap-1">
                            <a href="${data.filterUrl}" class="btn btn-outline-secondary btn-sm" title="Filter this table">
                                <i class="bi bi-funnel me-1"></i> Filter Table
                            </a>
                            <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="bootstrap.Modal.getInstance(document.getElementById('reportScanResultModal')).hide(); openTriggerReworkModal('${data.token}', '${data.jobNo}', ${data.unitIndex}, '${data.productCode}', ${isInRework});" title="Send to Rework">
                                <i class="bi bi-arrow-repeat me-1"></i> ${isInRework ? 'Re-Trigger Rework' : 'Send to Rework'}
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="${data.traceUrl}" class="btn btn-primary btn-sm shadow-sm">
                                <i class="bi bi-search me-1"></i> Full Traceability
                            </a>
                            <a href="${data.pdfUrl}" target="_blank" class="btn btn-danger btn-sm shadow-sm">
                                <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
                            </a>
                        </div>
                    `;
                }

                resultModal?.show();
            }
        })();
    </script>
}
