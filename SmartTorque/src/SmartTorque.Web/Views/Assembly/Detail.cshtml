@model SmartTorque.Services.AssemblyLineDetailDto
@using SmartTorque.Core.Entities
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"{Model.AssemblyCode} — Assembly Line Details";
    ViewData["ActiveNav"] = "Assembly";
    var unmappedProducts = (ViewBag.UnmappedProducts as IReadOnlyList<Product>) ?? new List<Product>();
    var allWorkers = (ViewBag.ActiveWorkers as IReadOnlyList<ApplicationUser>) ?? new List<ApplicationUser>();
    var stations = (ViewBag.WorkStations as IReadOnlyList<SmartTorque.Services.WorkStationDto>) ?? new List<SmartTorque.Services.WorkStationDto>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="h4 fw-bold mb-0">@Model.AssemblyCode — @Model.AssemblyName</h1>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>
        <p class="text-muted small mb-0 tooltip-trigger" data-tooltip="Assembly line details and creation date">
            Department: <strong class="text-dark">@Model.Department</strong> &bull; Created: @Model.CreatedAt.ToIstString("dd MMM yyyy HH:mm")
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addStationModal">
            <i class="bi bi-diagram-2 me-1"></i> Add Station / Subcell
        </button>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#mapProductModal">
            <i class="bi bi-plus-lg me-1"></i> Map Product
        </button>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#assignWorkerModal">
            <i class="bi bi-person-plus me-1"></i> Assign Worker
        </button>
        <a asp-action="Edit" asp-route-id="@Model.AssemblyLineId" class="btn btn-secondary">
            <i class="bi bi-pencil me-1"></i> Edit Line
        </a>
    </div>
</div>


<!-- Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Mapped Products</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.Products.Count</h3>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Stations &amp; Subcells</span>
                    <h3 class="fw-bold my-1 text-dark">@stations.Count</h3>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-diagram-2 fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Assigned Workers</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.Workers.Count</h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Active Tasks</span>
                    <h3 class="fw-bold my-1 text-dark">@Model.ActiveTasks.Count</h3>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-kanban fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs for Products, Stations, Workers, Tasks -->
<ul class="nav nav-pills mb-3 gap-2" id="lineTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="products-tab" data-bs-toggle="pill" data-bs-target="#products-pane" type="button" role="tab">
            <i class="bi bi-box-seam me-1"></i> Mapped Products (@Model.Products.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="stations-tab" data-bs-toggle="pill" data-bs-target="#stations-pane" type="button" role="tab">
            <i class="bi bi-diagram-2 me-1"></i> Stations &amp; Subcells (@stations.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="workers-tab" data-bs-toggle="pill" data-bs-target="#workers-pane" type="button" role="tab">
            <i class="bi bi-people me-1"></i> Workers on Line (@Model.Workers.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tasks-tab" data-bs-toggle="pill" data-bs-target="#tasks-pane" type="button" role="tab">
            <i class="bi bi-kanban me-1"></i> Active Tasks &amp; Workload (@Model.ActiveTasks.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="lineTabsContent">
    <!-- MAPPED PRODUCTS PANE -->
    <div class="tab-pane fade show active" id="products-pane" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Products Designated for @Model.AssemblyCode</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item Code</th>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th class="text-center">Designated Default</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Products.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-box-seam fs-2 text-secondary opacity-50"></i>
                                    <p class="mt-2 mb-1 fw-semibold">No products mapped to this line</p>
                                    <p class="small text-muted">Click "Add Product Mapping" to assign existing products to this assembly line.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var prod in Model.Products)
                            {
                                <tr>
                                    <td>
                                        <a href="/Product/Detail/@prod.ProductId" class="fw-bold text-decoration-none text-primary">
                                            @prod.ProductCode
                                        </a>
                                    </td>
                                    <td class="fw-semibold">
                                        @prod.ProductName
                                        @if (prod.WorkStationId.HasValue)
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-info-subtle text-dark border border-info" style="font-size: 0.72rem;">
                                                    <i class="bi bi-geo-alt-fill text-info me-1"></i>Station: @prod.StationCode (@prod.StationName)
                                                </span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(prod.Description) ? "—" : prod.Description)</td>
                                    <td class="text-center">
                                        @if (prod.IsDefault)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-check-circle me-1"></i>Designated Line
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="SetDefaultLine" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@prod.ProductId" />
                                                <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="btn btn-xs btn-outline-secondary" title="Make this line the primary designated line">
                                                    Set as Default
                                                </button>
                                            </form>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (prod.IsProductActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="RemoveProduct" method="post" class="d-inline" onsubmit="return confirm('Remove product @prod.ProductCode@(prod.WorkStationId.HasValue ? $" ({prod.StationCode})" : "") from this assembly line?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@prod.ProductId" />
                                            <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                            @if (prod.WorkStationId.HasValue)
                                            {
                                                <input type="hidden" name="workStationId" value="@prod.WorkStationId" />
                                            }
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove mapping">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- STATIONS & SUBCELLS PANE -->
    <div class="tab-pane fade" id="stations-pane" role="tabpanel">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-1">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-diagram-2 text-primary me-2"></i>Stations &amp; Subcells under @Model.AssemblyCode</h6>
                    <span class="tooltip-trigger border-0" data-tooltip="Physical workstations and subcells configured for localized fastening steps and dedicated worker assignment.">
                        <i class="bi bi-info-circle tooltip-icon"></i>
                    </span>
                </div>
            </div>
            @if (stations.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-diagram-2 fs-1 text-secondary opacity-50 mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">No Stations or Subcells Configured</h5>
                    <p class="text-muted small mx-auto" style="max-width: 520px;">
                        This line operates line-wide without designated stations. You can add workstations or manufacturing subcells to scope specific product assembly operations (e.g. Bolt 1–2 vs Bolt 3–4) and pin workers to individual stations.
                    </p>
                    <button type="button" class="btn btn-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#addStationModal">
                        <i class="bi bi-plus-circle me-1"></i> Add First Station / Subcell
                    </button>
                </div>
            }
            else
            {
                <div class="card-body p-3">
                    <div class="row g-3">
                        @foreach (var st in stations)
                        {
                            var stationProducts = Model.Products.Where(p => p.WorkStationId == st.WorkStationId).ToList();
                            var stationWorkers = Model.Workers.Where(w => w.WorkStationId == st.WorkStationId).ToList();

                            <div class="col-12">
                                <div class="card border rounded-3 shadow-none">
                                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center py-2 px-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(st.StationType == SmartTorque.Core.Enums.StationType.Subcell ? "bg-warning-subtle text-warning-emphasis border border-warning" : "bg-info-subtle text-info-emphasis border border-info") px-2 py-1">
                                                <i class="bi @(st.StationType == SmartTorque.Core.Enums.StationType.Subcell ? "bi-grid-3x3" : "bi-wrench") me-1"></i>@st.StationType
                                            </span>
                                            <h6 class="mb-0 fw-bold text-dark">@st.StationCode — @st.StationName</h6>
                                            <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <form asp-action="DeleteStation" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove station @st.StationCode? Any workers on this station will revert to line-wide.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="workStationId" value="@st.WorkStationId" />
                                                <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove station">
                                                    <i class="bi bi-trash me-1"></i>Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (!string.IsNullOrWhiteSpace(st.Description))
                                        {
                                            <p class="small text-muted mb-3"><i class="bi bi-info-circle me-1"></i>@st.Description</p>
                                        }
                                        <div class="row g-3">
                                            <!-- Designated Products Under This Station -->
                                            <div class="col-md-6 border-end">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-uppercase small fw-bold text-secondary">
                                                        <i class="bi bi-box-seam me-1"></i>Designated Products &amp; Scopes (@stationProducts.Count)
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary small" data-bs-toggle="modal" data-bs-target="#mapProductModal" onclick="preselectStation(@st.WorkStationId)">
                                                        + Map Product
                                                    </button>
                                                </div>
                                                @if (stationProducts.Count == 0)
                                                {
                                                    <div class="p-3 bg-light rounded text-center text-muted small">
                                                        No products specifically mapped to this station yet.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var prod in stationProducts)
                                                        {
                                                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-start">
                                                                <div>
                                                                    <a href="/Product/Detail/@prod.ProductId" class="fw-bold text-decoration-none text-primary">
                                                                        @prod.ProductCode
                                                                    </a>
                                                                    <div class="small text-dark">@prod.ProductName</div>
                                                                    <div class="mt-1">
                                                                        @if (!string.IsNullOrWhiteSpace(prod.ScopeSummary))
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">
                                                                                <i class="bi bi-check2-circle me-1"></i>@prod.ScopeSummary
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.72rem;">
                                                                                Full Product
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <form asp-action="RemoveProduct" method="post" class="d-inline" onsubmit="return confirm('Remove product @prod.ProductCode from station @st.StationCode?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="productId" value="@prod.ProductId" />
                                                                    <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                                                    <input type="hidden" name="workStationId" value="@prod.WorkStationId" />
                                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2" title="Unmap product from station">
                                                                        <i class="bi bi-x-circle"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <!-- Assigned Workers Under This Station -->
                                            <div class="col-md-6">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-uppercase small fw-bold text-secondary">
                                                        <i class="bi bi-people me-1"></i>Assigned Station Workers (@stationWorkers.Count)
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary small" data-bs-toggle="modal" data-bs-target="#assignWorkerModal" onclick="preselectWorkerStation(@st.WorkStationId)">
                                                        + Assign Worker
                                                    </button>
                                                </div>
                                                @if (stationWorkers.Count == 0)
                                                {
                                                    <div class="p-3 bg-light rounded text-center text-muted small">
                                                        No dedicated workers assigned directly to this station. Line workers handle tasks line-wide.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var w in stationWorkers)
                                                        {
                                                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <div class="fw-semibold text-dark">
                                                                        <i class="bi bi-person-fill text-success me-1"></i>@w.FullName
                                                                    </div>
                                                                    <div class="small text-muted">
                                                                        @(string.IsNullOrWhiteSpace(w.EmployeeNo) ? w.Email : w.EmployeeNo) &bull;
                                                                        <span class="text-primary fw-semibold">@w.ActiveTaskCount task(s) (@w.ActiveWorkload.ToString("F1") pts)</span>
                                                                    </div>
                                                                </div>
                                                                <form asp-action="AssignWorkerLine" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="workerId" value="@w.WorkerId" />
                                                                    <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                                                    <input type="hidden" name="workStationId" value="" />
                                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" title="Unpin to Line-Wide">
                                                                        Float Line-Wide
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- WORKERS PANE -->
    <div class="tab-pane fade" id="workers-pane" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Workers Operating on @Model.AssemblyCode</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Worker Name</th>
                            <th>Employee ID / Username</th>
                            <th>Station / Subcell</th>
                            <th>Email</th>
                            <th class="text-center">Active Workload</th>
                            <th class="text-center">Active Tasks</th>
                            <th class="text-center">Last Task Assigned</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Workers.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-people fs-2 text-secondary opacity-50"></i>
                                    <p class="mt-2 mb-1 fw-semibold">No workers assigned to this line</p>
                                    <p class="small text-danger">Strict boundary: Tasks cannot be auto-assigned until at least one worker is assigned to this line.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var w in Model.Workers)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <i class="bi bi-person-circle text-primary me-2"></i>@w.FullName
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(w.EmployeeNo) ? "—" : w.EmployeeNo)</td>
                                    <td>
                                        @if (w.WorkStationId.HasValue)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">
                                                <i class="bi bi-geo-alt me-1"></i>@w.StationCode (@w.StationName)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Line-Wide (Floating)</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@w.Email</td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary fw-bold fs-6">
                                            @w.ActiveWorkload.ToString("F1") pts
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            @w.ActiveTaskCount task(s)
                                        </span>
                                    </td>
                                    <td class="text-center text-muted small">
                                        @(w.LastAssignedAt.HasValue ? w.LastAssignedAt.Value.ToIstString("dd MMM HH:mm") : "None yet")
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="AssignWorkerLine" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@w.WorkerId" />
                                            <input type="hidden" name="assemblyLineId" value="" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Unassign worker from line">
                                                <i class="bi bi-x-circle me-1"></i>Unassign
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ACTIVE TASKS PANE -->
    <div class="tab-pane fade" id="tasks-pane" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Active Tasks for @Model.AssemblyCode</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Job No</th>
                            <th>Item Code</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th class="text-center">Workload Pts</th>
                            <th>Assigned Worker</th>
                            <th>Due Date</th>
                            <th class="text-end">Reassign</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ActiveTasks.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-kanban fs-2 text-secondary opacity-50"></i>
                                    <p class="mt-2 mb-0 fw-semibold">No active tasks on this line</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var task in Model.ActiveTasks)
                            {
                                <tr>
                                    <td>
                                        <a href="/Job/@task.JobId" class="fw-bold text-decoration-none text-primary">
                                            @task.JobNo
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@task.ProductCode</div>
                                        <div class="text-muted small">@task.ProductName</div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background-color: var(--priority-@task.Priority.ToString().ToLower(), #6c757d); color: #fff;">
                                            @task.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(task.Status == SmartTorque.Core.Enums.JobStatus.Pending ? "bg-warning-subtle text-dark" : "bg-primary-subtle text-primary")">
                                            @task.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border fw-bold">
                                            @task.EstimatedWorkload.ToString("F1")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(task.AssignedWorkerName))
                                        {
                                            <span class="fw-semibold text-success">
                                                <i class="bi bi-person-check me-1"></i>@task.AssignedWorkerName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Unassigned</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(task.DueDate.HasValue ? task.DueDate.Value.ToString("dd MMM yyyy") : "—")
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reassignModal-@task.JobId">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>

                                        <!-- Reassign Task Modal -->
                                        <div class="modal fade text-start" id="reassignModal-@task.JobId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="ReassignTask" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="jobId" value="@task.JobId" />
                                                        <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Reassign Task @task.JobNo</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Worker (Only workers assigned to @Model.AssemblyCode)</label>
                                                                <select name="workerId" class="form-select">
                                                                    <option value="">— Unassign (Pending) —</option>
                                                                    @foreach (var w in Model.Workers)
                                                                    {
                                                                        <option value="@w.WorkerId" selected="@(w.WorkerId == task.AssignedWorkerId)">
                                                                            @w.FullName (Workload: @w.ActiveWorkload.ToString("F1") pts)
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Estimated Workload (pts)</label>
                                                                <input type="number" step="0.1" name="estimatedWorkload" class="form-control" value="@task.EstimatedWorkload" />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary btn-sm">Save Reassignment</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Map Product to Line -->
<div class="modal fade" id="mapProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Map Product to @Model.AssemblyCode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Select Product
                            <span class="tooltip-trigger border-0" data-tooltip="Choose from active products currently created in Product Management.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select name="productId" class="form-select" required>
                            <option value="">— Select an active product —</option>
                            @foreach (var p in unmappedProducts)
                            {
                                <option value="@p.ProductId">@p.ProductCode — @p.ProductName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Target Workstation / Subcell (Optional)
                            <span class="tooltip-trigger border-0" data-tooltip="Optionally designate this product mapping to a specific workstation on this line.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select name="workStationId" class="form-select">
                            <option value="">— Line-Wide (All Stations / Entire Line) —</option>
                            @foreach (var st in stations)
                            {
                                <option value="@st.WorkStationId">@st.StationCode — @st.StationName (@st.StationType)</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="checkDefault" checked />
                        <label class="form-check-label small" for="checkDefault">
                            Set as primary designated assembly line for this product
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Map Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Assign Worker to Line -->
<div class="modal fade" id="assignWorkerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignWorkerLine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Assign Worker to @Model.AssemblyCode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Select Active Worker
                            <span class="tooltip-trigger border-0" data-tooltip="Assigning a worker associates their active capacity with this line for automatic workload distribution.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select name="workerId" class="form-select" required>
                            <option value="">— Select Worker —</option>
                            @foreach (var w in allWorkers)
                            {
                                var currentLineText = w.CurrentAssemblyLineId.HasValue
                                    ? (w.CurrentAssemblyLineId == Model.AssemblyLineId ? "Already on this line" : $"On line {w.CurrentAssemblyLine?.AssemblyCode ?? w.CurrentAssemblyLineId.ToString()}")
                                    : "Unassigned";
                                <option value="@w.Id">@w.FullName (@currentLineText)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Target Station / Subcell (Optional)
                            <span class="tooltip-trigger border-0" data-tooltip="Optionally pin this worker to a specific station on this line, or leave line-wide.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select name="workStationId" id="assignModalStationSelect" class="form-select">
                            <option value="">— Entire Line (Line-Wide / Floating) —</option>
                            @foreach (var st in stations)
                            {
                                <option value="@st.WorkStationId">@st.StationCode — @st.StationName (@st.StationType)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Assign to Line</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Station / Subcell -->
<div class="modal fade" id="addStationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddStation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="assemblyLineId" value="@Model.AssemblyLineId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-diagram-2 text-primary me-2"></i>Add Station / Subcell to @Model.AssemblyCode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Station / Subcell Code <span class="text-danger">*</span>
                            <span class="tooltip-trigger border-0" data-tooltip="Unique identifier for this workstation within the assembly line.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <input type="text" name="stationCode" class="form-control" data-no-spaces="true" placeholder="e.g. ST-01, SUBCELL-01, STATION1" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Station / Subcell Name <span class="text-danger">*</span>
                            <span class="tooltip-trigger border-0" data-tooltip="Descriptive display name for workers and reports.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <input type="text" name="stationName" class="form-control" placeholder="e.g. Station 1 - Front Panel Fastening" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Type <span class="text-danger">*</span>
                            <span class="tooltip-trigger border-0" data-tooltip="Select Station for assembly lines or Subcell for cellular manufacturing cells.">
                                <i class="bi bi-info-circle tooltip-icon"></i>
                            </span>
                        </label>
                        <select name="stationType" class="form-select" required>
                            <option value="Station">Station (Physical Workstation on Assembly Line)</option>
                            <option value="Subcell">Subcell (Autonomous Manufacturing Subcell)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description / Notes (Optional)</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="e.g. Pre-assembly torque checks, Bolt 1 to Bolt 2" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Add Station</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function preselectStation(stationId) {
            const sel = document.querySelector('#mapProductModal select[name="workStationId"]');
            if (sel) sel.value = stationId;
        }
        function preselectWorkerStation(stationId) {
            const sel = document.querySelector('#assignWorkerModal select[name="workStationId"]');
            if (sel) sel.value = stationId;
        }
    </script>
}
