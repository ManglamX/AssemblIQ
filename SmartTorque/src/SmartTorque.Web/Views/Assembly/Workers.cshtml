@model SmartTorque.Web.ViewModels.Assembly.WorkersManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Worker Line Assignments";
    ViewData["ActiveNav"] = "Assembly";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="h4 fw-bold mb-0">Worker Assembly Line Assignments</h1>
        </div>
        <p class="text-muted small mb-0">Manage which assembly line each active worker is stationed at and monitor their real-time workload</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Active Workers Directory</h5>
        <span class="text-muted small">Total: @Model.Workers.Count worker(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Worker Name</th>
                    <th>Employee ID</th>
                    <th>Email</th>
                    <th>Current Assembly Line</th>
                    <th class="text-center">Active Workload</th>
                    <th class="text-center">Active Tasks</th>
                    <th class="text-end" style="width: 220px;">Assign / Switch Line</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Workers.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-people fs-1 text-secondary opacity-50"></i>
                            <p class="mt-2 mb-0 fw-semibold">No active workers found in the system</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var w in Model.Workers)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold"><i class="bi bi-person-circle text-primary me-2"></i>@w.FullName</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(w.EmployeeNo) ? "—" : w.EmployeeNo)</td>
                            <td class="text-muted small">@w.Email</td>
                            <td>
                                @if (w.CurrentAssemblyLineId.HasValue)
                                {
                                    <span class="badge bg-success-subtle text-success p-2">
                                        <i class="bi bi-diagram-3 me-1"></i>@w.CurrentAssemblyCode — @w.CurrentAssemblyName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary p-2">
                                        <i class="bi bi-dash-circle me-1"></i>Unassigned
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(w.ActiveWorkload > 0 ? "bg-primary-subtle text-primary" : "bg-light text-muted border") fw-bold fs-6">
                                    @w.ActiveWorkload.ToString("F1") pts
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @w.ActiveTaskCount task(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="AssignWorkerLine" method="post" class="d-flex align-items-center justify-content-end gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workerId" value="@w.WorkerId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <select name="assemblyLineId" class="form-select form-select-sm" style="max-width: 150px;">
                                        <option value="">— Unassign —</option>
                                        @foreach (var line in Model.AssemblyLines)
                                        {
                                            <option value="@line.AssemblyLineId" selected="@(w.CurrentAssemblyLineId == line.AssemblyLineId)">
                                                @line.AssemblyCode
                                            </option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Update line">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
