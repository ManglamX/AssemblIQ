@model SmartTorque.Web.ViewModels.Assembly.ProductMappingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Product-to-Assembly Mapping";
    ViewData["ActiveNav"] = "Assembly";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="h4 fw-bold mb-0">Product-to-Assembly Mapping</h1>
        </div>
        <p class="text-muted small mb-0">Designate the required assembly line for each product item code from the Product Catalogue</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assignProductModal">
            <i class="bi bi-plus-lg me-1"></i> Map Product to Line
        </button>
    </div>
</div>

@if (Model.UnmappedCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>@Model.UnmappedCount Product(s) Without Assembly Assignment:</strong>
                <div class="small">Tasks for unmapped products cannot be automatically assigned until mapped to an active assembly line.</div>
            </div>
        </div>
        <a asp-action="ProductMappings" asp-route-unmappedOnly="true" class="btn btn-sm btn-outline-dark">
            View Unmapped Products
        </a>
    </div>
}

<!-- Filters -->
<form method="get" class="card mb-4 p-3 shadow-sm">
    <div class="row g-2 align-items-end">
        <div class="col-sm-5 col-md-4">
            <label class="form-label small mb-1 fw-semibold">Search Product</label>
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Item code or product name…" value="@Model.Search" />
        </div>
        <div class="col-sm-4 col-md-3">
            <label class="form-label small mb-1 fw-semibold">Assembly Line</label>
            <select name="assemblyLineId" class="form-select form-select-sm">
                <option value="">All Lines</option>
                @foreach (var line in Model.AssemblyLines)
                {
                    <option value="@line.AssemblyLineId" selected="@(Model.AssemblyLineId == line.AssemblyLineId)">
                        @line.AssemblyCode — @line.AssemblyName
                    </option>
                }
            </select>
        </div>
        <div class="col-sm-3 col-md-2">
            <label class="form-label small mb-1 fw-semibold">Filter</label>
            <select name="unmappedOnly" class="form-select form-select-sm">
                <option value="">All Products</option>
                <option value="true" selected="@(Model.UnmappedOnly == true)">Unmapped Only</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-search me-1"></i> Filter
            </button>
            <a asp-action="ProductMappings" class="btn btn-secondary btn-sm ms-1">Clear</a>
        </div>
    </div>
</form>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Product Catalog &amp; Assembly Allocations</h5>
        <span class="text-muted small">Showing @Model.Products.Count entries</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 160px;">Item Code</th>
                    <th scope="col">Product Name</th>
                    <th scope="col">Assigned Assembly Line</th>
                    <th scope="col" class="text-center">Designated Default</th>
                    <th scope="col" class="text-center">Product Status</th>
                    <th scope="col" class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-box-seam fs-1 text-secondary opacity-50"></i>
                            <p class="mt-2 mb-1 fw-semibold">No products match your filter</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td>
                                <a href="/Product/Detail/@item.ProductId" class="fw-bold text-decoration-none text-primary">
                                    @item.ProductCode
                                </a>
                            </td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td>
                                @if (item.AssemblyLineId.HasValue)
                                {
                                    <a asp-action="Detail" asp-route-id="@item.AssemblyLineId" class="badge bg-primary-subtle text-primary text-decoration-none p-2">
                                        <i class="bi bi-diagram-3 me-1"></i>@item.AssemblyCode &bull; @item.AssemblyName
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger p-2">
                                        <i class="bi bi-exclamation-circle me-1"></i>Not Assigned
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.AssemblyLineId.HasValue && item.IsDefault)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-circle me-1"></i>Designated Line
                                    </span>
                                }
                                else if (item.AssemblyLineId.HasValue)
                                {
                                    <form asp-action="SetDefaultLine" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="assemblyLineId" value="@item.AssemblyLineId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-xs btn-outline-secondary" title="Designate this line as default">
                                            Make Default
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.AssemblyLineId.HasValue)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Detail" asp-route-id="@item.AssemblyLineId" class="btn btn-outline-secondary" title="View assembly line">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="RemoveProduct" method="post" class="d-inline" onsubmit="return confirm('Remove @item.ProductCode from @item.AssemblyCode?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="assemblyLineId" value="@item.AssemblyLineId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-outline-danger" title="Remove line mapping">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#assignModal-@item.ProductId">
                                        <i class="bi bi-link me-1"></i>Map to Line
                                    </button>

                                    <!-- Quick map modal for this specific product -->
                                    <div class="modal fade text-start" id="assignModal-@item.ProductId" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="AssignProduct" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Map @item.ProductCode to Assembly Line</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Select Assembly Line</label>
                                                            <select name="assemblyLineId" class="form-select" required>
                                                                <option value="">— Select an active assembly line —</option>
                                                                @foreach (var line in Model.AssemblyLines)
                                                                {
                                                                    <option value="@line.AssemblyLineId">@line.AssemblyCode — @line.AssemblyName (@line.Department)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="form-check mb-3">
                                                            <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="checkDefault-@item.ProductId" checked />
                                                            <label class="form-check-label small" for="checkDefault-@item.ProductId">
                                                                Set as primary designated assembly line
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary btn-sm">Map Product</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Map Product to Line General -->
<div class="modal fade" id="assignProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="modal-header">
                    <h5 class="modal-title">Assign Product to Assembly Line</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Product Item</label>
                        <select name="productId" class="form-select" required>
                            <option value="">— Select product —</option>
                            @foreach (var prod in Model.Products.DistinctBy(p => p.ProductId))
                            {
                                <option value="@prod.ProductId">@prod.ProductCode — @prod.ProductName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Assembly Line</label>
                        <select name="assemblyLineId" class="form-select" required>
                            <option value="">— Select active assembly line —</option>
                            @foreach (var line in Model.AssemblyLines)
                            {
                                <option value="@line.AssemblyLineId">@line.AssemblyCode — @line.AssemblyName</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="genCheckDefault" checked />
                        <label class="form-check-label small" for="genCheckDefault">
                            Set as primary designated assembly line
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save Mapping</button>
                </div>
            </form>
        </div>
    </div>
</div>
